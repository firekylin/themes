<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||'');const hasCover=/^(https?:\/\/|\/(?!\/))/.test(cover);const cat=(archive.loliCategories?.[archive.row.id]||[])[0]; %><article class="entry"><% if(hasCover){ %><a class="thumb" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="entry-content"><% if(cat){ %><a class="category" href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(180) %></div><p class="meta"><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></p></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>