<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const cats=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const cover=String(site.themeConfig.coverUrl||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转到正文</a><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary aria-label="切换导航菜单">☰</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details><label class="theme-control" hidden>模式 <select id="theme-mode"><option value="auto">自动</option><option value="light">明亮</option><option value="dark">暗黑</option></select></label></header><section class="hero"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img src="<%= cover %>" alt=""><% } %><div><h1><%= site.themeConfig.heroText||site.title() %></h1><p><%= site.description() %></p></div><div class="wave" aria-hidden="true"></div></section><div class="container"><div class="breadcrumb"><a href="/">HOME</a></div><div class="columns"><main id="main"><%~ block('content') %></main><details id="widgets" open><summary>侧栏</summary><div class="widgets-inner"><section class="widget"><h2>搜索</h2><form action="/search.html" method="get"><label class="sr-only" for="widget-search">搜索文章</label><input id="widget-search" name="keyword" required><button>搜索</button></form></section><section class="widget"><h2>最近文章</h2><% while(recent.next()){const img=String(recent.row.options?.featuredImage||''); %><article class="recent"><% if(/^(https?:\/\/|\/(?!\/))/.test(img)){ %><img src="<%= img %>" alt="" loading="lazy"><% } %><div><a href="<%= recent.permalink %>"><%= recent.title() %></a><time><%= recent.date('YYYY-MM-DD') %></time></div></article><% } %></section><section class="widget"><h2>分类</h2><ul><% cats.stack.forEach(c=>{ %><li><a href="/cate/<%= c.pathname %>"><%= c.name %></a></li><% }); %></ul></section><section class="widget"><h2>标签云</h2><div class="tags"><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></section></div></details></div></div><footer class="site-footer"><p><%= site.themeConfig.footerText||site.title() %></p><p>Theme by <a href="https://www.boxmoe.com">Boxmoe</a> · <a href="https://github.com/baomihuahua/lolimeow">LoliMeow</a> · Firekylin</p></footer><a class="back-top" href="#top" aria-label="返回顶部">↑</a></body></html>