<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="archive-container"><section class="container content archive"><h2><%= archive.archiveTitle||'最新文章' %></h2><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section></div><% }) %>