<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++; %><dl class="post-row entry"><dt><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></dt><dd><a href="<%= archive.permalink %>"><%= archive.title() %></a></dd></dl><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>