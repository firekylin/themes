<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="header-container gradient"><div class="container"><div class="header-nav"><div class="header-logo"><a href="/"><%= site.title() %></a></div><nav class="native-nav nav-items nav-menu" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><div class="container header-wrapper"><div class="header-content"><%~ block('hero',()=>{ %><h1 class="header-title"><%= site.title() %></h1><div class="header-underline"></div><p class="header-subtitle header-subtitle-homepage"><%= site.description() %></p><% }) %></div></div></header><main id="main" class="native-main"><%~ block('content') %></main><footer class="footer"><div class="container footer-container native-footer"><section><div class="footer-title">站点导航</div><nav aria-label="页脚导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a></nav></section><section><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/shaform/hugo-theme-den">Den</a> / <a href="https://github.com/molivier/nest">Nest</a></p></section></div></footer></body></html>