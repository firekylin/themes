<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><div class="post-bubbles"><a class="format-bubble" aria-label="<%= archive.title() %>" href="<%= archive.permalink %>"></a></div><div class="content-inner"><header class="post-header"><figure class="featured-media"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><div class="post-content"><p><%= archive.excerpt(300) %></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>