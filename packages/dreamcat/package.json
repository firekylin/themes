{
  "name": "dreamcat",
  "title": "DreamCat",
  "version": "0.1.0",
  "private": true,
  "description": "DreamCat Material cards with profile sidebar and customizable palette.",
  "license": "SEE LICENSE IN NOTICE.md",
  "author": "LychApe contributors; Firekylin contributors",
  "homepage": "https://github.com/LychApe/DreamCat",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/dreamcat"
  },
  "firekylin": {
    "type": "theme",
    "id": "dreamcat"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "profileName",
      "label": "侧栏名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "侧栏介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "侧栏图片",
      "help": "站内路径或HTTPS图片。"
    },
    {
      "type": "text",
      "name": "saying",
      "label": "工具栏短句",
      "help": "纯文本，不请求第三方一言服务。"
    },
    {
      "type": "text",
      "name": "listMode",
      "label": "文章列表模式",
      "help": "text（默认）或 image，图片取文章 featuredImage。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本。"
    }
  ]
}
