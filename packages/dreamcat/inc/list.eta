<% const archive=firekylin.archive;const cfg=firekylin.cfg;let count=0;while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||'');const image=cfg.listMode==='image'&&/^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="entry card <%= image?'image-entry':'' %>"><a href="<%= archive.permalink %>"><% if(image){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><div class="entry-body"><h2><%= archive.title() %></h2><p class="meta">发表时间：<%= archive.date('YYYY-MM-DD') %></p><% if(!image){ %><div class="excerpt"><%~ archive.excerpt(350) %></div><p class="read-more">- 阅读剩余部分 -</p><% } %></div></a></article><% }if(!count){ %><p>没有找到内容。</p><% } %>