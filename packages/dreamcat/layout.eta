<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="masthead"><div class="appbar"><details class="site-menu"><summary aria-label="切换导航菜单">☰</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details><a href="/" class="brand"><%= site.title() %></a><button id="appearance-open" hidden>配色</button><button id="copyright-open" hidden>原主题版权</button></div><div class="header-title"><h1><%= site.title() %></h1><p><%= site.description() %></p></div></header><div class="container"><div class="toolbar"><form action="/search.html"><input name="keyword" aria-label="搜索关键词" placeholder="搜索"><button>搜索</button></form><span><%= cfg.saying||site.description() %></span><time id="local-clock" hidden></time></div><div class="columns"><aside class="profile card"><% if(/^(https?:\/\/|\/(?!\/))/.test(String(cfg.avatarUrl||''))){ %><img class="profile-image" src="<%= cfg.avatarUrl %>" alt=""><% } %><div class="profile-text"><h2><%= cfg.profileName||site.title() %></h2><p><%= cfg.profileBio||site.description() %></p><nav><a href="/">首页</a><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><details open><summary>分类</summary><% categories.stack.forEach(c=>{ %><a class="chip" href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></details><details open><summary>标签</summary><% tags.stack.forEach(t=>{ %><a class="chip" href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></details></div></aside><main id="main"><%~ block('content') %></main></div></div><footer class="site-footer"><p>© <%= cfg.footerText||site.title() %> · Powered by Firekylin</p><p>DreamCat 原生改编 · 与原版不同，非原作者背书</p><details id="copyright-fallback"><summary>原主题完整版权声明</summary><%~ include('./inc/copyright') %></details></footer><dialog id="copyright-dialog"><button class="close-dialog" aria-label="关闭版权说明">关闭</button><%~ include('./inc/copyright') %></dialog><dialog id="appearance-dialog"><button class="close-dialog" aria-label="关闭配色面板">关闭</button><h2>外观设置</h2><label>主题色<select id="primary-color"></select></label><label>强调色<select id="accent-color"></select></label><label>明暗模式<select id="color-mode"><option value="auto">跟随系统</option><option value="light">浅色</option><option value="dark">深色</option></select></label><button id="appearance-reset">恢复默认</button></dialog></body></html>