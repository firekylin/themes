<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="posts-container entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="thumbnail-container"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><p><%= archive.excerpt(350) %> <a href="<%= archive.permalink %>">阅读全文</a><span class="post-date"><time><%= archive.date('YYYY-MM-DD') %></time></span></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>