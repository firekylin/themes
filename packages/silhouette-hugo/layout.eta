<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:8});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="top-nav native-top-nav"><div class="native-top-inner"><a class="navbar-brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><%~ block('hero') %><div class="native-main-grid"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section><h2><%= cfg.authorName||site.title() %></h2><p><%= cfg.introDescription||site.description() %></p></section><section><h2>最近文章</h2><nav class="recent-links" aria-label="最近文章"><% recent.stack.slice(0,8).forEach(post=>{ %><a class="nav-link" href="<%= recent.permalinkFor(post) %>"><%= post.title %></a><% }); %></nav></section><section><h2>分类</h2><% categories.stack.slice(0,10).forEach(c=>{ %><a class="nav-link" href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><span><%= c.name %></span><span class="badge badge-pill badge-secondary"><%= c.count %></span></a><% }); %></section><section><h2>标签</h2><% tags.stack.slice(0,10).forEach(t=>{ %><a class="nav-link" href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><span><%= t.name %></span><span class="badge badge-pill badge-secondary"><%= t.count %></span></a><% }); %></section></aside></div><footer><div class="native-footer-columns"><section><h2>关于作者</h2><p class="footer-author"><%= cfg.authorName||site.title() %></p><p><%= cfg.introDescription||site.description() %></p></section><section><h2>关于本站</h2><p><%= cfg.footerText||site.description() %></p></section><section><h2>主题与引擎</h2><p>Firekylin · <a href="https://github.com/mattbutton/silhouette-hugo">Silhouette</a><br>Theme by <a href="https://www.mattbutton.com">Matt Button</a></p></section></div></footer></body></html>