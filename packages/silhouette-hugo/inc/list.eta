<% const archive=firekylin.archive;let count=0; %><div class="recent-posts"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row; %><article class="entry post-list-item"><h2><a class="title" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><strong><%= archive.author('display_name') %></strong> · <time><%= archive.date('YYYY-MM-DD') %></time><span class="tags-inline"><% (meta.tag||[]).forEach(t=>{ %> · <a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a><% }); %></span></div><p class="post-excerpt"><%= archive.excerpt(320) %></p><a class="btn btn-outline-secondary" href="<%= archive.permalink %>">继续阅读</a></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>