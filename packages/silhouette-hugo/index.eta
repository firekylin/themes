<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate,tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('hero',()=>{ %><% if(archive.archiveTitle){ %><header class="feature-image native-hero native-collection-hero"><h1 class="listing-heading"><%= archive.archiveTitle %></h1></header><% }else{const hero=String(site.themeConfig.heroImage||''); %><header class="feature-image native-hero"><% if(/^(https?:\/\/|\/(?!\/))/i.test(hero)){ %><img src="<%= hero %>" alt=""><span class="hero-shade"></span><% } %><div class="feature-image-text white-shadow-text"><h1><%= site.themeConfig.authorName||site.title() %></h1><p class="intro-description"><%= site.themeConfig.introDescription||site.description() %></p></div></header><% } %><% }) %><% block('content',()=>{ %><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %><% }) %>