<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post-body entry"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %>