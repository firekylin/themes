<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post on-list entry"><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="post-meta"><span class="post-date"><time><%= archive.date('YYYY-MM-DD') %></time></span></div><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="post-content"><p><%= archive.excerpt(260) %></p></div><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>