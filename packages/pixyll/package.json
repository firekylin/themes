{
  "name": "pixyll",
  "title": "Pixyll",
  "version": "0.1.0",
  "private": true,
  "description": "Pixyll bold titles and serif reading typography.",
  "license": "MIT",
  "author": "John Otander and Pixyll contributors; Firekylin contributors",
  "homepage": "https://github.com/johno/pixyll",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/pixyll"
  },
  "firekylin": {
    "type": "theme",
    "id": "pixyll"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
