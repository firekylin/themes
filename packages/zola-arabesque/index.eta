<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><div class="zt-hero al-pattern al-pattern--hero"><div class="al-pattern__art" aria-hidden="true" data-pattern-hero></div><section class="al-page zt-hero__body"><h1 class="al-display zt-hero__title"><%= site.title() %></h1><p class="al-lede zt-hero__lede"><%= site.description() %></p></section></div><% } %><div class="al-page zt-main"><% if(archive.archiveTitle){ %><h1 class="al-page-head"><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>