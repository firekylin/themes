<% const archive=firekylin.archive;let count=0; %><ol class="zt-posts" role="list"><% while(archive.next()){count++; %><li><article class="entry zt-post"><p class="zt-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><h2 class="zt-post__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="zt-post__summary"><%= archive.excerpt(280) %></p></article></li><% } %></ol><% if(!count){ %><p>暂无文章。</p><% } %>