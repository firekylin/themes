<% const archive=firekylin.archive;let count=0; %><div class="listrecent"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="card entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="maxthumb"><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><div class="card-body"><h2 class="card-title"><a class="text-dark" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><h4 class="card-text"><%= archive.excerpt(180) %></h4></div><div class="card-footer bg-white"><div class="wrapfooter"><time class="post-date" datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><a class="post-read-more" href="<%= archive.permalink %>" aria-label="阅读全文：<%= archive.title() %>">→</a></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>