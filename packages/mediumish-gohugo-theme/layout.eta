<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><header class="mediumnavigation"><div class="container"><a class="navbar-brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="container site-content"><div class="mainheading"><h1 class="sitetitle"><%= site.title() %></h1><p class="lead"><%= site.description() %></p></div><div class="main-content"><%~ block('content') %></div></main><div class="jumbotron fortags"><div class="d-md-flex h-100"><div class="col-md-4 transpdark text-center h-100"><div class="d-md-flex align-items-center justify-content-center h-100"><h2 class="native-explore">探索标签 →</h2></div></div><div class="col-md-8 p-5 native-tag-area"><% let tagCount=0;while(tags.next()){tagCount++; %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% }if(!tagCount){ %><span>暂无标签。</span><% } %></div></div></div><footer class="footer"><div class="container native-footer"><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · <%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/lgaida/mediumish-gohugo-theme">Mediumish</a> · <a href="https://www.wowthemes.net/">WowThemes.net</a></p></div></footer></body></html>