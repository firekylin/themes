<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="section-title"><h2><span><%= archive.archiveTitle||'所有文章' %></span></h2></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>