<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry hentry"><header><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="entry-image-index"><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-content"><p><%= archive.excerpt(320) %></p><a href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>