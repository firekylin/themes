<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="<%~ block('bodyclass') %>"><a class="skip" href="#main">跳转到正文</a><div class="native-top"><nav class="native-nav nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><%~ block('hero') %><main id="main" class="native-main"><%~ block('content') %></main><footer class="footer-wrapper native-footer"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/dldx/hpstr-hugo-theme">HPSTR</a> · Design by <a href="https://github.com/mmistakes/hpstr-jekyll-theme">Michael Rose</a></p></footer></body></html>