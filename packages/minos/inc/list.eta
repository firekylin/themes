<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="article article-type-post entry"><div class="article-inner"><header class="article-header"><h2><a class="article-title" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="article-meta"><time class="article-date"><%= archive.date('YYYY-MM-DD') %></time></div><div class="article-entry"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><p><%= archive.excerpt(240) %></p><p class="article-more-link"><a href="<%= archive.permalink %>">阅读全文</a></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>