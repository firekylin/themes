<% const archive=firekylin.archive;let count=0,year=''; %><% while(archive.next()){const nextYear=archive.date('YYYY');if(nextYear!==year){if(count){ %></ul><% }year=nextYear; %><h2 class="year-heading"><%= year %></h2><ul class="posts-list"><% }count++; %><li class="entry"><span class="date"><time><%= archive.date('YYYY-MM-DD') %></time></span><a href="<%= archive.permalink %>"><%= archive.title() %></a></li><% } %><% if(count){ %></ul><% }else{ %><p>暂无文章。</p><% } %>