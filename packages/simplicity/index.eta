<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.profileImage||'');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><% if(!archive.archiveTitle){ %><section class="home-intro"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="homepage-avatar" src="<%= avatar %>" alt=""><% } %><h1><%= cfg.authorName||site.title() %></h1><p><%= site.description() %></p></section><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>