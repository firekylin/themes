<% const site=await firekylin.widget('Widget_Options'),cfg=site.themeConfig||{},type=firekylin.pageType,detail=['post','page','attachment'].includes(type),archive=await firekylin.widget('Widget_Archive',{type});const active=detail?archive.next():false;const title=detail&&active?archive.title():archive.archiveTitle||site.title();const safe=v=>typeof v==='string'&&/^(https?:\/\/|mailto:|\/(?!\/)|#)/i.test(v)?v:'#';const color=(v,d)=>/^#[0-9a-f]{6}$/i.test(v||'')?v:d;const parse=v=>{try{const a=JSON.parse(v||'[]');return Array.isArray(a)?a.filter(x=>x&&typeof x==='object').slice(0,40):[];}catch{return [];}}; %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><style>:root{--indigo-primary:<%= color(cfg.primaryColor,'#3f51b5') %>;--indigo-dark:<%= color(cfg.darkColor,'#303f9f') %>;--indigo-accent:<%= color(cfg.accentColor,'#ff4081') %>}</style><script src="<%= site.themeUrl('res/js/indigo.js') %>" defer></script></head><body><a href="#content" class="skip-link">Skip to content</a><aside id="menu" class="<%= detail&&cfg.hideMenu==='true'?'hide':'' %>"><div class="inner flex-row-vertical"><button id="menu-off" class="header-icon" aria-label="Close navigation" hidden>×</button><div class="brand-wrap"><% if(safe(cfg.brandUrl)!=='#'){ %><img class="brand-image" src="<%= safe(cfg.brandUrl) %>" alt=""><% } %><div class="brand"><a class="avatar" href="/"><% if(safe(cfg.avatarUrl)!=='#'){ %><img src="<%= safe(cfg.avatarUrl) %>" alt=""><% }else{ %><span><%= (cfg.authorName||site.title()).slice(0,1) %></span><% } %></a><hgroup class="introduce"><h5 class="nickname"><%= cfg.authorName||site.title() %></h5><p class="mail"><%= cfg.profileText||site.description() %></p></hgroup></div></div><div class="scroll-wrap flex-col"><ul class="nav"><% for(const n of site.navigation||[]){ %><li><a href="<%= safe(n.url) %>"><%= n.label %></a></li><% } %><li><a href="/search.html">Search</a></li><li><a href="/rss.html">RSS</a></li><% for(const n of parse(cfg.links)){ %><li><a href="<%= safe(n.url) %>"><%= n.name %></a></li><% } %></ul></div></div></aside><main id="main"><header id="header" class="top-header"><div class="flex-row"><button class="header-icon" id="menu-toggle" aria-label="Toggle navigation" aria-controls="menu" aria-expanded="false" hidden>☰</button><div class="flex-col header-title ellipsis"><%= title %></div><a class="header-icon" href="/search.html" aria-label="Search">⌕</a><button class="header-icon" id="share-toggle" aria-label="Share this page" hidden>↗</button></div></header><header class="content-header <%= detail?'post':'index' %>-header"><div class="container"><h1 class="title"><%= title %></h1><h5 class="subtitle"><% if(detail){ %><%= active?archive.date('Y-m-d'):'' %><% }else{ %><%= cfg.subtitle||site.description() %><% } %></h5></div></header><div id="content" class="container body-wrap">
<% if(detail){ %><article class="post-article"><div class="post-card"><h1 class="post-card-title"><%= title %></h1><div class="post-meta"><%= active?archive.date('Y-m-d'):'' %><% for(const c of archive.row?.cate||[]){ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% } %></div><% if(cfg.showToc!=='false'){ %><details id="toc"><summary>Contents</summary><nav aria-label="Table of contents"></nav></details><% } %><div class="post-content" id="post-content"><%~ active?archive.content():'' %></div><div class="post-footer"><% for(const t of archive.row?.tag||[]){ %><a class="post-tag" href="/tag/<%= t.pathname %>"># <%= t.name %></a><% } %></div></div><nav class="post-nav" aria-label="Adjacent posts"><% for(const k of ['prev','next']){const n=archive.row?.[k];if(n?.pathname){ %><a rel="<%= k %>" href="<%= archive.permalinkFor(n) %>"><%= n.title %></a><% }} %></nav><%~ active?firekylin.comment({title:'Comments',className:'article-comments'}):'' %></article>
<% }else if(type==='archive'){ %><section class="archive"><h1>Archives</h1><% for(const [m,rows] of Object.entries(archive.grouped||{})){ %><h2 class="archive-year"><%= m %></h2><ul class="archive-list"><% for(const r of rows){ %><li><time><%= String(r.create_time).slice(0,10) %></time> <a href="<%= archive.permalinkFor(r) %>"><%= r.title %></a></li><% } %></ul><% } %></section>
<% }else if(type==='cate'||type==='tag'){const metas=await firekylin.widget(type==='cate'?'Widget_Metas_Category_List':'Widget_Metas_Tag_Cloud'); %><section class="article-card"><h1><%= type==='cate'?'Categories':'Tags' %></h1><ul><% while(metas.next()){ %><li><a href="<%= metas.permalink %>"><%= metas.title() %></a></li><% } %></ul></section>
<% }else{ %><% if(type==='search'){ %><form class="article-card" action="/search.html" method="get"><label for="keyword">Search articles</label><input id="keyword" name="keyword" value="<%= archive.keyword||'' %>"><button class="post-more">Search</button></form><% } %><ul class="post-list"><% let count=0;while(archive.next()){count++; %><li class="post-list-item"><article class="article-card"><div class="post-meta"><time><%= archive.date('Y-m-d') %></time><% for(const c of archive.row?.cate||[]){ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% } %></div><h3 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="post-content"><%= archive.excerpt(300) %> <a class="post-more" href="<%= archive.permalink %>">Continue reading</a></div><% if(archive.row?.tag?.length){ %><div class="post-footer"><% for(const t of archive.row.tag){ %><a class="post-tag" href="/tag/<%= t.pathname %>"># <%= t.name %></a><% } %></div><% } %></article></li><% }if(!count){ %><li>No articles found.</li><% } %></ul><% if(archive.pagination){const p=archive.pagination; %><nav class="page-nav" aria-label="Pagination"><% if(p.currentPage>1){ %><a rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">Previous</a><% } %><span><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">Next</a><% } %></nav><% }} %></div><footer class="footer"><div class="top"><p><%= cfg.footerText||site.description() %></p></div><div class="bottom"><p>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/yscoder/hexo-theme-indigo">Indigo</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></div></footer></main><div id="menu-mask" hidden></div><a id="gotop" href="#" aria-label="Back to top">↑</a><p id="share-status" role="status"></p></body></html>
