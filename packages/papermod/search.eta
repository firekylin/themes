<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 - <%= s.title() %><% }) %><% block('content',()=>{ %><header class="page-header"><h1>搜索</h1></header><form action="/search.html" method="get" id="searchbox"><label for="searchInput">关键词</label><input id="searchInput" name="keyword" type="search" value="<%= a.keyword || '' %>"><button type="submit">搜索</button></form><%~ include('./inc/list',{archive:a,config:s.themeConfig}) %><% }) %>