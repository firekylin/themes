<% layout('./layout');const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},a=await firekylin.widget('Widget_Archive',{type:'page'});const exists=a.next();const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %><% block('title',()=>{ %><%= exists?a.title():s.title() %> - <%= s.title() %><% }) %><% block('content',()=>{ %><% if(exists){ %><article class="post-single"><header class="post-header"><h1 class="post-title"><%= a.title() %></h1><% if(c.hideMeta!=='true'){ %><div class="post-meta"><%= a.date('Y-m-d') %> · <%= a.author('display_name') %></div><% } %></header><% if(safe(a.row.featuredImage || a.row.options?.featuredImage)){ %><figure class="entry-cover"><img src="<%= safe(a.row.featuredImage || a.row.options?.featuredImage) %>" alt=""></figure><% } %><% if(c.showToc!=='false'){ %><details class="toc" hidden><summary>目录</summary><div class="inner"></div></details><% } %><div class="post-content md-content"><%~ a.content() %></div><footer class="post-footer"><% if(typeof a.tags==='function'){ %><div class="post-tags"><%~ a.tags(' ',true,'') %></div><% } %></footer><%~ firekylin.comment({className:'comments',title:'评论'}) %></article><% } else { %><h1>内容不存在</h1><% } %><% }) %>