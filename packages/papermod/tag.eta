<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>标签 - <%= s.title() %><% }) %><% block('content',()=>{ %><header class="page-header"><h1>标签</h1></header><ul class="terms-tags"><% while(a.next()){ %><li><a href="<%= a.permalink %>"><%= a.row.name %><sup><%= a.row.count||0 %></sup></a></li><% } %></ul><% }) %>