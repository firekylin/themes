<% layout('./layout');const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},a=await firekylin.widget('Widget_Archive',{type:'index'}); const home=a.is('index');const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %>
<% block('title',()=>{ %><%= a.archiveTitle || s.title() %><% }) %>
<% block('content',()=>{ %>
<% if(home && c.homeMode==='profile'){ %><div class="profile"><div class="profile_inner"><% if(safe(c.profileImage)){ %><img src="<%= safe(c.profileImage) %>" alt="" width="150" height="150"><% } %><h1><%= c.homeTitle || s.title() %></h1><span><%= c.homeContent || s.description() %></span><div class="buttons"><% for(const n of s.navigation){ %><a class="button" href="<%= n.url %>"><span class="button-inner"><%= n.label %></span></a><% } %></div></div></div>
<% } else { %><% if(!home && a.archiveTitle){ %><header class="page-header"><h1><%= a.archiveTitle %></h1></header><% } %><% if(home && c.homeMode==='info' && (!a.pagination || a.pagination.currentPage===1)){ %><article class="first-entry home-info"><header class="entry-header"><h1><%= c.homeTitle || s.title() %></h1></header><div class="entry-content"><p><%= c.homeContent || s.description() %></p></div></article><% } %><%~ include('./inc/list',{archive:a,config:c}) %><% } %><% }) %>