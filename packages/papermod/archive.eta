<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>归档 - <%= s.title() %><% }) %><% block('content',()=>{ %><header class="page-header"><h1>归档</h1></header><% for(const [month,posts] of Object.entries(a.grouped||{})){ %><div class="archive-year"><h2 class="archive-year-header"><%= month %><sup class="archive-count"><%= posts.length %></sup></h2><div class="archive-posts"><% for(const p of posts){ %><div class="archive-entry"><h3 class="archive-entry-title"><a href="<%= a.permalinkFor(p) %>"><%= p.title %></a></h3></div><% } %></div></div><% } %><% }) %>