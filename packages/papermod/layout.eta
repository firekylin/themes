<% const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig || {}; const a=await firekylin.widget('Widget_Archive'); %>
<!doctype html><html lang="zh-CN" data-theme="<%= c.colorMode==='dark'?'dark':'light' %>" data-default-theme="<%= ['light','dark'].includes(c.colorMode)?c.colorMode:'auto' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script defer src="<%= site.themeUrl('res/js/papermod.js') %>"></script></head>
<body id="top" class="<%= ['post','page','attachment'].some(t=>a.is(t))?'':'list' %>" data-copy="<%= c.showCopy==='false'?'false':'true' %>"><a class="skip-link" href="#main">跳转到正文</a><header class="header"><nav class="header-nav"><div class="logo"><a href="/"><%= site.title() %></a><div class="logo-switches"><button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深浅色" hidden><svg class="moon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                    <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </button></div></div><ul id="menu" class="menu"><% for(const n of site.navigation) { %><li><a href="<%= n.url %>"><span><%= n.label %></span></a></li><% } %><li><a href="/search.html">搜索</a></li></ul></nav></header>
<main class="main" id="main"><%~ block('content') %></main><footer class="footer"><span><%= c.footerText || site.title() %></span><span> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/adityatelange/hugo-PaperMod">PaperMod</a> · <a href="/rss.html">RSS</a></span></footer><a href="#top" class="top-link" aria-label="返回顶部">↑</a></body></html>
