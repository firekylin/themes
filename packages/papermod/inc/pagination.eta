<% const a=firekylin.archive,p=a.pagination; if(p && p.totalPages>1){ %><footer class="page-footer"><nav class="pagination" aria-label="分页"><% if(p.currentPage>1){ %><a class="prev" rel="prev" href="<%= a.pageUrl(p.currentPage-1) %>">« 上一页</a><% } %><% if(p.currentPage<p.totalPages){ %><a class="next" rel="next" href="<%= a.pageUrl(p.currentPage+1) %>">下一页 »</a><% } %></nav></footer><% } %>