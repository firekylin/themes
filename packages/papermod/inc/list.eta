<% const a=firekylin.archive,c=firekylin.config||{};let i=0; const home=a.is('index');const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %>
<% if(!a.have()) { %><p>暂无文章。</p><% } %>
<% while(a.next()){ const first=home && (!a.pagination || a.pagination.currentPage===1) && i++===0 && !['info','profile'].includes(c.homeMode); %><article class="<%= first?'first-entry':'post-entry' %>"><% if(safe(a.row.featuredImage || a.row.options?.featuredImage)){ %><figure class="entry-cover"><img src="<%= safe(a.row.featuredImage || a.row.options?.featuredImage) %>" alt="" loading="lazy"></figure><% } %><header class="entry-header"><h2><%= a.title() %></h2></header><% if(c.hideSummary!=='true'){ %><div class="entry-content"><p><%= a.excerpt(240,'…') %></p></div><% } %><% if(c.hideMeta!=='true'){ %><footer class="entry-footer"><%= a.date('Y-m-d') %> · <%= a.author('display_name') %></footer><% } %><a class="entry-link" href="<%= a.permalink %>" aria-label="<%= a.title() %>"></a></article><% } %>
<%~ include('./pagination',{archive:a}) %>
