<% const archive=firekylin.archive;let count=0; %><div class="native-grid gridcards <%= firekylin.columns===false?'single-column':'' %>"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row;const locked=Boolean(archive.row.password_protected||archive.row.options?.postPasswordHash||archive.row.title==='此内容被密码保护');const cover=locked?'':String(archive.row.options?.featuredImage||''); %><article class="entry card"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="native-cover" href="<%= archive.permalink %>"><img class="card-img-top" src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="card-body"><p class="card-kicker"><% (meta.cate||[]).forEach(c=>{ %><a href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a><% }); %></p><h2 class="card-title h1"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-meta"><time><%= archive.date('YYYY/MM/DD') %></time> · <%= archive.author('display_name') %></p><p class="card-text card-summary"><%= archive.excerpt(280) %></p></div><div class="card-footer card-tags"><% (meta.tag||[]).filter(t=>!(meta.cate||[]).some(c=>c.name===t.name)).slice(0,3).forEach(t=>{ %><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a><% }); %></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>