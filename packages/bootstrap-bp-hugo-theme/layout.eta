<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const palette=['default','blue','light','dark'].includes(cfg.palette)?cfg.palette:'default'; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/palette-'+palette+'.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar navbar-light border-bottom native-header"><div class="container"><a class="navbar-brand link-primary" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="container native-main"><%~ block('content') %></main><footer class="site-footer border-top"><div class="container"><div class="footer-top"><div><h5><%= site.title() %></h5><p class="footer-description"><%= cfg.footerText||site.description() %></p></div><p class="footer-author"><%= cfg.authorName||site.title() %></p></div><div class="footer-bottom"><span>Firekylin · <a href="https://github.com/spech66/bootstrap-bp-hugo-theme">Bootstrap-BP</a> · Sebastian Pech</span><a href="#main">返回顶部</a></div></div></footer></body></html>