<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const image=String(archive.row?.options?.featuredImage||'');const hasImage=/^(https?:\/\/|\/(?!\/))/i.test(image); %><% if(count===1){ %><article class="entry latest <%= hasImage?'':'no-image' %>"><% if(hasImage){ %><a href="<%= archive.permalink %>"><img src="<%= image %>" alt="" loading="lazy"></a><% } %><div><p class="created text-muted text-uppercase font-weight-bold"><%= archive.date('YYYY-MM-DD') %></p><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(260) %></p></div></article><div class="article-grid"><% }else{ %><article class="entry card"><a href="<%= archive.permalink %>"><% if(hasImage){ %><img class="card-img-top" src="<%= image %>" alt="" loading="lazy"><% } %><div class="card-body"><h2 class="card-title"><%= archive.title() %></h2><p class="card-text text-muted text-uppercase"><%= archive.date('YYYY-MM-DD') %></p><p class="card-text"><%= archive.excerpt(180) %></p></div></a></article><% } %><% } %><% if(count){ %></div><% }else{ %><p>暂无文章。</p><% } %>