<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const archive=await firekylin.widget('Widget_Archive',{type:'index'});const hero=String(cfg.heroImage||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="hero"><div class="hero-copy"><h1><%= site.title() %></h1><p><%= site.description() %></p></div><% if(/^(https?:\/\/|\/(?!\/))/i.test(hero)){ %><img class="hero-image" src="<%= hero %>" alt=""><% } %></section><% }else{ %><h1 class="page-header"><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>