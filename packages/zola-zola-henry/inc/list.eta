<% const archive=firekylin.archive;let count=0; %><ul class="blog-posts-list"><% while(archive.next()){count++; %><li class="blog-posts-list-item entry"><span class="blog-posts-list-item-meta"><time><%= archive.date('YYYY-MM-DD') %></time></span><h2><a class="blog-posts-list-item-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>