<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next();const cover=found?String((archive.row.options||{}).featuredImage||''):''; %><% block('title',()=>{ %><%= found?archive.title()+' :: ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><section class="post"><% if(found){ %><article><h1 class="post-title"><%= archive.title() %></h1><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><figure class="post-cover"><img src="<%= cover %>" alt=""></figure><% } %><div class="post-content"><%~ archive.content() %></div></article><hr><div class="post-info"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %><p><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></p></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></section><% }) %>