<% const archive=firekylin.archive;const groups=new Map();while(archive.next()){const year=archive.date('YYYY');if(!groups.has(year))groups.set(year,[]);groups.get(year).push({title:archive.title(),url:archive.permalink,day:archive.date('MM-DD')});} %><% for(const [year,posts] of groups){ %><div class="posts-group"><div class="post-year"><%= year %></div><ul class="posts-list"><% for(const post of posts){ %><li class="post-item"><a href="<%= post.url %>"><span><%= post.title %></span><time><%= post.day %></time></a></li><% } %></ul></div><% } %><% if(!groups.size){ %><p>暂无文章。</p><% } %>