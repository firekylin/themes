<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><header class="header"><div class="header-inner"><a class="logo" href="/"><span aria-hidden="true">&gt;</span><span class="logo-text"><%= site.themeConfig.logoText||'hello' %></span><span class="cursor" aria-hidden="true"></span></a><div class="header-right"><details class="site-menu" open><summary>Menu</summary><nav aria-label="主导航"><a href="/archives">Posts</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details><button id="appearance" aria-label="切换深色模式" aria-pressed="false" hidden>◐</button></div></div></header><main id="main"><%~ block('content') %></main><footer class="footer"><div>© <%= new Date().getFullYear() %> <%= site.title() %> | <a href="/rss.html">RSS</a></div><div>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> | <a href="https://github.com/rhazdon/hugo-theme-hello-friend-ng">Hello Friend NG</a> by rhazdon</div></footer></body></html>