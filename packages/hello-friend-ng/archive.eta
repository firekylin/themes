<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'archive'});const years=new Map();for(const [month,posts] of Object.entries(archive.grouped)){const year=month.slice(0,4);if(!years.has(year))years.set(year,[]);years.get(year).push(...posts);} %><% block('title',()=>{ %>Posts · <%= site.title() %><% }) %><% block('content',()=>{ %><section class="posts"><h1>Posts</h1><% for(const [year,posts] of years){ %><div class="posts-group"><div class="post-year"><%= year %></div><ul class="posts-list"><% for(const post of posts){ %><li class="post-item"><a href="<%= archive.permalinkFor(post) %>"><span><%= post.title %></span><time><%= String(post.create_time||'').slice(5,10) %></time></a></li><% } %></ul></div><% } %><% if(!years.size){ %><p>暂无文章。</p><% } %></section><% }) %>