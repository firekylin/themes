<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const portrait=String(cfg.portrait||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle||(archive.pagination&&archive.pagination.currentPage>1)){ %><section class="posts"><h1><%= archive.archiveTitle||'Posts' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }else{ %><section class="landing"><div><% if(/^(https?:\/\/|\/(?!\/))/.test(portrait)){ %><img class="portrait" src="<%= portrait %>" alt="<%= site.title() %>"><% } %><h1><%= site.title() %></h1><% if(cfg.subtitle||site.description()){ %><p><%= cfg.subtitle||site.description() %></p><% } %><nav class="social" aria-label="联系与文章"><% if(/^https:\/\//.test(String(cfg.github||''))){ %><a href="<%= cfg.github %>" rel="me">GitHub</a><% } %><% if(/^[^\s@]+@[^\s@]+$/.test(String(cfg.email||''))){ %><a href="mailto:<%= cfg.email %>">Email</a><% } %><a href="/archives">Posts</a><a href="/rss.html">RSS</a></nav></div></section><% } %><% }) %>