<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||'');const hasCover=/^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="entry<%= hasCover?' has-thumbnail':'' %>"><div class="entry-wrap"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="meta"><%= archive.date('YYYY-MM-DD') %></p><div class="excerpt"><%~ archive.excerpt(230) %></div><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a></div><% if(hasCover){ %><a class="thumbnail" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>