<% /* Tranquilpeak; modified 2026-10-30 for Firekylin, GPLv3. */const site=await firekylin.widget('Widget_Options');const avatar=String(site.themeConfig.avatarUrl||''),cover=String(site.themeConfig.coverUrl||'');const valid=u=>/^(https?:\/\/|\/(?!\/))/.test(u); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><details id="sidebar" open><summary aria-label="切换侧栏菜单">☰ <span><%= site.title() %></span></summary><div class="sidebar-panel"><% if(valid(cover)){ %><img class="sidebar-cover" src="<%= cover %>" alt=""><% } %><div class="sidebar-container"><div class="sidebar-profile"><% if(valid(avatar)){ %><img class="profile-picture" src="<%= avatar %>" alt=""><% } %><h2><%= site.themeConfig.profileName||site.title() %></h2><p class="profile-bio"><%= site.themeConfig.profileBio||site.description() %></p></div><nav class="sidebar-links" aria-label="主导航"><div><a href="/" title="首页"><span class="icon" aria-hidden="true">⌂</span><span class="label">首页</span></a><a href="/categories" title="分类"><span class="icon" aria-hidden="true">▤</span><span class="label">分类</span></a><a href="/tags" title="标签"><span class="icon" aria-hidden="true">#</span><span class="label">标签</span></a><a href="/archives" title="归档"><span class="icon" aria-hidden="true">▣</span><span class="label">归档</span></a></div><div><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>" title="<%= n.label %>"><span class="icon" aria-hidden="true">›</span><span class="label"><%= n.label %></span></a><% }); %><a href="/search.html" title="搜索"><span class="icon" aria-hidden="true">⌕</span><span class="label">搜索</span></a><a href="/rss.html" title="RSS"><span class="icon" aria-hidden="true">◉</span><span class="label">RSS</span></a></div></nav></div></div></details><div id="main-wrap"><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= site.themeConfig.footerText||site.title() %></p><p><a href="https://github.com/LouisBarranqueiro/hexo-theme-tranquilpeak">Tranquilpeak</a> · Firekylin</p></footer></div></body></html>