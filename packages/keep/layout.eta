<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" class="light-mode"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><div class="page-container border-box"><div class="page-main-content border-box is-home"><header class="header-wrapper"><div class="header-content border-box"><div class="left"><a class="site-name" href="/"><%= site.title() %></a></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="page-main-content-middle border-box"><main id="main" class="native-main main-content border-box"><%~ block("content") %></main></div></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/XPoet/hexo-theme-keep">Keep</a> by XPoet · <a href="https://github.com/firekylin/themes/tree/main/packages/keep">主题源码（AGPL）</a></footer></body></html>