<% const archive=firekylin.archive;let count=0; %><div class="home-content-container"><ul class="home-post-list border-box"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><li class="home-post-item entry"><div class="home-post-item-top border-box"><h3 class="home-post-title border-box"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></div><div class="home-post-item-bottom border-box has-cover"><div class="home-post-content keep-markdown-body"><p><%= archive.excerpt(260) %></p></div><div class="post-meta-info"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul></div>