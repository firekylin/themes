<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><h2><a href="/">‹ <%= site.title() %></a></h2><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><div class="content-container"><div class="content"><p><%= cfg.footerText||site.description() %></p><p class="horizontal-links"><a href="/archives">归档</a><a href="/tags">标签</a><a href="/search.html">搜索</a></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/mavidser/hugo-rocinante">Rocinante</a></p></div></div></footer></body></html>