<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++; %><article class="post-list entry"><div class="title-group"><div class="title"><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1></div><div class="date"><h5><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></h5></div></div><div class="content"><p><%= archive.excerpt(260) %></p></div><div class="read-more"><a href="<%= archive.permalink %>" aria-label="阅读全文：<%= archive.title() %>">阅读全文 ›</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>