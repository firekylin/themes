<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% }else if((archive.pagination?.currentPage||1)===1){ %><section class="native-intro"><p><%= site.description() %></p></section><% }else{ %><h3 class="current-page">第 <%= archive.pagination.currentPage %> 页</h3><% } %><hr><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>