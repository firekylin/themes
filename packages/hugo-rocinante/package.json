    "directory": "packages/hugo-rocinante"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugo-rocinante"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
