<% const site=firekylin.site;const archive=firekylin.archive;let count=0,lastYear=''; %><div class="hero-title"><h1 class="site-title"><% Array.from(site.title()).forEach((c,i)=>{ %><span class="base0<%= 8+(i%6) < 10 ? 8+(i%6) : String.fromCharCode(97+(i%6)-2) %>"><%= c %></span><% }); %> # _</h1><p><%= site.description() %></p></div><div class="article-list"><% while(archive.next()){count++; %><article class="list-item entry"><h2 class="headline"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><span class="key">发布于 </span><time class="val"><%= archive.date('YYYY-MM-DD') %></time></div><section class="summary"><p><%= archive.excerpt(300) %></p></section></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>