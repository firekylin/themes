<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry rounded-2 box-shadow-medium px-3 pb-2 pt-2 mb-3"><header class="Subhead mb-2"><h2 class="Subhead-heading entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="Subhead-description"><time><%= archive.date('YYYY-MM-DD') %></time></p></header><p class="text-gray entry-summary"><%= archive.excerpt(350) %> <a class="muted-link" href="<%= archive.permalink %>" aria-label="阅读全文：<%= archive.title() %>">…</a></p></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>