<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="holy" class="container-lg bg-white"><header id="header"><div class="UnderlineNav"><a class="UnderlineNav-actions muted-link h2" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="holy-main markdown-body px-4 bg-white"><%~ block('content') %></main><div id="side" class="pr-1 bg-white"><aside class="pr-3"><div id="toc" class="Box Box--blue mb-3" hidden></div><section class="Box Box--blue mb-3 sidebar-panel"><h3><a href="/tags">标签</a></h3><div class="native-tags"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %> <span class="Counter"><%= tags.row.count %></span></a><% } %></div></section><section class="Box Box--blue mb-3 sidebar-panel"><h3><a href="/categories">分类</a></h3><div class="native-tags"><% const categories=await firekylin.widget('Widget_Metas_Category_List');while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %> <span class="Counter"><%= categories.row.count %></span></a><% } %></div></section></aside></div><footer id="footer" class="native-footer text-center"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/qqhann/hugo-primer">Hugo-Primer</a></p></footer></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>