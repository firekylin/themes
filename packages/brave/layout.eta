<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const valid=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><section class="hero"><% if(valid(cfg.coverUrl)){ %><img class="hero-image" src="<%= cfg.coverUrl %>" alt=""><% } %><header><a href="/" class="brand"><%= site.title() %></a><details class="site-menu" open><summary aria-label="切换导航菜单">☰</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details></header><div class="couple"><% if(cfg.firstName&&cfg.secondName){ %><div class="person"><% if(valid(cfg.firstAvatar)){ %><img src="<%= cfg.firstAvatar %>" alt=""><% } %><h2><%= cfg.firstName %></h2></div><div class="heart" aria-hidden="true"></div><div class="person"><% if(valid(cfg.secondAvatar)){ %><img src="<%= cfg.secondAvatar %>" alt=""><% } %><h2><%= cfg.secondName %></h2></div><% }else{ %><h1><%= site.title() %></h1><% } %></div><div class="wave" aria-hidden="true"></div></section><main id="main"><%~ block('content') %></main><footer class="site-footer"><p>© <%= site.themeConfig.footerText||site.title() %></p><p>Powered by Firekylin ※ Theme is <a href="https://blog.zwying.com">Brave</a></p></footer></body></html>