<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;let wishes=[];try{const data=JSON.parse(cfg.loveList||'[]');if(Array.isArray(data))wishes=data.filter(x=>x&&typeof x.text==='string').slice(0,100)}catch{}const start=String(cfg.startDate||'');const validStart=/^\d{4}-\d{2}-\d{2}T.*(?:Z|[+-]\d{2}:\d{2})$/.test(start)&&Number.isFinite(Date.parse(start))&&Date.parse(start)<=Date.now();const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="together"><% if(validStart){ %><h2>我们风雨同舟已经一起走过</h2><p id="together-clock" data-start="<%= start %>">相伴始于 <time datetime="<%= start %>"><%= start %></time></p><% } %><div class="portals"><% if(/^\/(?!\/)/.test(String(cfg.blessingUrl||''))){ %><a href="<%= cfg.blessingUrl %>"><span aria-hidden="true">💌</span><div><h3>祝福板</h3><p>写下对我们的祝福</p></div></a><% } %><a href="/archives"><span aria-hidden="true">💖</span><div><h3>点点滴滴</h3><p>记录你我生活</p></div></a><% if(wishes.length){ %><a href="#love-list"><span aria-hidden="true">📜</span><div><h3>Love List</h3><p>甜蜜瞬间有你陪伴</p></div></a><% } %></div></section><% } %><div class="journal"><h1 class="intro"><%= archive.archiveTitle||cfg.introText||site.description() %></h1><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1&&wishes.length){ %><section id="love-list"><h2>Love List</h2><ul><% wishes.forEach(item=>{ %><li><span class="wish-state"><%= item.done===true?'已完成':'待完成' %></span><span class="<%= item.done===true?'done':'' %>"><%= item.text %></span></li><% }); %></ul></section><% } %><% }) %>