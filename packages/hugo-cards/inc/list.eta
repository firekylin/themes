<% const archive=firekylin.archive;let count=0; %><section class="row pack"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="col-md-4 card entry"><a class="index-anchor" href="<%= archive.permalink %>"><div class="panel panel-default"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="card-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="panel-body"><h2 class="panel-title"><%= archive.title() %></h2><time class="post-meta"><%= archive.date('YYYY-MM-DD') %></time></div><div class="panel-body entry-summary"><%= archive.excerpt(180) %></div></div></a></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>