<% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:3});const cover=String(firekylin.cover||'');let n=0; %><aside class="post-sidebar"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><div class="post-img"><img src="<%= cover %>" alt=""></div><% } %><section class="recent mt10"><h2>最新文章</h2><ul><% while(n<3&&recent.next()){n++; %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a><time><%= recent.date('YYYY-MM-DD') %></time></li><% } %></ul></section></aside>