<% const archive=firekylin.archive;let count=0; %><ul class="researcher-posts"><% while(archive.next()){count++; %><li class="entry"><a href="<%= archive.permalink %>"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time> | <%= archive.title() %></a></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>