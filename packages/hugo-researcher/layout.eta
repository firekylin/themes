<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="container mt-5 researcher-header"><div class="navbar navbar-expand-sm flex-column flex-sm-row p-0"><a class="navbar-brand mx-0 mr-sm-auto" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><hr><main id="main"><div id="content" class="researcher-content"><div class="container"><%~ block('content') %></div></div></main><footer id="footer" class="mb-5 native-footer"><hr><div class="container text-center"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/ojroques/hugo-researcher">Researcher</a> · <a href="https://github.com/ankitsultana/researcher">Ankit Sultana</a></p></div></footer></body></html>