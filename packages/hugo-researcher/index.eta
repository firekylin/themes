<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(Number(archive.pagination.currentPage)===1){ %><p class="researcher-intro"><%= site.description() %></p><% } %><h1>文章</h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>