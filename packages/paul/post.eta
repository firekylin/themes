<% const a=await firekylin.widget('Widget_Archive',{type:firekylin.kind||'post'});a.next();const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{}; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.title()}) %><main class="is-article"><nav class="navigation"><a href="/" class="active">日记</a><% if(/^https?:/.test(c.blog_url||'')){ %><a href="<%= c.blog_url %>">博文</a><% } %></nav><aside class="torTree"><nav class="torTree-wrap" id="torTree-wrap" aria-label="文章目录"></nav></aside><article><h1><%= a.date('YYYY-MM-DD') %></h1><div class="paul-note"><div class="note-content post-content"><h1 class="post-title"><%= a.title() %></h1><%~ a.content() %></div><% if(c.author_text){ %><div class="note-content"><%= c.author_text %></div><% } %><div class="note-inform"><span class="user"><%= c.profileName||site.title() %></span><% if(a.row.fields?.mood){ %><span class="mood"><%= a.row.fields.mood %></span><% } %></div><div class="note-action"><a href="#comments">评论 <%= a.commentsNum('%d') %></a></div></div></article><%~ firekylin.comment({title:'评论'}) %></main><%~ await includeAsync('./inc/footer',firekylin) %>