<% const a=await firekylin.widget('Widget_Archive',{type:'index'});const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};let projects=[];try{const data=JSON.parse(c.projects||'[]');if(Array.isArray(data))projects=data.filter(x=>x&&x.title&&/^https?:|^\//.test(x.url||'')).slice(0,12)}catch{}const quotes=String(c.quotes||'').split('\n').filter(Boolean).slice(0,4); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.archiveTitle}) %><main><nav class="navigation"><a href="/" class="active">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }) %></nav><% if(firekylin.ctx.path==='/'){ %><section class="me"><div class="my-avatar"><img src="<%= c.avatar||site.themeUrl('res/avatar.svg') %>" alt=""></div><div class="my-info"><h1><span><%= c.profileName||site.title() %></span><svg width="100%" height="3.5rem" aria-hidden="true"><% for(let i=1;i<5;i++){ %><text text-anchor="start" x="0" y="2.2rem" class="text text-<%= i %>"><%= c.profileName||site.title() %></text><% } %></svg></h1><p><%= site.description() %></p><div class="social-icons"><% if(c.github_username){ %><a href="https://github.com/<%= encodeURIComponent(c.github_username) %>">GH</a><% } if(c.weibo_id){ %><a href="https://weibo.com/<%= encodeURIComponent(c.weibo_id) %>">微博</a><% } if(c.bili_id){ %><a href="https://space.bilibili.com/<%= encodeURIComponent(c.bili_id) %>">B站</a><% } %><a href="/rss.html">RSS</a></div></div></section><% } %><section class="paul-news"><% if(projects.length&&firekylin.ctx.path==='/'){ %><div class="news-item"><div class="news-head grey"><h3 class="title"><i aria-hidden="true"></i>代表作品</h3></div><div class="news-body"><div class="row s"><% projects.forEach(x=>{ %><div class="col-4"><a class="news-project" href="<%= x.url %>"><% if(x.image){ %><img src="<%= x.image %>" alt=""><% } %><h4><%= x.title %></h4><p><%= x.description||'' %></p></a></div><% }) %></div></div></div><% } %><div class="news-item"><div class="news-head red"><h3 class="title"><i aria-hidden="true"></i><%= a.archiveTitle||'日记' %></h3><h3 class="more"><a href="/archives" aria-label="更多日记">→</a></h3></div><div class="news-body"><div class="row s" id="paul-notes"><% while(a.next()){ %><div class="col-m-6"><a class="boxed" href="<%= a.permalink %>" aria-label="<%= a.title() %>"><p><%= a.excerpt(80) %></p><p><span class="date"><%= a.date('YYYY-MM-DD') %></span></p></a></div><% } %></div></div></div><% if(firekylin.ctx.path==='/'){ %><div class="news-item"><div class="news-head green"><h3 class="title"><i aria-hidden="true"></i>语录</h3></div><div class="news-body green"><div class="row s"><% quotes.forEach(x=>{ %><div class="col-m-6"><div class="boxed"><p><%= x %></p></div></div><% }) %></div></div></div><% } %></section><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %></main><%~ await includeAsync('./inc/footer',firekylin) %>