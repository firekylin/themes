<% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'搜索'}) %><main class="is-article"><form class="paul-search" action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" required><button>搜索</button></form><article><% while(a.next()){ %><div class="paul-note"><div class="note-content"><h2><a href="<%= a.permalink %>"><%= a.title() %></a></h2><p><%= a.excerpt(100) %></p></div></div><% } %></article><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %></main><%~ await includeAsync('./inc/footer',firekylin) %>