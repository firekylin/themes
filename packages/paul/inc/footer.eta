<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{}; %><footer><p>© <%= new Date().getFullYear() %> <a href="/"><%= c.profileName||site.title() %></a></p>Design By <a href="https://paul.ren">Paul</a>. Dev By <a href="https://innei.ren">Innei</a>. Theme <a href="https://github.com/Innei/Typecho-Theme-Paul">Paul</a> · Firekylin.</footer><% if(c.audioUrl){ %><div class="paul-audio"><audio controls preload="none" src="<%= c.audioUrl %>" aria-label="音乐播放器"></audio></div><% } %><dialog id="paul-lightbox"><button id="lightbox-close" aria-label="关闭图片">×</button><img alt=""></dialog><script src="<%= site.themeUrl('res/port.js') %>" defer></script></body></html>