<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{}; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= firekylin.pageTitle?firekylin.pageTitle+' - ':'' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/base.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/paul.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/main.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>"><style><% if(c.background){ %>body:before{background-image:url(<%= JSON.stringify(c.background) %>)}<% } %><%~ c.customCSS||'' %></style></head><body><header id="paul-header"><button class="menu-toggle" aria-label="打开导航" aria-controls="paul-nav" aria-expanded="false"></button><nav id="paul-nav" aria-label="主导航"><a href="/" aria-label="首页"><i aria-hidden="true">⌂</i><span><%= c.profileName||site.title() %></span></a><a href="/archives" aria-label="归档"><i aria-hidden="true">▤</i><span>归档</span></a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>" aria-label="<%= n.label %>"><i aria-hidden="true">◇</i><span><%= n.label %></span></a><% }) %><a href="/search.html" aria-label="搜索"><i aria-hidden="true">⌕</i><span>搜索</span></a></nav></header>