<% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'归档'}) %><main class="is-article"><nav class="navigation"><a href="/archives" class="active">归档</a></nav><article><% Object.entries(a.grouped).forEach(([month,posts])=>{ %><h2 id="month-<%= month %>"><%= month %></h2><div class="paul-note note-content"><% posts.forEach(p=>{ %><p><span><%= String(p.create_time).slice(5,10) %></span> <a href="<%= a.permalinkFor(p) %>"><%= p.title %></a></p><% }) %></div><% }) %></article></main><%~ await includeAsync('./inc/footer',firekylin) %>