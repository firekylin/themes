<% const a=await firekylin.widget('Widget_Archive',{type:'index'});const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const full=c.IndexDisplayMode==='FullText'?await firekylin.widget('Widget_Matcha_FullPosts'):null;const bodies=new Map(full?full.toArray().map(x=>[x.id,x.content]):[]);let links=[];try{const d=JSON.parse(c.relatedLinks||'[]');if(Array.isArray(d))links=d.filter(x=>x&&x.title&&/^https?:|^\//.test(x.url||''))}catch{} %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.archiveTitle}) %><main class="col-12" id="main"><% if(a.archiveTitle){ %><h3 class="archive-title"><%= a.archiveTitle %></h3><% } if(links.length&&firekylin.ctx.path==='/'){ %><h2 class="section-title"><%= c.relatedLinksTitle||'相关链接' %></h2><section class="indexlink"><% links.forEach(x=>{ %><a href="<%= x.url %>"><h3><%= x.title %></h3><p><%= x.description||'' %></p></a><% }) %></section><% } %><section class="latest-post"><% while(a.next()){const cover=a.row.featuredImage||a.row.fields?.thumbnail; %><article class="post post-atmain <%= cover?'post-with-thumbnail':'' %>"><div class="post-text"><h2 class="post-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h2><ul class="post-meta"><li><time><%= a.date('YYYY-MM-DD') %></time></li><li><%~ a.category(',') %></li><li><a href="<%= a.permalink %>#comments"><%= a.commentsNum('%d') %> 评论</a></li></ul><div class="post-content"><% if(full){ %><%~ bodies.get(a.row.id)||a.row.summary||'' %><% }else{ %><%= a.excerpt(200) %><% } %></div></div><% if(cover){ %><div class="post-thumbnail"><a href="<%= a.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %></article><% } %></section><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %></main><%~ await includeAsync('./inc/footer',firekylin) %>