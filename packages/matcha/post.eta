<% const a=await firekylin.widget('Widget_Archive',{type:firekylin.kind||'post'});a.next();const cover=a.row.featuredImage||a.row.fields?.thumbnail; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.title()}) %><main class="col-12" id="main"><article class="post post-atpage"><% if(cover){ %><div class="post-thumbnail-atpage"><img src="<%= cover %>" alt=""></div><% } %><div class="post-header"><h1 class="post-title post-title-atpage"><%= a.title() %><button class="focus-mode-btn" data-focus aria-label="专注模式" aria-pressed="false">◉</button></h1><ul class="post-meta post-meta-atpage"><li><%= a.date('YYYY-MM-DD') %></li><li><%~ a.category(',') %></li></ul></div><div class="post-content"><%~ a.content() %></div><p class="tags-list post-tags-list"><%~ a.tags(' ',true,'') %></p></article><%~ firekylin.comment({title:'评论'}) %><aside id="tocbar" class="tocbar"><nav id="toc" aria-label="文章目录"></nav></aside><button class="focus-mode-btn" id="focus-mode-close" data-focus aria-label="退出专注模式">◉</button></main><%~ await includeAsync('./inc/footer',firekylin) %>