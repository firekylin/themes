<% const a=firekylin.archive,pg=a.pagination||{currentPage:1,totalPages:1}; %><nav class="page-navigator" aria-label="分页"><span id="previous"><% if(pg.currentPage>1){ %><a href="<%= a.pageUrl(pg.currentPage-1) %>" aria-label="上一页">←</a><% } %></span><span id="next"><% if(pg.currentPage<pg.totalPages){ %><a href="<%= a.pageUrl(pg.currentPage+1) %>" aria-label="下一页">→</a><% } %></span></nav>