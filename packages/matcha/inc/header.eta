<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const categories=await firekylin.widget('Widget_Metas_Category_List');const cat=categories.toArray(); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= firekylin.pageTitle?firekylin.pageTitle+' - ':'' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/normalize.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/matcha.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>"><style>:root{--theme-color:<%= String(c.ThemeColor||'#c5c56a').replace(/[<>;{}]/g,'') %>}<%~ c.customCSS||'' %></style></head><body class="<%= c.EnableExtraSimple==='able'?'extrasimple':'' %>" data-dark="<%= c.DarkMode||'default' %>" data-toc="<%= String(c.showTOC)!=='false' %>"><aside id="sidebar" class="sidebar"><section class="widget widget-nav sidebar-nav"><header id="header" class="header"><div class="site-name"><a href="/" class="site-title"><%= site.title() %></a><p class="description site-description"><%= site.description() %></p></div></header><ul class="widget-list"><li><a href="/">首页</a></li><% cat.forEach(x=>{ %><li><a href="/cate/<%= x.pathname %>"><%= x.name %></a></li><% });site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }) %><li><a href="/archives">归档</a></li><li><a href="/search.html">搜索</a></li></ul></section><section class="widget sidebar-foot"><ul class="widget-list"><li>Theme <a href="https://github.com/BigCoke233/matcha">Matcha</a> by <a href="https://github.com/BigCoke233">Eltrac</a></li><li>Powered by Firekylin</li></ul></section></aside><div id="helpbar"><button data-night aria-label="切换夜间模式" aria-pressed="false">◐</button><a href="/search.html" aria-label="搜索">⌕</a></div><div id="body"><div class="small-header" id="small-header"><div class="navbar"><div class="navbar-action"><div class="navbar-action-left"><button class="navbar-button" data-night aria-label="切换夜间模式" aria-pressed="false">◐</button></div><div class="navbar-action-right"><button class="navbar-button" id="nav-drop" aria-label="打开导航" aria-expanded="false" aria-controls="matcha-mobile">☰</button></div></div><nav class="navbar-dropdown" id="matcha-mobile" aria-label="手机导航" inert><button class="navbar-button navbar-dropup" id="nav-rise" aria-label="关闭导航">×</button><h2>页面</h2><ul class="widget-list"><li><a href="/">首页</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }) %><li><a href="/archives">归档</a></li><li><a href="/search.html">搜索</a></li></ul><h2>分类</h2><ul class="widget-list widget-category"><% cat.forEach(x=>{ %><li><a href="/cate/<%= x.pathname %>"><%= x.name %></a></li><% }) %></ul></nav></div><div class="site-name"><a href="/" class="site-title"><%= site.title() %></a><p class="description site-description"><%= site.description() %></p></div></div><div class="container">