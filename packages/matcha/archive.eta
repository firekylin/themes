<% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'归档'}) %><main id="main" class="col-12"><h1>归档</h1><% Object.entries(a.grouped).forEach(([month,posts])=>{ %><h2 id="month-<%= month %>"><%= month %></h2><ul class="archive-list"><% posts.forEach(p=>{ %><li><time><%= String(p.create_time).slice(5,10) %></time> <a href="<%= a.permalinkFor(p) %>"><%= p.title %></a></li><% }) %></ul><% }) %></main><%~ await includeAsync('./inc/footer',firekylin) %>