<% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'搜索'}) %><main id="main" class="col-12"><form class="matcha-search" action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" required><button>搜索</button></form><section class="latest-post"><% while(a.next()){ %><article class="post post-atmain"><h2 class="post-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h2><div class="post-content"><p><%= a.excerpt(200) %></p></div></article><% } %></section><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %></main><%~ await includeAsync('./inc/footer',firekylin) %>