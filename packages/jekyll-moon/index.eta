<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= site.title() %><% }) %><% block('content',()=>{ %><div class="post-title"><h1>文章</h1><% if(Number(archive.pagination.currentPage)===1){ %><p class="moon-intro"><%= site.description() %></p><% } %></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>