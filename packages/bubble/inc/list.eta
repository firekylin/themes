<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const archive = firekylin.archive; %><div class="fk-feed content-card-container">
<% while (archive.next()) { const cover = String(archive.row.featuredImage || ''); const safeCover = /^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="entry-card card"><a class="entry-cover" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><% if (safeCover) { %><img src="<%= cover %>" alt="" loading="lazy"><% } %></a><div class="entry-copy"><h2 class="entry-title card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author() %></p><p class="entry-excerpt"><%= archive.excerpt(160) %></p><a class="entry-more" href="<%= archive.permalink %>">阅读全文 →</a></div></article><% } %></div>
