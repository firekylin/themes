<% /* Bubble printAricle(): one full-width content card, metadata badges and optional picture. */const archive=firekylin.archive;%><div class="fk-feed"><% while(archive.next()) {const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage || '')?archive.row.featuredImage:''; %><article class="entry-card bubble-card"><% if(cover) { %><img class="bubble-card-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% if(archive.row.comment_num!=null) { %><a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 条评论</a><% } %><% for(const cate of archive.row.cate || []) { %><a class="bubble-badge" href="/cate/<%= cate.pathname %>"><%= cate.name %></a><% } %><a class="bubble-badge author" href="/author/<%= encodeURIComponent(archive.row.user?.name || '') %>"><%= archive.author() %></a></div><p class="entry-excerpt"><%= archive.excerpt(200) %></p></div></article><% } %></div>