<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || ''))?String(value):'';const image=safe(firekylin.bubbleCover)||safe(config.indexImage),avatar=safe(config.avatarUrl); const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#5e72e4'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/bubble.js') %>"></script><%~ block('headers') %></head>
<body class="fk-theme <%= firekylin.bubbleDetail ? 'bubble-detail-page' : '' %> <%= config.colorMode === 'dark' ? 'fk-dark' : '' %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="fk-header"><a class="fk-brand" href="/"><%= site.title() %></a><nav class="fk-nav" aria-label="主导航"><% for (const nav of site.navigation) { %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></header>
<section class="bubble-hero"><% if(image) { %><img class="bubble-hero-image" src="<%= image %>" alt=""><% } %><% if(config.bubbleShow!=='0') { %><div class="bubble-shapes" aria-hidden="true"><% for(let i=0;i<10;i++) { %><i></i><% } %></div><% } %><div class="bubble-intro"><% if(!firekylin.bubbleDetail && avatar) { %><img class="bubble-avatar" src="<%= avatar %>" alt=""><% } %><h1><%= firekylin.bubbleTitle || site.title() %></h1><% if(firekylin.bubbleDetail) { %><p>于 <%= firekylin.bubbleDate || '' %> 由 <%= firekylin.bubbleAuthor || '' %> 发布</p><% } else { %><hr><p><%= config.heroText || site.description() %></p><a class="bubble-start" href="#main">开始阅读 ↓</a><% } %></div></section>
<div class="fk-shell"><main id="main"><%~ block('content') %></main></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/trinitrotofu/Bubble">Bubble</a> by trinitrotofu · <a href="/rss.html">RSS</a></p></footer></body></html>
