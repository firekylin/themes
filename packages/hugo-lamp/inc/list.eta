<% const archive=firekylin.archive;let count=0; %><section class="entry-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry-single entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a href="<%= archive.permalink %>"><img class="entry-cover" src="<%= cover %>" alt="" loading="lazy"></a><% } %><header class="entry-header"><h2 class="entry-title"><a class="entry-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><p class="entry-summary"><%= archive.excerpt(220) %></p><footer class="entry-footer"><p class="entry-meta"><time class="entry-time"><%= archive.date('YYYY-MM-DD') %></time></p></footer></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>