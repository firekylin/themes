<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div class="wrapper"><header class="header"><% const avatar=String(cfg.avatarUrl||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="logo" src="<%= avatar %>" alt=""><% } %><h1 class="title"><a href="/"><%= site.title() %></a></h1><p class="subtitle"><%= site.description() %></p><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main" class="main"><%~ block('content') %></main><footer class="footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/huyb1991/hugo-lamp">Lamp</a> · Huy Nguyen</p></footer></div></body></html>