<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><a href="<%= archive.permalink %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="entry-cover" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="entry-body"><h2><%= archive.title() %></h2><p><%~ archive.excerpt(260) %></p><div class="meta"><time>▦ <%= archive.date('YYYY-MM-DD') %></time><span> <%= (archive.row.cate||[]).map(c=>c.name).join(', ') %></span></div></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %>