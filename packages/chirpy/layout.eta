<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||'');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><input type="checkbox" id="nav-trigger" aria-label="切换导航菜单"><aside id="sidebar"><header class="profile"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><a href="/"><img src="<%= avatar %>" alt="作者头像"></a><% } %><a class="site-title" href="/"><%= site.title() %></a><p><%= site.description() %></p></header><nav class="nav-items" aria-label="主导航"><a href="/">⌂　首页</a><a href="/categories">▦　分类</a><a href="/tags">#　标签</a><a href="/archives">▤　归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>">○　<%= n.label %></a><% }); %><a href="/search.html">⌕　搜索</a></nav><div class="sidebar-bottom"><label>◐ <select id="mode" aria-label="配色模式"><option value="system">跟随系统</option><option value="light">浅色</option><option value="dark">深色</option></select></label></div></aside><div id="main-wrapper"><header class="topbar"><label for="nav-trigger" class="menu-toggle" aria-label="切换导航菜单">☰</label><a href="/">Home</a><a href="/search.html">⌕ 搜索</a></header><div class="content-grid"><main id="main"><%~ block('content') %></main><aside class="panel"><section><h2>最近文章</h2><ul><% recent.stack.forEach(post=>{ %><li><a href="<%= recent.permalinkFor(post) %>"><%= post.title %></a></li><% }); %></ul></section><section><h2>标签</h2><div class="tag-cloud"><% tags.stack.slice(0,10).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></section><nav id="toc" aria-label="文章目录" hidden><h2>Contents</h2><ul></ul></nav></aside></div><footer class="site-footer"><%= cfg.footerText||site.description() %><p>Firekylin · <a href="https://github.com/cotes2020/jekyll-theme-chirpy">Chirpy</a> 原生改编</p></footer></div></body></html>