{
  "name": "chirpy",
  "title": "Chirpy",
  "version": "0.1.0",
  "private": true,
  "description": "Chirpy fixed-sidebar technical blog layout.",
  "license": "MIT",
  "author": "Cotes Chung; Firekylin contributors",
  "homepage": "https://github.com/cotes2020/jekyll-theme-chirpy",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/chirpy"
  },
  "firekylin": {
    "type": "theme",
    "id": "chirpy"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatar",
      "label": "头像",
      "help": "HTTPS或本站图片路径。"
    }
  ]
}
