<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><div id="page" class="site"><header id="masthead" class="site-header"><div class="site-header-wrap"><div class="site-branding"><h1 class="site-title"><a href="/"><%= site.title() %></a></h1><p class="site-description"><%= site.description() %></p></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div id="content" class="site-content"><main id="main" class="native-main site-main"><%~ block('content') %><footer class="native-footer"><p><%= cfg.authorName||site.title() %></p><p><%= cfg.footerText||site.description() %></p><a href="https://github.com/Automattic/themes/tree/trunk/altofocus">AltoFocus</a> by Automattic · Firekylin</footer></main></div></div></body></html>