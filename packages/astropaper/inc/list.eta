<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="date"><span aria-hidden="true">▦</span> <time><%= archive.date('YYYY-MM-DD') %></time></div><p><%~ archive.excerpt(240) %></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>