<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header wrapper"><div class="header-inner"><a class="site-title" href="/"><%= site.title() %></a><nav aria-label="主导航"><input type="checkbox" id="menu-trigger"><label for="menu-trigger" class="menu-icon" aria-label="切换导航菜单">☰</label><div class="nav-items"><a href="/archives">文章</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html" aria-label="搜索">搜索</a><button id="mode" aria-label="切换深浅色">◐</button></div></nav></div></header><main id="main" class="wrapper"><%~ block('content') %></main><footer class="site-footer wrapper"><div><span><%= cfg.footerText||site.description() %></span><a href="/categories">分类</a> · <a href="https://github.com/satnaing/astro-paper">AstroPaper</a> · Firekylin</div></footer></body></html>