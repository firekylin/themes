<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="listing-title"><%= archive.archiveTitle %></h1><% }else{ %><section class="hero"><h1><%= site.themeConfig.greeting||'Mingalaba' %></h1><p><%= site.description() %></p><p><a href="/archives">浏览所有文章 →</a></p></section><h2 class="recent-title">Recent Posts</h2><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>