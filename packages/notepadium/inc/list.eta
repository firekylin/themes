<% const archive=firekylin.archive;let count=0; %><ul class="note list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="item entry"><a class="note" href="<%= archive.permalink %>"><p class="note title"><%= archive.title() %></p><p class="note date"><%= archive.date('YYYY-MM-DD') %></p><p class="note content"><%= archive.excerpt(240) %></p></a></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>