<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="wrapper header-inner"><a class="site-title" href="/"><%= site.title() %></a><nav class="site-nav" aria-label="主导航"><div class="nav-items"><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></nav></div></header><main id="main" class="wrapper page-content"><%~ block('content') %></main><footer class="site-footer"><div class="wrapper"><div class="footer-columns"><div><%= cfg.authorName||site.title() %><p><a href="/categories">分类</a> · <a href="/tags">标签</a></p></div><div><%= cfg.footerText||site.description() %></div></div><p class="credits">Powered by Firekylin · <a href="https://github.com/yous/whiteglass">Whiteglass</a> 原生改编</p></div></footer></body></html>