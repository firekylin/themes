<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><header><h2><a class="post-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time class="post-meta"><%= archive.date('YYYY-MM-DD') %></time></header><div class="prose"><%~ archive.excerpt(600) %></div><p class="post-continue"><a href="<%= archive.permalink %>">继续阅读 →</a></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>