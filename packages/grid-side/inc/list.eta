<% const archive=firekylin.archive;let count=0; %><section class="masonry-flex-container"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="flex-item entry"><div class="page-item-container"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a href="<%= archive.permalink %>"><img class="page-item-image" src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="page-item-content"><time class="page-item-date"><%= archive.date('YYYY-MM-DD') %></time><h2 class="page-item-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="page-item-summary"><%= archive.excerpt(220) %></p><a class="page-item-btn" href="<%= archive.permalink %>">阅读全文</a><footer><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div></footer></div></div></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>