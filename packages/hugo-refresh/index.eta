<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&(!archive.pagination||archive.pagination.currentPage===1)){const image=String(cfg.heroImage||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(image); %><section class="hero native-hero<%= valid?'':' no-image' %>"><div class="hero-body"><div class="container"><div class="columns is-vcentered"><div class="column landing-caption<%= valid?' is-5 is-offset-1':'' %>"><h1 class="title is-1 is-bold is-spaced"><%= cfg.heroTitle||site.title() %></h1><p class="subtitle is-5 intro-text"><%= cfg.heroText||site.description() %></p><nav class="hero-links" aria-label="首页入口"><a class="button is-light" href="#articles">阅读文章</a><a class="button is-light" href="/archives">全部归档</a></nav></div><% if(valid){ %><div class="column is-5 is-offset-1"><figure class="image"><img class="native-hero-image" src="<%= image %>" alt=""></figure></div><% } %></div></div></div></section><% } %><section id="articles" class="section native-listing"><div class="container"><h1 class="title is-2 section-title native-title"><%= archive.archiveTitle||'文章' %></h1><div class="divider"></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div></section><% }) %>