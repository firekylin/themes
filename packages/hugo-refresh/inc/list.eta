<% const archive=firekylin.archive;let count=0; %><div class="native-grid"><% while(archive.next()){count++;const locked=Boolean(archive.row.password_protected||archive.row.options?.postPasswordHash||archive.row.title==='此内容被密码保护');const image=String(archive.row.options?.featuredImage||''); %><article class="entry"><div class="box"><% if(!locked&&/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><figure class="image is-3by2"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= image %>" alt="" loading="lazy"></a></figure><% } %><h2 class="title is-5 refresh-summary-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-date"><%= archive.date('YYYY-MM-DD') %></p><p class="refresh-summary"><%= archive.excerpt(220) %></p><div class="action has-text-right"><a class="button is-primary" href="<%= archive.permalink %>">阅读全文</a></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>