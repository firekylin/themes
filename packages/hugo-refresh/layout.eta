<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const tagRows=tags.stack; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="native-navbar"><div class="container"><button id="tag-toggle" class="tag-toggle" aria-controls="tag-panel" aria-expanded="false" hidden>☰ 标签</button><a class="native-brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><details class="native-tags-fallback"><summary>标签</summary><a href="/tags">全部标签</a><% tagRows.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %> (<%= t.count %>)</a><% }); %></details></div></header><dialog id="tag-panel" class="sidebar native-sidebar" aria-label="标签导航"><div class="sidebar-header"><h2>标签</h2><button id="tag-close" aria-label="关闭标签导航">×</button></div><div class="inner"><ul class="sidebar-menu"><li><a href="/tags">全部标签</a></li><% tagRows.forEach(t=>{ %><li><a href="/tag/<%= t.pathname %>"><span><%= t.name %></span><span class="tag-number"><%= t.count %></span></a></li><% }); %></ul></div></dialog><main id="main"><%~ block('content') %></main><div class="native-backtop container"><a href="#main">↑ 返回顶部</a></div><footer class="footer footer-dark native-footer"><div class="container"><div class="columns"><section class="column"><a class="footer-brand" href="/"><%= site.title() %></a><p><%= cfg.footerText||site.description() %></p></section><section class="column footer-column"><div class="footer-header"><h3>站点导航</h3></div><ul class="link-list"><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></section><section class="column footer-column"><div class="footer-header"><h3>关于本站</h3></div><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/PippoRJ/hugo-refresh">ReFresh</a></p><p>Roberto Jordaney · Fresh / CSS Ninja</p></section></div></div></footer></body></html>