<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categories=await firekylin.widget('Widget_Metas_Category_List');const home=!archive.archiveTitle&&archive.pagination?.currentPage===1; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(home){ %><section class="intro"><div class="container"><h1><%= site.themeConfig.introTitle||site.title() %></h1><p><%= site.themeConfig.introText||site.description() %></p></div></section><section class="frontpage-search"><div class="container"><h2>开始阅读</h2><span aria-hidden="true">▼</span><form action="/search.html" method="get"><label class="sr-only" for="home-keyword">搜索本站文章</label><input id="home-keyword" name="keyword" placeholder="搜索本站文章" required><button>搜索</button></form></div></section><section class="browse container"><h2 class="section-heading">浏览分类</h2><div class="topics"><% while(categories.next()){ %><a href="<%= categories.permalink %>"><span class="topic-mark" aria-hidden="true"><%= categories.row.name.slice(0,1) %></span><span><%= categories.row.name %></span></a><% } %></div></section><% if(archive.next()){ %><section class="highlights"><div class="container"><h2 class="section-heading">最新文章</h2><article><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="highlight-summary"><%~ archive.excerpt(280) %></div><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a></article></div></section><% } %><% }else{ %><section class="page-heading"><div class="container"><h1><%= archive.archiveTitle||'文章更新' %></h1></div></section><% } %><section class="updates container"><h2 class="section-heading"><%= home?'文章更新':'文章列表' %></h2><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>