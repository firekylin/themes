<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><%= archive.author('display_name') %> // <time><%= archive.date('YYYY-MM-DD') %></time></div><div class="entry-summary"><%~ archive.excerpt(300) %></div><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a></article><% } %><% if(!count){ %><p class="empty">暂无更多文章。</p><% } %>