<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><section class="page-heading"><div class="container"><h2>文章</h2></div></section><% if(found){ %><nav class="subnav" aria-label="文章分类"><div class="container"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div></nav><article class="single container"><h1 class="entry-title"><%= archive.title() %></h1><div class="entry-meta"><%= archive.author('display_name') %> // <time><%= archive.date('YYYY-MM-DD') %></time></div><div class="prose"><%~ archive.content() %></div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %></article><% }else{ %><p class="container">暂无内容。</p><% } %><% }) %>