<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="container"><div class="utility"><a href="/rss.html">RSS</a> · <a href="/search.html">搜索文章</a></div><div class="navbar"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details></div></div></header><main id="main"><%~ block('content') %></main><footer class="content-info"><div class="container"><div class="footer-columns"><section><a class="brand" href="/"><%= site.title() %></a><p><%= site.themeConfig.footerText||site.description() %></p></section><nav aria-label="页脚导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a></nav><section><a href="/rss.html">RSS 订阅</a><form action="/search.html" method="get"><label for="footer-keyword">搜索文章</label><div><input id="footer-keyword" name="keyword" required><button>搜索</button></div></form></section></div><p class="credits">© <%= new Date().getFullYear() %> <%= site.title() %> · Theme adapted from <a href="https://github.com/GSA/datagov-wptheme">Data.gov / Roots</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></div></footer></body></html>