<% const archive=firekylin.archive;let count=0,lastGroup=''; %><div class="archive"><% while(archive.next()){count++; %><% const year=archive.date('YYYY');if(year!==lastGroup){lastGroup=year; %><h2 class="archive-title"><%= year %></h2><% } %><article class="archive-item entry"><a class="archive-item-link" href="<%= archive.permalink %>"><%= archive.title() %></a><time class="archive-item-date"><%= archive.date('YYYY-MM-DD') %></time></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>