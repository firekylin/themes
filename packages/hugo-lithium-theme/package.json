{
  "name": "hugo-lithium-theme",
  "title": "Lithium",
  "version": "0.1.0",
  "private": true,
  "description": "Lithium’s pale full-width masthead, year-grouped archive, strong sans-serif titles and serif reading column.",
  "license": "MIT",
  "author": "Jonathan Rutheiser; Firekylin contributors",
  "homepage": "https://github.com/jrutheiser/hugo-lithium-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/hugo-lithium-theme"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugo-lithium-theme"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
