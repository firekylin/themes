<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %><% block('cover',()=>{const cfg=site.themeConfig; %><section class="cover"><% if(/^(https?:\/\/|\/(?!\/))/.test(String(cfg.coverUrl||''))){ %><img class="cover-bg" src="<%= cfg.coverUrl %>" alt=""><% } %><div class="cover-body"><h1><%= cfg.coverTitle||site.title() %></h1><p><%= cfg.coverSubtitle||site.description() %></p><nav class="dock" aria-label="封面导航"><a href="#content"><span aria-hidden="true">▤</span>博客</a><a href="/categories"><span aria-hidden="true">▦</span>分类</a><a href="/tags"><span aria-hidden="true">#</span>标签</a><a href="/archives"><span aria-hidden="true">▣</span>归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><span aria-hidden="true">◇</span><%= n.label %></a><% }); %></nav></div><a class="scroll-down" href="#content" aria-label="向下浏览文章">⌄</a></section><% }) %>