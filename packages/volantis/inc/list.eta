<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry card"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="headimg" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(240) %></div><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>">阅读全文 →</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>