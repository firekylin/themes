{
  "name": "volantis",
  "title": "Volantis",
  "version": "0.1.0",
  "private": true,
  "description": "Volantis fullscreen dock cover and floating blog cards.",
  "license": "MIT",
  "author": "xaoxuu and Volantis contributors; Firekylin contributors",
  "homepage": "https://github.com/volantis-x/hexo-theme-volantis",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/volantis"
  },
  "firekylin": {
    "type": "theme",
    "id": "volantis"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "coverTitle",
      "label": "封面标题",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "coverSubtitle",
      "label": "封面副标题",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "coverUrl",
      "label": "封面背景",
      "help": "站内路径或HTTPS图片；留空使用渐变。"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "博主名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "博主简介",
      "help": "纯文本。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像",
      "help": "站内路径或HTTPS图片。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本。"
    }
  ]
}
