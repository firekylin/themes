<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const valid=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><%~ block('cover') %><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary aria-label="切换导航菜单">☰</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details><button id="theme-toggle" hidden>深色</button></header><div class="columns" id="content"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section class="widget blogger"><% if(valid(cfg.avatarUrl)){ %><img src="<%= cfg.avatarUrl %>" alt=""><% } %><h2><%= cfg.profileName||site.title() %></h2><p><%= cfg.profileBio||site.description() %></p></section><div id="outline-slot"></div><section class="widget"><h2>文章分类</h2><% categories.stack.forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></section><section class="widget"><h2>标签</h2><div class="tag-cloud"><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></section><section class="widget"><h2>最近文章</h2><% recent.stack.forEach(post=>{ %><a href="<%= recent.permalinkFor(post) %>"><%= post.title %></a><% }); %></section></aside></div><footer class="site-footer"><p>© <%= cfg.footerText||site.title() %> · Powered by Firekylin</p><p>Theme <a href="https://github.com/volantis-x/hexo-theme-volantis">Volantis</a> · Firekylin 原生改编</p></footer><a class="back-top" href="#" aria-label="返回顶部">↑</a></body></html>