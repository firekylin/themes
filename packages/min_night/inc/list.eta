<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="item entry"><h4><a href="<%= archive.permalink %>"><%= archive.title() %></a></h4><h5><time><%= archive.date('YYYY-MM-DD') %></time></h5><p><%= archive.excerpt(160) %></p></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>