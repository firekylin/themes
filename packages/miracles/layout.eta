<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || '')) ? String(value) : ''; const background=safe(config.background); const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#6f9fc7'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,miracles-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/miracles.js') %>"></script><%~ block('headers') %></head>
<body class="fk-theme <%= config.colorMode==='dark'?'fk-dark':'' %>"><a class="skip-link" href="#main">跳转到正文</a><header class="fk-header"><a class="fk-brand" href="/"><%= site.title() %></a><nav class="fk-nav" aria-label="主导航"><% for(const nav of site.navigation){ %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav><button class="miracles-palette" type="button" hidden aria-label="切换夜间模式" aria-pressed="false">◐</button></header><section class="miracles-banner" style="height:<%= Math.max(25,Math.min(90,Number(config.bannerHeight)||45)) %>vh"><% const banner=safe(firekylin.detailCover)||safe(config.bannerUrl);if(banner){ %><img src="<%= banner %>" alt=""><% } %><div class="miracles-heading <%= banner?'with-image':'' %>"><h1><%= firekylin.detailTitle||config.bannerTitle||site.title() %></h1><p><%= firekylin.detailTitle?firekylin.detailMeta:config.heroText||site.description() %></p></div></section><div class="fk-shell"><main id="main"><%~ block('content') %></main></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/BigCoke233/miracles">Miracles</a> by Eltrac · <a href="/rss.html">RSS</a></p></footer></body></html>
