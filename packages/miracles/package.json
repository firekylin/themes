{
  "name": "miracles",
  "title": "Miracles",
  "version": "0.1.0",
  "private": true,
  "description": "Miracles banner and split-card reading layout for Firekylin.",
  "license": "LicenseRef-SATA-BNP",
  "author": "Eltrac",
  "homepage": "https://github.com/BigCoke233/miracles",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/miracles"
  },
  "firekylin": {
    "type": "theme",
    "id": "miracles"
  },
  "engines": {
    "firekylin": ">=2.16.0"
  },
  "configElements": [
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，不支持 HTML。"
    },
    {
      "type": "text",
      "name": "heroText",
      "label": "站点简介",
      "help": "留空使用站点描述。"
    },
    {
      "type": "color",
      "name": "accentColor",
      "label": "强调色",
      "help": "支持 #RGB 或 #RRGGBB。"
    },
    {
      "type": "text",
      "name": "colorMode",
      "label": "配色模式",
      "help": "填写 dark 启用深色；留空为浅色。"
    },
    {
      "type": "text",
      "name": "bannerUrl",
      "label": "首页封面",
      "help": "http(s) 或站内图片路径。"
    },
    {
      "type": "text",
      "name": "bannerTitle",
      "label": "封面标题",
      "help": "纯文本；留空使用站点名称。"
    },
    {
      "type": "text",
      "name": "bannerHeight",
      "label": "封面高度",
      "help": "25–90，单位 vh；默认 45。"
    }
  ]
}
