<% const archive=firekylin.archive;%><div class="fk-feed"><% while(archive.next()){const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage||'')?archive.row.featuredImage:'';%><article class="entry-card miracles-card"><a class="miracles-cover" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><% if(cover){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %></a><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.row.fields?.excerpt||archive.excerpt(130) %></p><div class="entry-meta"><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> · <% } %><% if(archive.row.comment_num!=null){ %><%= Number(archive.row.comment_num)||0 %> 评论 · <% } %><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div><a class="miracles-read" href="<%= archive.permalink %>">阅读全文</a></div></article><% } %></div>