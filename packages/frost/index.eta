<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="welcome"><div><h1><%= cfg.heroTitle||site.title() %></h1><p><%= cfg.heroLead||site.description() %></p><div class="buttons"><a class="button" href="#posts">Read the blog</a><a class="button outline" href="/archives">Explore archives</a></div></div></section><% if(cfg.featureTitle){ %><section class="feature"><div class="wide feature-columns"><div><h2><%= cfg.featureTitle %></h2><p><%= cfg.featureText||site.description() %></p><a class="button" href="<%= safe(cfg.featureUrl)?cfg.featureUrl:'/archives' %>">Learn More →</a></div><% if(safe(cfg.featureImage)){ %><img src="<%= cfg.featureImage %>" alt="<%= cfg.featureTitle %>"><% } %></div></section><% } %><% } %><section class="reading posts" id="posts"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>