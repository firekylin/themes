<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post-summary"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div></header><div><%~ archive.excerpt(260) %></div><p class="read-more"><a href="<%= archive.permalink %>">Read More</a></p></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>