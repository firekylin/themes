<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="reading single"><% if(found){ %><header><h1><%= archive.title() %></h1><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div></header><div class="prose"><%~ archive.content() %></div><footer class="entry-footer"><p>Tags: <% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></p></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>