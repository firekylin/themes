<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳至内容</a><header class="site-header"><div class="wide header-row"><a class="site-title" href="/"><%= site.title() %></a><details class="site-menu" open><summary>Menu</summary><nav aria-label="主导航"><a href="/archives">Archives</a><a href="/categories">Categories</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details></div></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><div class="wide footer-row"><p>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="/rss.html">RSS</a></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/wpengine/frost">Frost</a> by WP Engine</p></div></footer></body></html>