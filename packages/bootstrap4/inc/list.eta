<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="blog-post entry"><h2 class="blog-post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="blog-post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="button">阅读全文 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %>