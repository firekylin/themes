<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><div class="blog-masthead"><div class="container"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><header class="blog-header"><div class="container"><h1 class="blog-title"><a href="/"><%= site.title() %></a></h1><p class="lead blog-description"><%= site.description() %></p></div></header><div class="container"><div class="row"><main id="main" class="native-main col-sm-8 blog-main"><%~ block("content") %></main><aside class="col-sm-3 offset-sm-1 blog-sidebar"><div class="sidebar-module sidebar-module-inset"><h4><%= cfg.authorName||site.title() %></h4><p><%= site.description() %></p></div></aside></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/alanorth/hugo-theme-bootstrap4-blog">Bootstrap 4 Blog</a> by Alan Orth</footer></body></html>