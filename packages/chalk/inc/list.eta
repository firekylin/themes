<% const archive=firekylin.archive;let count=0; %><ul class="article-list"><% while(archive.next()){count++; %><li class="article-list-item entry"><a href="<%= archive.permalink %>"><h5><%= archive.title() %> <span class="arrow" aria-hidden="true">→</span></h5></a><p><%= archive.excerpt(300) %></p><div class="article-list-footer"><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.tag||[]).forEach(t=>{ %> · <a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>