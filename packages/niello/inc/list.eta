<% const archive=firekylin.archive;let count=0; %><div class="home-recommended-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="entry-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="entry-info"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time><%= archive.date('YYYY-MM-DD') %></time><p><%= archive.excerpt(220) %></p></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %></div>