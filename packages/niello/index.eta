<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const featured=await firekylin.widget('Widget_Contents_Post_Recent@niello-banner',{pageSize:2}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><h1 class="home-recommended-title"><%= archive.archiveTitle||'最新文章' %></h1><% if(!archive.archiveTitle&&featured.have()){ %><div class="native-banner" tabindex="0" aria-label="最新文章轮播"><% while(featured.next()){const image=String(featured.row?.options?.featuredImage||''); %><a class="banner-slide" href="<%= featured.permalink %>"><% if(/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><img src="<%= image %>" alt=""><% } %><h2><%= featured.title() %></h2></a><% } %></div><div class="banner-controls" hidden><button type="button" data-direction="prev" aria-label="上一张">←</button><button type="button" data-direction="next" aria-label="下一张">→</button></div><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>