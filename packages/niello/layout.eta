<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/banner.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="niello-wrap"><header class="niello-nav"><a class="brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><div class="niello-header"><p><%= site.description() %></p><form class="header-search" action="/search.html" method="get" role="search"><input name="keyword" aria-label="搜索文章" placeholder="搜索文章" required><button type="submit">搜索</button></form></div><div class="niello-columns"><main class="native-main" id="main"><%~ block('content') %></main><aside class="aside-container"><h2 class="aside-section-title">关于</h2><p><%= cfg.footerText||site.description() %></p><h2 class="aside-section-title">最新文章</h2><ul class="sidebar-recent"><% const recent=await firekylin.widget('Widget_Contents_Post_Recent@niello-sidebar',{pageSize:5});while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul><h2 class="aside-section-title">标签</h2><div class="native-tags"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% } %></div></aside></div><footer class="native-footer"><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/guangmean/Niello">Niello</a></p></footer></div></body></html>