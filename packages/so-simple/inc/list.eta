<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="entry-image" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><div class="excerpt"><%~ archive.excerpt(260) %></div><p class="more"><a href="<%= archive.permalink %>">Read more…</a></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>