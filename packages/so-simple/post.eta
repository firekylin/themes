<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-detail"><% if(found){ %><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="post-cover" src="<%= cover %>" alt=""><% } %><h1 class="page-title"><%= archive.title() %></h1><div class="post-columns"><aside class="post-meta"><p>by <%= archive.author('display_name') %></p><time><%= archive.date('YYYY-MM-DD') %></time><h2>Categories</h2><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><h2>Tags</h2><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></aside><div><div class="prose" id="post-content"><%~ archive.content() %></div><nav class="post-pagination" aria-label="相邻文章"><% if(archive.row.prev?.id){ %><a href="<%= archive.permalinkFor(archive.row.prev) %>">Previous<br><em><%= archive.row.prev.title %></em></a><% }if(archive.row.next?.id){ %><a href="<%= archive.permalinkFor(archive.row.next) %>">Next<br><em><%= archive.row.next.title %></em></a><% } %></nav><%~ firekylin.comment({title:'评论'}) %></div></div><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>