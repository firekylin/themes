<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const logo=String(cfg.logo||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav><header class="masthead"><% if(/^(https?:\/\/|\/(?!\/))/.test(logo)){ %><a class="site-logo" href="/"><img src="<%= logo %>" alt="站点标识"></a><% } %><h2 class="site-title"><a href="/"><%= site.title() %></a></h2><p class="site-description"><%= site.description() %></p></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/mmistakes/so-simple-theme">So Simple</a> 原生改编</p></footer></body></html>