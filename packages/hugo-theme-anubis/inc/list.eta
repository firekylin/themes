<% const archive=firekylin.archive;let count=0,lastGroup=''; %><div class="articles h-feed"><% while(archive.next()){count++; %><article class="post-list entry"><div class="post-header"><header><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1></header></div><div class="content post-summary"><p><%= archive.excerpt(300) %></p></div><div class="post-info"><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>