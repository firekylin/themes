<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1&&safe(site.themeConfig.bannerUrl)){ %><figure class="banner"><% if(safe(site.themeConfig.bannerLink)){ %><a href="<%= site.themeConfig.bannerLink %>"><% } %><img src="<%= site.themeConfig.bannerUrl %>" alt="<%= site.themeConfig.bannerTitle||'' %>"><% if(safe(site.themeConfig.bannerLink)){ %></a><% } %><% if(site.themeConfig.bannerTitle){ %><figcaption><%= site.themeConfig.bannerTitle %></figcaption><% } %></figure><% } %><section class="post-list-plane"><h1 class="list-title"><%= archive.archiveTitle||'最新文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>