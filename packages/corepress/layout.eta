<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="brand" href="/"><% if(safe(site.themeConfig.logoUrl)){ %><img src="<%= site.themeConfig.logoUrl %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">文章归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details></div></header><div class="html-main"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section class="widget"><form action="/search.html" method="get"><label class="sr-only" for="sidebar-keyword">搜索文章</label><input id="sidebar-keyword" name="keyword" placeholder="搜索内容" required><button>搜索</button></form></section><section class="widget"><h2>最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="widget"><h2>文章分类</h2><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.row.name %></a></li><% } %></ul></section><nav id="corepress-toc" class="widget" aria-label="文章目录" hidden><h2>文章目录</h2></nav></aside></div><footer class="site-footer">Copyright © <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://www.lovestu.com/corepress.html">CorePress Theme</a> by <a href="https://www.lovestu.com">applek</a> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a></footer></body></html>