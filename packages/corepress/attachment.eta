<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-content"><% if(found){ %><h1 class="post-title"><%= archive.title() %></h1><div class="post-meta"><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %> <% (archive.row.cate||[]).forEach(c=>{ %> · <a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div><div class="prose" id="post-content"><%~ archive.content() %></div><div class="the-end">THE END</div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>