<% const archive=firekylin.archive;let count=0;const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><% while(archive.next()){count++;const cover=(archive.row.options||{}).featuredImage; %><article class="post-item"><% if(safe(cover)){ %><a class="post-image" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="post-item-main"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-item-content"><%~ archive.excerpt(180) %></div><div class="post-item-meta"><span class="author"><%= archive.author('display_name') %></span><time><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% } %><% if(!count){ %><p class="empty">暂无文章。</p><% } %>