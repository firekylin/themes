<% /* DUX by 大前端, Arco-X, hiCasper. Modified for Firekylin, 2026. GPL-2.0. */ const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:6});const tags=await firekylin.widget('Widget_Metas_Tag_Cloud',{limit:20,ignoreZeroCount:1});const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/adapter.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><header class="header"><div class="container dux-header"><a class="dux-logo" href="/"><% if(safe(site.themeConfig.logoUrl)){ %><img src="<%= site.themeConfig.logoUrl %>" alt=""><% } %><%= site.title() %></a><% if(site.themeConfig.tagline){ %><span class="dux-brand"><%= site.themeConfig.tagline %></span><% } %><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/categories">分类</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a></nav></details><details class="search-menu"><summary>搜索</summary><form action="/search.html" method="get" role="search"><label for="header-keyword">关键词</label><input id="header-keyword" name="keyword" required><button>搜索</button></form></details></div></header><section class="container dux-body"><div class="content-wrap"><main class="content" id="main"><%~ block('content') %></main></div><aside class="sidebar"><section class="widget widget-tops"><ul class="widget-nav"><li class="active">最新文章</li></ul><ul class="widget-navcontent"><li class="item item-01 active"><ul><% while(recent.next()){ %><li><time><%= recent.date('MM-DD') %></time><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></li></ul></section><section class="widget widget_ui_tags"><h3>标签云</h3><div class="items"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %>（<%= tags.row.count||0 %>）</a><% } %></div></section></aside></section><footer class="footer"><div class="container">© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="/rss.html">RSS</a><br>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · DUX by 大前端 / Arco-X / <a href="https://github.com/hicasper/Typecho-theme-DUX">hiCasper</a></div></footer></body></html>