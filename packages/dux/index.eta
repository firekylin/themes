<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const taxonomy=await firekylin.widget('Widget_Dux_Categories',{postIds:archive.toArray().map(p=>p.id)});archive.duxCategories=taxonomy.byPost;const cfg=site.themeConfig;const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1&&safe(cfg.bannerImage)){ %><a class="dux-banner" href="<%= safe(cfg.bannerUrl)?cfg.bannerUrl:'/archives' %>"><img src="<%= cfg.bannerImage %>" alt="<%= site.title() %>"></a><% } %><div class="title"><h3><%= archive.archiveTitle||'最新发布' %></h3></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>