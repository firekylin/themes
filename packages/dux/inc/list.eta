<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String((archive.row.options||{}).featuredImage||'');const hasCover=/^(https?:\/\/|\/(?!\/))/.test(cover);const cat=((archive.duxCategories||{})[archive.row.id]||archive.row.cate||[])[0]; %><article class="excerpt <%= hasCover?'':'excerpt-text' %>"><% if(hasCover){ %><a class="focus" href="<%= archive.permalink %>"><img class="thumb" src="<%= cover %>" alt="" loading="lazy"></a><% } %><header><% if(cat){ %><a class="cat" href="/cate/<%= cat.pathname %>"><%= cat.name %><i aria-hidden="true"></i></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><p class="meta"><time><%= archive.date('YYYY-MM-DD') %></time><span class="author"><%= archive.author('display_name') %></span><a class="pc" href="<%= archive.permalink %>#comments">评论(<%= Number(archive.row.comment_num)||0 %>)</a></p><div class="note"><%~ archive.excerpt(111) %></div></article><% } %><% if(!count){ %><p class="directory">暂无文章。</p><% } %>