<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><div class="single-content"><% if(found){ %><header class="article-header"><h1 class="article-title"><%= archive.title() %></h1><div class="article-meta"><span class="item"><%= archive.date('YYYY-MM-DD') %></span><span class="item"><%= archive.author('display_name') %></span></div></header><article class="article-content"><%~ archive.content() %></article><div class="article-tags">标签：<% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><% if(site.themeConfig.authorDescription){ %><div class="article-author"><h4><%= archive.author('display_name') %></h4><span><%= site.themeConfig.authorDescription %></span></div><% } %><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></div><% }) %>