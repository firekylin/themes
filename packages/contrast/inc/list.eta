<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time><%= archive.date('YYYY-MM-DD') %></time></header><p><%~ archive.excerpt(400) %></p><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %>