<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><div class="content-subhead"><time><%= archive.date('YYYY-MM-DD') %></time></div><header class="post-header"><h2><a class="post-title" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="post-description"><p><%= archive.excerpt(500) %></p><a href="<%= archive.permalink %>">继续阅读</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>