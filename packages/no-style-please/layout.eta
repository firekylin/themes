<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const appearance=['auto','light','dark'].includes(cfg.appearance)?cfg.appearance:'auto'; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body data-appearance="<%= appearance %>"><a class="skip" href="#main">跳转到正文</a><div class="w"><nav class="nav-items" aria-label="主导航"><a href="/">..</a> · <a href="/archives">归档</a> · <a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %> · <a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><main id="main"><%~ block('content') %></main><footer><hr><p><%= cfg.footerText||site.description() %></p><small>Firekylin · <a href="https://github.com/riggraz/no-style-please">No Style Please</a> 原生改编</small></footer></div></body></html>