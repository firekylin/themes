<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><h1><%= archive.archiveTitle||site.title() %></h1><ul class="home-menu"><li>info<ul><li><%= site.description() %></li><li><a href="/categories">分类</a> · <a href="/tags">标签</a></li></ul></li><li>posts<%~ include('./inc/list',{archive}) %></li></ul><%~ include('./inc/pagination',{archive}) %><% }) %>