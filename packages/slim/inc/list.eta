<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++; %><article class="post entry"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><span class="post-date"><%= archive.date('YYYY-MM-DD') %></span><div class="summary"><p><%= archive.excerpt(300) %></p></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>