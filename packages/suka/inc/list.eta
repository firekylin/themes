<% const archive=firekylin.archive;let count=0; %><div class="post-stream-container"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post-entry container px-0 card entry"><div class="columns col-gapless"><div class="column column-thumbnail col-4 col-lg-12"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><div class="column column-body col-8 col-lg-12"><h2 class="h5 mb-0 card-header"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="mb-0 card-body"><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div><div class="card-footer post-entry-info text-gray"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>