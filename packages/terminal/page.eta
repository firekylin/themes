<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' :: ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="post"><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time><span><%= archive.author('display_name') %></span></div><div class="post-tags"><% (archive.row.tag||[]).forEach(t=>{ %>#<a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><% if(String(site.themeConfig.toc)!=='false'){ %><nav class="table-of-contents" id="terminal-toc" aria-label="文章目录" hidden><h2>Table of Contents</h2></nav><% } %><div class="post-content" id="post-content"><%~ archive.content() %></div><%~ firekylin.comment({title:'评论'}) %></article><% }else{ %><p>No posts yet.</p><% } %><% }) %>