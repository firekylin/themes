<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const mode=['center','full'].includes(cfg.layout)?cfg.layout:'';const color=(value,fallback)=>/^#[0-9a-fA-F]{6}$/.test(String(value||''))?value:fallback; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><% ['fonts','main','header','menu','post','pagination','footer','native'].forEach(file=>{ %><link rel="stylesheet" href="<%= site.themeUrl('res/css/'+file+'.css') %>"><% }); %><style>:root{--accent:<%= color(cfg.accent,'#eec35e') %>;--background:<%= color(cfg.background,'#1a170f') %>;--foreground:<%= color(cfg.foreground,'#eceae5') %>}</style><script defer src="<%= site.themeUrl('res/js/terminal.js') %>"></script></head><body><div class="container <%= mode %>"><header class="header"><div class="header__inner"><div class="header__logo"><a href="/"><div class="logo"><%= cfg.logoText||site.title() %></div></a></div></div><details class="terminal-menu" open><summary>Menu ▾</summary><nav class="navigation-menu" aria-label="主导航"><ul class="navigation-menu__inner"><li><a href="/">Home</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %><li><a href="/archives">Archives</a></li><li><a href="/search.html">搜索</a></li><li><a href="/rss.html">RSS</a></li></ul></nav></details></header><main id="main" class="content"><%~ block('content') %></main><footer class="footer"><div class="footer__inner"><span>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/panr/hugo-theme-terminal">Terminal</a> by panr · <a href="https://github.com/firekylin/firekylin">Firekylin</a></span></div></footer></div></body></html>