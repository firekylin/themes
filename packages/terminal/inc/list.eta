<% const archive=firekylin.archive; %><div class="posts"><% while(archive.next()){const cover=String((archive.row.options||{}).featuredImage||''); %><article class="post on-list"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time><span><%= archive.author('display_name') %></span></div><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="post-cover" src="<%= cover %>" alt=""><% } %><div class="post-content"><%~ archive.excerpt(240) %></div><a class="read-more" href="<%= archive.permalink %>">[Read more]</a></article><% } %><% if(!archive.have()){ %><p>No posts yet.</p><% } %></div>