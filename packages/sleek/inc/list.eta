<% const archive=firekylin.archive;let count=0; %><div class="post-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post-card entry"><a href="<%= archive.permalink %>"><figure class="post-card__thumb"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></figure></a><a class="post-card__inner" href="<%= archive.permalink %>"><div class="post-card__header"><h2><%= archive.title() %></h2><span class="post-card__meta"><time><%= archive.date('YYYY-MM-DD') %></time></span></div><p><%= archive.excerpt(160) %></p></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>