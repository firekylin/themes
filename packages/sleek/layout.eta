<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="is-head-left-logo home-template"><a class="native-skip" href="#main">跳转到正文</a><div class="site"><header class="header"><div class="container"><div class="header__inner"><a class="header__logo" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><section class="hero"><div class="hero__wrap"><h1 class="hero__title"><%= site.title() %></h1><p><%= site.description() %></p></div></section><main id="main" class="native-main site__content container"><%~ block('content') %></main></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/janczizikow/sleek">Sleek</a> by Jan Cizikow</footer></body></html>