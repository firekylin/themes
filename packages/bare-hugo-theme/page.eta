<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('hero',()=>{ %><% if(found){ %><header class="article-meta"><h1 class="post-title"><%= archive.title() %></h1></header><div class="hero-tags"><% (archive.row.tag||[]).forEach(t=>{ %><a class="tag is-link" href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><% } %><% }) %><% block('content',()=>{ %><article class="post post-detail"><% if(found){ %><div class="prose post-content content is-medium" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>