<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar is-transparent"><div class="navbar-brand"><a class="navbar-item" href="/"><%= site.title() %></a></div><div class="navbar-menu"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><section class="hero is-small is-info is-fullwidth"><div class="hero-body"><div class="container"><%~ block('hero',()=>{ %><h1 class="title"><%= cfg.authorName||site.title() %></h1><h2 class="subtitle"><%= site.description() %></h2><% }) %></div></div></section><main id="main" class="section bare-main"><div class="container"><%~ block('content') %></div></main><footer class="footer"><div class="content has-text-centered"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/orf/bare-hugo-theme">Bare Hugo theme.</a></p></div></footer></body></html>