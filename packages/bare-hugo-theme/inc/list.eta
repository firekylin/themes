<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++; %><article class="post entry"><div><a class="title is-size-5" href="<%= archive.permalink %>"><%= archive.title() %></a></div><div class="subtitle is-6"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= ['January','February','March','April','May','June','July','August','September','October','November','December'][Number(archive.date('YYYY-MM-DD').slice(5,7))-1]+' '+archive.date('YYYY-MM-DD').slice(8,10)+', '+archive.date('YYYY-MM-DD').slice(0,4) %></time></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>