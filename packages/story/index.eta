<% layout('./layout'); const site=await firekylin.widget('Widget_Options'); const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle ? archive.archiveTitle+' - ' : '' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="archive-header"><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><% if(!archive.have()){ %><p class="empty">暂无文章。</p><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>
