<% layout('./layout'); const site=await firekylin.widget('Widget_Options'); const archive=await firekylin.widget('Widget_Archive',{type:'post'}); const found=archive.next(); %><% block('title',()=>{ %><%= found ? archive.title()+' - ' : '' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="posti"><h1 class="post-title"><%= archive.title() %></h1><div class="post-meta"><p>Written by <%= archive.author('display_name') || archive.author('name') %> with ♥ on <time><%= archive.date('YYYY-MM-DD') %></time><% if(archive.row.cate && archive.row.cate.length){ %> in <%= archive.row.cate.map(c=>c.name).join(', ') %><% } %></p></div><div class="post-content"><%~ archive.content() %></div><div id="postFun"><span>tags: <% (archive.row.tag || []).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>"><%= tag.name %></a> <% }) %></span><a href="/">home</a></div><% const comments=firekylin.comment({title:'评论'}); if(comments){ %><details class="story-comments"><summary>show comments</summary><%~ comments %></details><% } %><div id="postTorTree"><nav id="torTree" aria-label="文章目录" data-open="<%= site.themeConfig.showToc === 'on' %>" hidden><div class="torArcT"><div class="torArcTile"></div></div></nav></div></article><% }else{ %><p class="empty">暂无内容。</p><% } %><% }) %>
