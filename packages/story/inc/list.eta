<% const archive=firekylin.archive; %><ul class="post-list clearfix">
<% while(archive.next()) { const cover=String(archive.row.featuredImage || ''); const safe=/^(https?:\/\/|\/(?!\/))/.test(cover); %><li class="post-item grid-item"><a class="post-link" href="<%= archive.permalink %>"><% if(safe){ %><img class="cover" src="<%= cover %>" alt="" loading="lazy"><% } %><h3 class="post-title"><time class="index-time"><%= archive.date('YYYY-MM-DD') %></time><br><%= archive.title() %></h3><% if(archive.row.cate && archive.row.cate.length){ %><div class="post-meta"><%= archive.row.cate.map(c=>c.name).join(', ') %></div><% } %></a></li><% } %></ul>
