<% const site = await firekylin.widget('Widget_Options'); const cfg = site.themeConfig || {}; const text = String(cfg.logoText || site.title()).slice(0,32); const icons = cfg.iconNav === 'on'; const bg = String(cfg.backgroundUrl || ''); const safeBg = /^(https?:\/\/|\/(?!\/))/.test(bg); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"></head>
<body><a class="skip-link" href="#main">跳转到正文</a><% if (safeBg) { %><img class="story-background" src="<%= bg %>" alt=""><% } %>
<header id="header"><div class="container-fluid"><div class="logo"><div class="header-logo">
<a class="story-logo" href="/" aria-label="<%= site.title() %>"><% Array.from(text).forEach((ch,i)=>{ %><span class="<%= i === 2 ? 'w' : 'b' %>" aria-hidden="true"><%= ch %></span><% }) %></a>
<details class="story-menu"><summary aria-label="打开导航">·</summary><div class="story-tools">
<details class="story-pages"><summary aria-label="页面导航"><%= icons ? '⚑' : '1' %></summary><nav aria-label="主导航"><% site.navigation.forEach(nav=>{ %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %><a href="/rss.html">RSS</a></nav></details>
<button type="button" class="story-toc-button" aria-label="文章目录" aria-expanded="false" aria-controls="torTree" hidden><%= icons ? '♧' : '2' %></button>
<details class="story-search"><summary aria-label="搜索"><%= icons ? '⌕' : '3' %></summary><form action="/search.html" method="get" role="search"><label class="sr-only" for="story-search">搜索</label><input id="story-search" type="search" name="keyword" placeholder="Type something~" required><button type="submit">搜索</button></form></details>
</div></details></div></div></div></header>
<main id="main" tabindex="-1"><%~ block('content') %></main><footer id="footer"><p>© <%= new Date().getFullYear() %> <%= site.title() %> · Using <a href="https://github.com/firekylin/firekylin">Firekylin</a> &amp; <a href="https://github.com/txperl/Story-for-Typecho">Story</a> by Trii Hsia.</p></footer><script src="<%= site.themeUrl('res/js/story.js') %>" defer></script></body></html>
