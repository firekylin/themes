<% const archive=firekylin.archive;const meta=firekylin.metaByPost||new Map();let count=0; %><% while(archive.next()){count++;const tags=(meta.get(archive.row.id)||archive.row).tag||[]; %><article class="card entry"><header class="card__header"><h2 class="card__header__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card__header__author"><%= archive.author('display_name') %></p><p class="card__header__date"><time><%= archive.date('YYYY-MM-DD') %></time></p></header><div class="card__body"><p><%= archive.excerpt(300) %></p></div><footer class="card__footer"><div class="tags"><% tags.forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>