<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="header__title"><a class="header__title__link" href="/"><%= site.title() %></a></div><nav class="menu" aria-label="主导航"><details class="menu__toggle"><summary>菜单</summary><div class="menu__items native-nav nav-items"><a class="menu__items__item" href="/archives">归档</a><a class="menu__items__item" href="/categories">分类</a><a class="menu__items__item" href="/tags">标签</a><a class="menu__items__item" href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a class="menu__items__item" href="<%= n.url %>"><%= n.label %></a><% }); %></div></details></nav></header><main id="main"><%~ block('content') %></main><footer class="footer"><div class="footer__copy"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/danielkvist/hugo-piercer-theme">Piercer</a> · Daniel Zaragoza</p></div></footer></body></html>