<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><header class="single__header"><h1><%= archive.archiveTitle %></h1></header><% }else{const cover=String(site.themeConfig.heroImage||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><section class="hero <%= valid?'has-cover':'' %>"><% if(valid){ %><img class="hero-cover" src="<%= cover %>" alt=""><% } %><h1><%= site.title() %></h1><p class="hero-description"><%= site.description() %></p><a class="btn cta" href="#posts">阅读文章</a></section><% } %><div class="list" id="posts"><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>