<% const archive=firekylin.archive;let count=0;const featured=firekylin.featureFirst; %><% while(archive.next()){count++;if(featured&&count===1){ %><article class="entry pinned-post card shadow round-corner"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="document-date"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p><hr class="red-hr"><p class="entry-summary"><%= archive.excerpt(700) %></p><a class="card-links entry-readmore" href="<%= archive.permalink %>">阅读全文</a></article><% }else{if(count===(featured?2:1)){ %><section class="recent-section card shadow round-corner"><h2>文章</h2><div class="list-page"><% } %><div class="entry list-page-data"><time class="list-page-date"><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>"><%= archive.title() %></a></div><% } %><% } %><% if(count>=(featured?2:1)){ %></div></section><% } %><% if(!count){ %><p>暂无文章。</p><% } %>