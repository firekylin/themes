<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const home=block('home')==='yes';const heading=block('mastheadTitle');const headingMeta=block('mastheadMeta');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:7});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><% if(home){const avatar=String(cfg.avatarURL||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(avatar); %><header class="site-header home-page-header shadow round-corner <%= valid?'':'no-avatar' %>"><% if(valid){ %><div class="header-image-container"><div class="header-image shadow"><img src="<%= avatar %>" alt=""></div></div><% } %><div class="header-info"><h1 class="main-title"><%= site.title() %></h1><p class="about-narrative"><%= cfg.aboutText||site.description() %></p><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><% }else{ %><header class="site-header regular-page-header shadow round-corner"><a class="home-link" href="/">← <%= site.title() %></a><h1 class="page-title"><% if(heading){ %><%~ heading %><% }else{ %><%= site.title() %><% } %></h1><% if(headingMeta){ %><p class="document-date"><%~ headingMeta %></p><% } %><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><% } %><main id="main"><%~ block('content') %></main><footer class="native-footer"><div class="footer shadow round-corner"><div class="grid-container"><div class="footer-recent-posts"><h2>最近文章</h2><ol><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ol><a href="/archives">所有文章</a></div><div><h2>分类与标签</h2><div class="footer-taxonomies"><% (categories.stack||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><% (tags.stack||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div><h2>站点</h2><div class="footer-taxonomies"><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></div></div><div class="footer-info-text"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/urjaacharya/redgood">Redgood</a> · Urja Acharya</p></div><a class="to-top" href="#main">↑ 返回顶部</a></div></footer></body></html>