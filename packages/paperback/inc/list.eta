<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div><p><%= archive.excerpt(300) %></p><footer><a href="<%= archive.permalink %>">继续阅读</a></footer></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>