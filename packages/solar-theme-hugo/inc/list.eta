<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="post entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-content"><p><%= archive.excerpt(400) %></p></div><p class="meta">Posted on <time><%= archive.date('YYYY-MM-DD') %></time></p></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>