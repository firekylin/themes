{
  "name": "solar-theme-hugo",
  "title": "Solar",
  "version": "0.1.0",
  "private": true,
  "description": "Solar’s Solarized palettes, narrow reading column, left navigation and dated summary feed.",
  "license": "GPL-2.0-or-later",
  "author": "bake; Firekylin contributors",
  "homepage": "https://github.com/bake/solar-theme-hugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/solar-theme-hugo"
  },
  "firekylin": {
    "type": "theme",
    "id": "solar-theme-hugo"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "select",
      "name": "scheme",
      "label": "配色",
      "default": "dark",
      "options": [
        {
          "label": "dark",
          "value": "dark"
        },
        {
          "label": "light",
          "value": "light"
        },
        {
          "label": "gray",
          "value": "gray"
        },
        {
          "label": "preference",
          "value": "preference"
        }
      ]
    }
  ]
}
