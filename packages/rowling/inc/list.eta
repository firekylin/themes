<% const archive=firekylin.archive;let count=0; %><div class="posts native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><figure class="post-image"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><header class="post-header"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p></header></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>