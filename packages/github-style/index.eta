<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="intro-box"><h1><%= archive.archiveTitle||site.title() %></h1><% if(!archive.archiveTitle){ %><p><%= site.description() %></p><% } %></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>