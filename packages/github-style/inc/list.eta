<% const archive=firekylin.archive;let count=0; %><div class="repo-cards"><% while(archive.next()){count++; %><article class="entry Box"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(180) %></p><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>