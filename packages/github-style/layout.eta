<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="Header"><a class="Header-link" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button class="theme-toggle" type="button" aria-pressed="false" hidden>切换为深色</button></header><div class="native-grid"><aside class="profile"><% const avatar=String(cfg.profileImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="profile-avatar" src="<%= avatar %>" alt="<%= site.title() %>"><% } %><h1><a href="/"><%= site.title() %></a></h1><p class="profile-author"><%= cfg.authorName||site.title() %></p><p><%= site.description() %></p><% if(cfg.location){ %><p class="profile-location"><%= cfg.location %></p><% } %></aside><main id="main" class="native-main"><div class="profile-tab"><a href="/">文章</a> · <a href="/archives">归档</a></div><%~ block('content') %></main></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/MeiK2333/github-style">GitHub Style</a></p></footer></body></html>