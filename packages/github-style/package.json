{
  "name": "github-style",
  "title": "GitHub Style",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Style’s profile sidebar, repository cards, file-panel articles and native light/dark preferences.",
  "license": "MIT",
  "author": "MeiK2333; Firekylin contributors",
  "homepage": "https://github.com/MeiK2333/github-style",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/github-style"
  },
  "firekylin": {
    "type": "theme",
    "id": "github-style"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "profileImage",
      "label": "头像地址",
      "help": "HTTP(S) 或站内绝对路径；留空不显示。"
    },
    {
      "type": "text",
      "name": "location",
      "label": "所在地",
      "help": "可选纯文本。"
    }
  ]
}
