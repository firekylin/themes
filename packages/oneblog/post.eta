<% const a=await firekylin.widget('Widget_Archive',{type:firekylin.kind||'post'});a.next();const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const cover=a.row.featuredImage||a.row.fields?.thumb||''; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.title(),detail:true}) %><% if(cover){ %><div class="post_thumb"><div class="post_bg" style="background-image:url(<%= JSON.stringify(cover) %>)"></div><div class="pc"><div class="post_header padding"><button class="pc oneblog-post-menu" data-menu aria-label="打开导航">☰</button><%~ a.category(' · ') %><h1><%= a.title() %></h1><div class="post_meta"><span><%= a.date('YYYY.MM.DD') %></span><span><%= a.commentsNum('%d') %> 评论</span></div></div></div></div><div class="m"><div class="category"><%~ a.category(',') %></div><div class="post_info"><h1><%= a.title() %></h1><span><%= a.date('YYYY.MM.DD') %></span></div></div><% }else{ %><div class="post_nothumb"><button class="pc oneblog-post-menu" data-menu aria-label="打开导航">☰</button><div class="breadcrumb"><li><a href="/">首页</a><span>&gt;</span></li><li>正文</li></div><h1><%= a.title() %></h1><div class="post_meta"><span><%= a.date('YYYY年MM月DD日') %></span><span><%= a.commentsNum('%d') %> 评论</span></div></div><% } %><article class="post_content padding"><%~ a.content() %><% if(c.copyrightText){ %><div class="cc-say"><%= c.copyrightText %></div><% } %><div class="tags"><%~ a.tags('',true,'') %></div></article><%~ firekylin.comment({title:'评论'}) %><%~ await includeAsync('./inc/footer',firekylin) %>