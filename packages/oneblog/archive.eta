<% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'归档'}) %><section class="padding oneblog-archives"><% Object.entries(a.grouped).forEach(([month,posts])=>{ %><h2 id="month-<%= month %>"><%= month %></h2><% posts.forEach(p=>{ %><p><span><%= String(p.create_time).slice(5,10) %></span> <a href="<%= a.permalinkFor(p) %>"><%= p.title %></a></p><% }) }) %></section><%~ await includeAsync('./inc/footer',firekylin) %>