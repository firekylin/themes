<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{}; %></main><footer class="footer pc"><div class="navigation"><a href="/">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }) %><a href="/archives">归档</a><a href="/rss.html">RSS</a></div><div class="copyright">© <%= c.Webtime?c.Webtime+' - ':'' %><%= new Date().getFullYear() %> <%= site.title() %><br><% if(c.ICP){ %><a href="https://beian.miit.gov.cn"><%= c.ICP %></a><br><% } %>Theme by <a href="https://023.me">彼岸临窗</a> · <a href="https://oneblog.023.me">OneBlog</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a><div class="switch"><button data-night aria-pressed="false">夜间模式</button></div></div><div class="contact"><% if(c.Email){ %><a href="mailto:<%= c.Email %>">Email</a><% } if(/^https?:/.test(c.Github||'')){ %><a href="<%= c.Github %>">GitHub</a><% } %></div></footer></div><button id="gototop" aria-label="返回顶部">↑</button><dialog id="oneblog-lightbox"><button id="lightbox-close" aria-label="关闭图片">×</button><img alt=""></dialog><script src="<%= site.themeUrl('res/port.js') %>" defer></script></body></html>