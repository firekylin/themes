<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const tags=await firekylin.widget('Widget_Metas_Tag_Cloud',{ignoreZeroCount:true}); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= firekylin.pageTitle?firekylin.pageTitle+' - ':'' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/main.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/m.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>"><style>:root{--theme-color:<%= String(c.themeColor||'#ff5050').replace(/[<>;{}]/g,'') %>;--oneblog-font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}body{font-family:var(--oneblog-font-family)}<%~ c.customCSS||'' %></style></head><body data-auto-night="<%= c.AutoNightMode||'off' %>"><div id="main"><main class="main"><nav class="menu" id="oneblog-menu" aria-label="导航" tabindex="-1" inert><button class="close" id="close-menu" aria-label="关闭导航">×</button><li><a href="/">首页</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }) %><li><a href="/archives">归档</a></li><li><button data-search>搜索</button></li><li><button data-night aria-pressed="false">夜间模式</button></li><div class="copyright m">Theme by <a href="https://023.me">彼岸临窗</a> · <a href="https://oneblog.023.me">OneBlog</a></div></nav><header class="header bg-white <%= firekylin.detail?'m':'' %>"><button id="menu-toggle" aria-controls="oneblog-menu" aria-expanded="false" aria-label="打开导航">☰</button><% if(c.logoStyle==='image'&&c.logo){ %><a class="logo" href="/" aria-label="<%= site.title() %>" data-light="<%= c.logo %>" data-dark="<%= c.logoWhite||c.logo %>" style="background-image:url(<%= JSON.stringify(c.logo) %>)"></a><% }else{ %><h1><a href="/"><%= site.title() %></a><span class="soul"><span class="pc">生活志</span><span class="m">博客</span></span></h1><% } %><button class="m" data-search aria-label="打开搜索">⌕</button></header><section class="search-layer" id="search-layer" inert aria-label="搜索"><button class="close-search" aria-label="关闭搜索">×</button><div class="search"><h5 class="pc">搜索</h5><form action="/search.html" role="search"><input type="search" name="keyword" class="input" placeholder="输入关键字搜索" aria-label="搜索关键词" required><button type="submit" class="search-icon">搜索</button></form></div><div class="tagscloud pc"><h5>标签</h5><% while(tags.next()){ %><a href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a><% } %></div></section><% if(!firekylin.detail){ %><div class="one pc">“ <%= firekylin.pageTitle||c.slogan||site.description() %> ”</div><% } %>