<% const a=firekylin.archive; %><div id="posts"><% while(a.next()){const cover=a.row.featuredImage||a.row.fields?.thumb||''; %><a href="<%= a.permalink %>" class="post"><h1><%= a.title() %></h1><div class="post_preview"><p><%= a.excerpt(80) %></p><% if(cover){ %><div class="post_img" style="background-image:url(<%= JSON.stringify(cover) %>)"></div><% } %></div><div class="post_meta"><span><%= a.date('YYYY-MM-DD') %></span><span><%= a.commentsNum('%d') %> 评论</span></div></a><% } %></div><div class="load" id="loadmore"><% if(a.pagination.currentPage<a.pagination.totalPages){ %><a href="<%= a.pageUrl(a.pagination.currentPage+1) %>">点击查看更多</a><% } %></div>