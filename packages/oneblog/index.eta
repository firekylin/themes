<% const a=await firekylin.widget('Widget_Archive',{type:'index'});const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{}; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.archiveTitle}) %><% if(c.switch==='on'&&firekylin.ctx.path==='/'){const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:50});const ids=String(c.bannerIds||'').split(',').map(Number);const rows=recent.toArray().filter(x=>ids.includes(x.id)).slice(0,3);if(rows.length){ %><section class="banner-container" aria-label="精选文章"><div class="banner"><% rows.forEach((row,i)=>{ %><a class="oneblog-feature" href="<%= a.permalinkFor(row) %>"><div class="banner-thumb" style="background-image:url(<%= JSON.stringify(row.featuredImage||row.fields?.thumb||'') %>)"><div class="banner-title"><h1><%= row.title %></h1></div></div></a><% }) %></div></section><% }} %><%~ await includeAsync('./inc/list',{...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>