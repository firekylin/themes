<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><div class="date">发布于 <time><%= archive.date('YYYY-MM-DD') %></time></div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div></div><div class="entry-content"><p><%= archive.excerpt(280) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>