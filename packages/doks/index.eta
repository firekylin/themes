<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="landing"><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="hero"><h1><%= site.themeConfig.introTitle||site.title() %></h1><p><%= site.themeConfig.introText||site.description() %></p><a class="btn" href="#latest">开始阅读 →</a></section><% }else{ %><h1 class="list-title"><%= archive.archiveTitle||'文章' %></h1><% } %><section class="blog-list" id="latest"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section></div><% }) %>