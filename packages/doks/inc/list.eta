<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="card entry"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="post-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="card-body"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= String(archive.row.summary||'').replace(/<[^>]*>/g,'').slice(0,230) %></p><div class="meta"><%= archive.date('YYYY-MM-DD') %></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>