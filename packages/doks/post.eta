<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="blog-single"><% if(found){ %><header class="blog-header"><h1><%= archive.title() %></h1><p class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p></header><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="single-cover" src="<%= cover %>" alt=""><% } %><div class="prose" id="post-content"><%~ archive.content() %></div><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>