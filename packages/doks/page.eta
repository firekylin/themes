<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next();const categories=await firekylin.widget('Widget_Metas_Category_List');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:10}); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><div class="doc-layout"><details class="docs-sidebar" open><summary>文档导航</summary><nav aria-label="内容导航"><h2>页面</h2><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><h2>分类</h2><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %></a><% } %><h2>最新文章</h2><% while(recent.next()){ %><a href="<%= recent.permalink %>"><%= recent.title() %></a><% } %></nav></details><article class="docs-content"><% if(found){ %><nav class="breadcrumb"><a href="/">首页</a> / <%= archive.title() %></nav><h1><%= archive.title() %></h1><div class="prose" id="post-content"><%~ archive.content() %></div><%~ firekylin.comment({title:'评论'}) %><% } %></article><details class="docs-toc" id="doks-toc" hidden open><summary>本页目录</summary><nav aria-label="文章目录"></nav></details></div><% }) %>