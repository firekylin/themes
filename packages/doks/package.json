    },
    {
      "type": "text",
      "name": "introText",
      "label": "首页介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，可留空。"
    }
  ]
