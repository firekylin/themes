{
  "name": "doks",
  "title": "Doks",
  "version": "0.1.0",
  "private": true,
  "description": "Doks landing, documentation and blog layouts for Firekylin.",
  "license": "MIT",
  "author": "Thulite; Gridsome; Firekylin contributors",
  "homepage": "https://github.com/thuliteio/doks",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/doks"
  },
  "firekylin": {
    "type": "theme",
    "id": "doks"
  },
  "engines": {
    "firekylin": ">=2.17.1"
