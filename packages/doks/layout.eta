<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar"><div class="container nav-inner"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a><a href="/categories">分类</a></nav></details><div class="actions"><a href="/search.html" aria-label="搜索文章">⌕</a><button id="theme-toggle" hidden aria-label="切换明暗模式" aria-pressed="false">◐</button></div></div></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><div class="container"><p><%= site.themeConfig.footerText||site.title() %></p><p><a href="https://github.com/thuliteio/doks">Doks</a> · Thulite · Firekylin</p><a href="/rss.html">RSS</a></div></footer></body></html>