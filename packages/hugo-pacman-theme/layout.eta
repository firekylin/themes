<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header><div><div id="textlogo"><h1 class="site-name"><a href="/"><%= site.title() %></a></h1><h2 class="blog-motto"><%= site.description() %></h2></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="sidebar-toggle" class="sidebar-control" aria-controls="asidepart" aria-expanded="true" hidden>隐藏侧边栏</button></div></header><div id="container"><main id="main"><%~ block('content') %></main><div id="asidepart"><aside><section class="categorieslist"><h2>分类</h2><ul><% let nc=0;while(categories.next()){nc++; %><li><a href="<%= categories.permalink %>"><span><%= categories.row.name %></span><span><%= categories.row.count %></span></a></li><% }if(!nc){ %><li class="sidebar-empty">暂无分类</li><% } %></ul></section><section class="tagslist"><h2>标签</h2><ul><% let nt=0;while(tags.next()){nt++; %><li><a href="<%= tags.permalink %>"><%= tags.row.name %></a></li><% }if(!nt){ %><li class="sidebar-empty">暂无标签</li><% } %></ul></section></aside></div></div><footer class="native-footer"><div id="footer"><% const avatar=String(cfg.avatarURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="author" src="<%= avatar %>" alt=""><% } %><div class="footer-copy"><p class="footer-description"><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/coderzh/hugo-pacman-theme">Pacman</a> · coderzh / Yang Jian</p></div></div></footer></body></html>