<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><section class="post entry"><a href="<%= archive.permalink %>"><h1><%= archive.title() %></h1><p><%= archive.excerpt(280) %></p><time><%= archive.date('YYYY/MM/DD') %></time></a></section><% }if(!count){ %><p>暂无文章。</p><% } %>