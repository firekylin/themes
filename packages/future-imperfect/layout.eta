<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header id="header"><h1><a href="/"><%= site.title() %></a></h1><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><div id="wrapper"><main id="main" class="native-main"><%~ block('content') %></main><aside id="sidebar"><section id="intro"><header><h2><a href="/"><%= site.title() %></a></h2><p><%= site.description() %></p></header></section><section class="recent-posts"><h3>最新文章</h3><div class="mini-posts"><% while(recent.next()){ %><article class="mini-post"><header><h3><a href="<%= recent.permalink %>"><%= recent.title() %></a></h3><time class="published"><%= recent.date('YYYY-MM-DD') %></time></header></article><% } %></div></section><footer class="native-footer"><p><%= cfg.footerText||site.description() %><br><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin</p><p>Design: <a href="https://html5up.net/future-imperfect">Future Imperfect by HTML5 UP</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a><br><a href="https://github.com/jpescador/hugo-future-imperfect">Hugo port: Julio Pescador</a><br>Modified for Firekylin</p></footer></aside></div></body></html>