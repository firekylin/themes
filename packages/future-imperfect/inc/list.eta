<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><header><div class="title"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></div><div class="meta"><time class="published"><%= archive.date('YYYY-MM-DD') %></time><p><%= archive.author('display_name') %></p></div></header><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a href="<%= archive.permalink %>" class="image featured"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><p><%= archive.excerpt(300) %></p><footer><a class="button big" href="<%= archive.permalink %>">继续阅读</a></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>