<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'post'}),found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(found){ %><div class="details"><article class="article"><nav class="breadcrumb-box" aria-label="面包屑"><ol class="breadcrumb"><li><a href="/">首页</a></li><% for(const cat of archive.row.cate||[]){ %><li><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a></li><% } %><li>正文</li></ol></nav><header class="header"><h1 class="title"><%= archive.title() %></h1><div class="meta"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %><span class="kratos-reading-time" hidden></span></div></header><details class="kratos-toc" open hidden><summary>文章目录</summary><ol></ol></details><div class="content entry-content" id="lightgallery"><%~ archive.content() %></div><footer class="kratos-tags"><% for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>">#<%= tag.name %></a> <% } %></footer></article></div><%~ firekylin.comment({title:'评论',className:'kratos-comments'}) %><% } else { %><p class="kratos-panel empty">内容不存在</p><% } %><% }); %>
