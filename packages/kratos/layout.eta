<% /* Kratos 4.3.4 header.php/index.php/sidebar composition. */
const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'';
const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}),cats=await firekylin.widget('Widget_Metas_Category_List'),tags=await firekylin.widget('Widget_Metas_Tag_Cloud');
const mode=['auto','dark'].includes(c.colorMode)?c.colorMode:'light',accent=/^#[a-f0-9]{6}$/i.test(c.accentColor||'')?c.accentColor:'#00a2ff';
%><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>:root{--kratos-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/kratos.js') %>"></script></head><body class="fk-theme <%= mode==='dark'?'fk-dark dark':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="k-header"><nav class="k-nav"><div class="container"><a class="navbar-brand" href="/"><h1><%= site.title() %></h1></a><div class="k-navigation"><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></div><details class="k-mobile-menu"><summary>菜单</summary><div><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></div></details></div></nav><% if(c.showBanner!=='false'){ %><div class="banner"><div class="content text-center"><% if(safe(c.coverImage)){ %><img class="k-cover" src="<%= safe(c.coverImage) %>" alt=""><% } %><div class="overlay"></div><div class="introduce"><div class="title"><%= c.bannerTitle||site.title() %></div><div class="mate"><%= c.heroText||site.description() %></div></div></div></div><% } %></header>
<div class="k-main <%= c.showBanner==='false'?'color':'banner' %>"><div class="container"><div class="row"><main id="main" class="col-lg-8 board"><%~ block('content') %></main><aside class="col-lg-4 sidebar"><section class="k-widget k-profile"><div class="k-profile-cover"><% if(safe(c.profileCover)){ %><img src="<%= safe(c.profileCover) %>" alt=""><% } %></div><% if(safe(c.avatarUrl)){ %><img class="k-avatar" src="<%= safe(c.avatarUrl) %>" alt="站点头像"><% } else { %><div class="k-avatar k-avatar-placeholder"><%= Array.from(site.title())[0] %></div><% } %><h2><%= c.profileName||site.title() %></h2><p><%= c.profileText||site.description() %></p></section><section class="k-widget"><h2>最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="k-widget"><h2>标签聚合</h2><div class="k-tags"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.title() %></a><% } %></div></section><section class="k-widget"><h2>分类</h2><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.title() %></a></li><% } %></ul></section></aside></div></div></div><footer class="k-footer"><%= c.footerText||site.title() %><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/seatonjiang/kratos">Kratos</a> by Seaton Jiang · <a href="/rss.html">RSS</a></p></footer><div class="k-tools"><button type="button" data-mode-toggle hidden aria-label="切换配色">◐</button><a href="#main" aria-label="返回正文顶部">↑</a></div><dialog class="kratos-lightbox" aria-label="图片预览"><button data-close type="button">关闭</button><img alt=""></dialog><progress class="kratos-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
