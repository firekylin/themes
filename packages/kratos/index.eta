<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %>
<% if(c.showCarousel==='true'&&archive.is('index')&&archive.stack.length){ %><section class="article-carousel k-carousel" aria-label="文章轮播"><% for(const [i,row] of archive.stack.slice(0,3).entries()){const image=safe(row.featuredImage||row.options?.featuredImage||c.defaultThumbnail); %><article class="k-slide" data-slide="<%= i %>"><a href="<%= archive.permalinkFor(row) %>"><% if(image){ %><img src="<%= image %>" alt=""><% } %><h2><%= row.title %></h2></a></article><% } %><div class="k-carousel-controls" hidden><button type="button" data-prev aria-label="上一篇">←</button><span aria-live="polite" data-slide-count></span><button type="button" data-next aria-label="下一篇">→</button></div></section><% } %>
<% if(archive.archiveTitle){ %><h1 class="kratos-panel"><%= archive.archiveTitle %></h1><% } if(!archive.have()){ %><p class="kratos-panel empty">暂无文章</p><% } while(archive.next()){const image=safe(archive.row.featuredImage||archive.row.options?.featuredImage||c.defaultThumbnail),thumb=c.showThumbnails!=='false'&&image; %><article class="article-panel"><% if(thumb){ %><div class="a-thumb"><a href="<%= archive.permalink %>"><img src="<%= image %>" alt="" loading="lazy"></a></div><% } %><div class="a-post <%= thumb?'':'a-none' %>"><header class="header"><% if(archive.row.cate?.length){const cat=archive.row.cate[0]; %><a class="label" href="/cate/<%= cat.pathname %>"><%= cat.name %><i class="label-arrow"></i></a><% } %><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="content"><p><%= archive.excerpt(260) %></p></div></div><footer class="a-meta"><span><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %><% if(archive.row.comment_num!=null){ %> · <a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 条评论</a><% } %></span><a class="k-read" href="<%= archive.permalink %>">阅读全文 ›</a></footer></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
