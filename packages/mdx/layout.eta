<% const site=await firekylin.widget('Widget_Options');const heading=block('heading');const cover=String(site.themeConfig.coverUrl||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转到正文</a><header class="toolbar"><details id="sidebar"><summary aria-label="切换侧栏菜单">☰</summary><div class="drawer"><h2><%= site.title() %></h2><nav class="sidebar-links" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/rss.html">RSS</a></nav><button id="theme-toggle" hidden>切换明暗模式</button></div></details><a class="brand" href="/"><%= site.title() %></a><a class="search-icon" href="#search-panel" aria-label="打开搜索">⌕</a></header><section id="search-panel"><a href="#main">关闭 ×</a><form action="/search.html" method="get"><label for="header-search">搜索</label><input id="header-search" name="keyword" required placeholder="搜索文章"><button>搜索</button></form></section><section class="hero"><% if(!heading&&/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img src="<%= cover %>" alt=""><% } %><% if(heading){ %><%~ heading %><% }else{ %><h1><%= site.themeConfig.heroText||site.description()||site.title() %></h1><% } %></section><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= site.themeConfig.footerText||site.title() %></p><a href="https://github.com/yrccondor/mdx">MDx</a> · Firekylin</footer><a class="back-top" href="#top" aria-label="返回顶部">↑</a><progress id="read-progress" max="100" value="0" hidden aria-label="阅读进度"></progress></body></html>