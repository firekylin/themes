<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||'');const hasCover=/^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="entry"><div class="card-media<%= hasCover?' has-image':'' %>"><% if(hasCover){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><div class="card-primary"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(hasCover?120:250) %></div></div></div><footer class="card-actions"><time><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>">去围观</a></footer></article><% }if(!count){ %><p>暂无文章。</p><% } %>