<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('hero',()=>{ %><% if(found){ %><header class="post-hero"><div class="taxonomies"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"># <%= t.name %></a> <% }); %></div><h1><%= archive.title() %></h1><div class="post-meta"><span class="mini-gem" aria-hidden="true"></span><%= archive.author('display_name') %> · <time><%= archive.date('YYYY-MM-DD') %></time></div></header><% } %><% }) %><% block('content',()=>{ %><article class="post-html"><% if(found){ %><div class="prose" id="post-content"><%~ archive.content() %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>