<% const archive=firekylin.archive;let count=0;const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><div class="article-grid"><% while(archive.next()){const lead=firekylin.lead&&count===0;count++;const cover=(archive.row.options||{}).featuredImage; %><article class="article-card <%= lead?'lead':'' %>"><% if(safe(cover)){ %><a class="post-image" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a><% }else{ %><div class="post-image placeholder" aria-hidden="true"></div><% } %><div class="card-content"><div class="card-label"><%= lead?'最新文章':'文章' %></div><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(180) %></div><div class="card-meta"><span class="mini-gem" aria-hidden="true"></span><span><%= archive.author('display_name') %></span><time><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% } %></div><% if(!count){ %><p class="empty">暂无文章。</p><% } %>