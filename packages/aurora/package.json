{
  "name": "aurora",
  "title": "Aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora gradient magazine layout adapted to native Firekylin pages.",
  "license": "MIT",
  "author": "Auroral-UI (Benny Guo); Firekylin contributors",
  "homepage": "https://github.com/auroral-ui/hexo-theme-aurora",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/aurora"
  },
  "firekylin": {
    "type": "theme",
    "id": "aurora"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "资料头像",
      "help": "HTTP(S) 或站内绝对路径。"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "资料名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "资料简介",
      "help": "留空使用站点描述。"
    }
  ]
}
