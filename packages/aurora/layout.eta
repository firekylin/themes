<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="brand" href="/"><span class="gem" aria-hidden="true"></span><%= site.title() %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details><a class="search-link" href="/search.html" aria-label="搜索">⌕</a><button id="color-toggle" aria-label="切换明暗主题" aria-pressed="false" hidden>☾</button></div></header><div class="site-container"><%~ block('hero') %><div class="columns"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section class="profile"><div class="profile-inner"><% if(safe(site.themeConfig.avatarUrl)){ %><img class="avatar" src="<%= site.themeConfig.avatarUrl %>" alt=""><% }else{ %><span class="avatar gem" aria-hidden="true"></span><% } %><h2><%= site.themeConfig.profileName||site.title() %></h2><span class="accent-line"></span><p><%= site.themeConfig.profileBio||site.description() %></p><a href="/rss.html">RSS</a></div></section><section class="widget"><h2>最新文章</h2><span class="accent-line"></span><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a><time><%= recent.date('YYYY-MM-DD') %></time></li><% } %></ul></section><nav id="aurora-toc" class="widget" aria-label="文章目录" hidden><h2>目录</h2><span class="accent-line"></span></nav></aside></div></div><footer>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/auroral-ui/hexo-theme-aurora">Aurora</a> by Auroral-UI · <a href="https://github.com/firekylin/firekylin">Firekylin</a></footer></body></html>