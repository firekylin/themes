<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categories=await firekylin.widget('Widget_Metas_Category_List');const lead=!archive.archiveTitle&&archive.pagination?.currentPage===1; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><nav class="category-bar" aria-label="文章分类"><a class="all" href="/">全部</a><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %></a><% } %></nav><%~ include('./inc/list',{archive,lead}) %><%~ include('./inc/pagination',{archive}) %><% }) %>