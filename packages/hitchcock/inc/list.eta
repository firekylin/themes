<% const archive=firekylin.archive;let count=0; %><div class="posts group native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><a class="post entry" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="post-overlay"><div class="archive-post-header"><p class="archive-post-date"><time><%= archive.date('YYYY-MM-DD') %></time></p><h2 class="archive-post-title"><%= archive.title() %></h2></div></div></a><% }if(!count){ %><p>暂无文章。</p><% } %></div>