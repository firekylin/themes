<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %><% block('cover',()=>{const cfg=site.themeConfig; %><section class="cover"><h1><%= cfg.coverTitle||site.title() %></h1><p><%= cfg.coverSubtitle||site.description() %></p><div class="banner-bottom"><a class="scroll-down" href="#content" aria-label="向下浏览文章">↓</a><nav aria-label="快捷导航"><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></section><% }) %>