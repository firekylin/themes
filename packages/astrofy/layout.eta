<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-theme="lofi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><div class="native-shell bg-base-100"><aside class="native-sidebar bg-base-200 text-base-content"><h1 class="text-2xl font-bold"><a href="/"><%= site.title() %></a></h1><p class="py-4"><%= site.description() %></p><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></aside><main id="main" class="native-main p-6 pt-10"><%~ block("content") %></main></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/manuelernestog/astrofy">Astrofy</a> by Manuel Ernesto Garcia</footer></body></html>