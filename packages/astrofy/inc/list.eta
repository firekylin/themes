<% const archive=firekylin.archive;let count=0; %><div class="flex flex-col gap-6"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out entry"><a href="<%= archive.permalink %>"><div class="hero-content flex-col md:flex-row"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="grow w-full"><h2 class="text-xl font-bold"><%= archive.title() %></h2><p class="py-1"><%= archive.excerpt(200) %></p><div class="text-sm"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></div></a></div><% }if(!count){ %><p>暂无文章。</p><% } %></div>