<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="entry"><a href="<%= archive.permalink %>" class="image fit"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="button">阅读全文 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %></section>