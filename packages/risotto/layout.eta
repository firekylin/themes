<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="page"><header class="page__header"><nav class="page__nav main-nav" aria-label="主导航"><ul class="nav-items"><li class="nomarker"><h1 class="page__logo"><a href="/" class="page__logo-inner"><%= site.title() %></a></h1></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav></header><main class="page__body" id="main"><%~ block('content') %></main><aside class="page__aside"><div class="aside__about"><h1 class="about__title"><%= cfg.authorName||site.title() %></h1><p class="about__description"><%= site.description() %></p></div><hr><div class="aside__content"><nav id="toc" aria-label="文章目录" hidden><p>本文目录</p><ul class="toc-list"></ul></nav></div></aside><footer class="page__footer"><p><%= cfg.footerText||site.description() %></p><a href="https://github.com/joeroe/risotto">Risotto</a> by Joe Roe · Firekylin</footer></div></body></html>