<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="post__thumbnail-wrapper"><a href="<%= archive.permalink %>"><img class="post__thumbnail" src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><div class="post__content"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(260) %></p></div><div class="post__footer"><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% } %><% if(!count){ %><p class="post">暂无文章。</p><% } %>