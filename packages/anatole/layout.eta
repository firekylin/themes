<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" class="html theme--light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body class="body"><a class="skip" href="#main">跳转到正文</a><div class="wrapper"><aside class="wrapper__sidebar"><div class="sidebar"><div class="sidebar__content"><div class="sidebar__introduction"><% const avatar=String(cfg.profileImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="sidebar__introduction-profileimage" src="<%= avatar %>" alt="<%= site.title() %>"><% } %><div class="sidebar__introduction-title"><a href="/"><%= site.title() %></a></div><div class="sidebar__introduction-description"><p><%= site.description() %></p></div></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/lxndrblz/anatole">Anatole</a></p></footer></div></aside><main id="main" class="wrapper__main"><header class="header"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button class="themeswitch" type="button" aria-pressed="false" hidden>切换为深色</button></header><%~ block('content') %></main></div></body></html>