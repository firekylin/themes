<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="navbar"><div class="container"><div class="flex"><a class="brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="dark-mode-button" type="button" aria-pressed="false" hidden>切换为深色</button></div></div></div><main id="main" class="container"><%~ block('content') %></main><footer class="native-footer container"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/WingLim/hugo-tania">Tania</a> · Design by <a href="https://www.taniarascia.com/">Tania Rascia</a></p></footer></body></html>