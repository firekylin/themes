<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry w-100 mb4 relative bg-white"><div class="pa4 gray"><time class="f6 db"><%= archive.date('YYYY-MM-DD') %></time><h2 class="f3 near-black"><a class="link black dim" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="nested-links f5 lh-copy"><p><%= archive.excerpt(240) %></p></div><a class="ba b--moon-gray bg-light-gray br2 color-inherit dib f7 link mt2 ph2 pv1" href="<%= archive.permalink %>">阅读全文</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>