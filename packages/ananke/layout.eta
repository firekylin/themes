<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="ma0 avenir bg-near-white"><a class="skip" href="#main">跳转到正文</a><header class="bg-black white-80"><div class="ph3 ph5-l pv3"><a class="f3 link white" href="/"><%= site.title() %></a><nav class="nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><div class="tc-l pv4 ph3 ph4-ns"><h1 class="f2 f-subheadline-l fw2 light-silver mb0 lh-title"><%= site.title() %></h1><h2 class="fw1 f5 f3-l white-80 measure-wide-l center lh-copy mt3 mb4"><%= site.description() %></h2></div></header><main id="main" class="mw8 center ph3 ph5-ns pv4"><%~ block('content') %></main><footer class="bg-black white-70 ph3 ph5-l pv4"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/gohugo-ananke/ananke">Ananke</a> by Bud Parr and Patrick Kollitsch</footer></body></html>