<% const archive=firekylin.archive;let count=0; %><div class="native-cards"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post-card card card-body p-0 border-0 surface entry"><a class="post-img" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><a class="post-title" href="<%= archive.permalink %>"><%= archive.title() %></a><div class="post-meta mb-0"><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>