<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-bs-theme="light" data-palette="blue"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><header class="top-app-bar"><div class="container native-heading"><a class="navbar-brand" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="container native-shell"><main id="main" class="native-main"><%~ block("content") %></main><aside class="native-sidebar surface"><h2><%= cfg.authorName||site.title() %></h2><p><%= site.description() %></p></aside></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/razonyang/hugo-theme-bootstrap">Hugo Bootstrap</a> by Razon Yang</footer></body></html>