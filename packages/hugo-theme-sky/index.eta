<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const archive=await firekylin.widget('Widget_Archive',{type:'index'});const avatar=String(cfg.avatarUrl||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="profile-panel panel panel-default"><div class="panel-body text-center"><% if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="profile-avatar" src="<%= avatar %>" alt=""><% } %><h1><%= cfg.profileName||site.title() %></h1><p><%= cfg.tagline||site.description() %></p><% if(cfg.location){ %><p><%= cfg.location %></p><% } %><p class="description"><%= cfg.about||site.description() %></p></div><div class="panel-footer text-center"><a href="/archives">所有文章</a> · <a href="/search.html">搜索</a></div></section><% } %><header class="page-heading"><h1 class="page-title"><%= archive.archiveTitle||'Blog' %></h1></header><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>