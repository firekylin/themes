<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a><time class="badge pull-right"><%= archive.date('YYYY-MM-DD') %></time></h2><p class="post-description"><%= archive.excerpt(260) %></p><a class="readmore" href="<%= archive.permalink %>">Read more »</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>