<% const archive=firekylin.archive;let count=0,last=''; %><ul class="list control"><% while(archive.next()){count++;const month=archive.date('YYYY-MM');if(month!==last){ %><li class="group-date"><h2><%= month %></h2></li><% last=month;} %><li class="item entry"><h3 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="item-meta"><%= archive.date('MM-DD') %></div></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>