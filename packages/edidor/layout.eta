<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body class="loaded light-mode"><a class="skip" href="#main">跳转到正文</a><header class="header"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div class="theme-tools" hidden><button data-mode="light">浅色</button><button data-mode="dark">深色</button><button data-mode="wild">随机配色</button></div></header><div class="middle"><aside class="sidebar"><a class="taxonomy-key" href="/"><%= site.title() %></a><p class="taxonomy-key">近期文章</p><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:12});while(recent.next()){ %><a href="<%= recent.permalink %>"><%= recent.title() %></a><% } %></aside><main id="main" class="main"><%~ block('content') %></main></div><footer class="footer"><span><%= cfg.footerText||site.description() %></span><span><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/jacobsun/edidor">Edidor</a></span></footer></body></html>