{
  "name": "cuckoo",
  "title": "Cuckoo",
  "version": "0.1.0",
  "private": true,
  "description": "Material-inspired raised cards, pink accents and a compact sidebar.",
  "license": "GPL-3.0-only",
  "author": "Bhao",
  "homepage": "https://github.com/bhaoo/Cuckoo",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/cuckoo"
  },
  "firekylin": {
    "type": "theme",
    "id": "cuckoo"
  },
  "engines": {
    "firekylin": ">=2.16.0"
  },
  "configElements": [
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，不支持 HTML。"
    },
    {
      "type": "text",
      "name": "heroText",
      "label": "站点简介",
      "help": "留空使用站点描述。"
    },
    {
      "type": "color",
      "name": "accentColor",
      "label": "强调色",
      "help": "支持 #RGB 或 #RRGGBB。"
    },
    {
      "type": "text",
      "name": "colorMode",
      "label": "配色模式",
      "help": "填写 dark 启用深色；留空为浅色。"
    },
    {
      "type": "text",
      "name": "sidebarTitle",
      "label": "侧栏标题",
      "help": "留空显示最新文章。"
    },
    {
      "type": "text",
      "name": "bgUrl",
      "label": "页面背景",
      "help": "HTTP(S) 或站内图片路径。"
    },
    {
      "type": "text",
      "name": "logoUrl",
      "label": "头像",
      "help": "站点头像图片。"
    },
    {
      "type": "text",
      "name": "sidebarBg",
      "label": "侧栏封面",
      "help": "个人资料卡片封面。"
    },
    {
      "type": "text",
      "name": "defaultCover",
      "label": "默认文章图片",
      "help": "替代上游随机图；featuredImage 优先。"
    },
    {
      "type": "text",
      "name": "articleStyle",
      "label": "文章样式",
      "help": "normal 为普通卡片，默认图片叠字。"
    }
  ]
}
