<% /* Cuckoo source image-card overlay and normal-card variants. */const archive=firekylin.archive,config=firekylin.site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || ''))?String(value):''; %><div class="fk-feed"><% while(archive.next()) {const cover=safe(archive.row.featuredImage)||safe(config.defaultCover);const normal=(archive.row.fields?.articleType || config.articleStyle)==='normal'; %><article class="entry-card cuckoo-card <%= normal?'cuckoo-normal':'cuckoo-media' %>"><% if(!normal && cover) { %><img class="cuckoo-card-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% if(archive.row.comment_num!=null) { %> | <a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 条评论</a><% } %></p><p class="entry-excerpt"><%= archive.excerpt(100) %></p></div></article><% } %></div>