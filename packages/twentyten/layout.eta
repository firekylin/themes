<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><div id="wrapper" class="hfeed"><header id="header"><div id="masthead"><div id="branding"><h1 id="site-title"><a href="/"><%= site.title() %></a></h1><div id="site-description"><%= site.description() %></div></div><div id="access"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="native-columns"><main id="main" class="native-main"><div id="content"><%~ block('content') %></div></main><aside class="native-sidebar widget-area"><section class="widget"><h3 class="widget-title">关于</h3><p><%= site.description() %></p></section><section class="widget"><h3 class="widget-title">标签</h3><ul><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><li><a href="<%= tags.permalink %>"><%= tags.row.name %></a></li><% } %></ul></section></aside></div><footer class="native-footer"><p><%= cfg.authorName||site.title() %></p><p><%= cfg.footerText||site.description() %></p><a href="https://github.com/WordPress/WordPress">Twenty Ten</a> by WordPress contributors · Firekylin</footer></div></body></html>