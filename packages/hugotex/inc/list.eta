<% const archive=firekylin.archive;let count=0; %><div class="posts-list"><% while(archive.next()){count++; %><article class="post-preview entry"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="postmeta"><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="post-entry"><p><%= archive.excerpt(240) %></p></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>