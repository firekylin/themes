  "version": "0.1.0",
  "private": true,
  "description": "HugoTeX LaTeX typography with Latin Modern, academic abstract, native heading contents and local KaTeX formulas.",
  "license": "MIT",
  "author": "Kaito Sugimoto; Firekylin contributors",
  "homepage": "https://github.com/hugotex-dev/HugoTeX",
  "repository": {
    "type": "git",
