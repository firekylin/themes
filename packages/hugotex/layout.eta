<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/katex.min.css') %>"><script src="<%= site.themeUrl('res/js/katex.min.js') %>" defer></script><script src="<%= site.themeUrl('res/js/auto-render.min.js') %>" defer></script><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body class="latex-dark-auto"><a class="skip" href="#main">跳转到正文</a><header><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div class="site-title"><a href="/"><%= site.title() %></a></div></header><main id="main"><%~ block('content') %></main><footer><p class="theme-by"><%= cfg.footerText||site.description() %><br><span class="footer-author"><%= cfg.authorName||site.title() %></span> · <a href="https://github.com/hugotex-dev/HugoTeX">HugoTeX</a> · Firekylin</p></footer></body></html>