<% const archive=firekylin.archive;let count=0,lastGroup=''; %><ul id="post-list"><% while(archive.next()){count++; %><li class="entry"><div class="post-list-item"><div class="post-header"><h4 class="post-link"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h4><h4 class="post-date"><%= archive.date('YYYY-MM-DD') %></h4></div><div class="post-summary"><p><%= archive.excerpt(300) %></p></div><div class="post-list-footer text-center"><a href="<%= archive.permalink %>">继续阅读</a></div></div></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>