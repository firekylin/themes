<% const archive=firekylin.archive;let count=0; %><div class="bloglist-container"><% while(archive.next()){count++; %><section class="bloglist-table-row entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div></div><p class="description"><%= archive.excerpt(220) %></p><a class="readmore" href="<%= archive.permalink %>">阅读全文 ⟶</a></section><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>