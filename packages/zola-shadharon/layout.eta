<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script>try{const t=localStorage.getItem('shadharon-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header><div class="navbar"><a class="nav-links home-title" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="theme-toggle" class="theme-toggle" aria-label="切换浅色或深色主题" hidden>浅色 / 深色</button></div></header><main id="main" class="content"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/syedzayyan/shadharon">Shadharon</a> · Syed Zayyan Masud</p></footer></body></html>