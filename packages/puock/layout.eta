<% const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'',mode=['dark','auto'].includes(c.colorMode)?c.colorMode:'light';const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}),tags=await firekylin.widget('Widget_Metas_Tag_Cloud'),cats=await firekylin.widget('Widget_Metas_Category_List');const accent=/^#[a-f0-9]{6}$/i.test(c.accentColor||'')?c.accentColor:'#1c60f3'; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>body{--pk-c-primary:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/puock.js') %>"></script></head><body class="fk-theme puock-<%= mode %> <%= mode==='dark'?'fk-dark':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a><div id="header-box"></div><header id="header"><div class="navbar"><div class="container"><a id="logo" class="navbar-brand" href="/"><span class="txt-logo"><%= site.title() %></span></a><nav class="pk-nav"><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></nav><details class="pk-mobile"><summary>菜单</summary><nav><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></nav></details><button type="button" data-mode-toggle hidden aria-label="切换配色">◐</button></div></div></header><div id="content" class="container mt15"><% if(c.heroText){ %><p class="p-block"><%= c.heroText %></p><% } %><div class="pk-grid <%= c.hideSidebar==='true'?'pk-wide':'' %>"><main id="main"><%~ block('content') %></main><aside id="sidebar"><% if(c.announcement){ %><section class="widget p-block"><h2>公告</h2><p><%= c.announcement %></p></section><% } %><section class="widget p-block"><h2>文章搜索</h2><form action="/search.html"><input name="keyword" placeholder="输入关键词" aria-label="搜索关键词"><button type="submit">搜索</button></form></section><section class="widget p-block pk-profile"><div class="pk-profile-cover"><% if(safe(c.profileCover)){ %><img src="<%= safe(c.profileCover) %>" alt=""><% } %></div><% if(safe(c.avatarUrl)){ %><img class="pk-avatar" src="<%= safe(c.avatarUrl) %>" alt="站点头像"><% } %><h2><%= c.profileName||site.title() %></h2><p><%= c.profileText||site.description() %></p></section><section class="widget p-block"><h2>最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="widget p-block"><h2>分类</h2><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.title() %></a></li><% } %></ul></section><section class="widget p-block"><h2>标签</h2><div class="pk-tags"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.title() %></a><% } %></div></section></aside></div></div><footer id="footer"><div class="container"><%= c.footerText||site.title() %><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · Theme <a href="https://github.com/Licoy/wordpress-theme-puock">Puock</a> by Licoy · <a href="/rss.html">RSS</a></p></div></footer><a class="pk-top" href="#main" aria-label="返回正文顶部">↑</a><dialog class="puock-lightbox" aria-label="图片预览"><button data-close type="button">关闭</button><img alt=""></dialog><progress class="puock-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
