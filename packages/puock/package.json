{
  "name": "firekylin-theme-puock",
  "private": true,
  "version": "0.1.0",
  "title": "Puock",
  "description": "Puock 2.11.0 blog list and card layouts",
  "license": "GPL-3.0-only",
  "engines": {
    "firekylin": ">=2.16.0"
  },
  "firekylin": {
    "type": "theme",
    "id": "puock"
  },
  "configElements": [
    {
      "type": "text",
      "name": "postStyle",
      "label": "文章列表",
      "help": "list 或 card（默认）"
    },
    {
      "type": "text",
      "name": "cardColumns",
      "label": "卡片列数",
      "help": "2（默认）、3 或 4"
    },
    {
      "type": "text",
      "name": "hideSidebar",
      "label": "隐藏侧栏",
      "help": "true 或 false（默认）"
    },
    {
      "type": "text",
      "name": "announcement",
      "label": "公告",
      "help": "站点公告"
    },
    {
      "type": "text",
      "name": "showCarousel",
      "label": "首页轮播",
      "help": "true 或 false（默认）；前三篇文章"
    },
    {
      "type": "text",
      "name": "defaultThumbnail",
      "label": "默认缩略图",
      "help": "有权使用的图片 URL"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "个人资料名称",
      "help": "留空使用站点标题"
    },
    {
      "type": "text",
      "name": "profileText",
      "label": "个人资料介绍",
      "help": "留空使用站点描述"
    },
    {
      "type": "text",
      "name": "profileCover",
      "label": "个人资料封面",
      "help": "有权使用的图片 URL"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "个人资料头像",
      "help": "有权使用的图片 URL"
    },
    {
      "type": "text",
      "name": "colorMode",
      "label": "配色模式",
      "help": "light（默认）、dark、auto"
    },
    {
      "type": "text",
      "name": "heroText",
      "label": "顶部介绍",
      "help": "可选文字"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "保留主题来源署名"
    },
    {
      "type": "color",
      "name": "accentColor",
      "label": "强调色"
    }
  ]
}
