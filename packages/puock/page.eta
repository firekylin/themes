<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= archive.title()||'文章' %> · <%= site.title() %><% });block('content',()=>{ %><% if(found){ %><article id="post-main" class="p-block"><h1 id="post-title"><%= archive.title() %></h1><div class="options"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %> <span data-reading-time></span><button type="button" class="pk-expand" hidden aria-pressed="false">展开阅读</button></div><details class="puock-toc" hidden open><summary>文章目录</summary><ol></ol></details><div class="entry-content-box"><div class="entry-content content-main markdown-body"><%~ archive.content()||'' %></div><div class="t-separator c-sub t-sm mt30">正文完</div><div class="pk-tags mt20"><% for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>"><%= tag.name %></a><% } %></div><div class="mt20"><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> <% } %></div></div></article><%~ firekylin.comment({title:'评论',className:'p-block'}) %><% } else { %><p class="p-block empty">内容不存在</p><% } %><% }); %>
