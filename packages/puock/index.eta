<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'',list=c.postStyle==='list',cols=['3','4'].includes(c.cardColumns)?c.cardColumns:'2'; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="p-block"><%= archive.archiveTitle %></h1><% } %>
<% if(c.showCarousel==='true'&&archive.is('index')&&archive.stack.length){ %><section id="index-banners" aria-label="文章轮播"><% for(const [i,row] of archive.stack.slice(0,3).entries()){const image=safe(row.featuredImage||row.options?.featuredImage||c.defaultThumbnail); %><article class="pk-slide" data-slide="<%= i %>"><a href="<%= archive.permalinkFor(row) %>"><% if(image){ %><img src="<%= image %>" alt=""><% } %><h2><%= row.title %></h2></a></article><% } %><div class="pk-carousel-controls" hidden><button type="button" data-prev aria-label="上一篇">←</button><span data-slide-count aria-live="polite"></span><button type="button" data-next aria-label="下一篇">→</button></div></section><% } %>
<div id="posts" class="pk-posts <%= list?'pk-list':'pk-cards pk-cols-'+cols %>"><% if(!archive.have()){ %><p class="p-block empty">暂无文章</p><% } while(archive.next()){const image=safe(archive.row.featuredImage||archive.row.options?.featuredImage||c.defaultThumbnail); %><article class="block card-plain post-item post-item-<%= list?'list p-block':'card' %> <%= image?'':'post-item-no-thumb' %>"><div class="<%= list?'pk-list-inner':'p-block post-item-block' %>"><% if(image){ %><div class="thumbnail"><a href="<%= archive.permalink %>"><img src="<%= image %>" alt="" loading="lazy"></a></div><% } %><div class="post-info"><h2 class="info-title"><% if(archive.row.cate?.length){const cat=archive.row.cate[0]; %><a class="badge bg-primary" href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %> <a class="a-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="info-meta c-sub text-2line"><%= archive.excerpt(180) %></div><footer class="info-footer"><span><%= archive.author('display_name') %><% if(archive.row.comment_num!=null){ %> · <a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a><% } %></span><time><%= archive.date('Y-m-d') %></time></footer></div><% if(list){ %><span class="title-l-c bg-primary"></span><% } %></div></article><% } %></div><%~ include('inc/pagination',{archive}) %><% }); %>
