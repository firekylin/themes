<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="box post entry"><h2 class="title post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-date"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></p><div class="content"><p><%= archive.excerpt(220) %></p><a class="has-text-danger-dark has-text-weight-semibold" href="<%= archive.permalink %>">阅读全文 →</a></div><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>