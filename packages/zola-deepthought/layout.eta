<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar is-light"><div class="container native-navbar"><a class="navbar-item is-size-5 has-text-weight-bold" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换明暗模式">夜间模式</button></div></header><main id="main" class="section"><div class="container"><div class="reading-column"><%~ block('content') %></div></div></main><footer class="footer native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/RatanShreshtha/DeepThought">DeepThought</a></p></footer><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>