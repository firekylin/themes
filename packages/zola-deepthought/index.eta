<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){const cfg=site.themeConfig;const avatar=String(cfg.profileImage||''); %><section class="home-intro has-text-centered"><h1 class="title is-2"><%= site.title() %></h1><p class="subtitle is-4"><%= site.description() %></p><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt=""><% } %></section><% } %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>