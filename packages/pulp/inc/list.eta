<% const archive=firekylin.archive;let count=0,last=''; %><div id="contentsList"><% while(archive.next()){count++;const month=archive.date('YYYY-MM');if(month!==last){if(last){ %><hr class="separator"><% } %><p class="date"><%= month %></p><% last=month;} %><p class="entry"><a href="<%= archive.permalink %>"><%= archive.title() %></a></p><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>