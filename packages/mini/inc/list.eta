<% const archive=firekylin.archive;let count=0; %><div id="list-page"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><section class="item entry"><div><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="date"><time><%= archive.date('YYYY-MM-DD') %></time></div></div><div class="summary"><%= archive.excerpt(220) %></div></section><% }if(!count){ %><p>暂无文章。</p><% } %></div>