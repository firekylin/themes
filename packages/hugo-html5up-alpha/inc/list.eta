<% const archive=firekylin.archive;let count=0; %><div class="alpha-grid"><% while(archive.next()){count++;const locked=Boolean(archive.row?.password_protected||archive.row?.title==='此内容被密码保护'||archive.row?.options?.postPasswordHash);const cover=locked?'':String(archive.row?.options?.featuredImage||''); %><article class="entry box special"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="image featured" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><time><%= archive.date('YYYY-MM-DD') %></time></p><p class="post-summary"><%= archive.excerpt(250) %></p><ul class="actions special"><li><a class="button alt" href="<%= archive.permalink %>">阅读更多</a></li></ul></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>