<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="page-wrapper"><header id="header"><a class="site-name" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><%~ block('banner') %><main id="main" class="container"><%~ block('content') %></main><footer id="footer" class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin 适配 · <a href="https://html5up.net/alpha">Alpha by HTML5 UP / AJ</a> · <a href="https://github.com/dewittn/hugo-html5up-alpha">Hugo port by Nelson Roberto</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a></p></footer></div></body></html>