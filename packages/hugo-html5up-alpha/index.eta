<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('banner',()=>{ %><% if(!archive.archiveTitle){const banner=String(cfg.bannerImageURL||''); %><section id="banner"><% if(/^(https?:\/\/|\/(?!\/))/i.test(banner)){ %><img class="banner-image" src="<%= banner %>" alt=""><% } %><div class="banner-copy"><h1><%= cfg.bannerTitle||site.title() %></h1><p><%= site.description() %></p><a class="button primary" href="#posts">阅读文章</a> <a class="button" href="/archives">文章归档</a></div></section><% } %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><header><h1><%= archive.archiveTitle %></h1></header><% }else{ %><section class="box special home-intro"><header class="major"><h2><%= cfg.introTitle||'最新文章' %></h2><% if(cfg.introText){ %><p><%= cfg.introText %></p><% } %></header></section><% } %><div id="posts"><%~ include('./inc/list',{archive}) %></div><%~ include('./inc/pagination',{archive}) %><% }) %>