<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value||''))?String(value):''; const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#1e80ff'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><%~ block('headers') %><script defer src="<%= site.themeUrl('res/js/jj.js') %>"></script></head>
<body class="fk-theme has-sidebar <%= config.colorMode === 'dark' ? 'fk-dark' : '' %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="fk-header"><a class="fk-brand" href="/"><%= site.title() %></a><nav class="fk-nav" aria-label="主导航"><% for (const nav of site.navigation) { %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></header><% if(!firekylin.jjDetail){ %><nav class="jj-categories" aria-label="文章分类"><a href="/">全部</a><% const categories=await firekylin.widget('Widget_Metas_Category_List');while(categories.next()){ %><a href="/cate/<%= categories.row.pathname %>"><%= categories.row.name %></a><% } %></nav><% } %>
<div class="fk-hero"><h1><%= site.title() %></h1><p><%= config.heroText || site.description() %></p></div>
<div class="fk-shell"><main id="main"><%~ block('content') %></main><aside class="fk-sidebar" aria-label="侧栏"><section class="fk-widget fk-profile"><% if(safe(config.avatar)){ %><img class="jj-avatar" src="<%= safe(config.avatar) %>" alt=""><% } else { %><span class="fk-monogram" aria-hidden="true"><%= Array.from(site.title())[0] || 'F' %></span><% } %><h2><%= site.title() %></h2><p><%= config.heroText || site.description() %></p></section>
<section class="fk-widget"><h2><%= config.sidebarTitle || '最新文章' %></h2><ul><% const recent = await firekylin.widget('Widget_Contents_Post_Recent', {pageSize:5}); while(recent.next()) { %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><% if(firekylin.jjDetail){ %><section class="fk-widget jj-toc" hidden><h2>目录</h2><nav></nav></section><% } %><section class="fk-widget"><h2>浏览</h2><ul><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li></ul></section></aside></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/mulingyuer/Typecho_Theme_JJ">JJ</a> by 木灵鱼儿 · <a href="/rss.html">RSS</a></p></footer></body></html>
