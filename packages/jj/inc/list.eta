<% const archive=firekylin.archive;%><div class="fk-feed"><div class="jj-feed-heading">最新文章</div><% while(archive.next()){const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage||'')?archive.row.featuredImage:'';%><article class="entry-card"><div class="jj-card-head"><span><%= archive.author() %></span><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %></div><div class="jj-card-body"><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(180) %></p><div class="jj-card-footer"><% if(archive.row.comment_num!=null){ %><a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a><% } %><% for(const tag of(archive.row.tag||[]).slice(0,3)){ %><a class="jj-tag" href="/tag/<%= tag.pathname %>"><%= tag.name %></a><% } %></div></div><% if(cover){ %><a class="jj-thumb" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %></div></article><% } %></div>