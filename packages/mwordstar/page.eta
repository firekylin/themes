<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="post-page mwordstar-block"><header class="entry-header border-bottom"><h1 class="entry-title"><%= archive.title() %></h1><div class="article-info"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div></header><div class="post-content"><%~ archive.content() %></div><p class="directory"><% (archive.row.cate||[]).forEach(cat=>{ %><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a> <% }); %><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>">#<%= tag.name %></a> <% }); %></p></article><% const comments=firekylin.comment({title:'评论'});if(comments){ %><section class="directory mwordstar-block mwordstar-comments"><%~ comments %></section><% } %><% }else{ %><p class="directory mwordstar-block">暂无内容。</p><% } %><% }) %>