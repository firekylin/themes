<% const archive=firekylin.archive;const site=firekylin.site;const mini=site.themeConfig.coverStyle==='mini'; %><% while(archive.next()){const cover=String(archive.row.featuredImage||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="post post-list-item mwordstar-block"><% if(valid&&!mini){ %><a class="native-cover" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><header class="entry-header border-bottom"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-summary <%= mini?'mini-summary':'' %>"><% if(valid&&mini){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><p><%= archive.excerpt(200,true) %></p></div><div class="article-info clearfix border-top"><div class="info"><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="info"><%= archive.author('display_name') %></div><div class="info"><a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a></div><a class="float-right" href="<%= archive.permalink %>">阅读全文</a></div></article><% } %>