<% const site=await firekylin.widget('Widget_Options');const cats=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const avatar=String(site.themeConfig.avatarUrl||''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/bootstrap.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body class="light-color" data-rounded="<%= site.themeConfig.rounded==='rightAngle'?'rightAngle':'rounded' %>"><a class="skip-link" href="#main">跳转到正文</a><header class="sticky-top"><nav class="navbar"><div class="container"><a class="navbar-brand" href="/"><%= site.title() %></a><details class="native-menu" open><summary>菜单</summary><div class="menu-links"><a href="/">首页</a><% site.navigation.forEach(nav=>{ %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %><a href="/archives">文章归档</a><a href="/categories">分类</a><a href="/tags">标签</a></div></details><form class="nav-search" action="/search.html" method="get" role="search"><label class="sr-only" for="nav-keyword">关键词</label><input id="nav-keyword" name="keyword" type="search" placeholder="搜索" required><button type="submit">搜索</button></form></div></nav></header><div class="container content-container"><div class="row"><main id="main" class="col-lg-8 article-list"><%~ block('content') %></main><aside class="col-lg-4 sidebar"><section class="mwordstar-block"><h4>博客信息</h4><div class="personal-information"><div class="user"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="avatar" src="<%= avatar %>" alt="作者头像"><% } %><p class="user-name"><%= site.themeConfig.nickname||site.title() %></p><p class="introduction"><%= site.description() %></p></div></div></section><section class="mwordstar-block" id="toc-section" hidden><h4>文章目录</h4><nav id="article-toc" aria-label="文章目录"></nav></section><section class="mwordstar-block"><h4>文章分类</h4><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.row.name %> (<%= cats.row.count %>)</a></li><% } %></ul></section><section class="mwordstar-block"><h4>标签云</h4><div class="tag-list"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a> <% } %></div></section></aside></div></div><footer><div class="container">© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/changbin1997/MWordStar">MWordStar</a> by Changbin · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></div></footer><button type="button" id="color-toggle" hidden aria-pressed="false">深色模式</button><script defer src="<%= site.themeUrl('res/js/mwordstar.js') %>"></script></body></html>
