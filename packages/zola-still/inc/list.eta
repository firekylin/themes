<% const archive=firekylin.archive;let count=0; %><section class="post-listing"><% while(archive.next()){count++; %><article class="post-card entry"><h2 class="post-card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-date"><%= archive.date('YYYY-MM-DD') %></div><p class="post-card-summary"><%= archive.excerpt(220) %></p></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>