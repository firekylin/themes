<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><div id="page" class="hfeed site"><header id="masthead" class="site-header"><div class="home-link"><h1 class="site-title"><a href="/"><%= site.title() %></a></h1><h2 class="site-description"><%= site.description() %></h2></div><div id="navbar" class="navbar"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="native-main site-main"><div id="primary" class="content-area"><div id="content" class="site-content"><%~ block('content') %></div></div></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><a href="https://github.com/WordPress/WordPress">Twenty Thirteen</a> by WordPress contributors · Firekylin</footer></div></body></html>