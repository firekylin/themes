<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/init.js') %>"></script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="native-topbar"><div class="navbar s-rounded shadow bg-primary"><div class="navbar-section"><button class="btn btn-primary pixel-toggle" id="pixelfont-toggle" aria-pressed="false" hidden>像素风格</button></div><div class="navbar-section"><nav class="native-nav nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="native-shell"><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/st-wong/hugo-spectre-pixel-theme">Spectre Pixel</a> · Shin Tatt, Wong</p></footer></div></body></html>