<% const archive=firekylin.archive;let count=0,year=''; %><div class="timeline"><% while(archive.next()){count++;const currentYear=archive.date('YYYY');if(year!==currentYear){year=currentYear; %><div class="timeline-item timeline-year"><div class="timeline-left"><i class="timeline-icon icon-lg" aria-hidden="true"></i></div><div class="timeline-content"><span class="year-label"><%= year %></span></div></div><% } %><article class="entry timeline-item"><div class="timeline-left"><i class="timeline-icon" aria-hidden="true"></i></div><div class="timeline-content"><div class="divider my-2" data-content="<%= archive.date('MM-DD') %>"></div><div class="tile s-rounded shadow"><h2 class="tile-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="tile-subtitle"><%= archive.excerpt(300) %></p></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>