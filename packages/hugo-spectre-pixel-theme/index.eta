<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="native-profile text-center"><% const avatar=String(cfg.avatarURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="profile-avatar" src="<%= avatar %>" alt=""><% } %><% if(archive.archiveTitle){ %><h1 class="listing-heading"><%= archive.archiveTitle %></h1><% }else{ %><h1><a href="/"><%= cfg.profileName||site.title() %></a></h1><% } %><p class="bio"><%= cfg.profileBio||site.description() %></p></header><div class="native-list"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>