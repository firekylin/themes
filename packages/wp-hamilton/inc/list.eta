<% const archive=firekylin.archive;let count=0; %><div class="posts native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><a class="post-preview entry fallback-image" href="<%= archive.permalink %>"><div class="preview-image"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></div><header class="preview-header"><h2 class="title"><%= archive.title() %></h2></header></a><% }if(!count){ %><p>暂无文章。</p><% } %></div>