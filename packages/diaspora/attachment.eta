<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'attachment'}),found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><div id="single"><% if(found){ %><header id="top"><a href="/">← 首页</a><h3 class="dp-subtitle"><%= archive.title() %></h3><button type="button" data-gallery hidden>查看图片</button><progress max="100" value="0" aria-label="阅读进度" hidden></progress></header><article class="article"><div><h1 class="title"><%= archive.title() %></h1><div class="stuff"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %></div><div class="content entry-content"><%~ archive.content() %></div><nav class="dp-taxonomy"><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>">#<%= tag.name %></a><% } %></nav><%~ firekylin.comment({title:'评论',className:'comment-wrap'}) %></div></article><% }else{ %><section class="dp-panel">内容不存在</section><% } %></div><% }); %>