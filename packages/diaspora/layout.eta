<% const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},mode=['dark','auto'].includes(c.colorMode)?c.colorMode:'light',safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'',overlay=/^#[a-f0-9]{6}$/i.test(c.overlayColor||'')?c.overlayColor:'#263e42'; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>:root{--cover-shade:<%= overlay %>}</style><script defer src="<%= site.themeUrl('res/js/diaspora.js') %>"></script></head><body class="fk-theme <%= mode==='dark'?'fk-dark':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a><details class="dp-menu"><summary>菜单</summary><nav aria-label="主导航"><a href="/" class="dp-brand"><% if(safe(c.logoUrl)){ %><img src="<%= safe(c.logoUrl) %>" alt="<%= site.title() %>"><% } else { %><%= site.title() %><% } %></a><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a><a href="/rss.html">RSS</a><button type="button" data-mode-toggle hidden>切换配色</button></nav></details><main id="main"><%~ block('content') %></main><footer class="dp-footer"><%= c.footerText||site.title() %> · <a href="https://github.com/LoeiFy/Diaspora">Diaspora</a> · Firekylin</footer><dialog class="dp-lightbox" aria-label="图片预览"><button type="button" data-close>关闭</button><img alt=""><nav class="dp-gallery-controls" aria-label="图片切换"><button type="button" data-prev>上一张</button><span data-position></span><button type="button" data-next>下一张</button></nav></dialog></body></html>