<% layout('layout',{compact:true});const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 · <%= site.title() %><% });block('content',()=>{ %><section class="dp-panel"><h1>搜索</h1><form action="/search.html" method="get"><label for="keyword">关键词</label><input class="form-control" id="keyword" name="keyword" value="<%= archive.keyword||'' %>"><button class="btn btn-primary" type="submit">搜索</button></form></section><% if(archive.keyword&&!archive.have()){ %><p class="dp-panel empty">没有找到相关文章</p><% } while(archive.next()){ %><article class="dp-panel"><h2 class="result-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(175) %></p></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
