<% layout('layout',{compact:true});const site=await firekylin.widget('Widget_Options'),items=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>标签 · <%= site.title() %><% });block('content',()=>{ %><section class="dp-panel"><h1>标签</h1><ul><% while(items.next()){ %><li><a href="<%= items.permalink %>"><%= items.title() %></a></li><% } %></ul></section><% }); %>