<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><div id="container"><% let first=true;while(archive.next()){const cover=safe(archive.row.featuredImage||archive.row.options?.featuredImage)||safe(c.coverImage); if(first){first=false; %><section id="screen"><div id="mark"><div class="layer"><% if(cover){ %><img id="cover" src="<%= cover %>" alt=""><% } %></div></div><div id="vibrant"><svg viewBox="0 0 2880 1620" height="100%" preserveAspectRatio="xMaxYMax slice" aria-hidden="true"><polygon opacity="0.7" points="2000,1620 0,1620 0,0 600,0"/></svg><div></div></div><header id="header"><div><a class="dp-brand" href="/"><%= site.title() %></a></div></header><div id="post0"><p><%= archive.date('Y-m-d') %></p><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= c.heroText||archive.excerpt(150) %></p></div></section><div id="primary"><% }else{ %><article class="post"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><% if(cover){ %><img class="cover" src="<%= cover %>" alt="" loading="lazy"><% }else{ %><span class="dp-placeholder" aria-hidden="true"></span><% } %></a><div class="else"><p><%= archive.date('Y-m-d') %></p><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><p><%= archive.excerpt(115) %></p><p class="here"><a href="<%= archive.permalink %>">继续阅读 →</a></p></div></article><% }} if(first){ %><section class="dp-panel"><h1><%= site.title() %></h1><p><%= c.heroText||site.description() %></p><p>暂无文章</p></section><% }else{ %></div><% } %><%~ include('inc/pagination',{archive}) %></div><% }); %>