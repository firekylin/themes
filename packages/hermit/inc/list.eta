<% const archive=firekylin.archive;let count=0,year=''; %><% while(archive.next()){const current=archive.date('YYYY');if(current!==year){if(count){ %></ul></div><% }year=current; %><div class="posts-group"><div class="post-year"><%= year %></div><ul class="posts-list"><% }count++; %><li class="post-item entry"><a href="<%= archive.permalink %>"><span class="post-title"><%= archive.title() %></span><time class="post-day"><%= archive.date('MM-DD') %></time></a></li><% }if(count){ %></ul></div><% }else{ %><p>暂无文章。</p><% } %>