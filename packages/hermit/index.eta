<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle && (!archive.pagination||archive.pagination.currentPage===1)){ %><section id="spotlight"><div id="home-center"><h1 id="home-title"><%= site.title() %></h1><p id="home-subtitle"><%= site.description() %></p><nav id="home-nav"><a href="#feed">阅读文章 ↓</a><a href="/archives">所有归档</a></nav></div></section><% }else{ %><h1><%= archive.archiveTitle||site.title() %></h1><% } %><section id="feed"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>