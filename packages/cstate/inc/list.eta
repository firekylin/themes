<% const archive=firekylin.archive;const labels={notice:'Notice',disrupted:'Disruption',down:'Outage',resolved:'Resolved'};let count=0; %><% while(archive.next()){count++;const state=String((archive.row.options||{}).incidentStatus||''); %><article class="issue"><div class="date"><%= archive.date('YYYY-MM-DD') %></div><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><% if(Object.hasOwn(labels,state)){ %><p class="text-<%= state %>"><strong><%= labels[state] %></strong></p><% } %><p><%~ archive.excerpt(250) %></p><a href="<%= archive.permalink %>">Read update →</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>