<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">Skip to content</a><header class="header"><div class="contain"><a class="brand" href="/"><% const logo=String(site.themeConfig.logoUrl||'');if(logo.startsWith('https://')||logo.startsWith('http://')||(logo.startsWith('/')&&!logo.startsWith('//'))){ %><img src="<%= site.themeConfig.logoUrl %>" alt="<%= site.title() %>"><% }else{ %><h1><%= site.title() %></h1><% } %></a></div></header><main id="main"><%~ block('content') %></main><footer class="footer"><div class="contain"><p><%= site.description() %></p><nav><a href="/">Status</a><a href="/archives">Archives</a><a href="/categories">Categories</a><a href="/tags">Tags</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><p>© <%= site.title() %> · <a href="https://github.com/cstate/cstate">cState</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></div></footer></body></html>