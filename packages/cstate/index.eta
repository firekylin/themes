<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const states={unknown:'Status not reported',ok:'All systems operational',notice:'Notice',disrupted:'Experiencing disruptions',down:'Major outage'};const status=Object.hasOwn(states,site.themeConfig.status)?site.themeConfig.status:'unknown';let components=[];try{const value=JSON.parse(site.themeConfig.components||'[]');if(Array.isArray(value))components=value.filter(x=>x&&typeof x.name==='string').slice(0,100);}catch{}const groups=[...new Set(components.map(x=>String(x.group||'Services')))]; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="contain"><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="summary status-<%= status %>"><div><strong><%= site.themeConfig.statusText||states[status] %></strong><div class="summary-date">Manual status<% if(site.themeConfig.statusUpdated){ %> · Updated <%= site.themeConfig.statusUpdated %><% } %></div></div><a href="/rss.html">Subscribe RSS</a></section><% groups.forEach(group=>{ %><details class="component-group" open><summary><%= group %></summary><div class="components"><% components.filter(x=>String(x.group||'Services')===group).forEach(c=>{const state=Object.hasOwn(states,c.status)?c.status:'unknown'; %><div class="component"><span><%= c.name %></span><span class="state-text text-<%= state %>"><%= state==='ok'?'Operational':states[state] %></span></div><% }); %></div></details><% }); %><% } %></div><div class="tabs"><nav class="contain"><a class="current" href="/">Updates</a><a href="/archives">History</a><a href="/search.html">Search</a></nav></div><section class="contain history"><h2><%= archive.archiveTitle||'Update history' %></h2><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>