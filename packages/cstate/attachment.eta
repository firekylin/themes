<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next();const state=found?String((archive.row.options||{}).incidentStatus||''):'';const labels={notice:'Notice',disrupted:'Disruption',down:'Outage',resolved:'Resolved'}; %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="contain"><% if(found){ %><p><a href="/">← All updates</a></p><h1><%= archive.title() %></h1><p class="date"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p><% if(Object.hasOwn(labels,state)){ %><p class="text-<%= state %>"><strong><%= labels[state] %></strong></p><% } %><div class="prose"><%~ archive.content() %></div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>