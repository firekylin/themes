<%
const site=await firekylin.widget('Widget_Options'),cfg=site.themeConfig||{},type=firekylin.pageType;
const archive=await firekylin.widget('Widget_Archive',{type:type==='links'?'page':type});
const detail=['post','page','attachment'].includes(type),item=detail&&archive.next();
const home=type==='index'&&!['cate','tag','author','search'].some(k=>archive.is(k));
const safeUrl=v=>typeof v==='string'&&/^(https?:\/\/|\/(?!\/)|#)/i.test(v)?v:'';
const title=item?archive.title():home?(cfg.slogan||site.description()):archive.archiveTitle||({archive:'Archives',cate:'Categories',tag:'Tags',search:'Search',links:'Links'}[type]||site.title());
const banner=safeUrl(detail?cfg.postBannerUrl||cfg.bannerUrl:cfg.bannerUrl);
const height= Math.min(100,Math.max(30,Number(home?cfg.homeBannerHeight:detail?cfg.postBannerHeight:60)||(home?100:detail?70:60)));
const mode=['light','dark'].includes(cfg.colorMode)?cfg.colorMode:'';
const mask=Math.max(0,Math.min(1,Number.isFinite(Number(cfg.bannerMask))&&cfg.bannerMask!==''?Number(cfg.bannerMask):0.3));
const nav=site.navigation||[];
%><!doctype html><html lang="en"<% if(mode) { %> data-user-color-scheme="<%= mode %>"<% } %>><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= home?'':title+' · ' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/bootstrap.min.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/github-markdown.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script src="<%= site.themeUrl('res/js/fluid.js') %>" defer></script></head><body><a class="skip-link" href="#board">Skip to content</a>
<header><div class="header-inner" style="height:<%= height %>vh"><nav id="navbar" class="navbar fixed-top navbar-expand-lg navbar-dark scrolling-navbar"><div class="container"><a class="navbar-brand" href="/"><strong><%= site.title() %></strong></a><button id="navbar-toggler-btn" class="navbar-toggler" aria-controls="navbarSupportedContent" aria-expanded="false" hidden>☰ Menu</button><div id="navbarSupportedContent" class="navbar-collapse"><ul class="navbar-nav ml-auto text-center"><% for(const n of nav) { %><li class="nav-item"><a class="nav-link" href="<%= safeUrl(n.url)||'#' %>"><%= n.label %></a></li><% } %><li class="nav-item"><a class="nav-link" href="/search.html">Search</a></li><li class="nav-item"><button class="nav-link mode-toggle" type="button" hidden aria-label="Switch color scheme">◐</button></li></ul></div></div></nav>
<div id="banner" class="banner"><% if(banner) { %><img class="banner-image" src="<%= banner %>" alt=""><% } %><div class="full-bg-img"><div class="mask flex-center" style="background-color:rgba(0,0,0,<%= mask %>)"><div class="banner-text text-center"><div class="h2"><span id="subtitle"><%= title %></span></div><% if(item){ %><div class="post-meta"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author() %></div><% } %></div><% if(home) { %><a class="scroll-down-bar" href="#board" aria-label="Read articles">⌄</a><% } %></div></div></div></div></header>
<main class="<%= detail?'fluid-detail':'' %>"><div class="container nopadding-x-md" id="board-ctn"><div id="board"><div class="container"><div class="row"><div class="col-12 col-md-10 m-auto">
<% if(detail){if(item){ %><article class="post-content mx-auto"><% if(cfg.showUpdated==='true'&&archive.row?.update_time){ %><p class="note note-info">Updated <%= String(archive.row.update_time).slice(0,10) %></p><% } %><div class="markdown-body"><%~ archive.content() %></div><hr><div class="post-metas"><% for(const key of ['cate','tag'])for(const meta of archive.row?.[key]||[]){ %><a class="mr-3" href="/<%= key %>/<%= meta.pathname %>"><%= key==='tag'?'#':'' %><%= meta.name %></a><% } %></div><% if(cfg.showCopyright==='true'){ %><div class="license-box"><strong><%= archive.title() %></strong><p><%= archive.author() %> · <a href="<%= archive.permalink %>">Permalink</a></p></div><% } %><nav class="post-prevnext my-3" aria-label="Adjacent articles"><% for(const key of ['prev','next']){const neighbor=archive.row?.[key];if(neighbor?.pathname){ %><a class="mr-3" rel="<%= key %>" href="<%= archive.permalinkFor(neighbor) %>"><%= key %>: <%= neighbor.title %></a><% }} %></nav><%~ firekylin.comment({title:'Comments',className:'article-comments'}) %></article><% }else{ %><h2>Not found</h2><% }}else if(type==='cate'||type==='tag'){const metas=await firekylin.widget(type==='cate'?'Widget_Metas_Category_List':'Widget_Metas_Tag_Cloud'); %><div class="list-group"><% while(metas.next()){ %><a class="list-group-item" href="<%= metas.permalink %>"><%= metas.title() %></a><% } %></div><% }else if(type==='archive'){ %><div class="list-group"><% for(const [month,rows] of Object.entries(archive.grouped||{})){ %><h2 class="h4"><%= month %></h2><% for(const row of rows){ %><a class="list-group-item" href="<%= archive.permalinkFor(row) %>"><time class="mr-3"><%= String(row.create_time).slice(0,10) %></time><%= row.title %></a><% }} %></div><% }else if(type==='links'){let links=[];try{const data=JSON.parse(cfg.links||'[]');if(Array.isArray(data))links=data.slice(0,100);}catch{} %><div class="row"><% for(const link of links.filter(v=>v&&typeof v==='object')){ %><div class="col-md-6 mb-3"><a href="<%= safeUrl(link.url)||'#' %>" rel="noopener"><strong><%= link.name %></strong><p><%= link.desc %></p></a></div><% } %></div><% }else{ %>
<% if(type==='search'){ %><form action="/search.html" method="get" class="mb-5"><label for="keyword">Search articles</label><div class="input-group"><input class="form-control" id="keyword" name="keyword" value="<%= archive.keyword||'' %>"><div class="input-group-append"><button class="btn btn-outline-secondary">Search</button></div></div></form><% } %>
<% let count=0;while(archive.next()){count++;const thumbnail=safeUrl(archive.row?.featuredImage||cfg.defaultThumbnail); %><div class="row mx-auto index-card"><% if(thumbnail){ %><div class="col-12 col-md-4 m-auto index-img"><a href="<%= archive.permalink %>"><img src="<%= thumbnail %>" alt="" loading="lazy"></a></div><% } %><article class="col-12 col-md-<%= thumbnail?'8':'12' %> mx-auto index-info"><h2 class="index-header"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><a class="index-excerpt <%= thumbnail?'':'index-excerpt__noimg' %>" href="<%= archive.permalink %>"><div><%= archive.excerpt(200) %></div></a><div class="index-btm post-metas"><time class="mr-3"><%= archive.date('Y-m-d') %></time><% for(const key of ['cate','tag'])for(const meta of archive.row?.[key]||[]){ %><a class="mr-3" href="/<%= key %>/<%= meta.pathname %>"><%= meta.name %></a><% } %></div></article></div><% }if(!count){ %><p>No articles found.</p><% } %>
<% if(archive.pagination){const p=archive.pagination; %><nav class="pagination justify-content-center" aria-label="Pagination"><% if(p.currentPage>1){ %><a class="page-link" rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">Previous</a><% } %><span class="page-link"><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a class="page-link" rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">Next</a><% } %></nav><% } %><% } %>
</div></div></div></div></div><% if(detail&&cfg.showToc!=='false'){ %><aside id="toc" class="fluid-toc"><details open><summary>Contents</summary><nav aria-label="Table of contents"></nav></details></aside><% } %><a id="scroll-top-button" class="fluid-top" href="#" aria-label="Back to top">↑</a></main>
<footer class="text-center py-4"><div><%= cfg.footerText||site.title() %></div><a href="https://github.com/fluid-dev/hexo-theme-fluid">Fluid</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></footer></body></html>
