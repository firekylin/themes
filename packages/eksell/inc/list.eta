<% const archive=firekylin.archive;let count=0; %><div class="posts native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="preview entry"><figure class="preview-media"><a class="preview-media-link" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><header class="preview-header"><h2 class="preview-title h4"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>