<% const archive=firekylin.archive;let count=0; %><div class="posts"><ul><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="post-preview entry"><a href="<%= archive.permalink %>"><h2 class="title"><span><%= archive.title() %></span></h2><time><%= archive.date('YYYY-MM-DD') %></time></a></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul></div>