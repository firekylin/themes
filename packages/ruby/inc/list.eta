<% const archive=firekylin.archive;let count=0; %><div class="post-feed gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry u-shadow"><a class="post-link" href="<%= archive.permalink %>"><figure class="post-media"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></figure><div class="post-wrapper"><h2 class="post-title"><%= archive.title() %></h2><div class="post-excerpt"><%= archive.excerpt(160) %></div></div><footer class="post-footer"><time class="native-date"><%= archive.date('YYYY-MM-DD') %></time><span class="post-more">阅读全文 →</span></footer></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>