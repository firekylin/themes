<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/pure-min.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="layout"><aside id="menu"><a class="brand" href="/"><%= site.title() %></a><div class="pure-menu"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><div class="small-print"><%= cfg.authorName||site.title() %><br><%= site.description() %></div></aside><main id="main"><div class="content"><%~ block('content') %><footer class="native-footer"><%= cfg.footerText||site.description() %> · Firekylin · <a href="https://github.com/yoshiharuyamashita/blackburn">Blackburn</a></footer></div></main></div></body></html>