<% const archive=firekylin.archive;let count=0; %><section><% while(archive.next()){count++; %><article class="entry"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><p><%= archive.excerpt(260) %></p><footer><a href="<%= archive.permalink %>">阅读全文 »</a></footer></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>