<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="gblog-post entry"><header class="gblog-post__header"><h2 class="gblog-post__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><section class="gblog-markdown"><p><%= archive.excerpt(400) %></p></section><div class="gblog-post__readmore"><a class="fake-link" href="<%= archive.permalink %>">阅读全文 →</a></div><footer class="gblog-post__footer"><div class="flex flex-wrap align-center gblog-post__meta"><span>◷ <time><%= archive.date('YYYY-MM-DD') %></time></span><span><%= archive.author('display_name') %></span><% (archive.row.tag||[]).forEach(t=>{ %><span><a href="/tag/<%= t.pathname %>">#<%= t.name %></a></span><% }); %></div></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>