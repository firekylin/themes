<% layout('./layout'); const site=await firekylin.widget('Widget_Options'); const metas=await firekylin.widget('Widget_Metas_Tag_Cloud'); %>
<% block('title',()=>{ %>标签 - <%= site.title() %><% }) %>
<% block('content',()=>{ %><section class="directory"><h1>标签</h1><div class="term-list">
<% while(metas.next()){ %><article class="gblog-post term"><header class="gblog-post__header"><h2 class="gblog-post__title"><a href="<%= metas.permalink %>"><%= metas.row.name %></a></h2></header><footer class="gblog-post__meta flex align-center"><span><%= metas.row.count %> 篇文章</span></footer>
<% if(metas.row.children&&metas.row.children.length){ %><ul class="term-children"><% for(const child of metas.row.children){ %><li><a href="/tag/<%= child.pathname %>"><%= child.name %></a> (<%= child.count %>)</li><% } %></ul><% } %>
</article><% } %></div><% if(!metas.have()){ %><p>暂无标签。</p><% } %></section><% }) %>
