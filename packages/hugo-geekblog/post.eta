<% layout('./layout'); %><% block('bodyClass',()=>{ %>post-view<% }) %><% const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="gblog-post post-detail"><% if(found){ %><header class="gblog-post__header"><% if(/^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="gblog-post__feature"><img src="<%= cover %>" alt=""></div><% } %><h1 class="gblog-post__title"><%= archive.title() %></h1><p class="gblog-post__meta gblog-post__meta--head"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><div class="gblog-markdown prose" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>