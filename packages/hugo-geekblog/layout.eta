<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig||{};const brand=String(cfg.brandImage||''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head>
<body><div class="w-full flex justify-center"><a href="#main" id="gblog-to-main">跳转到正文</a></div><div class="wrapper">
<header class="gblog-header"><div class="container flex flex-wrap"><div class="gblog-header__col-1 flex justify-start hidden-mobile"></div><div class="gblog-header__col-2 flex align-center justify-center"><a class="gblog-header__link" href="/"><span class="gblog-brand flex align-center justify-center"><% if(/^(?:https?:\/\/|\/(?!\/))/i.test(brand)){ %><img class="gblog-brand__img" src="<%= brand %>" alt=""><% } %><span class="gblog-brand__title"><%= site.title() %></span></span><span class="gblog-brand__subtitle flex align-center justify-center"><%= site.description() %></span></a></div><div class="gblog-header__col-3 flex justify-end"><button id="gblog-color-theme" type="button" aria-label="切换配色" hidden>自动</button></div></div></header>
<nav class="gblog-nav" aria-label="主导航"><details class="mobile-menu"><summary>☰ 导航</summary><div class="mobile-links"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></details><ul class="gblog-nav__list container flex flex-wrap justify-center native-nav"><li><a class="gblog-nav__entry" href="/">首页</a></li><li><a class="gblog-nav__entry" href="/archives">归档</a></li><li><a class="gblog-nav__entry" href="/categories">分类</a></li><li><a class="gblog-nav__entry" href="/tags">标签</a></li><li><a class="gblog-nav__entry" href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a class="gblog-nav__entry" href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav>
<main id="main" class="gblog-page container" tabindex="-1"><%~ block('content') %></main>
<footer class="gblog-footer"><div class="container flex justify-between"><div><p><%= cfg.footerText||site.description() %></p><p>Powered by <a class="gblog-footer__link" href="https://firekylin.org/">Firekylin</a> · <a class="gblog-footer__link" href="https://github.com/thegeeklab/hugo-geekblog">Hugo Geekblog</a></p></div><a class="gblog-footer__link" href="#main">↑ 返回顶部</a></div></footer></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>
