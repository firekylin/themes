<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post hentry entry"><a class="post-thumbnail" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><div class="native-entry-body"><header class="entry-header"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-summary"><p><%= archive.excerpt(300) %></p></div><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>