<% const archive=firekylin.archive;let count=0; %><div class="loop-container"><% while(archive.next()){const cover=String(archive.row?.options?.featuredImage||'');const image=/^(https?:\/\/|\/(?!\/))/.test(cover);count++; %><article class="post excerpt entry full-without-featured <%= image?'has-post-thumbnail':'' %> <%= count%2?'odd':'even' %>"><% if(image){ %><a class="featured-image-link" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><div class="featured-image"><img src="<%= cover %>" alt="" loading="lazy"></div></a><% } %><div class="excerpt-container"><div class="excerpt-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><header class="excerpt-header"><h2 class="excerpt-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="excerpt-content"><article><p><%= archive.excerpt(260) %></p><p class="more-link-wrapper"><a class="more-link" href="<%= archive.permalink %>">继续阅读</a></p></article></div></div></article><% } %></div><% if(!count){ %><section class="directory">暂无文章。</section><% } %>