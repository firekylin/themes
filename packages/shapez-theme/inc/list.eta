<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry timeline-post"><div class="publish-date"><h3><%= archive.date('DD') %></h3><time><%= archive.date('YYYY-MM') %></time></div><div class="timeline-post-body"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="timeline-post-description"><p><%= archive.excerpt(300) %></p><a class="timeline-post-read-more" href="<%= archive.permalink %>">阅读更多 →</a></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>