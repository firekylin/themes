<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-detail"><% if(found){ %><header class="article-header-container lin-gradient"><div class="article-header"><div class="publish-date"><h3><%= archive.date('DD') %></h3><time><%= archive.date('YYYY-MM') %></time></div><h1><%= archive.title() %></h1></div></header><div class="article-meta-inf"><span><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></span><div class="alignment-controls" hidden><button data-align="left" aria-pressed="false">左对齐</button><button data-align="justify" aria-pressed="true">两端对齐</button></div></div><div class="prose post-content" id="article-body"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><div class="native-comments"><%~ firekylin.comment({title:'评论'}) %></div><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>