<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="listing-heading"><%= archive.archiveTitle %></h1><% }else{ %><%~ include('./inc/hero',{site}) %><% } %><section id="scroll-down" class="timeline-container"><%~ include('./inc/list',{archive}) %></section><%~ include('./inc/pagination',{archive}) %><% }) %>