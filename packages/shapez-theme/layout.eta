<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="wrapper"><header class="native-navigation"><%~ include('./inc/side-shape') %><a class="native-site" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main><footer class="native-footer lin-gradient-revert"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/djuelg/Shapez-Theme">Shapez</a> · djuelg</p></footer></div></body></html>