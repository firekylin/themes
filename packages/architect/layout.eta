<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-head"><div class="inner"><h1><a href="/"><%= site.title() %></a></h1><p><%= site.description() %></p><nav class="nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div id="content-wrapper"><div class="inner clearfix"><div id="main-content"><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/pages-themes/architect">Architect</a> by Jason Long</footer></div><aside id="sidebar"><h2><%= cfg.authorName||site.title() %></h2><p><%= site.description() %></p></aside></div></div></body></html>