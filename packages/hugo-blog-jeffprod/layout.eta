<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><header class="navbar jeff-navbar"><a class="navbar-item" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><section class="hero is-info jeff-hero"><% const cover=String(cfg.headerImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="hero-image" src="<%= cover %>" alt=""><% } %><div class="hero-body"><div class="container has-text-centered"><h1 class="title"><%= site.title() %></h1><p><%= site.description() %></p></div></div></section><div class="container jeff-main"><div class="section"><div class="columns"><main id="main" class="column is-9"><div class="tile is-child box"><%~ block('content') %></div></main><aside class="column is-3 jeff-sidebar"><section class="card"><div class="card-content"><h2 class="title is-5">标签</h2><div class="tags"><% tags.stack.forEach(t=>{ %><span class="tag"><a href="/tag/<%= t.pathname %>"><%= t.name %></a></span><% }); %></div></div></section><section class="card"><div class="card-content jeff-recent"><h2 class="title is-5">最近文章</h2><% while(recent.next()){ %><a href="<%= recent.permalink %>"><%= recent.title() %></a><time><%= recent.date('YYYY-MM-DD') %></time><% } %></div></section><section class="card"><div class="card-content"><h2 class="title is-5">归档</h2><a href="/archives">浏览全部归档</a></div></section></aside></div></div></div><footer class="footer has-background-grey-darker has-text-white jeff-footer"><div class="content has-text-centered"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/Tazeg/hugo-blog-jeffprod">JeffProd</a></p></div></footer></body></html>