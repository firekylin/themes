<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= site.title() %><% }) %><% block('content',()=>{ %><div class="content"><h2 class="title is-4"><%= site.description()||'文章' %></h2><hr><%~ include('./inc/list',{archive}) %></div><%~ include('./inc/pagination',{archive}) %><% }) %>