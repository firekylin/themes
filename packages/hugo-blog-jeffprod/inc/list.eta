<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="media entry"><div class="media-content"><div class="content"><h2 class="title is-4"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-date"><%= archive.date('YYYY-MM-DD') %></p><div class="excerpt"><%~ archive.excerpt(200) %></div></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>