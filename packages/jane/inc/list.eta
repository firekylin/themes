<% const archive=firekylin.archive;let count=0; %><div class="home-container"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><section class="jane-card post entry"><header class="post-header"><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="post-meta-list"><div class="post-meta-item"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></header><div class="post-content"><div class="post-summary"><p><%= archive.excerpt(260) %></p></div><div class="read-more"><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></div></section><% }if(!count){ %><p>暂无文章。</p><% } %></div>