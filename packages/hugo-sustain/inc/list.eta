<% const archive=firekylin.archive;let count=0,lastGroup=''; %><section class="archive-feed panel"><h2>归档</h2><div class="panel-body"><% while(archive.next()){count++; %><div class="row mb-2 entry"><div class="col-4"><h5 class="date-column"><%= archive.date('YYYY-MM-DD') %></h5></div><div class="col-8"><h5><b><a href="<%= archive.permalink %>"><%= archive.title() %></a></b></h5></div></div><% } %></div></section><% if(!count){ %><p>暂无文章。</p><% } %>