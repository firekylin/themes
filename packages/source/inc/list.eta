<% const archive=firekylin.archive;let count=0; %><section class="gh-container is-grid no-image"><div class="gh-container-inner"><div class="gh-main"><div class="gh-feed"><% while(archive.next()){count++; %><article class="gh-card no-image entry"><div class="gh-card-link"><div class="gh-card-wrapper"><h2 class="gh-card-title is-title"><a class="gh-card-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="gh-card-excerpt is-body"><%= archive.excerpt(220) %></p><footer class="gh-card-meta"><span class="gh-card-author"><%= archive.author('display_name') %></span> · <time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></footer></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div></div></div></section>