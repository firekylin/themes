<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="<%~ block('bodyClass') %>"><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="container"><a class="title" href="/"><h1><%= site.title() %></h1></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="container padding-header"><main id="main" class="main"><%~ block('content') %></main><aside class="sidebar"><h3>站点导航</h3><ul class="base-list"><li><a href="/archives">所有文章</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul><p><%= site.description() %></p></aside></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/rust-br/dinkleberg">Dinkleberg</a></p></footer></body></html>