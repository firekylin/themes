<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><a class="post entry" href="<%= archive.permalink %>"><article><h2 class="title"><%= archive.title() %></h2><span class="description"><%= archive.excerpt(220) %></span><div class="extra"><time><%= archive.date('YYYY-MM-DD') %></time></div></article></a><% } %><% if(!count){ %><p>暂无文章。</p><% } %>