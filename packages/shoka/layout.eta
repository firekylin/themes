<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="loaded"><a class="native-skip" href="#main">跳转到正文</a><div id="container"><header id="header"><div class="inner"><div id="brand"><a href="/" class="logo"><h1 class="title"><%= site.title() %></h1></a><p class="meta"><%= site.description() %></p></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="native-main index wrap"><%~ block("content") %></main></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/amehime/hexo-theme-shoka">Shoka</a> by Ruri Shimotsuki</footer></body></html>