<% const archive=firekylin.archive;let count=0; %><div class="segments posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="item entry"><div class="cover"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><div class="info"><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="excerpt"><p><%= archive.excerpt(260) %></p></div><a href="<%= archive.permalink %>" class="btn">阅读全文</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>