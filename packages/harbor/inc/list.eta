<% const archive=firekylin.archive;let count=0; %><div class="posts-list"><% while(archive.next()){count++; %><article class="post-preview entry"><a href="<%= archive.permalink %>"><h2 class="post-title"><%= archive.title() %></h2></a><div class="post-entry"><p><%= archive.excerpt(250) %></p><a class="post-read-more" href="<%= archive.permalink %>" aria-label="阅读全文：<%= archive.title() %>">阅读全文 →</a></div><div class="postmeta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>