<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="navbar"><div class="nav"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><div class="intro-header"><div class="container"><div class="page-heading"><%~ block('hero',()=>{ %><h1><a href="/"><%= site.title() %></a></h1><p class="site-description"><%= site.description() %></p><% }) %></div></div></div></header><main id="main" class="container" role="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="copyright"><span class="footer-author"><%= cfg.authorName||site.title() %></span> · <a href="/"><%= site.title() %></a></p><button class="theme-toggle" type="button" aria-pressed="false" hidden>切换为深色</button><p class="theme-by">Firekylin · <a href="https://github.com/matsuyoshi30/harbor">Harbor</a></p></footer></body></html>