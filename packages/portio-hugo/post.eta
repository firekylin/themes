<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post post-detail"><% if(found){ %><header class="article-meta breadCrumb container text-center"><h1 class="post-title breadCrumb__title"><%= archive.title() %></h1><p class="post-date post-meta"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><section class="section singleBlog"><div class="container"><% if(!archive.row.password_protected&&archive.row.title!=='此内容被密码保护'&&!archive.row.options?.postPasswordHash&&/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="singleBlog__feature"><img class="post-cover" src="<%= cover %>" alt=""></div><% } %><div class="singleBlog__content"><aside class="article-toc" aria-label="文章目录" hidden><h2>目录</h2><ol></ol></aside><div class="prose post-content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %></div></div></section><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>
