<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="breadCrumb"><div class="container text-center"><h1 class="breadCrumb__title"><%= archive.archiveTitle||site.title() %></h1><nav aria-label="当前位置"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">首页</a></li><li class="breadcrumb-item active"><%= archive.archiveTitle||'博客' %></li></ol></nav><% if(!archive.archiveTitle){ %><p class="lead"><%= site.description() %></p><% } %></div></header><section class="section blog-page"><div class="container"><div class="row blog-grid"><%~ include('./inc/list',{archive}) %></div><%~ include('./inc/pagination',{archive}) %></div></section><% }) %>
