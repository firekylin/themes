<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="native-header"><div class="navbar"><div class="container"><a class="navbar-brand" href="/"><%= site.title() %></a><button class="menu-button" type="button" aria-controls="native-navigation" aria-expanded="true" hidden>菜单</button><nav id="native-navigation" class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><main id="main"><%~ block('content') %></main><footer id="footer" class="footer"><div class="container"><div class="footer__cta"><div class="footer__cta_content"><span>继续阅读</span><h2><%= cfg.footerText||site.description() %></h2></div><div class="footer__cta_action"><a href="/archives">浏览所有文章 →</a></div></div><div class="native-footer-bottom"><p><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/furioustheme/portio-hugo">Portio</a> · StaticMania / Furioustheme</p></div></div></footer></body></html>
