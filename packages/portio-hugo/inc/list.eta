<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const image=String(archive.row.options?.featuredImage||'');const locked=Boolean(archive.row.password_protected||archive.row.options?.postPasswordHash||archive.row.title==='此内容被密码保护');const hasImage=!locked&&/^(https?:\/\/|\/(?!\/))/i.test(image); %><div class="col-lg-4"><article class="entry blog-page__item<%= hasImage?'':' no-cover' %>"><% if(hasImage){ %><div class="blog-page__item-thumb"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= image %>" alt="" loading="lazy"></a></div><% } %><div class="blog-page__item-content bg-white"><span class="small"><time><%= archive.date('YYYY-MM-DD') %></time></span><h2 class="mb-0"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></div></article></div><% } %><% if(!count){ %><p class="col-12">暂无文章。</p><% } %>
