<% const archive=firekylin.archive;let count=0; %><div class="catalogue"><% while(archive.next()){count++; %><a class="catalogue-item entry" href="<%= archive.permalink %>"><time class="catalogue-time"><%= archive.date('YYYY/MM/DD') %></time><h1 class="catalogue-title"><%= archive.title() %></h1><div class="catalogue-line"></div><p><%= archive.excerpt(300) %></p></a><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>