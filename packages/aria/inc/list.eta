<% /* Aria source index.php: title/category/date, thumbnail, summary and comment metadata. */
const archive=firekylin.archive, config=firekylin.site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || '')) ? String(value) : '';
%><div class="fk-feed cards"><% while(archive.next()) { const cover=safe(archive.row.featuredImage) || safe(String(config.defaultThumbnail || '').split(/\s+/)[0]); %>
<article class="entry-card card"><div class="entry-copy"><h2 class="entry-title card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2>
<div class="card-meta-top"><span class="card-meta-cate"><% for(const [i,cate] of (archive.row.cate || []).entries()) { %><%= i ? ' • ' : '' %><a href="/cate/<%= cate.pathname %>"><%= cate.name %></a><% } %><% if(!archive.row.cate?.length && archive.is('cate')) { %><%= archive.archiveTitle %><% } %></span><time class="card-meta-date" datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div>
<% if(cover) { %><a class="entry-cover card-thumbnail" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %>
<p class="entry-excerpt card-body"><%= archive.excerpt(50) %></p><div class="card-line"></div><div class="card-meta-bottom"><a class="entry-more" href="<%= archive.permalink %>" aria-label="阅读 <%= archive.title() %>">•••</a><% if(Number.isFinite(Number(archive.row.comment_num)) && archive.row.comment_num != null) { %><a class="aria-comment-count" href="<%= archive.permalink %>#comments">评论 <%= Number(archive.row.comment_num) %></a><% } %></div>
</div></article><% } %></div>
