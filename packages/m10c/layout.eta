<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(avatar); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="app-header"><% if(valid){ %><a href="/"><img class="app-header-avatar" src="<%= avatar %>" alt="<%= cfg.authorName||site.title() %>"></a><% } %><a href="/" class="app-header-title"><%= site.title() %></a><nav class="app-header-menu nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><p><%= site.description() %></p></header><main class="app-container" id="main"><%~ block('content') %><footer class="footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/vaga/hugo-theme-m10c">m10c</a> by vaga</footer></main></body></html>