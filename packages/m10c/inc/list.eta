<% const archive=firekylin.archive;let count=0; %><ul class="posts-list"><% while(archive.next()){count++; %><li class="posts-list-item entry"><a class="posts-list-item-title" href="<%= archive.permalink %>"><%= archive.title() %></a><span class="posts-list-item-description"><time><%= archive.date('YYYY/MM/DD') %></time></span></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>