<% /* Echo by 宁采陈; modified for Firekylin Eta/Widgets, 2026. Apache-2.0. */ %><% const site=await firekylin.widget('Widget_Options');const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud',{limit:30,ignoreZeroCount:1});const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/dark.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/adapter.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><header class="header"><div class="echo-header"><a class="echo-logo" href="/"><% if(safe(site.themeConfig.logoUrl)){ %><img src="<%= site.themeConfig.logoUrl %>" alt=""><% } %><%= site.title() %></a><div class="controls"><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a></nav></details><button id="appearance" hidden aria-label="切换深色模式" aria-pressed="false">◐</button></div></div></header><div class="echo-container"><form class="mobile-search" action="/search.html" method="get" role="search"><label for="mobile-keyword">搜索</label><input id="mobile-keyword" name="keyword" placeholder="输入关键字搜索" required><button>搜索</button></form><div class="echo-grid"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section class="component"><form action="/search.html" method="get" role="search"><label for="sidebar-keyword">搜索文章</label><div class="search-row"><input id="sidebar-keyword" name="keyword" placeholder="输入关键字搜索" required><button>搜索</button></div></form></section><section class="column"><h3 class="title-sidebar">栏目分类</h3><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.row.name %><span><%= categories.row.count||0 %></span></a></li><% } %></ul><a href="/categories">全部分类</a></section><section class="tags"><h3 class="title-sidebar">标签云</h3><div><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% } %></div><a href="/tags">全部标签</a></section></aside></div></div><footer class="footer"><div class="t-copy"><span>© <%= new Date().getFullYear() %> <%= site.title() %> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · Theme by <a href="https://www.ncc.wang">Echo</a> · <a href="/rss.html">RSS</a></span></div></footer><a class="back-top" href="#main" aria-label="返回顶部">↑</a></body></html>