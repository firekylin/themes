<% /* Echo by 宁采陈; modified for Firekylin Eta/Widgets, 2026. Apache-2.0. */ %><% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="post"><%= archive.archiveTitle %></h1><% }else if(safe(cfg.bannerImage)&&archive.pagination?.currentPage===1){ %><a class="banner" href="<%= safe(cfg.bannerUrl)?cfg.bannerUrl:'/archives' %>"><img src="<%= cfg.bannerImage %>" alt="<%= site.title() %>"></a><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>