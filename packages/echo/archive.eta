<% /* Echo by 宁采陈; modified for Firekylin Eta/Widgets, 2026. Apache-2.0. */ %><% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>归档 - <%= site.title() %><% }) %><% block('content',()=>{ %><section class="archives"><h1>文章归档</h1><% for(const [month,posts]of Object.entries(archive.grouped)){ %><section class="timeline-item"><h2 class="timeline-header"><%= month %></h2><% for(const post of posts){ %><div class="timeline-wrap"><time class="timeline-date"><%= String(post.create_time||'').slice(5,10) %></time><div class="timeline-content"><a href="<%= archive.permalinkFor(post) %>"><%= post.title %></a></div></div><% } %></section><% } %><% if(!Object.keys(archive.grouped).length){ %><p>暂无文章。</p><% } %></section><% }) %>