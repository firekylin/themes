<% /* Echo Firekylin adaptation, 2026. Apache-2.0. */ %><% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String((archive.row.options||{}).featuredImage||''); %><article class="title-article list-card"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="list-pic" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><a href="<%= archive.permalink %>"><h1><%= archive.title() %></h1><p><%~ archive.excerpt(300) %></p></a><div class="title-msg"><span><time><%= archive.date('YYYY-MM-DD') %></time></span><span><%= Number(archive.row.comment_num)||0 %>条评论</span></div></article><% } %><% if(!count){ %><p class="post">暂无文章。</p><% } %>