<% /* Echo by 宁采陈; modified for Firekylin Eta/Widgets, 2026. Apache-2.0. */ %><% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><div class="map"><a href="/">首页</a> / 正文</div><article><header class="title-article"><h1><%= archive.title() %></h1><div class="title-msg"><span><%= archive.author('display_name') %></span><span><time><%= archive.date('YYYY-MM-DD') %></time></span></div></header><div class="text md_content" id="preview"><%~ archive.content() %></div><div class="tags-text">标签：<% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><div class="comment-text"><%~ firekylin.comment({title:'评论'}) %></div></article><% }else{ %><p class="post">暂无内容。</p><% } %><% }) %>