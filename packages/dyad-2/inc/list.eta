<% const archive=firekylin.archive;let count=0; %><div class="posts native-dyads"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post hentry entry"><a class="native-dyad-image" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><div class="native-dyad-text"><header class="entry-header"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><div class="entry-content"><p><%= archive.excerpt(300) %></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>