<% const archive=firekylin.archive;let count=0; %><div class="summary-container"><% while(archive.next()){count++;const protectedPost=archive.row?.password_protected||archive.row?.options?.postPasswordHash||archive.title()==='此内容被密码保护';const image=protectedPost?'':String(archive.row?.options?.featuredImage||''); %><article class="summary-classic entry"><div class="summary-flex"><% if(/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><a class="summary-image-link" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= image %>" alt="" loading="lazy" class="summary-image"></a><% } %><div class="summary-content"><h2 class="summary-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="summary-meta"><time>◷ <%= archive.date('YYYY/MM/DD') %></time> · <%= archive.author('display_name') %></p><p class="summary-text"><%= archive.excerpt(220) %></p></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %></div>
