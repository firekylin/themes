<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const photo=String(cfg.profileImage||'');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{limit:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %>
<form class="sidebar-search" method="get" action="/search.html" role="search"><label class="sr-only" for="sidebar-keyword">搜索文章</label><input id="sidebar-keyword" name="keyword" placeholder="搜索…" required><button type="submit" aria-label="搜索文章">⌕</button></form>
<section class="bio"><% if(/^(https?:\/\/|\/(?!\/))/i.test(photo)){ %><div class="bio-photo-wrap"><img class="bio-photo" src="<%= photo %>" alt="<%= cfg.authorName||site.title() %>"></div><% } %><h2 class="bio-name"><%= cfg.authorName||site.title() %></h2><p><%= cfg.bioText||site.description() %></p><% if(cfg.location){ %><p class="bio-location">⌖ <%= cfg.location %></p><% } %></section>
<section class="sidebar-recent"><h2>最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section>
<section class="taxo categories"><h2>分类</h2><div class="taxo-chips"><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %> <span><%= categories.row.count %></span></a><% } %></div></section>
<section class="taxo tags"><h2>标签</h2><div class="taxo-chips"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %> <span><%= tags.row.count %></span></a><% } %></div></section>
