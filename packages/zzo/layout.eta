<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %>
<!doctype html><html lang="zh-CN" data-palette="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head>
<body><a class="skip" href="#main">跳转到正文</a><div class="wrapper"><header class="navbar"><a class="navbar-brand" href="/"><span class="zzo-mark" aria-hidden="true"></span><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.filter(n=>!['/archives','/categories','/tags','/search.html'].includes(n.url)).forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><label class="palette-control" hidden>配色<select id="palette" aria-label="配色"><option value="dark">Dark</option><option value="light">Light</option><option value="hacker">Hacker</option><option value="solarized">Solarized</option><option value="kimbie">Kimbie</option></select></label></header>
<% if(firekylin.home){ %><div class="site-header"><h1 class="site-header-title"><a href="/"><%= site.title() %></a></h1><p><%= site.description() %></p></div><% } %><div class="inner"><main id="main"><%~ block('content') %></main><aside class="sidebar" aria-label="博客侧栏"><%~ await includeAsync('./inc/sidebar') %></aside></div>
<footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p>Powered by Firekylin · <a href="https://github.com/zzossig/hugo-theme-zzo">Zzo</a></p><a href="#main">↑ 返回顶部</a></footer></div></body></html>
