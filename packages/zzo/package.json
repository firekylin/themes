{
  "name": "zzo",
  "title": "Zzo",
  "version": "0.1.0",
  "private": true,
  "description": "Zzo’s boxed technical blog: classic thumbnail summaries, right biography/sidebar, colorful taxonomy chips and five palettes.",
  "license": "MIT",
  "author": "zzossig; Firekylin contributors",
  "homepage": "https://github.com/zzossig/hugo-theme-zzo",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/zzo"
  },
  "firekylin": {
    "type": "theme",
    "id": "zzo"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "作者名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "bioText",
      "label": "作者介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "profileImage",
      "label": "作者照片",
      "help": "HTTP(S) 或站内绝对路径，留空不显示。"
    },
    {
      "type": "text",
      "name": "location",
      "label": "所在地",
      "help": "可选，显示于侧栏。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "留空使用站点描述。"
    }
  ]
}
