<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-theme="auto"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="w"><header><nav aria-label="主导航"><ul class="horizontal-list nav-items"><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav><div class="dashed"></div><h1><%= site.title() %></h1><p><%= site.description() %></p><button type="button" class="native-mode" aria-pressed="false" hidden>深色模式</button></header><main id="main" class="page-content"><%~ block('content') %></main><footer><div class="dashed"></div><p><%= cfg.footerText||site.description() %></p><div class="credits"><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/abhinavs/moonwalk">Moonwalk</a> by Abhinav Saxena</div></footer></div></body></html>