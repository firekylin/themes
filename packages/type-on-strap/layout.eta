<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const logo=String(cfg.logo||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><a class="brand" href="/"><% if(/^(https?:\/\/|\/(?!\/))/.test(logo)){ %><img src="<%= logo %>" alt="站点标识"><% } %><%= site.title() %></a><input id="nav-trigger" type="checkbox" aria-label="切换导航菜单"><label class="menu-toggle" for="nav-trigger" aria-label="切换导航菜单">☰</label><nav class="nav-items" aria-label="主导航"><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a><a href="/search.html">搜索</a><a href="/tags">标签</a><button id="mode" aria-label="切换深浅色">◐</button></nav></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/sylhare/Type-on-Strap">Type on Strap</a> 原生改编</p><a href="/categories">分类</a></footer></body></html>