<% layout('./layout');const site=await firekylin.widget('Widget_Options');const banner=String(site.themeConfig.banner||'');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="archive-title"><%= archive.archiveTitle %></h1><% }else{ %><header class="call-out"><% if(/^(https?:\/\/|\/(?!\/))/.test(banner)){ %><img src="<%= banner %>" alt=""><% } %><h1><%= site.themeConfig.headerText||site.description() %></h1></header><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>