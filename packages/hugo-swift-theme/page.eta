<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next();const locked=Boolean(archive.row?.password_protected||archive.row?.title==='此内容被密码保护'||archive.row?.options?.postPasswordHash);const cover=locked?'':String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><section class="post_header"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-hero-image" src="<%= cover %>" alt=""><% } %><h1 class="post_title"><%= archive.title() %></h1></section><% } %><article class="post-detail"><% if(found){ %><header class="article-meta"></header><div class="prose post_content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>