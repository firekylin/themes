<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><section class="intro"><div class="intro_inner"><%~ include('./inc/wave') %><h1 class="intro_headline"><%= archive.archiveTitle||site.title() %></h1><p class="intro_desc"><%= archive.archiveTitle?'':site.description() %></p></div></section><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %><% }) %>