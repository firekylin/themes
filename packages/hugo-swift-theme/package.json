{
  "name": "hugo-swift-theme",
  "title": "Swift",
  "version": "0.1.0",
  "private": true,
  "description": "Swift’s original rounded two-column image cards, dark waveform intro, orange accents and automatic dark palette.",
  "license": "MIT",
  "author": "Weru; Firekylin contributors",
  "homepage": "https://github.com/onweru/hugo-swift-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/hugo-swift-theme"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugo-swift-theme"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
