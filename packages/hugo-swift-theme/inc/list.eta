<% const archive=firekylin.archive;let count=0; %><ul class="posts wrap native-posts"><% while(archive.next()){count++;const locked=Boolean(archive.row?.password_protected||archive.row?.title==='此内容被密码保护'||archive.row?.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||'');const safe=/^(https?:\/\/|\/(?!\/))/i.test(cover);const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row;const tag=(meta.tag||[])[0]; %><li class="entry post_item <%= safe?'':'no-cover' %>"><% if(safe){ %><a class="post_card" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="excerpt"><% if(tag){ %><div class="excerpt_meta"><a class="post_tag" href="/tag/<%= encodeURIComponent(tag.pathname||tag.name) %>"><%= tag.name %></a></div><% } %><h2 class="post_link"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="pale"><%= archive.excerpt(180) %></p></div></li><% } %></ul><% if(!count){ %><p class="native-page">暂无文章。</p><% } %>