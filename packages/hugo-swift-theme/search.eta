<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %>搜索 - <%= site.title() %><% }) %><% block('content',()=>{ %><div class="native-page"><h1>搜索</h1><form action="/search.html" method="get" role="search"><label for="keyword">关键词</label><input id="keyword" name="keyword" value="<%= archive.keyword %>" required><button type="submit">搜索</button></form><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>