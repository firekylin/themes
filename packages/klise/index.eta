<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||'');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="listing-title"><%= archive.archiveTitle %></h1><% }else{ %><section class="author"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="author-avatar" src="<%= avatar %>" alt="作者头像"><% } %><h1 class="author-name"><%= cfg.authorName||site.title() %></h1><p class="author-bio"><%= site.description() %></p></section><h2 class="posts-note">Recent Posts</h2><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>