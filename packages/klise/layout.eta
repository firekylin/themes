<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar"><nav class="menu" aria-label="主导航"><button id="mode" aria-label="切换深浅色">◐</button><input id="menu-trigger" type="checkbox"><label class="menu-icon" for="menu-trigger" aria-label="切换导航菜单">☰</label><div class="nav-items"><a href="/">首页</a><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></nav></header><main id="main" class="wrapper"><%~ block('content') %></main><footer class="footer wrapper"><div><a href="/categories">分类</a> · <a href="/tags">标签</a></div><small><%= cfg.footerText||site.description() %><br>Firekylin · <a href="https://github.com/piharpi/jekyll-klise">Klisé</a> 原生改编</small></footer></body></html>