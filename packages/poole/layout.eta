<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div class="container content"><header class="masthead"><h3 class="masthead-title"><a href="/"><%= site.title() %></a> <small><%= site.description() %></small></h3><nav class="nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main><footer class="footer"><p><%= cfg.footerText||site.description() %></p><small><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/poole/poole">Poole</a> by Mark Otto</small></footer></div></body></html>