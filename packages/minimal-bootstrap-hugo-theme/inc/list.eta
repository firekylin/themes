<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><small class="text-secondary"><%= archive.date('YYYY-MM-DD') %></small> <span class="entry-tags"><% (archive.row.tag||[]).forEach(t=>{ %><small><code><a href="/tag/<%= t.pathname %>"><%= t.name %></a></code></small><% }); %></span></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>