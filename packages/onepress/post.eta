<% /* Firekylin adaptation of Onepress templates, modified 2026; original Apache-2.0 copyright2018 Jeremiah Succeed. */ %><% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const row=archive.row||{};const locked=Boolean(row.password_protected||row.options?.postPasswordHash||row.title==='此内容被密码保护');const cover=locked?'':String(row.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="single post post-detail"><% if(found){ %><header class="article-meta"><h1 class="post-title"><%= archive.title() %></h1><p class="post-date"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="post-cover" src="<%= cover %>" alt=""><% } %><div class="prose post-content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>