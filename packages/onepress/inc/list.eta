<% /* Firekylin adaptation of Onepress templates, modified 2026; original Apache-2.0 copyright2018 Jeremiah Succeed. */ %><% const archive=firekylin.archive;const meta=firekylin.metaByPost||new Map();let count=0; %><% while(archive.next()){count++;const row=archive.row;const tax=meta.get(row.id)||row;const locked=Boolean(row.password_protected||row.options?.postPasswordHash||row.title==='此内容被密码保护');const cover=locked?'':String(row.options?.featuredImage||''); %><article class="entry list"><a href="<%= archive.permalink %>"><h2 class="title"><%= archive.title() %></h2></a><div class="tags"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %><% (tax.tag||[]).forEach(t=>{ %> · <a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="cover-link" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img class="post-cover" src="<%= cover %>" alt="" loading="lazy"></a><% } %><p class="intro"><%= archive.excerpt(300) %></p><a class="read-more" href="<%= archive.permalink %>">阅读全文</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>