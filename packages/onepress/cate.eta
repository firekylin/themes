<% /* Firekylin adaptation of Onepress templates, modified 2026; original Apache-2.0 copyright2018 Jeremiah Succeed. */ %><% layout('./layout'); const site = await firekylin.widget('Widget_Options'); const metas = await firekylin.widget('Widget_Metas_Category_List'); %>
<% block('title', () => { %>分类 - <%= site.title() %><% }) %>
<% block('content', () => { %><div class="native-wrap"><section class="directory"><h1 class="archive-header">分类</h1><ul>
<% while (metas.next()) { %><li><a href="<%= metas.permalink %>"><%= metas.row.name %></a> (<%= metas.row.count %>)
<% if (metas.row.children && metas.row.children.length) { %><ul><% for (const child of metas.row.children) { %><li><a href="/cate/<%= child.pathname %>"><%= child.name %></a> (<%= child.count %>)</li><% } %></ul><% } %>
</li><% } %></ul><% if (!metas.have()) { %><p>暂无分类。</p><% } %></section></div><% }) %>
