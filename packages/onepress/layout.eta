<% /* Firekylin adaptation of Onepress templates, modified 2026; original Apache-2.0 copyright2018 Jeremiah Succeed. */ %><% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const sidebar=cfg.sidebarMode!=='none';const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><% const logo=String(cfg.logoURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(logo)){ %><img class="site-logo" src="<%= logo %>" alt=""><% } %><a class="site-title" href="/"><%= site.title() %></a><p class="site-description"><%= site.description() %></p></header><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div id="<%= sidebar?'site-wrapper':'site-wrapper-centered' %>"><main id="main"><%~ block('content') %></main><% if(sidebar){ %><aside class="native-sidebar desktop-only"><div class="widgets"><section class="widget"><h2 class="widget-title">关于</h2><p class="about-text"><%= cfg.aboutText||site.description() %></p></section><section class="widget"><h2 class="widget-title">最近文章</h2><ul class="recent-posts"><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="widget topics"><h2 class="widget-title">分类与标签</h2><ul><% (categories.stack||[]).forEach(c=>{ %><li><a href="/cate/<%= c.pathname %>"><%= c.name %></a></li><% }); %><% (tags.stack||[]).forEach(t=>{ %><li><a href="/tag/<%= t.pathname %>">#<%= t.name %></a></li><% }); %></ul></section></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/jeremyikwuje/onepress">Onepress</a> · Jeremiah Succeed</p></footer></aside><% }else{ %><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/jeremyikwuje/onepress">Onepress</a> · Jeremiah Succeed</p></footer><% } %></div><% if(sidebar){ %><div class="site-footer-mobile"><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/jeremyikwuje/onepress">Onepress</a> · Jeremiah Succeed</p></footer></div><% } %></body></html>