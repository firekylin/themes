<% const archive=firekylin.archive;let count=0; %><section class="card-container"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><a href="<%= archive.permalink %>" class="card blog-card entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="card-img-container"><img class="card-img" src="<%= cover %>" alt="" loading="lazy"></div><% } %><article class="card-body"><h2 class="card-title"><%= archive.title() %></h2><p class="card-text"><%= archive.excerpt(220) %></p><div class="card-subtext muted-text"><p><%= archive.date('YYYY-MM-DD') %></p></div></article></a><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>