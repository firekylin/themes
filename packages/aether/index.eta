<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><header class="home-header"><div class="home-blob-text-container"><h1 class="home-blob-title"><%= site.title() %></h1><p class="home-blob-text"><%= site.description() %></p></div></header><% } %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>