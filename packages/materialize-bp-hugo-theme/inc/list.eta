<% const archive=firekylin.archive;const meta=firekylin.metaByPost||new Map();let count=0; %><% while(archive.next()){count++;const row=archive.row;const tax=meta.get(row.id)||row;const cover=String(row.options?.featuredImage||''); %><article class="card entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="card-image"><a href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><div class="card-content"><h2 class="card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="card-meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div><p><%= archive.excerpt(300) %></p><a class="btn read-more" href="<%= archive.permalink %>">阅读全文</a></div><footer class="card-action"><% (tax.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>">+<%= c.name %></a><% }); %><% (tax.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>