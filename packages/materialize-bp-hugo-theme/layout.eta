<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="site-name" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="native-main"><%~ block('content') %></main><footer class="page-footer"><div class="footer-inner"><section><h2><%= site.title() %></h2><p><%= cfg.footerText||site.description() %></p></section><section><h2>作者</h2><p class="footer-author"><%= cfg.authorName||site.title() %></p></section><section><h2>站点</h2><div class="footer-links"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></section></div><div class="footer-copyright"><div class="copyright-inner">Firekylin · <a href="https://github.com/spech66/materialize-bp-hugo-theme">Materialize-BP</a> · Sebastian Pech · Materialize</div></div></footer></body></html>