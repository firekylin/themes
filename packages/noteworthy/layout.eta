<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="is-head-left-logo home-template"><a class="native-skip" href="#main">跳转到正文</a><nav class="sidebar-nav"><header><div class="site-title"><a href="/"><%= site.title() %></a></div></header><p><%= site.description() %></p><div class="nav-menu"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></nav><main id="main" class="native-main content-container"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/kimcc/hugo-theme-noteworthy">Noteworthy</a> by kimcc</footer></body></html>