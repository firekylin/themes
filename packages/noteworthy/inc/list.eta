<% const archive=firekylin.archive;let count=0; %><div class="article-content"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(240) %></p><div class="post-footer"><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>