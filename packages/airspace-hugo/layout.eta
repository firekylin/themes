<% const site = await firekylin.widget('Widget_Options');
const cfg = site.themeConfig || {};
const used = new Set(['/', '/archives', '/categories', '/tags', '/search.html']); %>
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light"><title><%~ block('title') %></title>
  <meta name="description" content="<%= site.description() %>">
  <link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>">
</head>
<body>
<a class="skip" href="#main">跳转到正文</a>
<header class="navigation"><div class="container nav-wrap">
  <a class="brand" href="/"><%= site.title() %></a>
  <nav class="native-nav nav-items" aria-label="主导航">
    <a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a>
    <% (site.navigation || []).forEach(n => { if (!used.has(n.url) && /^(https?:\/\/|\/(?!\/))/.test(String(n.url))) { used.add(n.url); %><a href="<%= n.url %>"><%= n.label %></a><% } }); %>
  </nav>
</div></header>
<section class="page-title"><div class="container"><h1><%~ block('heading') %></h1><p><%= site.description() %></p></div></section>
<div class="page-wrapper container"><div class="blog-grid">
  <main id="main"><%~ block('content') %></main>
  <%~ await includeAsync('./inc/sidebar') %>
</div></div>
<footer class="footer"><div class="container">
  <nav class="footer-menu" aria-label="页脚导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/tags">标签</a></nav>
  <p><%= cfg.footerText || site.description() %></p>
  <p>Powered by <a href="https://firekylin.org">Firekylin</a> · <a href="https://github.com/themefisher/airspace-hugo">Airspace Hugo</a> by Themefisher</p>
</div></footer>
</body></html>
