<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('heading', () => { %><%= found ? archive.title() : '暂无内容' %><% }) %>
<% block('content',()=>{ %><article class="post post-single post-detail"><% if(found){ %><header class="article-meta"><h1 class="post-title"><%= archive.title() %></h1><%~ include('./inc/meta', {archive}) %></header><% const locked = archive.row.password_protected || archive.row.options?.postPasswordHash || archive.row.title === '此内容被密码保护'; %>
<% if (!locked && /^(https?:\/\/|\/(?!\/))/.test(cover)) { %><div class="post-thumb"><img src="<%= cover %>" alt=""></div><% } %>
<div class="prose post-content post-excerpt" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>