<% /* Jasmine 3.1.0: template-parts left/navbar/right, GPL-3.0-only. */
const site=await firekylin.widget('Widget_Options'), config=site.themeConfig || {};
const categories=await firekylin.widget('Widget_Metas_Category_List'), tags=await firekylin.widget('Widget_Metas_Tag_Cloud'),recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});
const logo=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(config.logoUrl || '') ? config.logoUrl : '';
const categoryNum=Math.min(12,Math.max(1,parseInt(config.categoryNum,10)||5));
%><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script defer src="<%= site.themeUrl('res/js/jasmine.js') %>"></script><%~ block('headers') %></head>
<body class="fk-theme has-sidebar <%= config.colorMode==='dark' ? 'fk-dark' : '' %>"><a class="skip-link" href="#main">跳转到正文</a>
<div class="jasmine-shell" id="top"><aside class="jasmine-rail" aria-label="站点导航"><% if(logo) { %><a href="/"><img src="<%= logo %>" alt="<%= site.title() %>" width="50" height="50"></a><% } %><% for(const nav of site.navigation) { %><a href="<%= nav.url %>" title="<%= nav.label %>"><%= nav.label %></a><% } %><a href="/rss.html">RSS</a><a href="#top">↑ 顶部</a></aside>
<div class="jasmine-middle"><header class="fk-header jasmine-navbar"><a class="fk-brand" href="/"><%= site.title() %></a><nav class="fk-nav" aria-label="分类导航"><a href="/">首页</a><% let n=0; while(categories.next() && n++<categoryNum) { %><a href="<%= categories.permalink %>"><%= categories.title() %></a><% } %><a href="/search.html">搜索</a></nav><button data-jasmine-dark hidden type="button" aria-label="切换配色" aria-pressed="<%= config.colorMode==='dark' ? 'true' : 'false' %>">◐</button></header>
<main id="main"><%~ block('content') %></main></div>
<aside class="jasmine-right" aria-label="侧栏"><p class="jasmine-description"><%= config.heroText || site.description() %></p><section><h2><%= config.sidebarTitle || '最新文章' %></h2><% while(recent.next()) { %><a href="<%= recent.permalink %>"><%= recent.title() %></a><% } %></section><section><h2>标签</h2><div class="jasmine-tags"><% while(tags.next()) { %><a href="<%= tags.permalink %>"><%= tags.title() %></a><% } %></div></section></aside></div>
<footer class="fk-footer"><p><%= config.footerText || site.title() %></p><a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/liaocp666/Jasmine">Jasmine</a> by Kent Liao</footer></body></html>
