<% /* Source index-default.php: summary and category/date with optional right thumbnail. */ const archive=firekylin.archive; %><div class="fk-feed jasmine-posts"><% while(archive.next()) {const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage || '') ? archive.row.featuredImage : ''; %><article class="entry-card"><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(70) %></p><div class="entry-meta"><% for(const cate of archive.row.cate || []) { %><a href="/cate/<%= cate.pathname %>"><%= cate.name %></a> · <% } %><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div></div><% if(cover) { %><a class="jasmine-thumbnail" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %></article><% } %></div>