<% const row=firekylin.row,fields=row.fields||row.options?.fields||{},href=firekylin.href;const image=row.featuredImage||row.options?.featuredImage;const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %><article class="group bg-white/90 dark:bg-zinc-900/90 backdrop-blur-sm rounded-2xl ring-1 ring-zinc-900/5 dark:ring-white/10 shadow-lg overflow-hidden transition-all duration-300 ease-out hover:shadow-xl hover:shadow-primary-500/10 hover:-translate-y-2"><div class="relative overflow-hidden aspect-[16/9] bg-gradient-to-br from-zinc-100 to-zinc-200 dark:from-zinc-800 dark:to-zinc-900"><a href="<%= href %>" class="block w-full h-full"><% if(safe(image)){ %><img src="<%= safe(image) %>" alt="" loading="lazy" style="position:absolute;width:100%;height:100%;object-fit:cover"><% }else{ %><div class="w-full h-full bg-gradient-to-br from-primary-600/40 via-secondary-600/30 to-primary-800/50 flex items-center justify-center"><span class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center" aria-hidden="true"><svg class="w-8 h-8 text-white/40" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg></span></div><% } %></a></div><div class="p-8 space-y-4"><h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight"><a href="<%= href %>" class="hover:underline"><%= row.title %></a></h3><p class="text-zinc-600 dark:text-zinc-400 text-base leading-relaxed line-clamp-3"><%= String(row.summary||'').replace(/<[^>]*>/g,'').slice(0,180) %></p><div class="pt-3 border-t border-zinc-100 dark:border-zinc-800"><div class="text-xs text-zinc-500 mb-3"><%= fields.authors||row.user?.display_name||row.user?.name||'' %> · <%= String(fields.eventStart||row.create_time||'').slice(0,10) %><% if(fields.location){ %> · <%= fields.location %><% } %></div><a href="<%= href %>" class="text-primary-600 dark:text-primary-400 text-sm">Read more →</a></div></div></article>