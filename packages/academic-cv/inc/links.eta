<% const row=firekylin.row,fields=row.fields||row.options?.fields||{};const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %><div class="academic-links"><% for(const [key,label] of [['pdfUrl','PDF'],['codeUrl','Code'],['slidesUrl','Slides'],['videoUrl','Video']]){if(safe(fields[key])){ %><a href="<%= safe(fields[key]) %>"><%= label %></a><% }} %><% if(/^10\.\d{4,9}\//.test(String(fields.doi||''))){ %><a href="https://doi.org/<%= encodeURIComponent(fields.doi) %>">DOI</a><% } %><% if(fields.bibtex){ %><details class="citation-fallback"><summary>Citation</summary><pre><%= String(fields.bibtex) %></pre></details><button type="button" class="citation-button" data-citation="<%= String(fields.bibtex) %>" hidden>Cite</button><% } %></div>