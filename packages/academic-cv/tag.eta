<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>Tags - <%= s.title() %><% }) %><% block('content',()=>{ %><section class="academic-page"><h1>Tags</h1><ul><% while(a.next()){ %><li><a href="<%= a.permalink %>"><%= a.row.name %></a> (<%= a.row.count||0 %>)</li><% } %></ul></section><% }) %>