<% layout('./layout');const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},a=await firekylin.widget('Widget_Archive',{type:'index'});const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';let profile={};try{const parsed=JSON.parse(c.profileJSON||'{}');if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed))profile=parsed;}catch{} const home=a.is('index')&&(!a.pagination||a.pagination.currentPage===1);let records=[],recent;if(home){recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:Math.min(500,Math.max(10,Number(c.collectionLimit)||100))});while(recent.next())records.push({...recent.row});}const fields=row=>row.fields||row.options?.fields||{};const groups={publications:records.filter(r=>fields(r).academicType==='publication'),events:records.filter(r=>fields(r).academicType==='event'),news:records.filter(r=>!['publication','event'].includes(fields(r).academicType))}; %><% block('title',()=>{ %><%= a.archiveTitle||s.title() %><% }) %><% block('content',()=>{ %><% if(home){ %><%~ include('./inc/profile',{site:s,profile,safe}) %><% if(c.researchText){ %><section class="hbb-section academic-research"><h2><%= c.researchTitle||'My Research' %></h2><p><%= c.researchText %></p></section><% } %><% for(const [id,title,rows,style] of [['papers','Featured Publications',groups.publications.filter(r=>['true',true,1].includes(fields(r).featured)),'grid'],['publications','Recent Publications',groups.publications,'citation'],['talks','Recent & Upcoming Talks',groups.events,'card'],['news','Recent News',groups.news,'card']]){if(!rows.length)continue; %><section id="<%= id %>" class="hbb-section academic-collection"><div class="flex flex-col items-center max-w-prose mx-auto gap-3 justify-center px-6 md:px-0"><h2 class="mb-6 text-3xl font-bold text-gray-900 dark:text-white"><%= title %></h2></div><div class="flex flex-col items-center px-6"><% if(style==='citation'){ %><div class="mt-16 sm:mt-20 container max-w-3xl w-full"><div class="flex flex-col space-y-3"><% for(const row of rows){const f=fields(row); %><div class="pub-list-item view-citation"><span><%= f.authors||row.user?.display_name||'' %></span> (<%= String(row.create_time||'').slice(0,4) %>). <a class="underline" href="<%= recent.permalinkFor(row) %>"><%= row.title %></a>. <%= f.publication||'' %><%~ include('./inc/links',{row}) %></div><% } %></div></div><% }else{ %><div class="<%= style==='grid'?'container px-8 mx-auto xl:px-5 py-5 lg:py-8 '+(rows.length===1?'max-w-[500px] justify-center':'max-w-screen-lg'):'container max-w-[65ch] mx-auto my-5' %>"><div class="<%= style==='grid'?'grid gap-10 md:grid-cols-2 lg:gap-10':'grid grid-cols-1 gap-6' %>"><% for(const row of rows){ %><%~ include('./inc/card',{row,href:recent.permalinkFor(row)}) %><% } %></div></div><% } %></div></section><% } %><% }else{ %><section class="academic-page"><h1><%= a.archiveTitle||'Articles' %></h1><%~ include('./inc/list',{archive:a}) %></section><% } %><% }) %>