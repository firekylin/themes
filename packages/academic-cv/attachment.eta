<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'attachment'});let profile={};try{profile=JSON.parse((s.themeConfig||{}).profileJSON||'{}')||{};}catch{}const exists=a.next(),f=a.row.fields||a.row.options?.fields||{}; %><% block('title',()=>{ %><%= exists?a.title():s.title() %><% }) %><% block('content',()=>{ %><div class="page-body my-10"><div class="mx-auto flex max-w-screen-xl academic-detail"><aside class="academic-detail-spacer" aria-hidden="true"></aside><aside class="hb-toc order-last hidden w-64 shrink-0 xl:block px-4"><div class="academic-desktop-toc"><h2>On this page</h2><nav></nav></div></aside><article class="w-full break-words flex min-h-[calc(100vh-var(--navbar-height))] min-w-0 justify-center pb-8"><div class="w-full min-w-0 max-w-6xl px-6 pt-4 md:px-12"><% if(exists){ %><h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100"><%= a.title() %></h1><div class="mt-4 mb-16"><p class="text-gray-500 dark:text-gray-300 text-sm"><%= a.date('Y-m-d') %> · <%= f.authors||a.author('display_name') %></p><div class="mt-3"><%~ include('./inc/links',{row:a.row}) %></div></div><% if(f.academicType==='publication'||f.academicType==='event'){ %><dl class="max-w-prose grid grid-cols-1 md:grid-cols-[200px_auto] gap-4 my-6"><% for(const [key,label] of [['publicationKind','Type'],['publication','Publication'],['eventStart','Starts'],['eventEnd','Ends'],['location','Location']]){if(f[key]){ %><dt class="font-bold text-2xl"><%= label %></dt><dd><%= f[key] %></dd><% }} %></dl><% } %><details class="academic-toc" hidden><summary>Contents</summary><nav></nav></details><div class="article-body prose prose-slate lg:prose-xl dark:prose-invert"><%~ a.content() %></div><% if(profile.authorLogin && profile.authorLogin===a.row.user?.name){const avatar=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(profile.avatarUrl||''))?profile.avatarUrl:''; %><section class="academic-author"><% if(avatar){ %><img src="<%= avatar %>" width="96" height="96" alt=""><% } %><div><small>AUTHORS</small><h2><%= a.author('display_name') %></h2><strong><%= profile.role||'' %></strong><p><%= profile.bio||'' %></p></div></section><% } %><%~ firekylin.comment({title:'Comments'}) %><% }else{ %><h1>Content unavailable</h1><% } %></div></article></div></div><% }) %>