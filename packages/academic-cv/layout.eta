<% const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{}; %><!doctype html><html lang="en" class="<%= c.colorMode==='dark'?'dark':'' %>" data-color-mode="<%= ['light','dark'].includes(c.colorMode)?c.colorMode:'auto' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= s.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= s.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/firekylin.css') %>"><script defer src="<%= s.themeUrl('res/js/academic.js') %>"></script></head><body><a class="skip-link" href="#main">Skip to content</a><header id="site-header" class="header"><nav class="navbar px-3 flex justify-start"><div class="order-0 h-full"><a class="navbar-brand" href="/"><%= s.title() %></a></div><button id="academic-menu" type="button" class="order-3 lg:hidden" aria-controls="nav-menu" aria-expanded="false" aria-label="Toggle navigation" hidden><%~ include('./inc/icons/bars-3') %></button><ul id="nav-menu" class="navbar-nav order-3 lg:flex w-full pb-6 lg:order-1 lg:w-auto lg:space-x-2 lg:pb-0 xl:space-x-8 justify-start"><% for(const n of s.navigation){ %><li class="nav-item"><a class="nav-link" href="<%= n.url %>"><%= n.label %></a></li><% } %></ul><div class="order-1 ml-auto flex items-center md:order-2 lg:ml-0"><a class="px-3" href="/search.html" aria-label="Search"><%~ include('./inc/icons/magnifying-glass') %></a><button class="theme-toggle px-3" id="academic-theme" type="button" aria-label="Toggle color scheme" hidden><span class="block dark:hidden"><%~ include('./inc/icons/moon') %></span><span class="hidden dark:block"><%~ include('./inc/icons/sun') %></span></button></div></nav></header><main id="main" class="academic-main"><%~ block('content') %></main><footer class="academic-footer"><p><%= c.footerText||s.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/HugoBlox/kit">HugoBlox Academic CV</a> · <a href="/rss.html">RSS</a></p></footer><dialog id="citation-dialog" aria-labelledby="citation-title"><h2 id="citation-title">Citation</h2><pre></pre><p role="status"></p><button type="button" data-copy-citation>Copy</button><button type="button" data-save-citation>Download BibTeX</button><button type="button" data-close-citation>Close</button></dialog></body></html>