<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>Search - <%= s.title() %><% }) %><% block('content',()=>{ %><section class="academic-page"><h1>Search</h1><form action="/search.html" method="get"><label for="keyword">Keyword</label><input id="keyword" type="search" name="keyword" value="<%= a.keyword||'' %>"><button type="submit">Search</button></form><%~ include('./inc/list',{archive:a}) %></section><% }) %>