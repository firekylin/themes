<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><aside class="desktop-drawer nav"><%~ include('./inc/drawer',{site}) %></aside><details class="mobile-drawer"><summary class="menu-trigger" aria-label="打开导航">☰</summary><aside class="nav"><%~ include('./inc/drawer',{site}) %></aside></details><div class="main-shell"><header class="hero"><% if(/^(https?:\/\/|\/(?!\/))/i.test(String(cfg.cover||''))){ %><img class="hero-image" src="<%= cfg.cover %>" alt=""><% } %><h1 class="hero-title"><a href="/"><%= site.title() %></a></h1></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><span>Firekylin · Polymer · Design <a href="https://github.com/pdevty/polymer">pdevty</a></span></footer></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>