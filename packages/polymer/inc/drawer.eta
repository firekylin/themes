<% const site=firekylin.site;const cfg=site.themeConfig;const safe=value=>/^(https?:\/\/|\/(?!\/))/i.test(String(value||''))?String(value):''; %><div class="profile"><% if(safe(cfg.profile)){ %><img class="profile-bg" src="<%= safe(cfg.profile) %>" alt=""><% } %><% if(safe(cfg.photo)){ %><img class="photo" width="64" height="64" src="<%= safe(cfg.photo) %>" alt=""><% } %><p class="author"><%= cfg.authorName||site.title() %></p></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav>