<% const archive=firekylin.archive;let count=0; %><div class="content"><% while(archive.next()){count++;const locked=archive.row.password_protected||archive.row.title==='此内容被密码保护'||archive.row.options?.postPasswordHash;const meta=locked?{}:(firekylin.metaByPost?.get(archive.row.id)||archive.row); %><article class="article entry"><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="categories"><% (meta.cate||[]).forEach(c=>{ %><a href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a><% }); %></div><p class="description"><%= archive.excerpt(300) %></p><div class="tags"><time><%= archive.date('YYYY-MM-DD') %></time><% (meta.tag||[]).forEach(t=>{ %><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>">#<%= t.name %></a><% }); %></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>