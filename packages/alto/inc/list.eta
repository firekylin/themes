<% const archive=firekylin.archive;let count=0; %><div class="post-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><figure class="post-media gh-canvas"><a class="post-image-link" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><div class="gh-canvas"><header class="post-header"><h2 class="post-title"><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><div class="post-excerpt"><%= archive.excerpt(220) %></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>