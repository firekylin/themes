<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div class="container"><header id="header"><div class="header-extra"><%= site.themeConfig.headerText||'' %></div><a id="site-title" href="/"><% if(safe(site.themeConfig.logoUrl)){ %><img src="<%= site.themeConfig.logoUrl %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><p class="site-desc"><%= site.description() %></p></header><nav id="navigation" aria-label="主导航"><ul><li><a href="/">首页</a></li><li><a href="/archives">文章归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %><li><a href="/search.html">搜索</a></li></ul></nav><div class="columns <%= site.themeConfig.sidebarPosition==='left'?'sidebar-left':'' %>"><main id="main"><%~ block('content') %></main><aside id="sidebar"><section class="widget-container"><h2 class="widget-title">搜索</h2><form action="/search.html" method="get"><label class="sr-only" for="sidebar-keyword">关键词</label><input id="sidebar-keyword" name="keyword" required><button>搜索</button></form></section><section class="widget-container"><h2 class="widget-title">最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="widget-container"><h2 class="widget-title">文章分类</h2><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.row.name %></a></li><% } %></ul></section><section class="widget-container"><h2 class="widget-title">订阅</h2><a href="/rss.html">RSS</a></section></aside></div><footer id="footer"><p>© <%= new Date().getFullYear() %> <%= site.title() %></p><p id="credits"><a href="https://github.com/simplethemes/skeleton_wp">Skeleton</a> by <a href="https://www.simplethemes.com">Simple Themes</a> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></footer></div></body></html>