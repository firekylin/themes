<% const archive=firekylin.archive;let count=0;const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><% while(archive.next()){count++;const cover=(archive.row.options||{}).featuredImage; %><article class="post"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta">发表于 <time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div><div class="entry-summary"><% if(safe(cover)){ %><a class="post-image" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><%~ archive.excerpt(250) %></div><div class="entry-utility"><a class="more-link" href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>