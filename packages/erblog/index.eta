<% layout('./layout');const site=await firekylin.widget('Widget_Options');const sidebar=await includeAsync('./inc/sidebar');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><section class="about"><div class="about_left"><% const cfg=site.themeConfig,avatar=String(cfg.profileImage||'');if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="about_portrait" src="<%= avatar %>" alt=""><% } %><h1><%= cfg.authorName||site.title() %></h1><h2><%= site.description() %></h2></div><div class="about_right"><h1>关于本站</h1><h2><%= cfg.biography||site.description() %></h2></div></section><div class="recent native-columns"><div class="native-feed"><h2>近期文章</h2><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><%~ sidebar %></div><% }) %>