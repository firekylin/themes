<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="self-elem-quote entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p><p class="summary"><%= archive.excerpt(250) %> <a href="<%= archive.permalink %>" style="color:#01AAED">阅读全文</a></p></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>