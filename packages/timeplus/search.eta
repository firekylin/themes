<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %><%= archive.archiveTitle||'搜索' %> <%= site.title() %><% }) %><% block('content',()=>{ %><section class="album-reading"><h1>搜索：<%= archive.keyword %></h1><form action="/search.html" method="get" role="search"><label for="keyword">关键词</label><input id="keyword" name="keyword" value="<%= archive.keyword %>" required><button type="submit">搜索</button></form></section><%~ include('./inc/list',{archive}) %><% if(!archive.have()){ %><p class="empty">暂无照片或文章。</p><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>