<% const site=await firekylin.widget('Widget_Options');const cats=await firekylin.widget('Widget_Metas_Category_List'); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body><a class="skip-link" href="#content">跳转到正文</a><header id="header"><h1><a href="/"><strong><%= site.title() %></strong></a></h1><span class="discription"><%= site.description() %></span><nav aria-label="主导航"><ul><li><details class="album-menu"><summary>分类</summary><div><a href="/">全部</a><% while(cats.next()){ %><a href="<%= cats.permalink %>"><%= cats.row.name %></a><% } %><a href="/archives">归档</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(nav=>{ %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %></div></details></li><li><button type="button" id="fullscreen" hidden>全屏</button></li><li><a href="#footer" id="about-open">关于</a></li></ul></nav></header><div id="wrapper"><main id="content"><%~ block('content') %></main><footer id="footer"><h2>关于 <%= site.title() %></h2><p><%= site.themeConfig.aboutText||site.description() %></p><p class="copyright-info">TimePlus by <a href="https://github.com/zhheo/TimePlus">ZHHEO</a> / <a href="https://github.com/wclk/time">ZMKI</a> · Design <a href="https://html5up.net">HTML5 UP</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></p><button type="button" id="about-close" hidden>关闭</button></footer></div><script defer src="<%= site.themeUrl('res/js/timeplus.js') %>"></script></body></html>
