<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }); %><% block('content',()=>{ %><% if(found){ %><article class="album-reading"><h1><%= archive.title() %></h1><time><%= archive.date('YYYY-MM-DD') %></time><div class="post-content"><%~ archive.content() %></div><p><% (archive.row.cate||[]).forEach(cat=>{ %><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a> <% }); %><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>">#<%= tag.name %></a> <% }); %></p></article><% const comments=firekylin.comment({title:'评论'});if(comments){ %><section class="album-reading timeplus-comments"><%~ comments %></section><% } %><% }else{ %><p>暂无内容。</p><% } %><% }); %>