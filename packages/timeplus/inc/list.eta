<% const archive=firekylin.archive; %><div id="main"><% while(archive.next()){const cover=String(archive.row.featuredImage||''); %><article class="thumb"><a class="image" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><h2><%= archive.title() %></h2><span class="album-date"><%= archive.date('YYYY-MM-DD') %></span><button type="button" class="album-open" hidden>查看相册</button></article><% } %></div>