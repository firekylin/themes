<% const archive=firekylin.archive; %><div class="article-list"><% while(archive.next()){const cover=String((archive.row.options||{}).featuredImage||''); %><article class="article-link"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="thumbnail" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% } %><% if(!archive.have()){ %><p>暂无文章。</p><% } %></div>