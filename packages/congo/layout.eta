<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/scheme.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/congo.css') %>"><script defer src="<%= site.themeUrl('res/js/congo.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转正文</a><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><nav aria-label="主导航"><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">Blog</a><a href="/tags">Tags</a><a href="/search.html">搜索</a><button id="appearance" aria-label="切换深色模式" aria-pressed="false" hidden>☾</button></nav></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><p>© <%= new Date().getFullYear() %> <%= site.title() %></p><p><a href="https://github.com/jpanther/congo">Congo</a> by James Panther · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></p></footer><a class="to-top" href="#top" aria-label="回到顶部">↑</a></body></html>