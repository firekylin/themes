<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const avatar=String(cfg.avatar||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% }else if(!archive.pagination||archive.pagination.currentPage===1){ %><section class="home-intro <%= cfg.homeLayout==='page'?'page-home':'profile-home' %>"><% if(cfg.homeLayout!=='page'&&/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="avatar" src="<%= avatar %>" alt="<%= cfg.name||site.title() %>"><% } %><h1><%= cfg.name||site.title() %></h1><p class="bio"><%= cfg.bio||site.description() %></p><% if(/^https:\/\//.test(String(cfg.github||''))){ %><a class="author-link" href="<%= cfg.github %>" rel="me">GitHub</a><% } %><% if(cfg.intro){ %><p class="intro-text"><%= cfg.intro %></p><% } %></section><h2 class="recent-heading">Recent</h2><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>