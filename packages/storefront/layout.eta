<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="col-full"><div class="header-top"><div class="site-branding"><a class="site-title" href="/"><% if(safe(site.themeConfig.logoUrl)){ %><img src="<%= site.themeConfig.logoUrl %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><p class="site-description"><%= site.description() %></p></div><form class="site-search" action="/search.html" method="get" role="search"><label class="sr-only" for="header-keyword">搜索文章</label><input type="search" id="header-keyword" name="keyword" placeholder="Search posts…" required><button aria-label="搜索文章">⌕</button></form></div><details class="site-menu" open><summary>Menu</summary><nav aria-label="主导航"><a href="/">Home</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">Archives</a><a href="/categories">Categories</a><a href="/search.html">搜索</a></nav></details></div></header><div class="col-full site-content"><main id="main"><%~ block('content') %></main><aside class="widget-area"><section class="widget"><h2>Recent Posts</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="widget"><h2>Categories</h2><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.row.name %></a></li><% } %></ul><a href="/categories">All categories</a></section><section class="widget"><h2>Explore</h2><ul><li><a href="/archives">Archives</a></li><li><a href="/tags">Tags</a></li><li><a href="/rss.html">RSS</a></li></ul></section></aside></div><footer class="site-footer"><div class="col-full site-info">© <%= site.title() %> <%= new Date().getFullYear() %><br>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · Built with <a href="https://github.com/woocommerce/storefront">Storefront</a></div></footer></body></html>