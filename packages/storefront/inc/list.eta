<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String((archive.row.options||{}).featuredImage||''); %><article class="hentry"><header class="entry-header"><div class="post-meta">Posted on <a href="<%= archive.permalink %>"><time><%= archive.date('YYYY-MM-DD') %></time></a> by <%= archive.author('display_name') %></div><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-content"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a href="<%= archive.permalink %>"><img class="post-image" src="<%= cover %>" alt="" loading="lazy"></a><% } %><p><%~ archive.excerpt(300) %></p><p><a href="<%= archive.permalink %>">Continue reading</a></p></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>