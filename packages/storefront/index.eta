<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% }else if(site.themeConfig.introTitle&&archive.pagination?.currentPage===1){ %><section class="welcome"><h1><%= site.themeConfig.introTitle %></h1><p><%= site.themeConfig.introText||site.description() %></p></section><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>