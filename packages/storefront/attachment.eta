<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next();const cover=found?String((archive.row.options||{}).featuredImage||''):''; %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="hentry"><header class="entry-header"><div class="post-meta">Posted on <time><%= archive.date('YYYY-MM-DD') %></time> by <%= archive.author('display_name') %></div><h1 class="entry-title"><%= archive.title() %></h1></header><div class="entry-content"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="post-image" src="<%= cover %>" alt=""><% } %><%~ archive.content() %></div><aside class="entry-taxonomy"><div>Categories: <% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %></div><div>Tags: <% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div></aside><%~ firekylin.comment({title:'评论'}) %></article><% }else{ %><p>暂无内容。</p><% } %><% }) %>