<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><figure class="featured-media"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><div class="post-inner section-inner thin"><div class="post-header"><div class="post-meta top"><time><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></div><div class="post-content entry-content"><p><%= archive.excerpt(300) %></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>