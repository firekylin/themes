<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categoryByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate').select();related.forEach(p=>categoryByPost.set(p.id,p.cate?.[0]?.name||'未分类'));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><h1 class="page-header"><%= archive.archiveTitle||site.title() %></h1><%~ include('./inc/list',{archive,categoryByPost}) %><%~ include('./inc/pagination',{archive}) %><% }) %>