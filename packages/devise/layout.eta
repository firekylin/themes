<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><% const avatar=String(cfg.avatarUrl||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(avatar); %><div id="content"><header class="profile-header"><div class="profile-row <%= valid?'has-avatar':'' %>"><% if(valid){ %><a href="/"><img id="home-image" class="rounded-circle" src="<%= avatar %>" alt=""></a><% } %><div class="profile-text"><h2><a href="/"><%= site.title() %></a></h2><p><%= site.description() %></p><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><hr></header><main id="main"><%~ block('content') %></main></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/austingebauer/devise">Devise</a> · Austin Gebauer</p></footer></body></html>