<% const archive=firekylin.archive;const posts=[];while(archive.next()){posts.push({title:archive.title(),url:archive.permalink,date:archive.date('YYYY-MM-DD'),cate:archive.row.cate?.[0]?.name||'未分类'});}const groups=new Map();posts.forEach(x=>{if(!groups.has(x.cate))groups.set(x.cate,[]);groups.get(x.cate).push(x);}); %><div class="home-groups"><% if(!archive.archiveTitle&&posts.length){ %><section class="group"><h2><span class="category">最近发布</span></h2><ul class="post-list recent"><% posts.slice(0,7).forEach(x=>{ %><li><time><%= x.date %></time> <a href="<%= x.url %>"><%= x.title %></a></li><% }); %></ul></section><% } %><% for(const [name,items] of groups){ %><section class="group"><h2><span class="category"><%= name %></span></h2><ul class="post-list"><% items.forEach(x=>{ %><li class="entry"><time><%= x.date %></time> <a href="<%= x.url %>"><%= x.title %></a></li><% }); %></ul></section><% } %></div><% if(!posts.length){ %><p>暂无文章。</p><% } %>