<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry native-hero"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><a href="<%= archive.permalink %>" class="post-header section medium-padding"><div class="post-meta-top"><time><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="post-title"><%= archive.title() %></h2></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>