<% if(firekylin.depth<8){ %><ul><% for(const [i,n] of firekylin.nodes.slice(0,100).entries()){if(!n||typeof n!=='object')continue;const url=firekylin.safe(n.url),children=Array.isArray(n.children)?n.children:[],id=firekylin.prefix+'-'+i; %><li><% if(children.length){ %><input type="checkbox" class="toggle" id="<%= id %>" <%= n.collapsed===true?'':'checked' %> aria-label="Expand <%= String(n.label||'Section') %>"><label for="<%= id %>"><a <% if(url){ %>href="<%= url %>"<% } %>><%= String(n.label||'Section') %></a><%~ include('./chevron-right') %></label><%~ include('./tree',{nodes:children,depth:firekylin.depth+1,prefix:id,safe:firekylin.safe}) %><% }else{ %><a <% if(url){ %>href="<%= url %>"<% } %>><%= String(n.label||'Untitled') %></a><% } %></li><% } %></ul><% } %>
