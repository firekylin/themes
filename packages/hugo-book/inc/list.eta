<% const a=firekylin.archive; if(!a.have()){ %><p>No articles found.</p><% }while(a.next()){ %><article class="markdown book-post"><h2><a href="<%= a.permalink %>"><%= a.title() %></a></h2><p class="text-small"><time><%= a.date('Y-m-d') %></time> · <%= a.author('display_name') %></p><div class="book-post-content"><%= a.excerpt(280,true) %></div></article><% } %><%~ include('./pagination',{archive:a}) %>
