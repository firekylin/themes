<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'index'}),doc=s.themeConfig?.homeMode==='document'&&a.is('index')&&(!a.pagination||a.pagination.currentPage===1);let recent;if(doc)recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:1}); %><% block('title',()=>{ %><%= a.archiveTitle||s.title() %><% }) %><% block('content',()=>{ %><% if(doc&&recent.next()){ %><article class="markdown book-article"><h1><%= recent.title() %></h1><div class="article-body"><%~ recent.content() %></div></article><% }else{ %><h1><%= a.archiveTitle||s.title() %></h1><%~ include('./inc/list',{archive:a}) %><% } %><% }) %>
