<% const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';const colors=['light','dark','auto','contrast-light','contrast-dark','contrast-auto','catppuccin-light','catppuccin-dark','catppuccin-auto','ayu-light','ayu-dark','ayu-auto'];let tree=[];try{const x=JSON.parse(c.menuJSON||'[]');if(Array.isArray(x))tree=x;}catch{}if(!tree.length)tree=s.navigation;const toc=c.showTOC!=='false'; %><!doctype html><html lang="<%= c.language||'en' %>" dir="<%= c.direction==='rtl'?'rtl':'ltr' %>" data-theme="<%= colors.includes(c.colorMode)?c.colorMode:'light' %>" data-layout="centered"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= s.description() %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><script defer src="<%= s.themeUrl('res/js/book.js') %>"></script></head><body dir="<%= c.direction==='rtl'?'rtl':'ltr' %>"><a class="skip-link" href="#main">Skip to content</a><div class="book-container flex"><aside id="book-menu-panel" class="book-menu" aria-label="Documentation"><div class="book-menu-content"><nav><%~ include('./inc/brand',{site:s,logo:safe(c.logoUrl)}) %><form class="book-search" method="get" action="/search.html" role="search"><input name="keyword" type="search" placeholder="Search" aria-label="Search documentation" enterkeyhint="search"></form><%~ include('./inc/tree',{nodes:tree,depth:0,prefix:'book-tree',safe}) %><ul><li><a href="/archives">Archives</a></li><li><a href="/categories">Categories</a></li></ul></nav></div></aside><header class="book-header hidden"><div class="flex align-center justify-between gap"><input type="checkbox" class="toggle" id="menu-control" aria-label="Menu" aria-controls="book-menu-panel"><label for="menu-control" aria-label="Menu"><%~ include('./inc/menu') %></label><%~ include('./inc/brand',{site:s,logo:safe(c.logoUrl)}) %><% if(toc){ %><input type="checkbox" class="toggle" id="toc-control" aria-label="Table of contents" aria-controls="book-toc-panel"><label for="toc-control" aria-label="Table of contents"><%~ include('./inc/toc') %></label><% }else{ %><span></span><% } %></div></header><main class="book-page" id="main"><%~ block('content') %><footer class="book-footer"><p><%= c.footerText||s.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/alex-shpak/hugo-book">Hugo Book</a> · <a href="/rss.html">RSS</a></p></footer><label for="menu-control" class="hidden book-menu-overlay" aria-hidden="true"></label></main><% if(toc){ %><aside class="book-toc" aria-label="Table of contents" id="book-toc-panel"><div class="book-toc-content"><nav id="TableOfContents"></nav></div></aside><% } %></div></body></html>
