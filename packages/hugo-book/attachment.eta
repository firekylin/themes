<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'attachment'}),exists=a.next(),fields=a.row.fields||a.row.options?.fields||{}; %><% block('title',()=>{ %><%= exists?a.title():s.title() %><% }) %><% block('content',()=>{ %><article class="markdown book-article"><% if(exists){ %><h1><%= a.title() %></h1><p class="text-small"><time><%= a.date('Y-m-d') %></time> · <%= a.author('display_name') %></p><div class="article-body"><%~ a.content() %></div><% }else{ %><h1>Content unavailable</h1><% } %></article><% if(exists){const edit=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(fields.bookEditUrl||''))?fields.bookEditUrl:'';if(edit){ %><p><a href="<%= edit %>">Edit this page</a></p><% } %><%~ firekylin.comment({className:'book-comments',title:'Comments'}) %><% } %><% }) %>
