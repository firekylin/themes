<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>Search - <%= s.title() %><% }) %><% block('content',()=>{ %><article class="markdown"><h1>Search</h1><form class="book-search" action="/search.html" method="get"><input name="keyword" type="search" value="<%= a.keyword||'' %>" aria-label="Search"><button type="submit">Search</button></form></article><%~ include('./inc/list',{archive:a}) %><% }) %>
