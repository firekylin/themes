<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>Archives - <%= s.title() %><% }) %><% block('content',()=>{ %><article class="markdown"><h1>Archives</h1><% for(const [month,rows] of Object.entries(a.grouped||{})){ %><h2><%= month %></h2><ul><% for(const row of rows){ %><li><a href="<%= a.permalinkFor(row) %>"><%= row.title %></a></li><% } %></ul><% } %></article><% }) %>
