<% const archive=firekylin.archive;let count=0; %><div class="columns is-multiline iris-cards"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><div class="column is-half"><a class="entry normal-link" href="<%= archive.permalink %>"><article class="card"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><figure class="card-image"><img src="<%= cover %>" alt="" loading="lazy"></figure><% } %><div class="card-content"><h2 class="title card-title"><%= archive.title() %></h2><p><%= archive.excerpt(180) %></p><p><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></p></div></article></a></div><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>