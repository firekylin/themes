<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/toc.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header><section class="hero is-dark is-bold iris-hero"><div class="hero-head"><div class="navbar"><div class="container"><div class="navbar-brand"><a class="navbar-item" href="/"><%= site.title() %></a></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></div><div class="hero-body"><div class="columns"><div class="column is-8 is-offset-2"><%~ block('hero',()=>{ %><h1 class="title is-spaced"><%= site.title() %></h1><p class="subtitle is-6"><%= site.description() %></p><% }) %></div></div></div></section></header><main id="main" class="hero is-dark iris-main"><div class="columns"><div class="column is-8 is-offset-2"><section class="section"><%~ block('content') %></section></div></div></main><footer class="footer hero is-dark is-bold iris-footer"><div class="content has-text-centered container"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/peaceiris/hugo-theme-iris">IRIS Theme</a></p></div></footer></body></html>