<% /* Modified from Fuji list: native archive, escaped summaries and date metadata. */ const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><h2 class="post-item post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-item post-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div><div class="post-item post-summary markdown-body"><p><%= archive.excerpt(260) %></p></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>