<% /* Modified from Fuji Hugo layout for native Firekylin widgets and visible mobile navigation. */ %><% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body data-theme="auto"><a class="skip" href="#main">跳转到正文</a><header><div class="container-lg"><div class="col-12 header"><a class="title-main" href="/"><%= site.title() %></a><span class="title-sub"><%= site.description() %></span></div></div></header><div class="container-lg"><div class="col-12 site-controls"><button class="theme-toggle" type="button" aria-pressed="false" hidden>切换为深色</button></div></div><div class="container-lg native-body"><main id="main" class="col-12 col-md-9 content"><%~ block('content') %></main><aside class="col-12 col-md-3 sidebar"><div class="sidebar-item sidebar-pages"><h3>导航</h3><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><div class="sidebar-item sidebar-tags"><h3>标签</h3><div class="native-tags"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% } %></div></div><div class="sidebar-item"><h3>关于</h3><p><%= cfg.footerText||site.description() %></p></div></aside></div><footer class="native-footer"><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/dsrkafuu/hugo-theme-fuji">Fuji</a></p></footer></body></html>