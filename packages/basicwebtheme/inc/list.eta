<% const archive=firekylin.archive;const cfg=firekylin.config||{};let count=0; %><% while(archive.next()){count++; %><article class="entry"><div class="post-header"><% if(cfg.titleStyle==='compact'){ %><em class="compact-title"><%= archive.title() %></em> — <% }else{ %><h2><%= archive.title() %></h2><% } %><a class="entry-link" href="<%= archive.permalink %>"><em><% if(cfg.showDate==='hide'){ %><small><%= archive.permalink %></small><% }else{ %><%= archive.date('YYYY-MM-DD') %><% } %></em></a></div><div class="list-content"><p><%= archive.excerpt(200) %></p></div><hr></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>