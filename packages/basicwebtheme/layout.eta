<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><a href="/"><% if(cfg.headerText){ %><h1><%= cfg.headerText %></h1><% }else if(/^(https?:\/\/|\/(?!\/))/i.test(String(cfg.headerImage||''))){ %><img src="<%= cfg.headerImage %>" alt="<%= site.title() %>"><% }else{ %><h1><%= site.title() %></h1><% } %></a><hr></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><hr><nav class="native-nav nav-items" aria-label="主导航"><ul><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %><% if(cfg.updatedText){ %><li><em id="updated">更新：<%= cfg.updatedText %></em></li><% } %></ul></nav><p><%= cfg.footerText||site.description() %></p><small>Firekylin · <a href="https://github.com/mdashx/basicwebtheme">Basic Web Theme</a> · <%= cfg.authorName||site.title() %></small></footer></body></html>