<% const archive=firekylin.archive;let count=0; %><div class="entries-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="entry"><header class="entry-header"><h3 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3></header><footer class="entry-meta"><ul><li><time><%= archive.date('YYYY-MM-DD') %></time></li></ul></footer><div class="entry-excerpt"><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>