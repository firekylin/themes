<% const archive=firekylin.archive;let count=0; %><div class="post-grid"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row; %><article class="entry card card-hover"><div class="card-body"><div class="card-categories"><% (meta.cate||[]).forEach(c=>{ %><a class="link-cta" href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a><% }); %></div><h2 class="card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-meta"><%= archive.date('YYYY-MM-DD') %></p><p class="card-text"><%= archive.excerpt(260) %></p><div class="card-tags"><% (meta.tag||[]).forEach(t=>{ %><a class="link-tag text-dark" href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>">#<%= t.name %></a><% }); %></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>