<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><main id="main"><%~ block('content') %></main><footer class="site-footer"><div class="container"><div class="footer-top"><section class="footer-description"><h2 class="h5"><a href="/"><%= site.title() %></a></h2><p><%= cfg.footerText||site.description() %></p></section><section><h2 class="h5">Menu</h2><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></section></div><hr><p class="footer-author"><%= cfg.authorName||site.title() %></p><p class="text-muted">Firekylin · <a href="https://github.com/10mohi6/hugo-theme-simple-blog">Simple Blog</a> · 10mohi6</p></div></footer></body></html>