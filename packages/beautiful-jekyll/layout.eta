<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="navbar"><a class="brand" href="/"><%= site.title() %></a><input id="nav-trigger" type="checkbox" aria-label="切换导航菜单"><label class="menu-toggle" for="nav-trigger" aria-label="切换导航菜单">☰</label><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><a class="avatar" href="/"><img src="<%= avatar %>" alt="导航头像"></a><% } %></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><a href="/categories">分类</a> · <a href="/tags">标签</a></p><p><%= cfg.authorName||site.title() %> · <%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/daattali/beautiful-jekyll">Beautiful Jekyll</a> 原生改编</p></footer></body></html>