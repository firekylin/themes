<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="page-heading"><h1><%= archive.archiveTitle||site.title() %></h1><hr><p><%= site.description() %></p></header><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>