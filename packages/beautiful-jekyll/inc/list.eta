<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="meta">Posted on <time><%= archive.date('YYYY-MM-DD') %></time></p><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="entry-image" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="excerpt"><%~ archive.excerpt(260) %> <a class="read-more" href="<%= archive.permalink %>">[Read More]</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>