<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><div class="inner"><div class="box post-box"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><span class="post-meta"><%= archive.author('display_name') %> · <time><%= archive.date('YYYY-MM-DD') %></time></span><p class="post-excerpt"><%= archive.excerpt(240) %></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>