{
  "name": "archer",
  "title": "Archer",
  "version": "0.1.0",
  "private": true,
  "description": "Archer photo hero, profile column and archive drawer.",
  "license": "MIT",
  "author": "fi3ework; Firekylin contributors",
  "homepage": "https://github.com/fi3ework/hexo-theme-archer",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/archer"
  },
  "firekylin": {
    "type": "theme",
    "id": "archer"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "profileName",
      "label": "侧栏名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "侧栏介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像图片",
      "help": "可选站内路径或 HTTPS 图片。"
    },
    {
      "type": "text",
      "name": "coverUrl",
      "label": "横幅背景",
      "help": "可选站内路径或 HTTPS 图片；留空使用深色底。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，可留空。"
    }
  ]
}
