<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(230) %></div><p class="entry-bottom"><time><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>">继续阅读 →</a></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>