<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:30});const cats=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const valid=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||''));const heading=block('heading'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><progress id="read-progress" max="100" value="0" hidden aria-label="阅读进度"></progress><details id="sidebar"><summary aria-label="切换侧栏菜单">☰</summary><div class="sidebar-panel"><nav class="tabs" aria-label="侧栏栏目"><a href="#drawer-archive">Archive</a><a href="#drawer-tag">Tag</a><a href="#drawer-cate">Cate</a></nav><section id="drawer-archive"><h2>最近文章</h2><% while(recent.next()){ %><a href="<%= recent.permalink %>"><%= recent.title() %></a><% } %><a href="/archives">全部归档 →</a></section><section id="drawer-tag"><h2>标签</h2><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %><a href="/tags">全部标签 →</a></section><section id="drawer-cate"><h2>分类</h2><% cats.stack.forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><a href="/categories">全部分类 →</a></section><form action="/search.html" method="get"><label for="drawer-search">搜索</label><input id="drawer-search" name="keyword" required><button>搜索</button></form></div></details><header class="intro"><% if(valid(site.themeConfig.coverUrl)){ %><img class="intro-image" src="<%= site.themeConfig.coverUrl %>" alt=""><% } %><a class="brand" href="/"><%= site.title() %></a><div class="intro-title"><% if(heading){ %><%~ heading %><% }else{ %><h1><%= site.title() %></h1><p><%= site.description() %></p><% } %></div></header><div class="container"><aside class="profile"><% if(valid(site.themeConfig.avatarUrl)){ %><img src="<%= site.themeConfig.avatarUrl %>" alt=""><% } %><h2><%= site.themeConfig.profileName||site.title() %></h2><p><%= site.themeConfig.profileBio||site.description() %></p><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/rss.html">RSS</a></nav></aside><main id="main"><%~ block('content') %></main></div><footer class="site-footer"><p><%= site.themeConfig.footerText||site.title() %></p><a href="https://github.com/fi3ework/hexo-theme-archer">Archer</a> · Firekylin</footer></body></html>