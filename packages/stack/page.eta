<% layout('./layout');const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},a=await firekylin.widget('Widget_Archive',{type:'page'});const exists=a.next(); %><% block('title',()=>{ %><%= exists?a.title():s.title() %> - <%= s.title() %><% }) %><% block('content',()=>{ %><% if(exists){ %><article class="main-article <%= a.row.featuredImage||a.row.options?.featuredImage?'has-image':'' %>"><%~ include('./inc/header',{archive:a,detail:true}) %><% if(c.showToc!=='false'){ %><aside class="article-toc" hidden><details><summary><div class="article-toc-title"><%~ include('./inc/icons/chevron-right') %><span>目录</span></div></summary><nav class="toc-nav" data-mobile-toc></nav></details></aside><% } %><section class="article-content"><%~ a.content() %></section><footer class="article-footer"><% if(typeof a.tags==='function'){ %><section class="article-tags"><%~ a.tags(' ',true,'') %></section><% } %></footer></article><%~ firekylin.comment({className:'stack-comments',title:'评论'}) %><% }else{ %><h1>内容不存在</h1><% } %><% }) %>