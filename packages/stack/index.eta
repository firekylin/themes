<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= a.archiveTitle || s.title() %><% }) %><% block('content',()=>{ %><% if(a.archiveTitle){ %><header class="section-header"><h1 class="section-title"><%= a.archiveTitle %></h1></header><% } %><%~ include('./inc/list',{archive:a}) %><% }) %>