<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>归档 - <%= s.title() %><% }) %><% block('content',()=>{ %><h1 class="section-title">归档</h1><% for(const [month,posts] of Object.entries(a.grouped||{})){ %><section class="archives-group"><h2 class="archives-date section-title"><%= month %></h2><div class="article-list--compact"><% for(const p of posts){ %><article><a href="<%= a.permalinkFor(p) %>"><div class="article-details"><h2 class="article-title"><%= p.title %></h2><footer class="article-time"><%= String(p.create_time).slice(0,10) %></footer></div></a></article><% } %></div></section><% } %><% }) %>