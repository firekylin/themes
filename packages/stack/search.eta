<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 - <%= s.title() %><% }) %><% block('content',()=>{ %><form class="search-form" action="/search.html" method="get"><p><label for="keyword">搜索</label><input id="keyword" name="keyword" value="<%= a.keyword||'' %>" required><button type="submit" aria-label="搜索"><%~ include('./inc/icons/search') %></button></p></form><%~ include('./inc/list',{archive:a}) %><% }) %>