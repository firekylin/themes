<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>标签 - <%= s.title() %><% }) %><% block('content',()=>{ %><h1 class="section-title">标签</h1><div class="article-list--compact"><% while(a.next()){ %><article><a href="<%= a.permalink %>"><div class="article-details"><h2 class="article-title"><%= a.row.name %></h2><footer class="article-time"><%= a.row.count||0 %> 篇文章</footer></div></a></article><% } %></div><% }) %>