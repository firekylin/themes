<% const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},a=await firekylin.widget('Widget_Archive');const detail=['post','page','attachment'].some(t=>a.is(t));const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):''; %>
<!doctype html><html lang="zh-CN" data-scheme="<%= c.colorMode==='dark'?'dark':'light' %>" data-default-scheme="<%= ['light','dark'].includes(c.colorMode)?c.colorMode:'auto' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= s.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= s.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/firekylin.css') %>"><script defer src="<%= s.themeUrl('res/js/stack.js') %>"></script></head><body class="<%= detail?'article-page':'' %>" data-copy="<%= c.showCopy==='false'?'false':'true' %>"><a class="skip-link" href="#main">跳转到正文</a><div class="container main-container flex on-phone--column extended">
<aside class="sidebar left-sidebar sticky <%= c.compact==='true'?'compact':'' %>"><button class="hamburger hamburger--spin" type="button" id="toggle-menu" aria-label="切换导航" aria-expanded="false" aria-controls="main-menu" hidden><span class="hamburger-box"><span class="hamburger-inner"></span></span></button><header><% if(safe(c.avatarUrl)){ %><figure class="site-avatar"><a href="/"><img class="site-logo" src="<%= safe(c.avatarUrl) %>" width="100" height="100" alt="站点头像"></a><% if(c.emoji){ %><span class="emoji"><%= c.emoji %></span><% } %></figure><% } %><div class="site-meta"><h1 class="site-name"><a href="/"><%= s.title() %></a></h1><h2 class="site-description"><%= c.subtitle || s.description() %></h2></div></header>
<ol class="menu show" id="main-menu"><% for(const n of s.navigation){const icon=n.url==='/'?'home':n.url.includes('archive')?'archives':n.url.includes('categor')?'categories':'hash'; %><li><a href="<%= n.url %>"><%~ include('./inc/icons/'+icon) %><span><%= n.label %></span></a></li><% } %><li><a href="/search.html"><%~ include('./inc/icons/search') %><span>搜索</span></a></li><li><a href="/rss.html"><%~ include('./inc/icons/rss') %><span>RSS</span></a></li><li class="menu-bottom-section"><button type="button" id="dark-mode-toggle" hidden aria-label="切换深浅色"><%~ include('./inc/icons/toggle-left') %><%~ include('./inc/icons/toggle-right') %><span>深色模式</span></button></li></ol></aside>
<aside class="sidebar right-sidebar sticky"><% if(detail && c.showToc!=='false'){ %><section class="widget archives stack-toc-widget" hidden><div class="widget-icon"><%~ include('./inc/icons/hash') %></div><h2 class="widget-title section-title">目录</h2><div class="widget--toc"><nav class="toc-nav" id="TableOfContents"></nav></div></section><% } else { %><form action="/search.html" method="get" class="search-form widget"><p><label for="sidebar-search">搜索</label><input id="sidebar-search" name="keyword" placeholder="输入关键词" required><button title="搜索"><%~ include('./inc/icons/search') %></button></p></form><% for(const [name,title,icon] of [['Widget_Metas_Category_List','分类','categories'],['Widget_Metas_Tag_Cloud','标签','tag']]){const terms=await firekylin.widget(name); %><section class="widget tagCloud"><div class="widget-icon"><%~ include('./inc/icons/'+icon) %></div><h2 class="widget-title section-title"><%= title %></h2><div class="tagCloud-tags"><% while(terms.next()){ %><a href="<%= terms.permalink %>"><%= terms.row.name %></a><% } %></div></section><% } %><% } %></aside>
<main class="main full-width" id="main"><%~ block('content') %><footer class="site-footer"><section class="copyright"><%= c.footerText || s.title() %></section><section class="powerby">Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a><br>Theme <a href="https://github.com/CaiJimmy/hugo-theme-stack">Stack</a> by <a href="https://jimmycai.com">Jimmy Cai</a></section></footer></main></div></body></html>