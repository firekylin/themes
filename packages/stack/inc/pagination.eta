<% const a=firekylin.archive,p=a.pagination;if(p&&p.totalPages>1){const nums=[...new Set([1,p.totalPages,p.currentPage-1,p.currentPage,p.currentPage+1])].filter(n=>n>=1&&n<=p.totalPages).sort((a,b)=>a-b); %><nav class="pagination" aria-label="分页"><% if(p.currentPage>1){ %><a class="page-link" rel="prev" aria-label="上一页" href="<%= a.pageUrl(p.currentPage-1) %>">‹</a><% } %><% let prev=0;for(const n of nums){if(prev&&n-prev>1){ %><span class="page-link">…</span><% }prev=n; %><a class="page-link <%= n===p.currentPage?'current':'' %>" <%= n===p.currentPage?'aria-current=page':'' %> href="<%= a.pageUrl(n) %>"><%= n %></a><% } %><% if(p.currentPage<p.totalPages){ %><a class="page-link" rel="next" aria-label="下一页" href="<%= a.pageUrl(p.currentPage+1) %>">›</a><% } %></nav><% } %>