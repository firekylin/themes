<% const a=firekylin.archive;const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';const hue=value=>{let hash=2166136261;for(const byte of Buffer.from(String(value)))hash=Math.imul(hash^byte,16777619)>>>0;return hash%360;};const image=safe(a.row.featuredImage||a.row.options?.featuredImage); %><header class="article-header"><% if(image){ %><div class="article-image"><a href="<%= a.permalink %>"><img src="<%= image %>" loading="lazy" alt=""></a></div><% } %><div class="article-details"><% if(a.row.cate?.length){ %><header class="article-category"><% for(const category of a.row.cate){ %><a href="/cate/<%= category.pathname %>" style="background-color:hsl(<%= hue(category.name) %>,60%,84%);color:hsl(<%= hue(category.name) %>,60%,15%)"><%= category.name %></a><% } %></header><% } %><div class="article-title-wrapper"><% if(firekylin.detail){ %><h1 class="article-title"><%= a.title() %></h1><% } else { %><h2 class="article-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h2><% } %><% if(a.row.description || a.row.fields?.subtitle){ %><h3 class="article-subtitle"><%= a.row.description || a.row.fields.subtitle %></h3><% } %></div><footer class="article-meta"><div class="inline-meta"><%~ include('./icons/date') %><time><%= a.date('Y-m-d') %></time></div></footer></div></header>