<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || '')) ? String(value) : ''; const banner=safe(firekylin.voidCover) || safe(config.defaultBanner); const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#bd6262'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><%~ block('headers') %></head>
<body class="fk-theme <%= config.indexStyle==='narrow' ? 'void-narrow' : '' %> <%= firekylin.voidDetail ? 'void-detail-page' : '' %> <%= config.colorMode === 'dark' ? 'fk-dark' : '' %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="fk-header"><a class="fk-brand" href="/"><%= site.title() %></a><nav class="fk-nav" aria-label="主导航"><% for (const nav of site.navigation) { %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></header>
<section class="void-banner <%= banner ? 'with-image' : 'no-banner' %>"><% if(banner) { %><img src="<%= banner %>" alt=""><% } %><div class="void-banner-title"><h1><%= firekylin.voidTitle || config.indexBannerTitle || site.title() %></h1><% if(firekylin.voidDetail) { %><p><%= firekylin.voidAuthor || '' %> · <%= firekylin.voidDate || '' %> · <a href="#comments">评论</a></p><% } else { %><p><%= config.heroText || site.description() %></p><% } %></div></section>
<div class="fk-shell"><main id="main"><%~ block('content') %></main></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/AlanDecode/Typecho-Theme-VOID">VOID</a> by AlanDecode · <a href="/rss.html">RSS</a></p></footer></body></html>
