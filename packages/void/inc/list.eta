<% /* VOID source index.php: optional banner, date, title, excerpt. */ const archive=firekylin.archive; %><div class="fk-feed index-list"><% while(archive.next()) {const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage || '')?archive.row.featuredImage:''; %><article class="entry-card"><% if(cover) { %><a class="entry-cover" href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="entry-copy"><p class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></p><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(80) %></p></div></article><% } %></div>