<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const valid=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="reading-progress" aria-hidden="true"></div><div class="body-container"><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><p><%= site.description() %></p><form action="/search.html"><input name="keyword" aria-label="搜索关键词" placeholder="输入关键词搜索"><button>搜索</button></form></header><div class="navbar"><details class="site-menu" open><summary aria-label="切换导航菜单">☰ 导航</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/categories">分类</a><a href="/archives">归档</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details><button id="theme-toggle" hidden>深色模式</button></div><div class="columns"><main id="main"><%~ block('content') %></main><aside class="sidebar"><section class="blogger-card"><div class="blogger-bg"><% if(valid(cfg.profileCover)){ %><img src="<%= cfg.profileCover %>" alt=""><% } %></div><% if(valid(cfg.avatarUrl)){ %><img class="avatar" src="<%= cfg.avatarUrl %>" alt=""><% }else{ %><div class="avatar avatar-empty" aria-hidden="true"></div><% } %><h2><%= cfg.profileName||site.title() %></h2><p><%= cfg.profileBio||site.description() %></p></section><section class="sidebar-card"><h2>文章分类</h2><ul><% categories.stack.forEach(c=>{ %><li><a href="/cate/<%= c.pathname %>"><%= c.name %></a></li><% }); %></ul></section><section class="sidebar-card"><h2>最近文章</h2><ul><% recent.stack.forEach(post=>{ %><li><a href="<%= recent.permalinkFor(post) %>"><%= post.title %></a></li><% }); %></ul></section><section class="sidebar-card"><h2>文章标签</h2><div class="tag-cloud"><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></section><section class="sidebar-card hourglass" hidden><h2>时光沙漏</h2><% ['今年','本月','今天'].forEach((label,i)=>{ %><div><p><%= label %>剩余时间 <span id="time-label-<%= i %>"></span></p><progress id="time-progress-<%= i %>" max="100" value="0"></progress></div><% }); %></section></aside></div><footer><p>© <%= cfg.footerText||site.title() %> · Powered by Firekylin</p><p>Theme <a href="https://github.com/whitebearcode/typecho-bearsimple">BearSimple</a> by BearNotion · Firekylin 原生改编</p></footer></div></body></html>