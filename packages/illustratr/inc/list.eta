<% const archive=firekylin.archive;let count=0; %><div class="post-list"><% while(archive.next()){count++;const locked=Boolean(archive.row.password_protected||archive.row.title==='此内容被密码保护'||archive.row.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||''); %><article class="entry hentry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="entry-thumbnail"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><header class="entry-header"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><span class="cat-links"><time><%= archive.date('YYYY-MM-DD') %></time></span></header><div class="entry-summary"><p><%= archive.excerpt(300) %></p><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>