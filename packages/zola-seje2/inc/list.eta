<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="post entry"><h2 class="post-title"><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-content"><p><%= archive.excerpt(220) %></p><a class="More" href="<%= archive.permalink %>">阅读全文</a></div><div class="post-meta"><%~ include('./date',{date:archive.date('YYYY-MM-DD')}) %></div></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>