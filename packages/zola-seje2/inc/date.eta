<% const date=String(firekylin.date||'');const parts=date.split('-');const digits='〇一二三四五六七八九';const number=n=>n<10?digits[n]:n===10?'十':n<20?'十'+digits[n-10]:n===20?'二十':n<30?'廿'+digits[n-20]:n===30?'三十':'三十一';const valid=/^\d{4}-\d{2}-\d{2}$/.test(date)&&Number(parts[1])>=1&&Number(parts[1])<=12&&Number(parts[2])>=1&&Number(parts[2])<=31; %><time datetime="<%= date %>"><%= valid?Array.from(parts[0],x=>digits[Number(x)]).join('')+'年'+number(Number(parts[1]))+'月'+number(Number(parts[2]))+'日':date %></time>