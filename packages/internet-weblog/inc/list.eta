<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="postmeta"><time><%= archive.date('YYYY-MM-DD') %></time></div><p><%= archive.excerpt(400) %></p><a class="continue" href="<%= archive.permalink %>">继续阅读 »</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>