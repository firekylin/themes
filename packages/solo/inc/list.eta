<% const archive=firekylin.archive;let count=0; %><div class="gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><figure class="gh-card-image"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></figure><div class="gh-card-wrapper"><h2 class="gh-card-title"><%= archive.title() %></h2><footer class="gh-card-meta"><time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></footer></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>