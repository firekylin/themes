<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><figure class="featured-media"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><div class="post-inner"><div class="post-meta light"><time><%= archive.date('YYYY-MM-DD') %></time></div><header class="post-header"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="post-content"><p><%= archive.excerpt(300) %></p></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>