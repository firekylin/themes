<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post-preview entry"><header><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><div class="date"><%= archive.date('YYYY-MM-DD') %></div></div></header><div class="summary"><p><%= archive.excerpt(300) %></p></div><div class="rmore"><a href="<%= archive.permalink %>">继续阅读</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>