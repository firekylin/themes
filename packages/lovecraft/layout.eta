<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><header class="header-wrapper"><div class="header section bg-white small-padding"><div class="section-inner group"><h1 class="blog-title"><a href="/"><%= site.title() %></a></h1><h4 class="blog-tagline"><%= site.description() %></h4></div></div><div class="navigation bg-white"><div class="section-inner group"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="wrapper section"><div class="section-inner group"><main id="main" class="native-main content"><%~ block('content') %></main><aside class="sidebar"><div class="widget"><h3 class="widget-title">关于</h3><p><%= site.description() %></p></div></aside></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/andersnoren/lovecraft">Lovecraft</a> by Anders Norén</footer></body></html>