<% const archive=firekylin.archive;let count=0;let year=''; %><section class="posts"><% while(archive.next()){count++;const nextYear=archive.date('YYYY');if(year!==nextYear){year=nextYear; %><h1 class="title is-3 year-heading"><%= year %></h1><% } %><article class="columns archive-entry entry"><div class="column is-2"><time class="entry-date"><%= archive.date('MM-DD') %></time></div><div class="column"><h2 class="subtitle is-size-4-mobile is-size-3-desktop entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="content entry-summary is-hidden-mobile"><p><%= archive.excerpt(400) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></div></div></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>