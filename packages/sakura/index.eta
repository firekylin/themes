<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'';let i=0; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(c.announcement){ %><aside class="notice"><%= c.announcement %></aside><% } %><h1 class="main-title"><%= archive.archiveTitle||c.postAreaTitle||'文章列表' %></h1><% if(!archive.have()){ %><p class="empty">暂无文章</p><% } while(archive.next()){i++;const image=safe(archive.row.featuredImage||archive.row.options?.featuredImage||c.defaultThumbnail); %><article class="post post-list-thumb post-list-show <%= i%2===0?'reverse-card':'' %>"><div class="post-thumb"><a href="<%= archive.permalink %>"><% if(image){ %><img src="<%= image %>" alt="" loading="lazy"><% } else { %><span class="sakura-image-placeholder"></span><% } %></a></div><div class="post-content-wrap"><div class="post-content"><time class="post-date"><%= archive.date('Y-m-d') %></time><a class="post-title" href="<%= archive.permalink %>"><h3><%= archive.title() %></h3></a><div class="post-meta"><span><%= archive.author('display_name') %></span><% for(const cat of archive.row.cate||[]){ %> · <a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><% if(archive.row.comment_num!=null){ %> · <a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a><% } %></div><div class="float-content"><p><%= archive.excerpt(130) %></p><div class="post-bottom"><a class="button-normal" href="<%= archive.permalink %>" aria-label="阅读全文">•••</a></div></div></div></div></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
