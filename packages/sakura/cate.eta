<% layout('layout',{compact:true});const site=await firekylin.widget('Widget_Options'),items=await firekylin.widget('Widget_Metas_Category_List'); %><% block('title',()=>{ %>分类 · <%= site.title() %><% });block('content',()=>{ %><section class="sakura-panel"><h1>分类</h1><ul><% while(items.next()){ %><li><a href="<%= items.permalink %>"><%= items.title() %></a></li><% } %></ul></section><% }); %>