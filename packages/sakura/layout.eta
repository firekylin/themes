<% /* Sakura 3.4.0 header.php and layouts/imgbox.php mapping. */
const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'';
const accent=/^#[a-f0-9]{6}$/i.test(c.accentColor||'')?c.accentColor:'#fe9600';const mode=['light','dark'].includes(c.colorMode)?c.colorMode:'auto';
%><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>:root{--sakura-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/sakura.js') %>"></script></head><body class="fk-theme <%= mode==='dark'?'dark fk-dark':'' %> <%= c.readingFont==='serif'?'serif':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="site-header"><div class="site-top"><div class="site-branding"><a class="site-name" href="/"><%= site.title() %></a></div><nav class="sakura-nav" aria-label="主导航"><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></nav><details class="sakura-mobile-menu"><summary>菜单</summary><nav><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a><a href="/rss.html">RSS</a></nav></details></div></header>
<% if(!firekylin.compact){ %><section class="headertop"><figure id="centerbg"><% if(safe(c.coverImage)){ %><img class="sakura-cover" src="<%= safe(c.coverImage) %>" alt=""><% } %><div class="focusinfo"><% if(safe(c.avatarUrl)){ %><div class="header-tou"><img src="<%= safe(c.avatarUrl) %>" alt="站点头像"></div><% } else { %><h1 class="center-text"><%= c.heroTitle||site.title() %></h1><% } %><div class="header-info"><p><%= c.heroText||site.description() %></p><div class="top-social"><a href="/rss.html">RSS</a></div></div></div><a class="sakura-down" href="#main" aria-label="阅读文章">⌄</a></figure></section><% } %>
<div id="content" class="site-content <%= firekylin.compact?'inner-content':'' %>"><main id="main" class="site-main"><%~ block('content') %></main></div><footer class="site-footer"><%= c.footerText||site.title() %><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/mashirozx/sakura">Sakura</a> by Mashiro, Spirit, Louie, Fuzzz · Akina ancestry</p></footer><div class="sakura-tools"><button data-mode-toggle hidden type="button" aria-label="切换颜色模式">◐</button><a href="#main" aria-label="返回正文顶部">↑</a></div><dialog class="sakura-lightbox" aria-label="图片预览"><button data-close type="button">关闭</button><img alt=""></dialog><progress class="sakura-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
