<% const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},mode=['dark','auto'].includes(c.colorMode)?c.colorMode:'light',accent=/^#[a-f0-9]{6}$/i.test(c.accentColor||'')?c.accentColor:'#ff0000',safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>:root{--svbtle-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/svbtle.js') %>"></script></head><body class="fk-theme <%= mode==='dark'?'fk-dark dark':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a><header id="sidebar"><figure class="logo medium"><a href="/" aria-label="<%= site.title() %>"><% if(safe(c.logoUrl)){ %><img src="<%= safe(c.logoUrl) %>" alt=""><% } else { %><span><%= Array.from(site.title())[0] %></span><% } %></a></figure><h1><a href="/"><%= site.title() %></a></h1><% if(c.username){ %><h2><%= c.username %></h2><% } %><h3><%= c.heroText||site.description() %></h3><nav class="sv-desktop"><ul id="user_nav"><% for(const n of site.navigation){ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% } %><li><a href="/search.html">搜索</a></li><% if(c.showRss!=='false'){ %><li><a href="/rss.html">RSS</a></li><% } %></ul></nav><details class="sv-mobile"><summary>菜单</summary><nav><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a><% if(c.showRss!=='false'){ %><a href="/rss.html">RSS</a><% } %></nav></details><aside id="svbtle_linkback"><a href="https://github.com/themeskult/wp-svbtle">WP-SVBTLE</a><span> · Firekylin</span><button type="button" data-mode-toggle hidden aria-label="切换配色">◐</button></aside></header><section id="river"><main id="main"><%~ block('content') %></main><footer class="sv-footer"><%= c.footerText||site.title() %> · <a href="#main">返回顶部 ↑</a></footer></section><dialog class="svbtle-lightbox" aria-label="图片预览"><button data-close type="button">关闭</button><img alt=""></dialog><progress class="svbtle-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
