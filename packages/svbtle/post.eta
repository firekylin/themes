<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'post'}),found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(found){ %><header id="begin"><time id="top_time"><%= archive.date('Y-m-d') %></time></header><article class="post"><h1 class="entry-title"><%= archive.title() %></h1><div class="sv-meta"><%= archive.author('display_name') %><span class="svbtle-reading-time" hidden></span></div><details class="svbtle-toc" hidden open><summary>文章目录</summary><ol></ol></details><div class="entry-content"><%~ archive.content() %></div><nav class="sv-taxonomy"><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> <% } for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>">#<%= tag.name %></a> <% } %></nav></article><%~ firekylin.comment({title:'评论',className:'sv-comments'}) %><% } else { %><article class="post empty">内容不存在</article><% } %><% }); %>
