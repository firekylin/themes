<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><header id="begin"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } else if(archive.stack[0]){ %><time id="top_time"><%= String(archive.stack[0].create_time||'').slice(0,10) %></time><% } %></header><% if(!archive.have()){ %><article class="post"><p class="empty">暂无文章</p></article><% } while(archive.next()){ %><article class="post"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="sv-feed"><% if(c.feedStyle==='excerpt'||!archive.is('index')){ %><p><%= archive.excerpt(250) %></p><a href="<%= archive.permalink %>">继续阅读 →</a><% } else { %><%~ archive.content() %><% } %></div><% if(archive.row.comment_num!=null){ %><a class="sv-comments-link" href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a><% } %></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
