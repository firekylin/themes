<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><a class="featured-image" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><div class="content"><p><%= archive.excerpt(300) %></p></div><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>