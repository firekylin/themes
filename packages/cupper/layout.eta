<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="is-head-left-logo home-template"><a class="native-skip" href="#main">跳转到正文</a><div class="wrapper"><header class="intro-and-nav"><div><div class="intro"><a class="logo" href="/"><h1><%= site.title() %></h1></a><p class="library-desc"><%= site.description() %></p></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="main-and-footer"><div><main id="main" class="native-main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/zwbetz-gh/cupper-hugo-theme">Cupper</a> by zwbetz-gh</footer></div></div></div></body></html>