<% const archive=firekylin.archive;let count=0; %><ul class="patterns-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time><%= archive.date('YYYY-MM-DD') %></time><p><%= archive.excerpt(200) %></p></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>