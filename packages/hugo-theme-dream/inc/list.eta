<% const archive=firekylin.archive;let count=0; %><div class="dream-grid-native"><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry dream-column-native"><div class="dream-card"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><figure><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a></figure><% } %><div class="card-body"><h2 class="card-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-date"><%= archive.date('YYYY-MM-DD') %></p><p><%= archive.excerpt(300) %></p><p class="card-author"><%= archive.author('display_name') %></p></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>