<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-theme="emerald"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/init.js') %>"></script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="dream-header"><div class="dream-container header-inner"><div class="brand"><% const avatar=String(cfg.avatarURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="brand-avatar" src="<%= avatar %>" alt=""><% } %><div><a class="site-name" href="/"><%= site.title() %></a><p class="motto"><%= site.description() %></p></div></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div class="native-controls"><button id="dream-flip" aria-controls="dream-about" aria-expanded="false" hidden>关于 / 翻面</button><button id="dark-mode-toggle" hidden>浅色 / 深色</button></div></div></header><main id="main" class="dream-container native-stage"><div id="dream-front" class="native-face" tabindex="-1"><%~ block('content') %></div><section id="dream-about" class="native-face" tabindex="-1" hidden inert aria-label="关于本站"><div class="about-grid"><article class="dream-card"><div class="card-body"><h2 class="card-title"><%= cfg.aboutTitle||site.title() %></h2><p class="about-text"><%= cfg.aboutText||site.description() %></p></div></article><article class="dream-card"><div class="card-body"><h2 class="card-title">站点导航</h2><div class="about-links"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></div></article></div></section></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/g1eny0ung/hugo-theme-dream">Dream</a> · Yue Yang</p></footer></body></html>