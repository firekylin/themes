<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="article-detail card"><% if(found){ %><header><h1><%= archive.title() %></h1><div class="meta"><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></div></header><div class="prose"><%~ archive.content() %></div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>