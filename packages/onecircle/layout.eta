<% const site=await firekylin.widget('Widget_Options');const categories=await firekylin.widget('Widget_Metas_Category_List');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const safe=u=>String(u||'').startsWith('https://')||String(u||'').startsWith('http://')||(String(u||'').startsWith('/')&&!String(u||'').startsWith('//')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="brand" href="/"><% if(safe(site.themeConfig.avatarUrl)){ %><img src="<%= site.themeConfig.avatarUrl %>" alt=""><% } %><%= site.title() %></a><details class="search-menu"><summary>⌕ 搜索</summary><form action="/search.html" method="get"><label for="header-keyword">搜索文章</label><input id="header-keyword" name="keyword" required><button>搜索</button></form></details></div></header><div class="shell"><aside class="left-nav"><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/"><span aria-hidden="true">⌂</span> 动态</a><a href="/categories"><span aria-hidden="true">◉</span> 分类</a><a href="/archives"><span aria-hidden="true">♡</span> 归档</a><a href="/tags"><span aria-hidden="true">♧</span> 标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><span aria-hidden="true">↗</span> <%= n.label %></a><% }); %><a class="rss" href="/rss.html">RSS 订阅</a></nav></details></aside><main id="main"><%~ block('content') %></main><aside class="right-sidebar"><section class="card profile"><div class="profile-cover"><% if(safe(site.themeConfig.coverUrl)){ %><img src="<%= site.themeConfig.coverUrl %>" alt=""><% } %></div><div class="profile-detail"><% if(safe(site.themeConfig.avatarUrl)){ %><img class="profile-avatar" src="<%= site.themeConfig.avatarUrl %>" alt=""><% } %><h2><%= site.themeConfig.profileName||site.title() %></h2><p><%= site.themeConfig.profileBio||site.description() %></p></div></section><section class="card"><h2 class="card-title">分类</h2><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.row.name %></a></li><% } %></ul></section><section class="card"><h2 class="card-title">最近文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><footer>© <%= site.title() %><br><a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/gogobody/onecircle">OneCircle</a></footer></aside></div><a class="to-top" href="#top" aria-label="回到顶部">↑</a></body></html>