<% const archive=firekylin.archive;const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//')));let count=0; %><% while(archive.next()){count++;const options=archive.row.options||{};const gallery=Array.isArray(options.gallery)?options.gallery.filter(safe).slice(0,9):safe(options.featuredImage)?[options.featuredImage]:[];const name=archive.author('display_name')||'作者'; %><article class="post-article"><div class="post-avatar" aria-hidden="true"><%= String(name).slice(0,1) %></div><div class="post-body"><header><strong><%= name %></strong><time><%= archive.date('YYYY-MM-DD') %></time></header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(180) %></div><% if(gallery.length){ %><div class="gallery gallery-<%= gallery.length===1?'single':'grid' %>"><% gallery.forEach(url=>{ %><a href="<%= url %>"><img src="<%= url %>" alt="文章图片" loading="lazy"></a><% }); %></div><% } %><div class="post-actions"><a href="<%= archive.permalink %>">阅读全文 →</a><time><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% } %><% if(!count){ %><div class="card empty">暂无文章。</div><% } %>