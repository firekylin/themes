{
  "name": "onecircle",
  "title": "OneCircle",
  "version": "0.1.0",
  "private": true,
  "description": "OneCircle public reading feed adapted to Firekylin.",
  "license": "MIT",
  "author": "gogobody; Firekylin contributors",
  "homepage": "https://github.com/gogobody/onecircle",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/onecircle"
  },
  "firekylin": {
    "type": "theme",
    "id": "onecircle"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "站点头像",
      "help": "HTTP(S) 或站内绝对路径。"
    },
    {
      "type": "text",
      "name": "coverUrl",
      "label": "简介封面",
      "help": "HTTP(S) 或站内绝对路径。"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "简介名称",
      "help": "留空使用站点名称。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "简介文字",
      "help": "留空使用站点描述。"
    }
  ]
}
