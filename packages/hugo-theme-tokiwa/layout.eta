<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/toc.js') %>" defer></script></head><body class="bg-gray-100 text-gray-700 font-sans"><a class="skip" href="#main">跳转到正文</a><div class="tokiwa-shell p-6 sm:p-10 md:p-16 flex flex-wrap"><header class="tokiwa-side w-full md:w-2/5 xl:w-1/2 md:pr-12 lg:pr-20 xl:pr-24 order-1 max-w-2xl"><div class="tokiwa-sticky md:text-right leading-loose tracking-tight md:sticky md:top-0 pt-2"><h1><a class="heading font-cursive icon" href="/"><%= site.title() %></a></h1><%~ block('hero') %><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="tokiwa-main w-full md:w-3/5 xl:w-1/2 max-w-3xl order-2 min-h-70vh pt-2 pb-4"><%~ block('content') %></main><div class="w-full h-0 flex-none order-3"></div><aside class="native-footer w-full md:w-2/5 xl:w-1/2 md:pr-12 lg:pr-20 xl:pr-24 order-4 md:order-3 self-end max-w-2xl"><div class="md:text-right"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/heyeshuang/hugo-theme-tokiwa">Tokiwa</a></p></div></aside></div></body></html>