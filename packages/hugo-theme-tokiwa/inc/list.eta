<% const archive=firekylin.archive;let count=0; %><div class="tokiwa-list"><% while(archive.next()){count++; %><article class="entry"><h2 class="font-serif"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="summary font-serif"><%= archive.excerpt(200) %></p><div class="entry-meta"><div class="entry-tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>