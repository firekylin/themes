<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'index'}),c=s.themeConfig||{},home=a.is('index')&&(!a.pagination||a.pagination.currentPage===1)&&c.homeMode!=='posts',safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';let social=[];try{const v=JSON.parse(c.socialJSON||'[]');if(Array.isArray(v))social=v;}catch{} %><% block('title',()=>{ %><%= a.archiveTitle||s.title() %><% }) %><% block('content',()=>{ %><% if(home){ %><section class="container centered"><div class="about"><% if(safe(c.avatarUrl)){ %><div class="avatar"><img src="<%= safe(c.avatarUrl) %>" alt="Profile"></div><% } %><h1><%= c.author||s.title() %></h1><h2><% for(const line of String(c.info||s.description()).split('\n')){ %><%= line %><br><% } %></h2><% if(social.length){ %><ul><% for(const n of social){if(n&&safe(n.url)){ %><li><a href="<%= safe(n.url) %>" aria-label="<%= String(n.name||'Link') %>"><% if(/^fa[a-z0-9 -]+$/.test(n.icon||'')){ %><i class="<%= n.icon %>" aria-hidden="true"></i><% }else{ %><%= String(n.name||'Link') %><% } %></a></li><% }} %></ul><% } %></div></section><% }else{ %><section class="container list"><header><h1 class="title"><%= a.archiveTitle||'Posts' %></h1></header><%~ include('./inc/list',{archive:a}) %></section><% } %><% }) %>
