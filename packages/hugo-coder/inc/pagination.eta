<% const a=firekylin.archive,p=a.pagination;if(p&&p.totalPages>1){ %><nav class="coder-pagination" aria-label="Pagination"><% if(p.currentPage>1){ %><a rel="prev" href="<%= a.pageUrl(p.currentPage-1) %>">← Previous</a><% } %><span><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a rel="next" href="<%= a.pageUrl(p.currentPage+1) %>">Next →</a><% } %></nav><% } %>
