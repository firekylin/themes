<% const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},mode=['light','dark','auto'].includes(c.colorMode)?c.colorMode:'auto',year=new Date().getFullYear(),since=Number(c.since); %><!doctype html><html lang="en" data-theme="<%= mode %>" dir="<%= c.rtl==='true'?'rtl':'ltr' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= s.description() %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/dark.css') %>"><% if(c.rtl==='true'){ %><link rel="stylesheet" href="<%= s.themeUrl('res/css/rtl.css') %>"><% } %><link rel="stylesheet" href="<%= s.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><script defer src="<%= s.themeUrl('res/js/coder.js') %>"></script></head><body class="colorscheme-<%= mode %><%= c.rtl==='true'?' rtl':'' %>" data-color-mode="<%= mode %>"><a class="skip-link" href="#content">Skip to content</a><% if(c.hideColorToggle!=='true'){ %><div class="float-container"><button id="dark-mode-toggle" type="button" class="colorscheme-toggle" aria-label="Switch color scheme" hidden><i class="fa-solid fa-adjust fa-fw" aria-hidden="true"></i></button></div><% } %><main class="wrapper"><nav class="navigation" aria-label="Main navigation"><section class="container"><a class="navigation-title" href="/"><%= s.title() %></a><input type="checkbox" id="menu-toggle" aria-label="Toggle menu" aria-controls="navigation-list"><label class="menu-button float-right" for="menu-toggle" aria-label="Toggle menu"><i class="fa-solid fa-bars fa-fw" aria-hidden="true"></i></label><ul class="navigation-list" id="navigation-list"><% for(const n of s.navigation){ %><li class="navigation-item"><a class="navigation-link" href="<%= n.url %>"><%= n.label %></a></li><% } %><li class="navigation-item"><a class="navigation-link" href="/search.html">Search</a></li></ul></section></nav><div class="content" id="content"><%~ block('content') %></div><footer class="footer"><section class="container"><% if(c.footerText){ %><%= c.footerText %> · <% } %>© <% if(Number.isInteger(since)&&since>0&&since<year){ %><%= since %> - <% } %><%= year %> <%= c.author||s.title() %> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> &amp; <a href="https://github.com/luizdepra/hugo-coder">Coder</a>.</section></footer></main></body></html>
