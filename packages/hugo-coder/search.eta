<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>Search · <%= s.title() %><% }) %><% block('content',()=>{ %><section class="container list"><header><h1 class="title">Search</h1></header><form class="coder-search" action="/search.html" method="get"><input name="keyword" type="search" value="<%= a.keyword||'' %>" aria-label="Search"><button type="submit">Search</button></form><%~ include('./inc/list',{archive:a}) %></section><% }) %>
