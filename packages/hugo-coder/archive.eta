<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>Archives · <%= s.title() %><% }) %><% block('content',()=>{ %><section class="container list"><header><h1 class="title">Archives</h1></header><% for(const [month,rows] of Object.entries(a.grouped||{})){ %><h2><%= month %></h2><ul><% for(const row of rows){ %><li><span class="date"><%= String(row.create_time||'').slice(0,10) %></span><a class="title" href="<%= a.permalinkFor(row) %>"><%= row.title %></a></li><% } %></ul><% } %></section><% }) %>
