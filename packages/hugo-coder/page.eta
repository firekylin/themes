<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'page'}),c=s.themeConfig||{},exists=a.next(),image=String(a.row.featuredImage||a.row.options?.featuredImage||''); %><% block('title',()=>{ %><%= exists?a.title():s.title() %><% }) %><% block('content',()=>{ %><section class="container post"><article><% if(exists){ %><header><div class="post-title"><h1 class="title"><a class="title-link" href="<%= a.permalink %>"><%= a.title() %></a></h1></div><div class="post-meta"><div class="date"><span class="posted-on"><i class="fa-solid fa-calendar" aria-hidden="true"></i><time><%= a.date('Y-m-d') %></time></span></div><% if(a.row.cate?.length){ %><div class="categories"><i class="fa-solid fa-folder" aria-hidden="true"></i><% for(const t of a.row.cate){ %><a href="<%= '/cate/'+t.pathname %>"><%= t.name %></a> <% } %></div><% } %><% if(a.row.tag?.length){ %><div class="tags"><i class="fa-solid fa-tag" aria-hidden="true"></i><% for(const t of a.row.tag){ %><a class="tag" href="<%= '/tag/'+t.pathname %>"><%= t.name %></a> <% } %></div><% } %></div></header><% if(c.tocEnabled==='true'){ %><details class="entry__toc toc" <%= c.tocOpen==='true'?'open':'' %> hidden><summary class="toc__title">Contents</summary><nav></nav></details><% } %><div class="post-content article-body"><% if(/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(image)){ %><img src="<%= image %>" alt="Featured image"><% } %><%~ a.content() %></div><footer><%~ firekylin.comment({title:'Comments'}) %></footer><% }else{ %><header><h1>Content unavailable</h1></header><% } %></article></section><% }) %>
