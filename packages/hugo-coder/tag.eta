<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>Tags · <%= s.title() %><% }) %><% block('content',()=>{ %><section class="container list"><header><h1 class="title">Tags</h1></header><ul><% while(a.next()){ %><li><a class="title" href="<%= a.permalink %>"><%= a.row.name %></a> <span class="taxonomy-count"><%= a.row.count||0 %></span></li><% } %></ul></section><% }) %>
