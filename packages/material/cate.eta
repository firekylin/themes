<%~ await includeAsync('./inc/header',firekylin) %><% const items=await firekylin.widget('Widget_Metas_Category_List'); %><section class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1>分类</h1><ul><% while(items.next()) { %><li><a href="/cate/<%= items.row.pathname %>"><%= items.row.name %></a> (<%= items.row.count %>)</li><% } %></ul></section><%~ await includeAsync('./inc/footer',firekylin) %>