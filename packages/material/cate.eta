<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:t('分类','Categories','分類')}) %><% const items=await firekylin.widget('Widget_Metas_Category_List'); %><section class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1><%= t('分类','Categories','分類') %></h1><ul><% while(items.next()) { %><li><a href="/cate/<%= items.row.pathname %>"><%= items.row.name %></a> (<%= items.row.count %>)</li><% } %></ul></section><%~ await includeAsync('./inc/footer',firekylin) %>