<%~ await includeAsync('./inc/header',firekylin) %><% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><section class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1>搜索</h1><form action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" value="<%= a.keyword || '' %>" required><button>搜索</button></form><% if(a.keyword && !a.pagination.count) { %><p>没有找到文章</p><% } %></section><%~ await includeAsync('./inc/list',{...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>