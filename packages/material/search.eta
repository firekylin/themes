<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:t('搜索','Search','搜尋')}) %><% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><section class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1><%= t('搜索','Search','搜尋') %></h1><form action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" value="<%= a.keyword || '' %>" required><button><%= t('搜索','Search','搜尋') %></button></form><% if(a.keyword && !a.pagination.count) { %><p><%= t('没有找到文章','No articles found','沒有找到文章') %></p><% } %></section><%~ await includeAsync('./inc/list',{...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>