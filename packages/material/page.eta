<% const a=await firekylin.widget('Widget_Archive',{type:'page'}); const available=a.next(); const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig||{}; const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; %>
<%~ await includeAsync('./inc/header',{...firekylin,pageTitle:available?a.title():'',detail:true}) %>
<% if(available) { %><article class="mdl-card mdl-shadow--4dp mdl-cell mdl-cell--12-col material-detail">
<%~ await includeAsync('./inc/media',{...firekylin,article:a,detail:true}) %>
<div class="mdl-card__supporting-text meta"><img class="avatar" src="<%= c.avatarURL||site.themeUrl('res/avatar.svg') %>" alt=""><div><span class="author-name-span"><%= a.author() %></span><time><%= a.date('YYYY-MM-DD') %></time></div><span class="section-spacer"></span><% if(a.row.tag&&a.row.tag.length) { %><details class="material-menu"><summary aria-label="<%= t('标签','Tags','標籤') %>">▣</summary><div><%~ a.tags(' ') %></div></details><% } %><details class="material-menu"><summary aria-label="<%= t('分享','Share','分享') %>">↗</summary><div><a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(site.siteUrl+a.permalink) %>">Twitter</a><a href="https://telegram.me/share/url?url=<%= encodeURIComponent(site.siteUrl+a.permalink) %>">Telegram</a><button type="button" class="share-native"><%= t('复制链接','Copy link','複製連結') %></button><span class="share-result" role="status"></span></div></details></div>
<div id="article-content-div" class="mdl-color-text--grey-700 mdl-card__supporting-text post-article-content"><%~ a.content() %></div>
<% const comments=firekylin.comment({className:'article-comments',title:t('评论','Comments','評論')}); if(comments) { %><div class="comments"><%~ comments %></div><% } %>
</article><nav class="demo-nav mdl-cell mdl-cell--12-col" aria-label="文章导航"><% if(a.row.prev&&a.row.prev.pathname&&a.row.prev.title) { %><a href="<%= a.permalinkFor(a.row.prev) %>">← <%= a.row.prev.title %></a><% } %><span class="section-spacer"></span><% if(a.row.next&&a.row.next.pathname&&a.row.next.title) { %><a href="<%= a.permalinkFor(a.row.next) %>"><%= a.row.next.title %> →</a><% } %></nav><% } %>
<%~ await includeAsync('./inc/footer',firekylin) %>