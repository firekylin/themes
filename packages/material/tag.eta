<%~ await includeAsync('./inc/header',firekylin) %><% const items=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><section class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1>标签</h1><ul><% while(items.next()) { %><li><a href="/tag/<%= items.row.pathname %>"><%= items.row.name %></a> (<%= items.row.count %>)</li><% } %></ul></section><%~ await includeAsync('./inc/footer',firekylin) %>