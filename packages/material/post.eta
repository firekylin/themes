<% const a=await firekylin.widget('Widget_Archive',{type:'post'}); const available=a.next(); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:available?a.title():''}) %><% if(available) { %><article class="mdl-card mdl-cell mdl-cell--12-col article-module"><div class="mdl-card__media mdl-color-text--grey-50"><h1 class="article-headline-p"><%= a.title() %></h1></div><div class="mdl-card__supporting-text meta"><%= a.author() %> · <time><%= a.date('YYYY-MM-DD') %></time></div><div class="mdl-card__supporting-text post-content"><%~ a.content() %></div><div class="mdl-card__supporting-text"><%~ a.tags(', ') %></div><div class="mdl-card__supporting-text" id="comments"><%~ firekylin.comment({className:'article-comments',title:'评论'}) %></div></article><% } %><%~ await includeAsync('./inc/footer',firekylin) %>