<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:t('归档','Archives','歸檔')}) %><% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><article class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1><%= t('归档','Archives','歸檔') %></h1><% Object.entries(a.grouped).forEach(([month,posts]) => { %><h2><%= month %></h2><ul><% posts.forEach(post => { %><li><a href="<%= a.permalinkFor(post) %>"><%= post.title %></a></li><% }) %></ul><% }) %></article><%~ await includeAsync('./inc/footer',firekylin) %>