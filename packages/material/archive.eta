<%~ await includeAsync('./inc/header',firekylin) %><% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><article class="mdl-card mdl-cell mdl-cell--12-col port-panel"><h1>归档</h1><% Object.entries(a.grouped).forEach(([month,posts]) => { %><h2><%= month %></h2><ul><% posts.forEach(post => { %><li><a href="<%= a.permalinkFor(post) %>"><%= post.title %></a></li><% }) %></ul><% }) %></article><%~ await includeAsync('./inc/footer',firekylin) %>