<% const a = firekylin.archive; %><% while(a.next()) { %>
<article class="mdl-card mdl-cell mdl-cell--12-col article-module"><div class="mdl-card__media mdl-color-text--grey-50 cover-media"><% if(a.row.featuredImage) { %><img class="cover-image" src="<%= a.row.featuredImage %>" alt=""><% } %><h2 class="article-headline-p"><a href="<%= a.permalink %>"><%= a.title() %></a></h2></div><div class="mdl-card__supporting-text index-article-content"><%= a.excerpt(180,'…') %> <a href="<%= a.permalink %>">继续阅读</a></div><div class="mdl-card__supporting-text meta"><span><%= a.author() %></span><time><%= a.date('YYYY-MM-DD') %></time><span class="section-spacer"></span><%~ a.category(', ') %><a href="<%= a.permalink %>#comments"><%= a.commentsNum('%d 评论') %></a></div></article><% } %>
<% if(a.pagination) { const pg=a.pagination; %><nav class="demo-nav mdl-cell mdl-cell--12-col" aria-label="分页"><% if(pg.currentPage>1) { %><a href="<%= a.pageUrl(pg.currentPage-1) %>">← 上一页</a><% } %><span>第 <%= pg.currentPage %> 页</span><% if(pg.currentPage<pg.totalPages) { %><a href="<%= a.pageUrl(pg.currentPage+1) %>">下一页 →</a><% } %></nav><% } %>