<% const a=firekylin.archive; const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig||{}; const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; %><% while(a.next()) { %>
<article class="mdl-card mdl-cell mdl-cell--12-col article-module"><%~ await includeAsync('./media',{...firekylin,article:a}) %><div class="mdl-card__supporting-text index-article-content"><%= a.excerpt(80,'…') %> <a href="<%= a.permalink %>"><%= t('继续阅读','Continue Reading','繼續閱讀') %></a></div><div class="article-info"><div class="mdl-card__supporting-text meta article-author-date"><img class="avatar" src="<%= c.avatarURL||site.themeUrl('res/avatar.svg') %>" alt=""><div><span class="author-name-span"><%= a.author() %></span><time><%= a.date('YYYY-MM-DD') %></time></div></div><div class="article-category-comment"><%~ a.category(', ') %> | <a href="<%= a.permalink %>#comments"><%= a.commentsNum(t('%d 评论','%d comments','%d 評論')) %></a></div></div></article><% } %>
<% if(a.pagination) { const pg=a.pagination; %><nav class="demo-nav mdl-cell mdl-cell--12-col" aria-label="<%= t('分页','Pagination','分頁') %>"><% if(pg.currentPage>1) { %><a href="<%= a.pageUrl(pg.currentPage-1) %>">← <%= t('上一页','Previous','上一頁') %></a><% } else { %><span></span><% } %><span><%= pg.currentPage %> / <%= Math.max(1,pg.totalPages) %></span><% if(pg.currentPage<pg.totalPages) { %><a href="<%= a.pageUrl(pg.currentPage+1) %>"><%= t('下一页','Next','下一頁') %> →</a><% } else { %><span></span><% } %></nav><% } %>