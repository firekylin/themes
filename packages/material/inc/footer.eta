<% const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig||{}; let social=[]; try{const value=JSON.parse(c.socialLinks||'[]');if(Array.isArray(value))social=value.filter(x=>x&&typeof x.label==='string'&&/^https?:\/\//.test(x.url));}catch{} %></div><footer class="mdl-mini-footer port-footer" id="bottom"><div class="mdl-mini-footer--left-section"><% social.forEach(link=>{ %><a href="<%= link.url %>" rel="me"><%= link.label %></a><% }) %></div><div id="copyright">Copyright © <%= new Date().getFullYear() %> <%= site.title() %></div><div class="mdl-mini-footer--right-section">Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a><br><a href="https://github.com/iblh/typecho-theme-material">Material</a> by Viosey / iblh</div></footer></main></div><nav class="material-fabs" aria-label="页面工具"><a href="#top" aria-label="返回顶部">↑</a><a href="/archives" aria-label="归档">▦</a></nav><script src="<%= site.themeUrl('res/port.js') %>" defer></script></body></html>