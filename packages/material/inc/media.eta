<% const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig||{}; const a=firekylin.article; const pure=String(c.ThumbnailOption)==='2'; const valid=u=>typeof u==='string'&&/^(https?:\/\/|\/(?!\/))/.test(u); const candidates=String(c.randomPicURLs||'').split(/\s+/).filter(valid); const n=Math.abs(Number(a.row.id)||0); const fallback=candidates.length?candidates[n%candidates.length]:site.themeUrl('res/cover-'+(n%4)+'.svg'); const match=String(a.row.content||a.row.summary||'').match(/<img[^>]+src=["']([^"']+)["']/i); const first=a.row.featuredImage||(match&&match[1]); const src=String(c.ThumbnailOption)==='3'?fallback:(valid(first)?first:fallback); const bg=/^#[a-f0-9]{3,8}$/i.test(c.TitleColor||'')?c.TitleColor:'#ffffff'; %>
<div class="mdl-card__media mdl-color-text--grey-50 cover-media<%= pure?' pure-media':'' %>"<% if(pure) { %> style="background-color:<%= bg %>;color:#757575"<% } %>><% if(!pure) { %><img class="cover-image" src="<%= src %>" alt=""><% } %><% if(firekylin.detail) { %><h1 class="article-headline-p"><%= a.title() %></h1><% } else { %><h2 class="<%= pure?'article-headline-p-nopic':'article-headline-p' %>"><a href="<%= a.permalink %>"><% if(pure) { %>“<br><% } %><%= a.title() %><% if(pure) { %><br>”<% } %></a></h2><% } %></div>