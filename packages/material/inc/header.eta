<% const site = await firekylin.widget('Widget_Options'); const c = site.themeConfig || {}; const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; const gradients=['linear-gradient(135deg,#1fddff,#ffedbc)','linear-gradient(135deg,#396d87,#d9e3e5)','linear-gradient(135deg,#3e465c,#dce6c8)','linear-gradient(135deg,#8fb59e,#d5e8d3)','linear-gradient(135deg,#61669e,#edbbcc)','linear-gradient(to left,#dad299,#b0dab9)','linear-gradient(-20deg,#d0b782 20%,#a0cecf 80%)','linear-gradient(to left,#f1f2b5,#135058)','linear-gradient(to left,#02aab0,#00cdac)','linear-gradient(to left,#c9ffbf,#ffafbd)']; const color = (v, d) => /^#[0-9a-f]{3,8}$/i.test(v || '') ? v : d; %>
<!doctype html><html lang="<%= String(c.langis)==='0'?'en':String(c.langis)==='2'?'zh-Hant':'zh-CN' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><% if(firekylin.pageTitle) { %><%= firekylin.pageTitle %> - <% } %><%= site.title() %></title><meta name="description" content="<%= site.description() %>">
<meta name="theme-color" content="<%= color(c.ChromeThemeColor||c.ThemeColor,'#039be5') %>"><% if(c.favicon||site.row?.favicon_url) { %><link rel="icon" href="<%= c.favicon||site.row.favicon_url %>"><% } %>
<link rel="stylesheet" href="<%= site.themeUrl('res/material.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>">
<style>:root{--theme:<%= color(c.ThemeColor,'#039be5') %>;--link:<%= color(c.alinkcolor,'#039be5') %>;--background:<%= color(c.bgcolor,'#f5f5f5') %>}<% if(String(c.BGtype)==='2') { %>body{background-image:<%= gradients[Math.max(0,Math.min(9,Number(c.GradientType)||0))] %>}<% } %><%~ c.customCSS || '' %></style></head><body><% if(String(c.BGtype)==='1'&&c.backgroundImage) { %><img class="page-background" src="<%= c.backgroundImage %>" alt=""><% } %>
<button class="MD-burger-icon" id="drawer-toggle" aria-controls="material-drawer" aria-expanded="false" aria-label="打开导航"><span class="MD-burger-layer"></span></button>
<dialog id="material-drawer"><button id="drawer-close" aria-label="关闭导航">×</button><header><img class="sidebar-avatar" width="64" height="64" src="<%= c.avatarURL||c.logo||site.themeUrl('res/avatar.svg') %>" alt=""><h2><%= site.title() %></h2><p><%= site.description() %></p></header><nav aria-label="主导航"><a href="/"><%= t('首页','Home','首頁') %></a><% site.navigation.forEach(n => { %><a href="<%= n.url %>"><%= n.label %></a><% }) %><a href="/archives"><%= t('归档','Archives','歸檔') %></a><details class="sidebar-section"><summary><%= t('分类','Categories','分類') %></summary><% const categories=await firekylin.widget('Widget_Metas_Category_List'); while(categories.next()) { %><a href="/cate/<%= categories.row.pathname %>"><%= categories.row.name %></a><% } %></details><a href="/tags"><%= t('标签','Tags','標籤') %></a><a href="/search.html"><%= t('搜索','Search','搜尋') %></a><a href="/rss.html">RSS</a></nav></dialog>
<div class="demo-blog<%= firekylin.detail?' demo-blog--blogpost':'' %> mdl-layout is-upgraded"><main class="mdl-layout__content" id="material-main"><div id="top"></div><div class="demo-blog__posts mdl-grid<%= firekylin.detail?' post-module':'' %>">
