<% const site = await firekylin.widget('Widget_Options'); const c = site.themeConfig || {}; const color = (v, d) => /^#[0-9a-f]{3,8}$/i.test(v || '') ? v : d; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><% if(firekylin.pageTitle) { %><%= firekylin.pageTitle %> - <% } %><%= site.title() %></title><meta name="description" content="<%= site.description() %>">
<link rel="stylesheet" href="<%= site.themeUrl('res/material.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>">
<style>:root{--theme:<%= color(c.ThemeColor,'#009688') %>;--link:<%= color(c.alinkcolor,'#008577') %>;--background:<%= color(c.bgcolor,'#f5f5f5') %>}<%~ c.customCSS || '' %></style></head><body>
<button class="MD-burger-icon" id="drawer-toggle" aria-controls="material-drawer" aria-expanded="false" aria-label="打开导航"><span class="MD-burger-layer"></span></button>
<dialog id="material-drawer"><button id="drawer-close" aria-label="关闭导航">×</button><header><% if(c.avatarURL) { %><img width="64" height="64" src="<%= c.avatarURL %>" alt=""><% } %><h2><%= site.title() %></h2><p><%= site.description() %></p></header><nav aria-label="主导航"><a href="/">首页</a><% site.navigation.forEach(n => { %><a href="<%= n.url %>"><%= n.label %></a><% }) %><a href="/archives">归档</a><a href="/search.html">搜索</a><a href="/rss.html">RSS</a></nav></dialog>
<div class="demo-blog mdl-layout is-upgraded"><main class="mdl-layout__content" id="material-main"><div id="top"></div><div class="demo-blog__posts mdl-grid">
