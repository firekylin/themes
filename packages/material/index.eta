<%~ await includeAsync('./inc/header', firekylin) %><% const site=await firekylin.widget('Widget_Options'); const c=site.themeConfig || {}; const t=(cn,en,tw)=>String(c.langis)==='0'?en:String(c.langis)==='2'?(tw||cn):cn; const a=await firekylin.widget('Widget_Archive',{type:'index'}); %>
<% if(!a.is('tag') && !a.is('cate')) { %><section class="mdl-card daily-pic mdl-cell mdl-cell--8-col index-top-block"><div class="mdl-card__media mdl-color-text--grey-50 daily-media"><% if(c.dailypic) { %><img class="daily-image" src="<%= c.dailypic %>" alt=""><% } %><p class="index-top-block-slogan"><a href="<%= c.dailypicLink||'/' %>"><%= c.slogan || site.description() || site.title() %></a></p></div><div class="mdl-card__supporting-text meta"><img class="avatar" src="<%= c.avatarURL||site.themeUrl('res/avatar.svg') %>" alt=""><%= site.title() %></div></section>
<section class="mdl-card something-else mdl-cell mdl-cell--8-col mdl-cell--4-col-desktop index-top-block"><a class="search-fab" href="/search.html" aria-label="搜索"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></a><a class="something-else-logo" href="<%= c.logoLink||'/' %>"><% if(c.logo) { %><img src="<%= c.logo %>" alt="<%= site.title() %>"><% } else { %><span class="material-mark" aria-hidden="true">M</span><% } %></a><div class="mdl-card__supporting-text meta meta--fill"><strong><%= site.title() %></strong><span class="section-spacer"></span><details class="material-menu"><summary aria-label="页面">▦</summary><div><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }) %><a href="/archives"><%= t('归档','Archives','歸檔') %></a></div></details><details class="material-menu"><summary aria-label="更多">⋮</summary><div><a href="/rss.html">RSS</a><a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(site.siteUrl) %>"><%= t('分享到 Twitter','Share to Twitter','分享到 Twitter') %></a><a href="https://telegram.me/share/url?url=<%= encodeURIComponent(site.siteUrl) %>">Telegram</a></div></details></div></section><% } else { %><h1 class="mdl-cell mdl-cell--12-col"><%= a.archiveTitle %></h1><% } %>
<% if(!a.is('tag')&&!a.is('cate')&&c.stickyIds) { const ids=String(c.stickyIds).split(',').map(x=>x.trim()); const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:50}); while(recent.next()) { if(ids.includes(String(recent.row.id))) { %><div class="mdl-article-top mdl-cell mdl-cell--12-col"><a href="<%= recent.permalink %>">[<%= t('置顶','Pinned','置頂') %>] <%= recent.title() %></a></div><% } } } %>
<%~ await includeAsync('./inc/list', {...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>