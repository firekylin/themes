<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 - <%= site.title() %><% }) %><% block('content',()=>{ %><div class="card standalone"><h1>搜索</h1><form action="/search.html" method="get" role="search"><label for="keyword">关键词</label><input id="keyword" name="keyword" value="<%= archive.keyword %>" required><button type="submit">搜索</button></form><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>