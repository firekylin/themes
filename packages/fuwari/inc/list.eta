<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const im=String(archive.row.options?.featuredImage||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(im); %><article class="entry card <%= valid?'has-image':'' %>"><div class="entry-body"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><span class="meta-icon">▦</span><time><%= archive.date('YYYY-MM-DD') %></time></div><p><%~ archive.excerpt(260) %></p></div><% if(valid){ %><a class="entry-cover" href="<%= archive.permalink %>"><img src="<%= im %>" alt="" loading="lazy"></a><% }else{ %><a class="entry-arrow" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>">›</a><% } %></article><% }if(!count){ %><p class="card empty">暂无文章。</p><% } %>