<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const avatar=String(cfg.avatar||'');const banner=String(cfg.banner||'');const hasBanner=/^(https?:\/\/|\/(?!\/))/.test(banner);const hue=cfg.hue!==undefined&&cfg.hue!==''&&Number.isFinite(Number(cfg.hue))?Math.max(0,Math.min(360,Number(cfg.hue))):250; %><!doctype html><html lang="zh-CN" style="--hue:<%= hue %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></head><body class="<%= hasBanner?'has-banner':'' %>"><a class="skip" href="#main">跳转到正文</a><header class="navbar"><a class="brand" href="/">⌂ <%= site.title() %></a><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav><div class="controls"><details class="palette"><summary aria-label="主题色设置">◉</summary><label>主题色 <input id="hue" type="range" min="0" max="360" value="<%= hue %>"></label></details><button id="mode" aria-label="切换深浅色">◐</button></div></header><% if(hasBanner){ %><img class="banner" src="<%= banner %>" alt=""><% } %><div class="main-grid"><aside class="sidebar"><section class="card profile"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt="作者头像"><% } %><h2><%= cfg.authorName||site.title() %></h2><div class="profile-rule"></div><p><%= site.description() %></p></section><section class="card widget"><h2>分类</h2><ul><% categories.stack.forEach(c=>{ %><li><a href="/cate/<%= c.pathname %>"><%= c.name %></a><span><%= c.count %></span></li><% }); %></ul></section><section class="card widget"><h2>标签</h2><div class="tag-cloud"><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></section><nav id="toc" class="card widget" aria-label="文章目录" hidden><h2>目录</h2><ul></ul></nav></aside><div class="main-column"><main id="main"><%~ block('content') %></main><footer class="site-footer"><%= cfg.footerText||site.description() %><p>Firekylin · <a href="https://github.com/saicaca/fuwari">Fuwari</a> 原生改编</p></footer></div></div><a class="back-top" href="#main" aria-label="返回正文顶部">↑</a></body></html>