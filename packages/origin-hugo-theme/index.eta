<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('tag').select();related.forEach(p=>metaByPost.set(p.id,p));}const featured=archive.is('index')&&!archive.is('tag')&&!archive.is('cate')&&!archive.is('author')&&(archive.pagination?.currentPage||1)===1&&site.themeConfig.featured!=='off'; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><div class="list-header native-list-heading"><h1 class="listing-heading"><%= archive.archiveTitle %></h1></div><% } %><%~ include('./inc/list',{archive,metaByPost,featured}) %><%~ include('./inc/pagination',{archive}) %><% }) %>