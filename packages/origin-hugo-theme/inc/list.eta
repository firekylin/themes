<% const archive=firekylin.archive;let count=0;const featured=firekylin.featured===true;let group=''; %><% while(archive.next()){const current=featured&&count<3?'featured':'list';if(current!==group){if(group){ %></div><% }group=current; %><div class="<%= group==='featured'?'featured-posts':'post-list' %>"><% }count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row;const cover=String(archive.row.options?.featuredImage||'');const safe=/^(https?:\/\/|\/(?!\/))/i.test(cover);const tags=meta.tag||[]; %><% if(current==='featured'){ %><article class="entry featured-post <%= safe?'':'no-cover' %>"><% if(safe){ %><img class="featured-post__image" src="<%= cover %>" alt="" loading="lazy"><div class="featured-post__image-filter"></div><% } %><a class="featured-post__wrapper" href="<%= archive.permalink %>"><h2 class="featured-post__title"><%= archive.title() %></h2><div class="featured-post__description"><%= archive.excerpt(200) %></div><time><%= archive.date('YYYY-MM-DD') %></time></a><ul class="featured-post__tags"><% tags.forEach(t=>{ %><li><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a></li><% }); %></ul></article><% }else{ %><article class="entry post-item"><div class="post-item-flex"><a class="post-item__meta post-item--left <%= tags.length?'':'no-tag' %>" href="<%= archive.permalink %>"><h2 class="post-item__title"><%= archive.title() %></h2><time class="post-item__date"><%= archive.date('YYYY-MM-DD') %></time><div class="post-item__description"><%= archive.excerpt(250) %></div></a><% if(safe){ %><a class="post-item--right post-item__image" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><% if(tags.length){ %><a class="post-item__tag" href="/tag/<%= encodeURIComponent(tags[0].pathname||tags[0].name) %>"><%= tags[0].name %></a><% } %></div></article><% } %><% } %><% if(group){ %></div><% }else{ %><p>暂无文章。</p><% } %>