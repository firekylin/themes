{
  "name": "origin-hugo-theme",
  "title": "Origin",
  "version": "0.1.0",
  "private": true,
  "description": "Origin’s peach canvas, offset black header frame, asymmetric featured grid and shadowed image/text cards.",
  "license": "MIT",
  "author": "Andrey Parfenov; Firekylin contributors",
  "homepage": "https://github.com/fourtyone11/origin-hugo-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/origin-hugo-theme"
  },
  "firekylin": {
    "type": "theme",
    "id": "origin-hugo-theme"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "select",
      "name": "featured",
      "label": "首页前三篇突出展示",
      "options": [
        {
          "label": "开启",
          "value": "on"
        },
        {
          "label": "关闭",
          "value": "off"
        }
      ],
      "default": "on"
    }
  ]
}
