<% const archive=firekylin.archive;let count=0; %><div class="gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><% if(count===1){ %><figure class="gh-card-image"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></figure><% } %><time class="gh-card-date"><span class="gh-card-month"><%= archive.date('MM-DD') %></span> <%= archive.date('YYYY') %></time><h2 class="gh-card-title"><%= archive.title() %></h2><p class="gh-card-excerpt"><%= archive.excerpt(220) %></p></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>