<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post post-detail"><% if(found){ %><header class="post-head-wrapper-text-only"><h1 class="post-title"><%= archive.title() %></h1><p class="post-meta"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><div class="post-body-wrapper"><div class="post-body prose" id="post-content"><% const media=archive.row?.options?.attachment||{};const mediaUrl=String(media.url||'');const mediaValid=/^(https?:\/\/|\/(?!\/))/.test(mediaUrl);const mime=String(media.mime||''); %><% if(mediaValid){ %><section class="attachment-media"><% if(mime.startsWith('image/')){ %><a href="<%= mediaUrl %>"><img src="<%= mediaUrl %>" alt="<%= archive.title() %>"></a><% }else if(mime.startsWith('audio/')){ %><audio controls preload="metadata" src="<%= mediaUrl %>"></audio><% }else if(mime.startsWith('video/')){ %><video controls preload="metadata" src="<%= mediaUrl %>"></video><% } %><p><a href="<%= mediaUrl %>" download><%= media.name||archive.title() %></a></p></section><% } %><%~ archive.content() %></div></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>