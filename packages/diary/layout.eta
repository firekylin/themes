<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="native-mobile"><h1><a href="/"><%= site.title() %></a></h1><nav class="nav-items" aria-label="移动导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><div id="app"><div id="content"><main id="main" class="stream-container"><div class="post-list-container post-list-container-no-background"><%~ block('content') %></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/AmazingRise/hugo-theme-diary">Diary</a> by Rise</footer></main></div><aside class="side-container" id="sideContainer"><a class="a-block nav-head" href="/"><div class="nav-title"><%= site.title() %></div><div class="nav-subtitle"><%= site.description() %></div></a><nav class="nav-items nav-link-list" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></aside></div></body></html>