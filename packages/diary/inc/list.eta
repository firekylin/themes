<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><a href="<%= archive.permalink %>" class="a-block entry"><div class="post-item-wrapper"><article class="post-item post-item-no-divider"><div class="post-item-info-wrapper"><h2 class="post-item-title"><%= archive.title() %></h2><div class="post-item-summary"><%= archive.excerpt(220) %></div><div class="post-item-meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></div></div></article></div></a><% }if(!count){ %><p>暂无文章。</p><% } %>