<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="<%~ block('bodyClass') %>" data-zone="THE LIBRARY" data-sky="afternoon"><a class="skip" href="#main">跳转到正文</a><div class="world" aria-hidden="true"><div class="sky"></div><div class="celestial"></div><div class="layer layer--clouds" id="layer-clouds"></div><div class="layer layer--far" id="layer-far"></div><div class="layer layer--mid" id="layer-mid"></div><div class="layer layer--near" id="layer-near"></div><div class="layer layer--ground"><div class="ground-strip ground-grass" style="width:600vw"></div></div></div><div class="hero" aria-hidden="true"><div class="hero__shadow"></div><div class="hero__sprite" id="hero"></div></div><header class="hud hud--top" aria-hidden="true"><div class="hud-row"><div class="hud-box"><div><small>HP</small><div class="bar" style="--bar-color:var(--c-hp)"><div class="bar__fill" style="--w:100%"></div></div></div><div class="hud-num" id="hp-num">100</div></div><div class="hud-box"><div><small>XP</small><div class="bar" style="--bar-color:var(--c-xp)"><div class="bar__fill" id="xp-fill" style="--w:0%"></div></div></div><div class="hud-num" id="xp-num" data-start="0" data-max="100">0/100</div></div></div><div class="hud-name"><%= cfg.authorName||site.title() %></div></header><div class="hud hud--bottom" aria-hidden="true"><div class="hud-row"><div class="zone-tag">ZONE: <b id="zone-name">THE LIBRARY</b></div><div class="scroll-hint">▼ SCROLL TO MOVE ▼</div></div></div><div class="warp"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/brandonhon/press-start">Press Start</a></p></footer><button class="to-top" id="to-top" type="button" aria-label="返回顶部"><span class="tt-arrow" aria-hidden="true">▲</span><span class="tt-label">TOP</span></button><script src="<%= site.themeUrl('res/js/quest.js') %>" defer></script></body></html>