<% const archive=firekylin.archive;let count=0; %><section class="index-stack"><% while(archive.next()){count++; %><a class="scroll-card is-link entry" href="<%= archive.permalink %>"><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><h2><%= archive.title() %></h2><p><%= archive.excerpt(180) %></p><div class="read">▶ 阅读全文</div></a><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>