<% const archive=firekylin.archive;let count=0; %><div class="home"><ul class="post-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><div class="post-excerpt"><%= archive.excerpt(240) %></div></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul></div>