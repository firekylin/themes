<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="is-head-left-logo home-template"><a class="native-skip" href="#main">跳转到正文</a><div class="site-container"><header class="site-header"><div class="wrapper native-header"><a class="site-title" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="site-body wrapper"><aside class="site-sidebar"><div class="sidebar-section"><h3><%= cfg.authorName||site.title() %></h3><p><%= site.description() %></p></div><div class="sidebar-section"><h3>标签</h3><ul><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><li><a href="<%= tags.permalink %>"><%= tags.row.name %></a></li><% } %></ul></div></aside><main id="main" class="native-main site-main"><%~ block('content') %></main></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/ngzhio/jekyll-theme-hamilton">Hamilton</a> by Ng Zhi O</footer></body></html>