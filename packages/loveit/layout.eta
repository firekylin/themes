<% const s=await firekylin.widget('Widget_Options'),c=s.themeConfig||{},mode=['light','dark','auto'].includes(c.colorMode)?c.colorMode:'light'; %><!doctype html><html lang="en" data-theme="<%= mode %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= s.description() %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/fontawesome/css/all.min.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/animate.css') %>"><link rel="stylesheet" href="<%= s.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><script defer src="<%= s.themeUrl('res/js/loveit.js') %>"></script></head><body theme="<%= mode==='dark'?'dark':'light' %>" data-color-mode="<%= mode %>" data-code-lines="<%= Math.min(100,Math.max(5,Number(c.codeMaxLines)||20)) %>" data-header-desktop="<%= c.headerMode==='normal'?'normal':'fixed' %>" data-header-mobile="<%= c.headerMode==='normal'?'normal':'fixed' %>"><a class="skip-link" href="#main">Skip to content</a><div id="mask"></div><div class="wrapper"><header class="desktop" id="header-desktop"><div class="header-wrapper"><div class="header-title"><a href="/"><%= s.title() %></a></div><div class="menu"><div class="menu-inner"><% for(const n of s.navigation){ %><a class="menu-item" href="<%= n.url %>"><%= n.label %></a><% } %><span class="menu-item delimiter"></span><a class="menu-item" href="/search.html" aria-label="Search"><i class="fas fa-search" aria-hidden="true"></i></a><button type="button" class="menu-item theme-switch" aria-label="Switch theme" hidden><i class="fas fa-adjust" aria-hidden="true"></i></button></div></div></div></header><header class="mobile" id="header-mobile"><div class="header-container"><div class="header-wrapper"><div class="header-title"><a href="/"><%= s.title() %></a></div><button type="button" class="menu-toggle" id="menu-toggle-mobile" aria-label="Toggle menu" aria-controls="menu-mobile" aria-expanded="false" hidden><span></span><span></span><span></span></button></div><nav class="menu" id="menu-mobile"><% for(const n of s.navigation){ %><a class="menu-item" href="<%= n.url %>"><%= n.label %></a><% } %><a class="menu-item" href="/search.html">Search</a><button type="button" class="menu-item theme-switch" aria-label="Switch theme" hidden><i class="fas fa-adjust" aria-hidden="true"></i></button></nav></div></header><main id="main" class="main"><div class="container"><%~ block('content') %></div></main><footer class="footer"><div class="footer-container"><div class="footer-line"><%= c.footerText||s.title() %></div><div class="footer-line">Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/dillonzq/LoveIt"><i class="far fa-kiss-wink-heart" aria-hidden="true"></i> LoveIt</a> · <a href="/rss.html">RSS</a></div></div></footer></div><div id="fixed-buttons"><a href="#" id="back-to-top" class="fixed-button" aria-label="Back to top"><i class="fas fa-arrow-up" aria-hidden="true"></i></a></div><dialog id="image-dialog" aria-label="Image viewer"><button type="button" aria-label="Close image">×</button><img alt=""><p></p></dialog></body></html>
