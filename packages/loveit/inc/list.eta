<% const a=firekylin.archive,safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';if(!a.have()){ %><p>No articles found.</p><% }while(a.next()){const row=a.row,image=safe(row.featuredImage||row.options?.featuredImage); %><article class="single summary"><% if(image){ %><div class="featured-image-preview"><a href="<%= a.permalink %>"><img src="<%= image %>" alt="" loading="lazy"></a></div><% } %><h1 class="single-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h1><div class="post-meta"><span class="post-author"><a class="author" href="<%= '/author/'+encodeURIComponent(row.user?.name||'') %>"><i class="fas fa-user-circle" aria-hidden="true"></i> <%= a.author('display_name') %></a></span> <span class="post-publish">published on <time><%= a.date('Y-m-d') %></time></span></div><div class="content"><p><%= a.excerpt(280,true) %></p></div><div class="post-footer"><a href="<%= a.permalink %>">Read More</a><% if(row.tag?.length){ %><div class="post-tags"><i class="fas fa-tags" aria-hidden="true"></i> <% for(const t of row.tag){ %><a href="<%= '/tag/'+t.pathname %>"><%= t.name %></a> <% } %></div><% } %></div></article><% } %><%~ include('./pagination',{archive:a}) %>
