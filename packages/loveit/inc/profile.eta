<% const s=firekylin.site,c=s.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'';let links=[];try{const v=JSON.parse(c.socialJSON||'[]');if(Array.isArray(v))links=v;}catch{} %><div class="home-profile"><% if(safe(c.avatarUrl)){ %><div class="home-avatar"><a href="<%= safe(c.avatarLink)||'/' %>"><img src="<%= safe(c.avatarUrl) %>" width="120" height="120" alt="Profile"></a></div><% } %><h1 class="home-title"><%= c.profileTitle||s.title() %></h1><div class="home-subtitle"><%= c.profileSubtitle||s.description() %></div><% if(links.length){ %><div class="links"><% for(const n of links){if(n&&safe(n.url)){ %><a href="<%= safe(n.url) %>"><%= String(n.label||'Link') %></a><% }} %></div><% } %></div>
