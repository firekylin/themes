<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>Archives - <%= s.title() %><% }) %><% block('content',()=>{ %><div class="page archive"><h2 class="single-title">All Posts</h2><% for(const [month,rows] of Object.entries(a.grouped||{})){ %><h3 class="group-title"><%= month %></h3><% for(const row of rows){ %><article class="archive-item"><a class="archive-item-link" href="<%= a.permalinkFor(row) %>"><%= row.title %></a><span class="archive-item-date"><%= String(row.create_time||'').slice(5,10) %></span></article><% }} %></div><% }) %>
