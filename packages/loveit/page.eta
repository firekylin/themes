<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'page'}),exists=a.next(),c=s.themeConfig||{},safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/.test(String(v||''))?String(v):'',image=safe(a.row.featuredImage||a.row.options?.featuredImage); %><% block('title',()=>{ %><%= exists?a.title():s.title() %><% }) %><% block('content',()=>{ %><% if(c.tocEnabled!=='false'){ %><aside class="toc" id="toc-auto" hidden><h2 class="toc-title">Contents</h2><div class="toc-content always-active" id="toc-content-auto"></div></aside><% } %><article class="page single"><% if(exists){ %><h1 class="single-title animate__animated animate__flipInX"><%= a.title() %></h1><div class="post-meta"><div class="post-meta-line"><span class="post-author"><a class="author" href="<%= '/author/'+encodeURIComponent(a.row.user?.name||'') %>"><i class="fas fa-user-circle" aria-hidden="true"></i> <%= a.author('display_name') %></a></span></div><div class="post-meta-line"><i class="far fa-calendar-alt" aria-hidden="true"></i> <time><%= a.date('Y-m-d') %></time></div></div><% if(image){ %><div class="featured-image"><img src="<%= image %>" alt=""></div><% } %><% if(c.tocEnabled!=='false'){ %><details class="toc" id="toc-static" hidden><summary class="toc-title"><span>Contents</span><i class="fas fa-angle-right" aria-hidden="true"></i></summary><div class="toc-content" id="toc-content-static"></div></details><% } %><div class="content article-body" id="content"><%~ a.content() %></div><div class="post-footer" id="post-footer"><div class="post-info"><div class="post-info-line"><div class="post-info-mod"><% if(a.row.update_time){ %>Updated on <%= String(a.row.update_time).slice(0,10) %><% } %></div></div></div><div class="post-info-more"><section class="post-tags"><% for(const t of a.row.tag||[]){ %><a href="<%= '/tag/'+t.pathname %>"><%= t.name %></a> <% } %></section><section><a href="/">Home</a></section></div><nav class="post-nav" aria-label="Adjacent posts"><% for(const kind of ['prev','next']){const row=a.row[kind];if(row&&row.pathname){ %><a class="<%= kind %>" rel="<%= kind %>" href="<%= a.permalinkFor(row) %>"><% if(kind==='prev'){ %><i class="fas fa-angle-left" aria-hidden="true"></i> <% } %><%= row.title %><% if(kind==='next'){ %> <i class="fas fa-angle-right" aria-hidden="true"></i><% } %></a><% }} %></nav></div><%~ firekylin.comment({title:'Comments'}) %><% }else{ %><h1>Content unavailable</h1><% } %></article><% }) %>
