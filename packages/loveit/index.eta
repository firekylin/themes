<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Archive',{type:'index'}),c=s.themeConfig||{},home=a.is('index')&&(!a.pagination||a.pagination.currentPage===1); %><% block('title',()=>{ %><%= a.archiveTitle||s.title() %><% }) %><% block('content',()=>{ %><div class="page home" <% if(!home||c.postsEnabled!=='false'){ %>data-home="posts"<% } %>><% if(home&&c.profileEnabled!=='false'){ %><%~ include('./inc/profile',{site:s}) %><% }else if(!home){ %><h1><%= a.archiveTitle||'Articles' %></h1><% } %><% if(!home||c.postsEnabled!=='false'){ %><%~ include('./inc/list',{archive:a}) %><% } %></div><% }) %>
