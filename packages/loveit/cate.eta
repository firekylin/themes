<% layout('./layout');const s=await firekylin.widget('Widget_Options'),a=await firekylin.widget('Widget_Metas_Category_List'); %><% block('title',()=>{ %>Categories - <%= s.title() %><% }) %><% block('content',()=>{ %><div class="page archive"><h2 class="single-title">Categories</h2><div class="tag-cloud-tags"><% while(a.next()){ %><a href="<%= a.permalink %>"><%= a.row.name %> <sup><%= a.row.count||0 %></sup></a> <% } %></div></div><% }) %>
