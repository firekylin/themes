<%
const site=await firekylin.widget('Widget_Options'),cfg=site.themeConfig||{},type=firekylin.pageType,detail=['post','page','attachment'].includes(type),archive=await firekylin.widget('Widget_Archive',{type});
const scheme=['Muse','Mist','Pisces','Gemini'].includes(cfg.scheme)?cfg.scheme:'Muse';const safe=v=>typeof v==='string'&&/^(https?:\/\/|mailto:|\/(?!\/)|#)/i.test(v)?v:'#';const parse=v=>{try{const a=JSON.parse(v||'[]');return Array.isArray(a)?a.filter(x=>x&&typeof x==='object').slice(0,50):[];}catch{return [];}};
%><!doctype html><html lang="en" class="theme-next <%= scheme.toLowerCase() %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/'+scheme+'.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script src="<%= site.themeUrl('res/js/next.js') %>" defer></script></head><body><a href="#content" class="skip-link">Skip to content</a><div class="container sidebar-position-<%= cfg.sidebarPosition==='right'?'right':'left' %> <%= detail?'page-post-detail':'page-home' %>"><div class="headband"></div>
<header id="header" class="header"><div class="header-inner"><div class="site-brand-wrapper"><div class="site-meta"><div class="custom-logo-site-title"><a href="/" class="brand"><span class="logo-line-before"><i></i></span><span class="site-title"><%= site.title() %></span><span class="logo-line-after"><i></i></span></a></div><p class="site-subtitle"><%= cfg.subtitle||site.description() %></p></div><div class="site-nav-toggle"><button type="button" aria-label="Toggle navigation" aria-controls="menu" aria-expanded="false" hidden><span class="btn-bar"></span><span class="btn-bar"></span><span class="btn-bar"></span></button></div></div><nav class="site-nav"><ul id="menu" class="menu"><% for(const n of site.navigation||[]){ %><li class="menu-item"><a href="<%= safe(n.url) %>"><%= n.label %></a></li><% } %><li class="menu-item"><a href="/search.html">Search</a></li></ul></nav></div></header>
<main id="main" class="main"><div class="main-inner"><div class="content-wrap"><div id="content" class="content">
<% if(type==='archive'){ %><section class="posts-collapse"><div class="collection-title"><h1>Archives</h1></div><% for(const [month,rows] of Object.entries(archive.grouped||{})){ %><div class="collection-title"><h2><%= month %></h2></div><% for(const row of rows){ %><article class="post"><header class="post-header"><h3 class="post-title"><a class="post-title-link" href="<%= archive.permalinkFor(row) %>"><%= row.title %></a></h3><div class="post-meta"><time><%= String(row.create_time).slice(5,10) %></time></div></header></article><% }} %></section>
<% }else if(type==='cate'||type==='tag'){const metas=await firekylin.widget(type==='cate'?'Widget_Metas_Category_List':'Widget_Metas_Tag_Cloud'); %><section class="posts-expand"><h1><%= type==='cate'?'Categories':'Tags' %></h1><ul class="category-list"><% while(metas.next()){ %><li class="category-list-item"><a href="<%= metas.permalink %>"><%= metas.title() %></a></li><% } %></ul></section>
<% }else{ %><section id="posts" class="posts-expand"><% if(type==='search'){ %><h1>Search</h1><form action="/search.html" method="get"><label for="keyword">Search articles</label><input id="keyword" name="keyword" value="<%= archive.keyword||'' %>"><button class="btn">Search</button></form><% }else if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><% let count=0;while(archive.next()){count++; %><article class="post post-type-normal"><div class="post-block"><header class="post-header"><h1 class="post-title"><% if(detail){ %><%= archive.title() %><% }else{ %><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a><% } %></h1><div class="post-meta"><span class="post-time">Posted on <time><%= archive.date('Y-m-d') %></time></span><% if(cfg.showUpdated==='true'&&archive.row?.update_time){ %> | Updated <%= String(archive.row.update_time).slice(0,10) %><% } %><% for(const meta of archive.row?.cate||[]){ %> | <a href="/cate/<%= meta.pathname %>"><%= meta.name %></a><% } %></div></header><div class="post-body"><% if(detail){ %><%~ archive.content() %><% }else{ %><p><%= archive.excerpt(300) %></p><div class="post-button text-center"><a class="btn" href="<%= archive.permalink %>">Read more »</a></div><% } %></div><footer class="post-footer"><% if(detail){ %><div class="post-tags"><% for(const meta of archive.row?.tag||[]){ %><a href="/tag/<%= meta.pathname %>"># <%= meta.name %></a><% } %></div><div class="post-nav"><% for(const key of ['prev','next']){const n=archive.row?.[key];if(n?.pathname){ %><div class="post-nav-item post-nav-<%= key %>"><a rel="<%= key %>" href="<%= archive.permalinkFor(n) %>"><%= n.title %></a></div><% }} %></div><% }else{ %><div class="post-eof"></div><% } %></footer></div></article><% if(detail){const c=firekylin.comment({title:'Comments',className:'article-comments'});if(c){ %><%~ c %><% }break;}}if(!count){ %><p>No articles found.</p><% } %></section><% if(!detail&&archive.pagination){const p=archive.pagination; %><nav class="pagination" aria-label="Pagination"><% if(p.currentPage>1){ %><a rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">Previous</a><% } %><span class="page-number current"><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">Next</a><% } %></nav><% }} %></div></div>
<aside id="sidebar" class="sidebar"><div class="sidebar-inner"><button type="button" id="close-sidebar" hidden>Close</button><% if(detail&&cfg.showToc!=='false'){ %><ul class="sidebar-nav"><li><button data-panel="toc-panel" aria-pressed="true">Contents</button></li><li><button data-panel="overview-panel" aria-pressed="false">Overview</button></li></ul><section id="toc-panel"><nav class="post-toc" aria-label="Table of contents"><ol class="nav"></ol></nav></section><% } %><section id="overview-panel" class="site-overview"><div class="site-author"><% if(safe(cfg.avatarUrl)!=='#'){ %><img class="site-author-image" src="<%= safe(cfg.avatarUrl) %>" alt=""><% } %><p class="site-author-name"><%= cfg.authorName||site.title() %></p><p class="site-description"><%= cfg.description||site.description() %></p></div><div class="feed-link"><a href="/rss.html">RSS</a></div><div class="links-of-author"><% for(const s of parse(cfg.socialLinks)){ %><span class="links-of-author-item"><a href="<%= safe(s.url) %>" rel="me noopener"><%= s.name %></a></span><% } %></div><div class="links-of-blogroll"><h3 class="links-of-blogroll-title">Recent posts</h3><ul class="links-of-blogroll-list"><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});while(recent.next()){ %><li class="links-of-blogroll-item"><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul><% for(const l of parse(cfg.links)){ %><p><a href="<%= safe(l.url) %>"><%= l.name %></a></p><% } %></div></section></div></aside></div></main>
<footer id="footer" class="footer"><div class="footer-inner">© <%= new Date().getFullYear() %> <%= cfg.footerText||site.title() %><br>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · Theme <a href="https://github.com/iissnan/hexo-theme-next">NexT.<%= scheme %></a></div></footer><button class="sidebar-toggle" type="button" aria-controls="sidebar" aria-expanded="false" hidden>☰</button><a class="back-to-top" href="#" aria-label="Back to top">↑ <span id="scrollpercent">0%</span></a><div id="sidebar-mask" hidden></div></div></body></html>
