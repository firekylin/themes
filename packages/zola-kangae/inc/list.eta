<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="entry"><header class="article-header"><p class="time-title"><time><%= archive.date('YYYY-MM-DD') %></time><strong class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></strong></p><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a class="tag" href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></header><div class="summary"><p><%= archive.excerpt(400) %></p></div><footer class="article-footer"><a href="<%= archive.permalink %>" aria-label="阅读全文：<%= archive.title() %>">阅读全文 →</a></footer></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>