<% const archive=firekylin.archive;let count=0; %><div class="bloglist-container"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><section class="bloglist-meta bottom-divider"><ul><li class="date"><time><%= archive.date('YYYY-MM-DD') %></time></li></ul></section><section class="bloglist-content bottom-divider entry"><div><h2 class="bloglist-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="description"><p><%= archive.excerpt(260) %></p></div><a class="readmore" href="<%= archive.permalink %>">阅读全文 <span class="arrow">→</span></a></div></section><% }if(!count){ %><p>暂无文章。</p><% } %></div>