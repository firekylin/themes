{
  "name": "hugo-sugoi",
  "title": "Sugoi",
  "version": "0.1.0",
  "private": true,
  "description": "Sugoi’s Skeleton layout, charcoal hero, overlapping rounded reading panel and JavaScript-free menu.",
  "license": "MIT",
  "author": "Anupam; Firekylin contributors",
  "homepage": "https://github.com/aanupam23/hugo-sugoi",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/hugo-sugoi"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugo-sugoi"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍"
    },
    {
      "type": "text",
      "name": "heroTitle",
      "label": "首页介绍标题"
    },
    {
      "type": "text",
      "name": "heroLink",
      "label": "首页按钮链接",
      "help": "站内路径或 HTTP(S) URL，留空指向归档。"
    },
    {
      "type": "text",
      "name": "heroLinkText",
      "label": "首页按钮文字"
    }
  ]
}
