<% const archive=firekylin.archive;let count=0; %><div class="sugoi-feed"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row; %><article class="entry"><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time><span><%= archive.author('display_name') %></span></div><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(300) %></p><div class="entry-actions"><a class="button" href="<%= archive.permalink %>">继续阅读</a><span class="entry-categories"><% (meta.cate||[]).forEach(c=>{ %><a href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a> <% }); %></span></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>