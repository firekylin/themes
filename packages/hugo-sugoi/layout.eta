<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="sugoi-header"><a class="sugoi-brand" href="/"><%= site.title() %></a><input id="native-menu" class="native-menu-input" type="checkbox" checked aria-label="显示导航菜单"><label class="native-menu-label" for="native-menu">菜单</label><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><section class="section hero"><div class="container"><%~ block('hero') %></div></section><main id="main" class="section main native-main"><div class="native-reading"><%~ block('content') %></div></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/aanupam23/hugo-sugoi">Sugoi</a> · Anupam</p></footer></body></html>