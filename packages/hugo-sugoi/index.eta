<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate,tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('hero',()=>{ %><h1><%= archive.archiveTitle||site.themeConfig.heroTitle||site.description()||site.title() %></h1><% if(!archive.archiveTitle){const url=String(site.themeConfig.heroLink||'/archives');if(/^(https?:\/\/|\/(?!\/))/i.test(url)){ %><a class="button button-primary hero-action" href="<%= url %>"><%= site.themeConfig.heroLinkText||'浏览文章' %></a><% }} %><% }) %><% block('content',()=>{ %><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %><% }) %>