<% const archive=firekylin.archive;let count=0,lastGroup=''; %><section class="posts"><% while(archive.next()){count++; %><% const month=archive.date('YYYY-MM');if(month!==lastGroup){if(lastGroup){ %></ol></div><% }lastGroup=month; %><div class="posts-archive"><time class="posts-archive-month"><%= month %></time><ol class="posts-list"><% } %><li class="entry"><a href="<%= archive.permalink %>"><%= archive.title() %></a></li><% } %><% if(count){ %></ol></div><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>