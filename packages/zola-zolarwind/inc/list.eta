<% const archive=firekylin.archive;let count=0; %><div class="post-grid"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row;const image=String(archive.row.options?.featuredImage||''); %><article class="entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img class="entry-cover" src="<%= image %>" alt="" loading="lazy"></a><% } %><div class="entry-body"><div class="entry-tags"><% (meta.tag||[]).forEach(t=>{ %><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>">#<%= t.name %></a><% }); %></div><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(260) %></p><p class="entry-date"><time><%= archive.date('YYYY-MM-DD') %></time></p></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>