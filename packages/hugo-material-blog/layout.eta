<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="site-name" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><div class="footer-inner"><h2><%= site.title() %></h2><p><%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/Xzya/hugo-material-blog">Hugo Material Blog</a> · Mihail Cristian Dumitru</p></div><div class="footer-copyright"><p class="footer-author"><%= cfg.authorName||site.title() %></p></div></footer></body></html>