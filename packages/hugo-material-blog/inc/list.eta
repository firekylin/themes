<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="summary-meta"><strong><%= archive.author('display_name') %></strong><time><%= archive.date('YYYY-MM-DD') %></time></div><p class="entry-excerpt"><%= archive.excerpt(400) %></p></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>