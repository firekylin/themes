<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-detail"><% if(found){ %><header class="post-heading"><h1><%= archive.title() %></h1></header><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="cover-wrap"><img class="post-cover" src="<%= cover %>" alt=""></div><% } %><div class="article-columns"><aside class="article-byline"><strong><%= archive.author('display_name') %></strong><time><%= archive.date('YYYY-MM-DD') %></time></aside><div class="article-body"><div class="prose post-content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %></div></div><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>