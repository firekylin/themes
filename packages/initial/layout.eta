<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || '')) ? String(value) : ''; const background=safe(config.background); const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#6f9fc7'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/initial.js') %>"></script><%~ block('headers') %></head>
<body class="fk-theme <%= config.oneColumn==='1'?'initial-one':'has-sidebar' %> <%= config.fixedHeader==='1'?'initial-fixed':'' %> <%= config.colorMode==='dark'?'fk-dark':'' %>"><a class="skip-link" href="#main">跳转到正文</a><header class="fk-header"><a class="fk-brand" href="/"><% if(safe(config.logoUrl)){ %><img class="initial-logo" src="<%= safe(config.logoUrl) %>" alt=""><% } %><%= site.title() %></a><nav class="fk-nav" aria-label="主导航"><% for(const nav of site.navigation){ %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></header><div class="fk-shell"><main id="main"><%~ block('content') %></main><% if(config.oneColumn!=='1'){ %><aside class="fk-sidebar"><section class="fk-widget"><h2>关于本站</h2><p><%= config.heroText||site.description() %></p></section><section class="fk-widget"><h2>最新文章</h2><ul><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section class="fk-widget"><h2>标签云</h2><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a class="initial-tag" href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a><% } %></section></aside><% } %></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/jielive/initial">Initial</a> by jielive · <a href="/rss.html">RSS</a></p></footer></body></html>
