<% const archive=firekylin.archive;%><div class="fk-feed"><% while(archive.next()){const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage||'')?archive.row.featuredImage:'';%><article class="entry-card"><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% for(const cat of archive.row.cate||[]){ %> · <a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><% if(archive.row.comment_num!=null){ %> · <%= Number(archive.row.comment_num)||0 %> 条评论<% } %></div><% if(cover){ %><img class="initial-thumb" src="<%= cover %>" alt="" loading="lazy"><% } %><p class="entry-excerpt"><%= archive.excerpt(200) %></p><p class="initial-more"><a href="<%= archive.permalink %>">- 阅读全文 -</a></p></div></article><% } %></div>