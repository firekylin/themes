<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="summary entry"><header class="header"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><figure class="banner"><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a></figure><% } %><div class="header__metadata inline-list metadata"><time><%= archive.date('YYYY-MM-DD') %></time><div class="header__categories"><% (archive.row.cate||[]).forEach(c=>{ %><a class="inline-list__item" href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div></div><h2 class="header__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="summary__content"><%~ archive.excerpt(200) %></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>