<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle ? archive.archiveTitle+' · '+site.title() : site.title() %><% }) %><% block('content',()=>{ %><%~ include('./inc/hero',{cover:archive.archiveTitle?'':String(site.themeConfig.headerImage||''),title:archive.archiveTitle||site.title(),subtitle:archive.archiveTitle?'':site.description()}) %><div class="container"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>