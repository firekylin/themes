<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= site.title() %><% }) %><% block('content',()=>{ %><%~ include('./inc/hero',{cover:String(site.themeConfig.headerImage||''),title:site.title(),subtitle:site.description()}) %><div class="container"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>