<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="header-wrapper"><header id="header" class="native-container"><h1><a href="/"><%= site.title() %></a></h1><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header></div><div id="main-wrapper"><main id="main" class="native-container"><%~ block('content') %></main></div><div id="footer-wrapper"><footer class="native-container"><div class="footer-grid"><section><h2>最新文章</h2><ul><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:4});while(recent.next()){ %><li><time><%= recent.date('MM-DD') %></time><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section><section><h2><%= cfg.authorName||site.title() %></h2><p><%= cfg.footerText||site.description() %></p><a class="button" href="/archives">全部文章</a></section></div><p class="credit">Firekylin · <a href="https://github.com/curttimson/hugo-theme-dopetrope">Dopetrope</a> by Curtis Timson · Design: <a href="https://html5up.net">HTML5 UP / AJ</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a></p></footer></div></body></html>