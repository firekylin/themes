<% const archive=firekylin.archive;let count=0; %><div class="blog-grid"><% while(archive.next()){count++;const locked=Boolean(archive.row.password_protected||archive.row.title==='此内容被密码保护'||archive.row.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||''); %><article class="entry box"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="image featured" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><time><%= archive.date('YYYY-MM-DD') %></time></p></header><p><%= archive.excerpt(230) %></p><footer><a class="button" href="<%= archive.permalink %>">继续阅读</a></footer></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>