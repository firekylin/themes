<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="major"><h1><%= archive.archiveTitle||'Blog' %></h1></header><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>