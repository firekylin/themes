<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(avatar); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="container wrapper"><header class="header"><% if(valid){ %><div class="avatar"><a href="/"><img src="<%= avatar %>" alt="<%= site.title() %>"></a></div><% } %><h1 class="site-title"><a href="/"><%= site.title() %></a></h1><div class="site-description"><p><%= site.description() %></p><button class="mode-toggle" type="button" aria-pressed="false" hidden>深色模式</button></div><nav aria-label="主导航"><ul class="flat nav-items"><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav></header><main id="main"><%~ block('content') %></main><footer class="footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/knadh/hugo-ink">Ink</a> by Kailash Nadh</footer></div></body></html>