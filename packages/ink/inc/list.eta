<% const archive=firekylin.archive;let count=0; %><section class="recent-posts"><ul class="posts flat"><% while(archive.next()){count++; %><li class="post entry"><div class="post-header"><div class="meta"><div class="date"><span class="day"><%= archive.date('DD') %></span><span class="rest"><%= archive.date('YYYY/MM') %></span></div></div><div class="matter"><h4 class="title small"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h4><span class="description"><%= archive.excerpt(120) %></span></div></div></li><% } %></ul></section><% if(!count){ %><p>暂无文章。</p><% } %>