{
  "name": "ink",
  "title": "Ink",
  "version": "0.1.0",
  "private": true,
  "description": "Ink minimal blog with large date columns and light/dark mode.",
  "license": "MIT",
  "author": "Kailash Nadh; Firekylin contributors",
  "homepage": "https://github.com/knadh/hugo-ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/ink"
  },
  "firekylin": {
    "type": "theme",
    "id": "ink"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatar",
      "label": "头像地址"
    }
  ]
}
