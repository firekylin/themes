<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><h1 class="listing-title"><%= archive.archiveTitle||'最新文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>