<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><div class="entry"><div class="date"><time><%= archive.date('YYYY-MM-DD') %></time><span class="author"><%= archive.author('display_name') %></span></div><article><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a class="pure-button" href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><p><%= archive.excerpt(400) %></p></article></div><% } %><% if(!count){ %><p>暂无文章。</p><% } %>