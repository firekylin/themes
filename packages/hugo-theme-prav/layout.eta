<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="container"><header id="navbar"><a class="pure-menu-heading" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="theme-toggle" hidden>切换主题</button></header><div class="pure-g"><main id="main" class="pure-u-1 pure-u-md-3-4"><div id="content"><%~ block('content') %></div></main><aside id="sidebar" class="pure-u-1 pure-u-md-1-4"><div class="pad"><h3>关于本站</h3><div class="panel"><p><em><%= site.description() %></em></p></div><h3>最新文章</h3><div class="pure-menu"><ul class="pure-menu-list"><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:10});while(recent.next()){ %><li class="pure-menu-item"><a class="pure-menu-link" href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></div><h3>标签</h3><div class="panel tags"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a class="pure-button" href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a><% } %></div></div></aside></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/pravin/hugo-theme-prav">Prav</a> · Pravin Paratey</p></footer></div></body></html>