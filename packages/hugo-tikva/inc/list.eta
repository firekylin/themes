<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry post"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div><p><%= archive.excerpt(280) %></p><a class="btn btn-outline-primary" href="<%= archive.permalink %>">阅读全文 »</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>