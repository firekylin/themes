<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><% const side=['left','right','none'].includes(cfg.sidebar)?cfg.sidebar:'right';const cover=String(cfg.headerImage||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><header class="container masthead"><h1><a href="/"><%= site.title() %></a></h1><p class="subtitle"><%= site.description() %></p><% if(valid){ %><img class="header-image" src="<%= cover %>" alt=""><% } %><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><div class="container native-layout sidebar-<%= side %>"><main id="main" class="native-content"><%~ block('content') %></main><% if(side!=='none'){ %><aside class="tikva-sidebar"><section class="sidebar-panel"><h2>关于本站</h2><p><%= site.description() %></p></section><section class="sidebar-panel"><h2>分类</h2><ul><% const cats=await firekylin.widget('Widget_Metas_Category_List');while(cats.next()){ %><li><a href="/cate/<%= cats.row.pathname %>"><%= cats.row.name %></a></li><% } %></ul></section><section class="sidebar-panel"><h2>最新文章</h2><ul class="recent"><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:10});while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></section></aside><% } %></div><footer class="footer-container"><div class="container footer-grid"><section><h2>关于</h2><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p></section><section><h2>浏览</h2><div class="footer-links"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/search.html">搜索</a></div></section><section><h2>标签</h2><div class="tags"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a> <% } %></div></section></div></footer><div class="subfooter-container"><div class="container"><p>Firekylin · <a href="https://github.com/geschke/hugo-tikva">Tikva</a> · Ralf Geschke</p></div></div></body></html>