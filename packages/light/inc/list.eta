<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post h-entry entry"><div class="post-content"><header><time><%= archive.date('YYYY-MM-DD') %></time><h1 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1></header><div class="e-content"><p><%= archive.excerpt(260) %></p></div><footer><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></footer></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>