<% const archive=firekylin.archive;let count=0; %><div class="flex flex-col gap-3"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><div class="entry"><a href="<%= archive.permalink %>" class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 hover:bg-black/5 hover:text-black transition-colors duration-300 ease-in-out"><div class="flex flex-col flex-1 truncate"><div class="font-semibold"><%= archive.title() %></div><div class="text-sm"><%= archive.excerpt(160) %></div></div><span class="native-arrow">›</span></a></div><% }if(!count){ %><p>暂无文章。</p><% } %></div>