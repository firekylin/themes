<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><header class="native-heading"><div class="mx-auto max-w-screen-sm px-5"><div class="flex flex-wrap gap-y-2 justify-between"><a class="font-semibold" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><main id="main" class="native-main mx-auto max-w-screen-sm px-5"><p class="mb-8"><%= site.description() %></p><%~ block("content") %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/markhorn-dev/astro-nano">Astro Nano</a> by Mark Horn</footer></body></html>