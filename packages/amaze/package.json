      "help": "HTTP(S) 或站内绝对路径。"
    },
    {
      "type": "text",
      "name": "backgroundText",
      "label": "横幅标题",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像",
      "help": "HTTP(S) 或站内绝对路径。"
    },
    {
      "type": "text",
      "name": "socialGithub",
      "label": "GitHub",
      "help": "完整 HTTPS 个人主页 URL。"
    },
    {
      "type": "text",
      "name": "socialWeibo",
      "label": "微博",
      "help": "完整 HTTPS 个人主页 URL。"
    }
