{
  "name": "amaze",
  "title": "Amaze",
  "version": "0.1.0",
  "private": true,
  "description": "Amaze expansive header, author-led journal and reading directory.",
  "license": "MIT",
  "author": "spiritree; Firekylin contributors",
  "homepage": "https://github.com/spiritree/typecho-theme-amaze",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/amaze"
  },
  "firekylin": {
    "type": "theme",
    "id": "amaze"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "backgroundImage",
