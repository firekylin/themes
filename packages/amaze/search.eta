<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'});const cats=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %><%= archive.archiveTitle||'搜索' %> <%= site.title() %><% }) %><% block('content',()=>{ %><div class="blog-fixed journal-layout"><div class="journal-list"><section><h1>搜索：<%= archive.keyword %></h1><form action="/search.html" method="get" role="search"><label for="keyword">关键词</label><input id="keyword" name="keyword" value="<%= archive.keyword %>" required><button type="submit">搜索</button></form></section><%~ include('./inc/list',{archive,site}) %><% if(!archive.have()){ %><p>暂无文章。</p><% } %><%~ include('./inc/pagination',{archive}) %></div><%~ include('./inc/sidebar',{site,cats,tags}) %></div><% }) %>