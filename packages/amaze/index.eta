<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cats=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %><%= archive.archiveTitle||'' %> <%= site.title() %><% }) %><% block('content',()=>{ %><div class="blog-fixed journal-layout"><div class="journal-list"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive,site}) %><% if(!archive.have()){ %><p>暂无文章。</p><% } %><%~ include('./inc/pagination',{archive}) %></div><%~ include('./inc/sidebar',{site,cats,tags}) %></div><% }) %>