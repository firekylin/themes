<% const site=await firekylin.widget('Widget_Options');const banner=String(site.themeConfig.backgroundImage||''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/base.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body id="blog"><a class="skip-link" href="#main">跳转到正文</a><nav class="amaze-nav" aria-label="主导航"><a class="brand" href="/"><%= site.title() %></a><details class="amaze-menu" open><summary>菜单</summary><div><a href="/">HOME</a><% site.navigation.forEach(nav=>{ %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %><a href="/archives">归档</a><a href="/search.html">搜索</a></div></details></nav><header class="intro-header"><% if(/^(https?:\/\/|\/(?!\/))/.test(banner)){ %><img class="banner-image" src="<%= banner %>" alt=""><% } %><div class="container"><%~ block('hero',()=>{ %><div class="site-heading"><h1><%= site.themeConfig.backgroundText||site.title() %></h1><span class="subheading"><%= site.description() %></span></div><% }) %></div></header><main id="main"><%~ block('content') %></main><footer class="blog-footer blog-text-center"><p>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/spiritree/typecho-theme-amaze">Amaze</a> by spiritree · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p><a href="/rss.html">RSS</a></footer><script defer src="<%= site.themeUrl('res/js/amaze.js') %>"></script></body></html>
