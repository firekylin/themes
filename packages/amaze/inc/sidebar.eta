<% const site=firekylin.site;const cats=firekylin.cats;const tags=firekylin.tags; %><aside class="sidebar-container"><section><div class="sidebar-header"><span class="sidebar-header-title">关于博主</span></div><p><%= site.description() %></p><ul class="list-inline"><% for(const [key,label] of [['socialGithub','GitHub'],['socialWeibo','微博']]){const url=String(site.themeConfig[key]||'');if(/^https:\/\//.test(url)){ %><li><a href="<%= url %>"><%= label %></a></li><% }} %></ul></section><section><div class="sidebar-header"><span class="sidebar-header-title">分类列表</span></div><ul class="sidebar-list-body sidebar-list-items"><% while(cats.next()){ %><li class="sidebar-list-item"><a href="<%= cats.permalink %>"><%= cats.row.name %> (<%= cats.row.count %>)</a></li><% } %></ul></section><section><div class="sidebar-header"><span class="sidebar-header-title">标签列表</span></div><div class="tags"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% } %></div></section><section><div class="sidebar-header"><span class="sidebar-header-title">归档列表</span></div><a href="/archives">全部文章归档</a></section></aside>