<% const archive=firekylin.archive;const site=firekylin.site;const avatar=String(site.themeConfig.avatarUrl||''); %><% while(archive.next()){ %><article class="blog-entry-article"><div class="blog-entry-text post-preview"><div class="topic-header"><div class="author-lockup"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt="" class="avatar avatar-image"><% } %><span><%= archive.author('display_name') %></span></div><time class="time"><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="post-index-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-content-preview"><%= archive.excerpt(200,true) %></div></div></article><% } %>