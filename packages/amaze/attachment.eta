<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('hero',()=>{ %><div class="post-heading"><h1><%= found?archive.title():'暂无内容' %></h1><% if(found){ %><span class="meta">@<%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></span><div class="tags post-tags"><% (archive.row.cate||[]).forEach(cat=>{ %><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a> <% }); %></div><% } %></div><% }) %><% block('content',()=>{ %><div class="reading-layout"><% if(found){ %><article class="blog-article-p"><div id="post-content"><%~ archive.content() %></div><div class="tags"><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>"><%= tag.name %></a><% }); %></div></article><nav id="directory" aria-label="文章目录" hidden><h2>目录</h2></nav><% const comments=firekylin.comment({title:'评论'});if(comments){ %><section class="amaze-comments"><%~ comments %></section><% } %><% } %></div><% }) %>