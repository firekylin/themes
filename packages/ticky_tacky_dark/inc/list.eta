<% const archive=firekylin.archive;let count=0; %><div class="tile-grid"><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||'');const hasCover=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><article class="entry<%= hasCover?'':' tile-no-image' %>"><a class="tile-link" href="<%= archive.permalink %>"><% if(hasCover){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><h2 class="tile-name"><%= archive.title() %></h2></a><time><%= archive.date('YYYY-MM-DD') %></time></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>