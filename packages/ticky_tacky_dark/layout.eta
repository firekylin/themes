<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="full_body"><% const headerImage=String(cfg.headerImage||'');const hasHeader=/^(https?:\/\/|\/(?!\/))/i.test(headerImage); %><header id="header" class="top-section<%= hasHeader?' has-image':'' %>"><% if(hasHeader){ %><img id="headerimg" class="veryrounded" src="<%= headerImage %>" alt=""><% } %><div class="native-title"><a href="/"><%= cfg.headerTitle||site.title() %></a></div></header><div id="content" class="top-section"><div class="native-frame"><main id="main"><%~ block('content') %></main><aside class="native-sidebar"><div class="box morerounded"><nav class="native-nav nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></aside></div></div><footer id="footer" class="top-section"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/kc0bfv/ticky_tacky_dark">Ticky Tacky Dark</a> · kc0bfv</p></footer></div></body></html>