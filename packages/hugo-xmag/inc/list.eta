<% const archive=firekylin.archive;let count=0,lastGroup=''; %><div class="list"><% while(archive.next()){count++; %><section class="article-list entry"><div class="categories"><% const c=archive.row.cate?.[0];if(c){ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% } %></div><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="date-author"><span><%= archive.author('display_name') %></span> / <time><%= archive.date('YYYY-MM-DD') %></time></div><div class="summary"><a href="<%= archive.permalink %>"><% const cover=String(archive.row?.options?.featuredImage||'');if(/^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="thumbnail"><img src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"></div><% } %><%= archive.excerpt(200) %></a></div></section><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>