{
  "name": "hugo-xmag",
  "title": "XMag",
  "version": "0.1.2",
  "private": true,
  "description": "XMag’s newspaper masthead with double rules, responsive three-column story cards and floated thumbnails.",
  "license": "MIT",
  "author": "Yihui Xie; Firekylin contributors",
  "homepage": "https://github.com/yihui/hugo-xmag",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/hugo-xmag"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugo-xmag"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
