<% const archive=firekylin.archive;let count=0; %><div class="post-feed expanded text-only gh-feed"><% while(archive.next()){count++; %><article class="feed entry"><div class="feed-calendar"><div class="feed-calendar-day"><%= archive.date('DD') %></div><div class="feed-calendar-month"><%= archive.date('MM') %></div></div><div class="feed-wrapper"><h2 class="feed-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="feed-excerpt"><%= archive.excerpt(180) %></div><div class="feed-right"><time class="feed-date"><%= archive.date('YYYY-MM-DD') %></time></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>