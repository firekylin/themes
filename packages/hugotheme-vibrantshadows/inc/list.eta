<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const image=String(archive.row.options?.featuredImage||'');const locked=Boolean(archive.row.password_protected||archive.row.options?.postPasswordHash||archive.row.title==='此内容被密码保护'); %><article class="entry card mb-3"><div class="card-body"><div class="row flex-md-row-reverse"><% if(!locked&&/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><div class="cover-column col-md-auto my-auto text-center"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img class="thumbnail" src="<%= image %>" alt="" loading="lazy"></a></div><% } %><div class="summary-column col my-auto"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-meta small font-weight-bold"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></p><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><span class="badge badge-pill">#<%= t.name %></span></a><% }); %></div><div class="card-text"><p><%= archive.excerpt(400) %></p></div><a class="read-more font-weight-bold" href="<%= archive.permalink %>">继续阅读 →</a></div></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>
