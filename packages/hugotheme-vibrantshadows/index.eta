<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const hero=String(cfg.heroImage||'');const hasHero=!archive.archiveTitle&&(archive.pagination?.currentPage||1)===1&&/^(https?:\/\/|\/(?!\/))/i.test(hero); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="native-hero<%= hasHero?' has-image':'' %>"><% if(hasHero){ %><img class="hero-image" src="<%= hero %>" alt=""><% } %><h1><%= archive.archiveTitle||cfg.tagline||site.title() %></h1><% if(!archive.archiveTitle){ %><p class="lead"><%= site.description() %></p><% } %></header><section class="card-parent"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>
