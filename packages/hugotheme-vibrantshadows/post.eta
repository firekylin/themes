<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post post-detail"><% if(found){ %><header class="article-meta native-hero"><h1 class="post-title"><%= archive.title() %></h1><p class="post-date"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><div class="post-body"><div class="article-columns"><aside class="article-toc" aria-label="文章目录" hidden><h2 class="h4">目录</h2><ol></ol></aside><div class="article-reading"><div class="prose post-content" id="post-content"><%~ archive.content() %></div></div></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %></div><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>
