<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body class="dark"><a class="skip" href="#main">跳转到正文</a><header class="native-header"><div class="navbar"><a class="navbar-brand brand brand-color" href="/"><%= site.title() %></a><button class="menu-button" type="button" aria-controls="native-navigation" aria-expanded="true" hidden>菜单</button><nav id="native-navigation" class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button class="theme-button" type="button" aria-pressed="true" hidden>切换浅色</button></div></header><main id="main"><%~ block('content') %></main><footer id="footer" class="footer text-center"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/Softorage/HugoTheme-VibrantShadows">Vibrant Shadows</a> · Softorage</p></footer></body></html>
