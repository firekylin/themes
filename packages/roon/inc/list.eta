<% const archive=firekylin.archive;const site=firekylin.site;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry <%= count===1&&cover?'featured':'' %>"><% if(cover){ %><div class="image-holder"><a class="inner" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover post-image u-object-fit" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><% } %><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><header><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1></header><div class="text"><p><%= archive.excerpt(240) %></p><a class="readmore" href="<%= archive.permalink %>">继续阅读</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>