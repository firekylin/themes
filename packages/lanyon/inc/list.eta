<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++; %><article class="post entry"><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><time class="post-date"><%= archive.date('YYYY/MM/DD') %></time><div class="prose"><p><%= archive.excerpt(500) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>