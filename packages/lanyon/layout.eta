<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><input type="checkbox" class="sidebar-checkbox" id="sidebar-checkbox" aria-label="切换导航"><aside class="sidebar" id="sidebar"><div class="sidebar-item"><p><%= site.description() %></p></div><nav class="sidebar-nav nav-items" aria-label="主导航"><a class="sidebar-nav-item" href="/">首页</a><a class="sidebar-nav-item" href="/archives">归档</a><a class="sidebar-nav-item" href="/categories">分类</a><a class="sidebar-nav-item" href="/tags">标签</a><a class="sidebar-nav-item" href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a class="sidebar-nav-item" href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div class="sidebar-item"><%= cfg.authorName||site.title() %> · <a href="https://github.com/poole/lanyon">Lanyon</a> by Mark Otto</div></aside><div class="wrap"><header class="masthead"><div class="container"><h3 class="masthead-title"><a href="/"><%= site.title() %></a> <small><%= site.description() %></small></h3></div></header><div class="container content"><main id="main"><%~ block('content') %></main><footer class="footer"><%= cfg.footerText||site.description() %> · Firekylin · Lanyon</footer></div></div><label for="sidebar-checkbox" class="sidebar-toggle"><span class="sr-only">切换导航</span></label></body></html>