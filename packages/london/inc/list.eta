<% const archive=firekylin.archive;let count=0; %><div class="post-feed gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post-card entry <%= count%3===0?'post-card-large':'' %> <%= cover?'':'no-image' %>"><a class="post-card-link" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="post-card-content"><h2 class="post-card-title"><%= archive.title() %></h2></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>