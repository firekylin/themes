<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="blog-entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(200) %></div><a class="read-more" href="<%= archive.permalink %>">继续阅读 →</a><time><%= archive.date('YYYY-MM-DD') %></time></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>