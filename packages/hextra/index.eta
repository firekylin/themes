<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categories=await firekylin.widget('Widget_Metas_Category_List');const home=!archive.archiveTitle&&archive.pagination?.currentPage===1;const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('hero',()=>{ %><% if(home){ %><section class="landing"><h1><%= site.themeConfig.heroTitle||site.title() %></h1><p><%= site.themeConfig.heroText||site.description() %></p><a class="hero-button" href="<%= safe(site.themeConfig.heroLink)?site.themeConfig.heroLink:'/archives' %>"><%= site.themeConfig.heroLabel||'开始阅读' %> →</a><h2>浏览分类</h2><div class="feature-cards"><% while(categories.next()){ %><a href="<%= categories.permalink %>"><h3><%= categories.row.name %> →</h3><p><%= categories.row.count %> 篇文章</p></a><% } %><a href="/tags"><h3>标签 →</h3><p>按标签探索文章。</p></a><a href="/archives"><h3>归档 →</h3><p>按日期浏览文章。</p></a></div></section><% } %><% }) %><% block('content',()=>{ %><h1 class="list-title"><%= archive.archiveTitle||'文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>