<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><div class="breadcrumb"><a href="/">首页</a> › 页面</div><article><% if(found){ %><h1><%= archive.title() %></h1><div class="prose" id="post-content"><%~ archive.content() %></div><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %><% const categories=await firekylin.widget('Widget_Metas_Category_List'); %><% block('sidebar',()=>{ %><details class="doc-menu" open><summary>站点目录</summary><nav aria-label="站点目录"><a href="/">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><h2>分类</h2><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %></a><% } %><a href="/archives">归档</a><a href="/tags">标签</a></nav></details><% }) %>