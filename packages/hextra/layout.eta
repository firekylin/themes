<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="nav-inner"><a class="brand" href="/"><span aria-hidden="true">⬡</span> <%= site.title() %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></details><form class="nav-search" action="/search.html" method="get"><label class="sr-only" for="nav-keyword">搜索文章</label><input id="nav-keyword" name="keyword" placeholder="搜索…" required><button aria-label="搜索">⌕</button></form><a class="mobile-search" href="/search.html" aria-label="搜索文章">⌕</a><button id="color-toggle" aria-label="切换明暗主题" aria-pressed="false" hidden>☾</button></div></header><%~ block('hero') %><div class="docs-layout"><aside class="left-column"><%~ block('sidebar') %></aside><main id="main"><%~ block('content') %></main><aside class="right-column"><nav id="hextra-toc" aria-label="文章目录" hidden><h2>本页内容</h2></nav></aside></div><footer><div>© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/imfing/hextra">Hextra</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></div></footer></body></html>