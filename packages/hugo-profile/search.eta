<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 · <%= site.title() %><% }) %><% block('content',()=>{ %><section id="list-page" class="container py-5"><h1 class="text-center">搜索</h1><form class="search-form" action="/search.html" method="get" role="search"><label for="keyword">关键词</label><input class="form-control" id="keyword" name="keyword" value="<%= archive.keyword %>" required><button class="btn btn-outline-info" type="submit">搜索</button></form><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>
