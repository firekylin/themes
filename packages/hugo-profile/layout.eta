<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig||{};const used=new Set(['/', '/archives','/categories','/tags','/search.html']);const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head>
<body><a class="skip" href="#main">跳转到正文</a><header id="profileHeader"><nav class="navbar primary-font native-nav" aria-label="主导航"><a class="navbar-brand" href="/"><%= site.title() %></a><div class="nav-items"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% for(const n of site.navigation){if(!used.has(n.url)&&safe(n.url)){used.add(n.url); %><a href="<%= n.url %>"><%= n.label %></a><% }} %><button id="theme-toggle" type="button" hidden aria-label="切换深色模式" aria-pressed="false">◐</button></div></nav></header>
<main id="main"><%~ block('content') %></main><footer id="footer" class="container text-center py-5"><p><%= cfg.footerText||site.description() %></p><p>Powered by <a href="https://firekylin.org">Firekylin</a> · <a href="https://github.com/gurusabarish/hugo-profile">Hugo Profile</a> by GURU SABARISH</p></footer></body></html>
