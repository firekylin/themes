<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next();const row=archive.row;const locked=row.password_protected||row.options?.postPasswordHash||row.title==='此内容被密码保护';const cover=locked?'':String(row.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><section id="single"><div class="container"><% if(found){ %><div class="row"><div class="col-lg-9 article-column"><header class="title mb-5 text-center"><h1 class="mb-4"><%= archive.title() %></h1><div><%= archive.author() %> · <time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></div></header><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><div class="featured-image"><img class="img-fluid mx-auto d-block" src="<%= cover %>" alt="<%= archive.title() %>"></div><% } %><article class="page-content prose p-2" id="post-content"><% const media=archive.row.options?.attachment||{};const url=String(media.url||'');const mime=String(media.mime||'');if(/^(https?:\/\/|\/(?!\/))/.test(url)){ %><section class="attachment-media"><% if(mime.startsWith('image/')){ %><img src="<%= url %>" alt="<%= archive.title() %>"><% }else if(mime.startsWith('video/')){ %><video controls preload="metadata" src="<%= url %>"></video><% }else if(mime.startsWith('audio/')){ %><audio controls preload="metadata" src="<%= url %>"></audio><% } %><p><a download href="<%= url %>"><%= media.name||archive.title() %></a></p></section><% } %><%~ archive.content() %></article><%~ firekylin.comment({title:'评论'}) %><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></div><div class="col-lg-3"><div class="sticky-sidebar"><aside class="toc" hidden><h2>目录</h2><nav class="toc-content" aria-label="文章目录"></nav></aside><% if((row.cate||[]).length||(row.tag||[]).length){ %><aside class="tags"><h2>分类与标签</h2><ul class="tags-ul list-unstyled"><% for(const c of row.cate||[]){ %><li><a href="/cate/<%= c.pathname %>"><%= c.name %></a></li><% } %><% for(const t of row.tag||[]){ %><li><a href="/tag/<%= t.pathname %>">#<%= t.name %></a></li><% } %></ul></aside><% } %><aside><a href="/archives">浏览全部文章</a></aside></div></div></div><% }else{ %><p>暂无内容。</p><% } %></div></section><% }) %>
