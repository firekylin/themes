<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig||{};const first=!archive.is('author')&&!archive.archiveTitle&&(!archive.pagination||archive.pagination.currentPage===1);const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %>
<% if(first&&cfg.profileTitle){ %><section id="hero" class="py-5"><div class="container px-lg-5"><div class="row align-items-center"><div class="col-lg-8 primary-font"><span class="subtitle"><%= cfg.profileIntro||'' %></span><h1><%= cfg.profileTitle %></h1><h2><%= cfg.profileSubtitle||'' %></h2><p class="hero-content"><%= cfg.profileText||site.description() %></p><% if(safe(cfg.profileLink)){ %><a class="btn" href="<%= cfg.profileLink %>"><%= cfg.profileLinkLabel||'了解更多' %></a><% } %></div><% if(safe(cfg.profileImage)){ %><div class="col-lg-4 image p-4"><img src="<%= cfg.profileImage %>" alt="<%= cfg.profileTitle %>" class="img-fluid"></div><% } %></div></div></section><% } %>
<section id="list-page" class="container pt-5"><h1 class="text-center pb-2"><%= archive.archiveTitle||'最新文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>
