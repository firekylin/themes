<% const archive=firekylin.archive;let count=0; %><div class="row post-grid"><% while(archive.next()){count++;const row=archive.row;const protectedRow=row.password_protected||row.options?.postPasswordHash||row.title==='此内容被密码保护';const cover=protectedRow?'':String(row.options?.featuredImage||''); %><div class="col-lg-4 col-md-6 my-3"><article class="card h-100 entry"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><div class="card-header"><a href="<%= archive.permalink %>"><img class="card-img-top" loading="lazy" src="<%= cover %>" alt="<%= archive.title() %>"></a></div><% } %><div class="card-body bg-transparent p-4 shadow-sm"><h2 class="card-title primary-font"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-text secondary-font"><%= archive.excerpt(300) %></p></div><div class="post-footer mt-auto py-3"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><a class="btn btn-outline-info btn-sm" href="<%= archive.permalink %>">阅读</a></div></article></div><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>
