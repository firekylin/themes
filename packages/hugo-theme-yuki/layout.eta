<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="site-logo__wrap"><div class="site-logo u-font"><a href="/"><% const logo=String(cfg.logoImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(logo)){ %><img src="<%= logo %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a></div></div><nav class="site-nav native-nav nav-items u-font" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main class="main" id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><span class="footer-author"><%= cfg.authorName||site.title() %></span> · Firekylin · <a href="https://github.com/iCyris/hugo-theme-yuki">Yuki</a></p></footer></body></html>