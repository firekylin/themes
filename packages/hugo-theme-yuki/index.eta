<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% const hero=String(site.themeConfig.heroImage||'');if(!archive.archiveTitle&&/^(https?:\/\/|\/(?!\/))/i.test(hero)){ %><img class="index-displayImg" src="<%= hero %>" alt=""><% } %><div class="index-line u-font"><span class="index-line__content"><%= archive.archiveTitle||site.title() %></span></div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>