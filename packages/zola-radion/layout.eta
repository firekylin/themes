<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" class="light" data-theme="toggle"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/init-theme.js') %>"></script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body class="hack main container"><a class="skip" href="#main">跳转到正文</a><header><div class="nav-header"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="dark-mode-toggle" class="theme-toggle" hidden>浅色 / 深色</button></div><p class="site-name"><a href="/"><%= site.title() %></a></p><p class="site-description"><%= site.description() %></p></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/micahkepe/radion">Radion</a> · Micah Kepe</p></footer></body></html>