<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry" itemscope itemtype="http://schema.org/CreativeWork"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-meta">发布于 <time><%= archive.date('YYYY-MM-DD') %></time></p></header><section itemprop="summary"><p><%= archive.excerpt(260) %></p><nav class="readmore"><a href="<%= archive.permalink %>">阅读全文 »</a></nav></section></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>