<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div class="left-content" aria-hidden="true"></div><div class="content"><header><nav class="site-nav"><div class="left-nav"><a href="/"><%= site.title() %></a></div><div class="right-nav"><div class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div><button id="theme-toggle" type="button" aria-label="切换明暗模式">切换明暗</button></div></nav></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/not-matthias/apollo">Apollo</a></p></footer></div><aside class="right-content"><nav id="apollo-toc" class="toc" aria-label="文章目录" hidden></nav></aside><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>