<% const archive=firekylin.archive;let count=0; %><section class="post-list"><ul><% while(archive.next()){count++; %><li class="list-item entry"><section><div class="post-header"><time><%= archive.date('YYYY-MM-DD') %></time><div><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><p class="description"><%= archive.excerpt(280) %></p><a class="readmore" href="<%= archive.permalink %>">继续阅读 ⟶</a></div></div></div></section></li><% } %></ul></section><% if(!count){ %><p>暂无文章。</p><% } %>