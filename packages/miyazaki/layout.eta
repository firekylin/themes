<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><header id="site-header"><div class="section-inner"><div class="header-left"><h1 class="site-title"><a href="/"><%= site.title() %></a></h1><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><main id="main" class="native-main section-inner"><header class="archive-header"><h2 class="archive-title"><%= site.description() %></h2></header><%~ block('content') %><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/andersnoren/miyazaki">Miyazaki</a> by Anders Norén</footer></main></body></html>