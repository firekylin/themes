<% layout('layout',{compact:true});const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'post'}),found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(found){ %><article class="iro-article"><header class="entry-header"><h1 class="entry-title"><%= archive.title() %></h1><div class="entry-census"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %><span class="iro-reading-time" hidden></span></div><hr></header><details class="iro-toc" open hidden><summary>文章目录</summary><ol></ol></details><div class="entry-content"><%~ archive.content() %></div><div class="iro-article-taxonomy"><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> <% } for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>">#<%= tag.name %></a> <% } %></div></article><%~ firekylin.comment({title:'评论',className:'comments iro-comments'}) %><% } else { %><p class="empty">内容不存在</p><% } %><% }); %>
