<% /* Adapted from Sakurairo 3.1.0 header.php/layouts/imgbox.php; see NOTICE.md. */
const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{};
const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'';
const accent=/^#[0-9a-f]{6}$/i.test(c.accentColor||'')?c.accentColor:'#d5b391';
const dark=c.colorMode==='dark',mode=['light','dark'].includes(c.colorMode)?c.colorMode:'auto';
%><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><style>:root{--theme-skin-matching:<%= accent %>;--theme-skin:#505050;--global-font-weight:400}</style><script defer src="<%= site.themeUrl('res/js/sakurairo.js') %>"></script></head><body class="fk-theme <%= dark?'dark fk-dark':'' %> <%= c.readingFont==='serif'?'serif':'' %>" data-mode="<%= mode %>"><a class="skip-link" href="#main">跳转到正文</a>
<header class="site-header"><div class="site-branding"><a href="/"><%= site.title() %></a></div><div class="nav-search-wrapper"><nav aria-label="主导航"><ul><% for(const n of site.navigation){ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% } %></ul></nav><a class="iro-search" href="/search.html">搜索</a></div><details class="iro-mobile-menu"><summary>菜单</summary><nav><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a><a href="/rss.html">RSS</a></nav></details></header>
<section class="headertop <%= c.coverHeight==='compact'||firekylin.compact?'compact':'' %>"><% if(safe(c.coverImage)){ %><img class="iro-cover" src="<%= safe(c.coverImage) %>" alt="" fetchpriority="high"><% } %><div class="focusinfo"><% if(safe(c.avatarUrl)){ %><div class="header-tou"><a href="/"><img src="<%= safe(c.avatarUrl) %>" alt="站点头像"></a></div><% } %><h1 class="iro-cover-title"><%= site.title() %></h1><div class="header-info"><p><%= c.heroText||site.description() %></p><a href="/rss.html">RSS</a></div></div><a class="iro-down" href="#main" aria-label="阅读文章">⌄</a></section>
<div id="content" class="site-content"><main id="main" class="site-main"><%~ block('content') %></main></div><footer class="site-footer"><%= c.footerText||site.title() %><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/mirai-mamori/Sakurairo">Sakurairo</a> by Fuukei · Based on <a href="https://github.com/mashirozx/sakura">Sakura</a></p></footer>
<div class="iro-tools"><button data-mode-toggle hidden type="button" aria-label="切换颜色模式">◐</button><a href="#main" aria-label="返回正文顶部">↑</a></div><dialog class="iro-lightbox" aria-label="图片预览"><button type="button" data-close>关闭</button><img alt=""></dialog><progress class="iro-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
