<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'});const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %>
<% if(c.announcement){ %><aside class="notice"><%= c.announcement %></aside><% } %><h1 class="main-title posts-area-title"><%= archive.archiveTitle||c.postAreaTitle||'文章列表' %></h1>
<% if(!archive.have()){ %><p class="empty">暂无文章</p><% } while(archive.next()){const cover=safe(archive.row.featuredImage||archive.row.options?.featuredImage||c.defaultThumbnail); %><article class="post post-list-thumb post-list-show"><div class="post-thumb"><a href="<%= archive.permalink %>"><% if(cover){ %><img src="<%= cover %>" alt="" loading="lazy"><% } else { %><span class="iro-image-placeholder" aria-hidden="true"></span><% } %></a></div><time class="post-date"><%= archive.date('Y-m-d') %></time><div class="post-meta"><span><%= archive.author('display_name') %></span><% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><% if(archive.row.comment_num!=null){ %><a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评论</a><% } %></div><div class="post-title"><a href="<%= archive.permalink %>"><h3><%= archive.title() %></h3></a></div><div class="post-excerpt"><span class="ai-excerpt-tip">摘要</span><p><%= archive.excerpt(130) %></p></div></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
