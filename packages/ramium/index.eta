<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const categories=await firekylin.widget('Widget_Metas_Category_List'); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="hero has-text-centered"><div class="hero-body"><h1 class="title"><%= site.title() %></h1><p class="subtitle"><%= site.description() %></p></div></section><section class="taxonomy-intro"><h2><a href="/tags">按标签阅读</a></h2><div class="tags-summary"><% while(tags.next()){ %><a class="tag is-dark is-large is-rounded" href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a><% } %></div><h2><a href="/categories">分类</a></h2><div class="tags-summary"><% while(categories.next()){ %><a class="tag is-dark is-large" href="/cate/<%= categories.row.pathname %>"><%= categories.row.name %></a><% } %></div></section><% } %><div class="native-column"><% if(archive.archiveTitle){ %><h1 class="list-heading"><%= archive.archiveTitle %></h1><% }else{ %><h2 class="list-heading">最新文章</h2><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><a class="seeall" href="/archives">查看全部文章</a></div><% }) %>