<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><article class="entry blog-brief"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="info"><time class="date"><%= archive.date('YYYY-MM-DD') %></time><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a class="tag is-rounded" href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></div><% if(valid){ %><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><p class="summary"><%= archive.excerpt(240) %></p><div class="continue-reading"><a href="<%= archive.permalink %>">阅读全文 »</a></div><hr></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>