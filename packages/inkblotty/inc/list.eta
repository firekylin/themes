<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry list__item post"><header class="post-header"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-details"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><div class="post-excerpt"><p><%= archive.excerpt(240) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></div><footer class="post-footer"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>