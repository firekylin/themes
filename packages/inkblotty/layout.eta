<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="two-column"><a class="skip" href="#main">跳转到正文</a><div class="wrapper"><header class="banner"><a href="/"><h1 class="site"><%= site.title() %></h1><p><%= site.description() %></p></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><div class="content"><main id="main"><%~ block('content') %></main><div class="sidebar1 widgets columns-1"><aside><h2>分类</h2><ul><% const categories=await firekylin.widget('Widget_Metas_Category_List');while(categories.next()){ %><li><a href="/cate/<%= categories.row.pathname %>"><%= categories.row.name %></a></li><% } %></ul></aside><aside><h2>标签</h2><div class="tagcloud"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><a href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a><% } %></div></aside><aside><h2>最新文章</h2><ul class="recent"><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:10});while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></aside><aside><h2>归档</h2><a href="/archives">所有文章</a></aside></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/tosi29/inkblotty">Inkblotty</a> by tosi · Inkblot by Michael Sisk</p></footer></div></body></html>