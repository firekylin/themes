<% const archive=firekylin.archive;let count=0; %><div class="article-grid"><% while(archive.next()){count++;const image=String(archive.row.options?.featuredImage||''); %><article class="entry card"><% if(/^(https?:\/\/|\/(?!\/))/.test(image)){ %><a class="headimg" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= image %>" alt="" loading="lazy"></a><% } %><div class="entry-info"><small>文章</small><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>">阅读全文</a></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>