<% layout('./layout');const site=await firekylin.widget('Widget_Options');const topPosts=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:6});const categories=await firekylin.widget('Widget_Metas_Category_List');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><nav class="category-tabs" aria-label="分类导航"><a href="/">首页</a><% categories.stack.forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><a href="/categories">更多 →</a></nav><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %><% block('cover',()=>{const cfg=site.themeConfig;const posts=topPosts.stack;const featured=posts[0]; %><section class="home-top"><div class="banner-group"><div class="identity"><h1><%= cfg.coverTitle||site.title() %><br><span><%= cfg.coverSubtitle||site.description() %></span></h1><a href="/archives">随便逛逛 →</a></div><nav class="category-group" aria-label="首页分类"><% categories.stack.slice(0,3).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></nav></div><div class="recommendations"><div class="recommendation-grid"><% posts.forEach(post=>{const image=String(post.options?.featuredImage||''); %><a href="<%= topPosts.permalinkFor(post) %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(image)){ %><img src="<%= image %>" alt=""><% } %><strong><%= post.title %></strong></a><% }); %></div><% if(featured){const image=String(featured.options?.featuredImage||''); %><div class="today-card"><% if(/^(https?:\/\/|\/(?!\/))/.test(image)){ %><img src="<%= image %>" alt=""><% } %><a href="<%= topPosts.permalinkFor(featured) %>"><small>最新文章</small><h2><%= featured.title %></h2></a><button id="show-recommendations" hidden>更多文章 →</button></div><% } %></div></section><% }) %>