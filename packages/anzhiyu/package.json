{
  "name": "anzhiyu",
  "title": "Anzhiyu",
  "version": "0.1.0",
  "private": true,
  "description": "Anzhiyu recommendation board, colorful categories and double-column blog.",
  "license": "GPL-3.0-only",
  "author": "Anzhiyu, Heo, Butterfly contributors; Firekylin contributors",
  "homepage": "https://github.com/anzhiyu-c/hexo-theme-anzhiyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/anzhiyu"
  },
  "firekylin": {
    "type": "theme",
    "id": "anzhiyu"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "coverTitle",
      "label": "首页大标题",
      "help": "留空使用站点名称。"
    },
    {
      "type": "text",
      "name": "coverSubtitle",
      "label": "首页副标题",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "博主名称",
      "help": "留空使用站点名称。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "博主简介",
      "help": "纯文本。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像",
      "help": "站内路径或HTTPS图片。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本。"
    }
  ]
}
