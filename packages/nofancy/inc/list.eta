<% const archive=firekylin.archive;let count=0; %><ul class="posts"><% while(archive.next()){count++; %><li class="entry"><a href="<%= archive.permalink %>"><%= archive.title() %></a><p class="footnote"><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.cate||[]).forEach(c=>{ %> · <a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></p></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>