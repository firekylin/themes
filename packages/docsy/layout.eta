<% const site=await firekylin.widget('Widget_Options');const categories=await firekylin.widget('Widget_Metas_Category_List'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><nav aria-label="主导航"><a href="/">Blog</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">Archives</a><a href="/search.html">Search</a></nav></header><div class="docs-layout"><aside class="sidebar"><form action="/search.html" method="get" role="search"><label class="sr-only" for="sidebar-keyword">搜索</label><input id="sidebar-keyword" name="keyword" type="search" placeholder="Search this site…" required><button aria-label="搜索">⌕</button></form><details class="site-menu" open><summary>Navigation</summary><nav aria-label="站点目录"><a class="nav-root" href="/"><%= site.title() %></a><a href="/">Blog</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">Archives</a><a class="nav-root" href="/categories">Categories</a><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %></a><% } %><a href="/tags">Tags</a></nav></details></aside><main id="main"><div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span><span>Content</span></div><%~ block('content') %></main><aside class="toc-sidebar"><nav id="docsy-toc" aria-label="文章目录" hidden><h2>On this page</h2></nav></aside></div><footer class="site-footer">© <%= new Date().getFullYear() %> <%= site.title() %> · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/docsy/docsy">Docsy</a></footer></body></html>