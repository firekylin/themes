<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article><h1><%= archive.title() %></h1><div class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></div><div class="prose" id="post-content"><%~ archive.content() %></div><footer class="article-footer"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></footer><%~ firekylin.comment({title:'评论'}) %></article><% }else{ %><p>暂无内容。</p><% } %><% }) %>