<% const archive=firekylin.archive;let count=0,lastYear=''; %><% while(archive.next()){count++;const year=archive.date('YYYY');const cover=String((archive.row.options||{}).featuredImage||''); %><% if(year!==lastYear){lastYear=year; %><h2 class="year"><%= year %></h2><% } %><article class="blog-entry"><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><div class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></div><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a href="<%= archive.permalink %>"><img class="post-image" src="<%= cover %>" alt="" loading="lazy"></a><% } %><p><%~ archive.excerpt(250) %></p><a href="<%= archive.permalink %>">Read more…</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>