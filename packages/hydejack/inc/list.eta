<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="page post mb6 entry"><header><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="post-date"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="markdown-body"><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>