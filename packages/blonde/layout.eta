<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/init.js') %>"></script><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="blonde-header"><div class="header-inner"><a class="site-name" href="/"><% const logo=String(cfg.logoURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(logo)){ %><img class="brand-logo" src="<%= logo %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><div class="header-actions"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="theme-toggle" class="theme-toggle" hidden aria-pressed="false">深色模式</button></div></div></header><div class="blonde-grid"><main id="main"><%~ block('content') %></main><aside class="blonde-sidebar"><form class="widget-search blonde-card" action="/search.html" method="get" role="search"><label for="sidebar-keyword">搜索本站</label><input id="sidebar-keyword" type="search" name="keyword" required><button type="submit">搜索</button></form><section class="widget blonde-card"><h2 class="widget-heading">分类</h2><% categories.stack.slice(0,10).forEach(c=>{ %><a class="widget-link" href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><span><%= c.name %></span><span class="count"><%= c.count %></span></a><% }); %></section><section class="widget blonde-card"><h2 class="widget-heading">标签</h2><div class="widget-tags"><% tags.stack.slice(0,20).forEach(t=>{ %><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a><% }); %></div></section><section class="widget widget-recent blonde-card"><h2 class="widget-heading">最近文章</h2><% recent.stack.slice(0,5).forEach(post=>{ %><a class="widget-link" href="<%= recent.permalinkFor(post) %>"><%= post.title %></a><% }); %></section><section class="widget blonde-card"><h2 class="widget-heading">归档</h2><a class="widget-link" href="/archives">查看全部月份</a></section></aside></div><footer class="site-footer"><div class="footer-inner"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/opera7133/Blonde">Blonde</a> · wamo</p></div></footer></body></html>