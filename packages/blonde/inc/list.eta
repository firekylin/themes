<% const archive=firekylin.archive;let count=0; %><div class="blonde-feed"><% while(archive.next()){count++;const locked=archive.row.password_protected||archive.row.title==='此内容被密码保护'||Boolean(archive.row.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||''); %><article class="entry blonde-card blonde-summary"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="summary-cover" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="summary-body"><h2 class="summary-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="summary-excerpt"><%= archive.excerpt(130) %></p><time class="summary-date"><%= archive.date('YYYY/MM/DD') %></time></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>