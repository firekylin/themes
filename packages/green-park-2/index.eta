<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="pagetitle"><%= archive.archiveTitle %></h1><% } if(!archive.have()){ %><p class="greenpark-panel empty">暂无文章</p><% } while(archive.next()){ %><article class="post"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="meta"><span><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %></span><% if(archive.row.comment_num!=null){ %><a class="button-style" href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 条评论 »</a><% } %></div><div class="entry gp-feed"><% if(c.feedStyle==='excerpt'){ %><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>">阅读全文 »</a><% } else { %><%~ archive.content() %><% } %></div><div class="postmetadata clearfix"><p>发表于 <% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> <% } %></p><% if(archive.row.tag?.length){ %><p>标签：<% for(const tag of archive.row.tag){ %><a href="/tag/<%= tag.pathname %>"><%= tag.name %></a> <% } %></p><% } %></div></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
