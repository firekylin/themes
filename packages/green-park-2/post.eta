<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'post'}),found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><% if(found){ %><nav id="breadcrumb"><a href="/">首页</a> » <% for(const cat of archive.row.cate||[]){ %><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a> » <% } %> 正文</nav><article class="post"><h1><%= archive.title() %></h1><div class="meta"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %><span class="greenpark-reading-time" hidden></span></div><details class="greenpark-toc" hidden open><summary>文章目录</summary><ol></ol></details><div class="entry entry-content"><%~ archive.content() %></div><div class="postmetadata"><% for(const tag of archive.row.tag||[]){ %><a href="/tag/<%= tag.pathname %>"><%= tag.name %></a> <% } %></div></article><%~ firekylin.comment({title:'评论',className:'gp-comments'}) %><% } else { %><p class="greenpark-panel empty">内容不存在</p><% } %><% }); %>
