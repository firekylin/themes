<% const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},mode=['dark','auto'].includes(c.colorMode)?c.colorMode:'light',recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}),cats=await firekylin.widget('Widget_Metas_Category_List'),tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script defer src="<%= site.themeUrl('res/js/green-park-2.js') %>"></script></head><body id="home" class="fk-theme <%= mode==='dark'?'fk-dark dark':'' %>" data-mode="<%= mode %>"><header id="header"><nav id="accessibility"><a href="/">首页</a><a href="#content">正文</a><a href="/rss.html">RSS</a><button type="button" data-mode-toggle hidden aria-label="切换配色">◐</button></nav><div id="branding"><div id="site-title" class="brand"><a href="/"><%= site.title() %></a></div><div id="site-description"><%= c.heroText||site.description() %></div></div><div id="access"><nav class="menu gp-desktop"><ul><% for(const n of site.navigation){ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% } %></ul></nav><details class="gp-mobile"><summary>菜单</summary><nav><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %></nav></details><form id="nav-search" action="/search.html"><label class="gp-sr" for="gp-keyword">搜索关键词</label><input id="gp-keyword" name="keyword" placeholder="搜索"><button id="searchsubmit" type="submit">搜索</button></form></div></header><div id="main" class="clearfix <%= c.hideSidebar==='true'?'no-sidebar':'' %>"><div id="container"><main id="content"><%~ block('content') %></main></div><% if(c.hideSidebar!=='true'){ %><aside id="sidebar"><ul class="sb-list"><li><div class="sb-tools"><a class="gp-rss" href="/rss.html"><span>订阅</span>订阅本站 RSS</a></div></li><li id="about"><div class="sb-title"><%= c.aboutTitle||'关于' %></div><p><%= c.aboutText||site.description() %></p></li></ul><div class="gp-groups <%= c.sidebarColumns==='1'?'gp-single':'' %>"><section class="group"><div class="widget"><h2 class="sb-title">分类</h2><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.title() %></a></li><% } %></ul></div><div class="widget"><h2 class="sb-title">标签</h2><ul><% while(tags.next()){ %><li><a href="<%= tags.permalink %>"><%= tags.title() %></a></li><% } %></ul></div></section><section class="group"><div class="widget"><h2 class="sb-title">最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></div><div class="widget"><h2 class="sb-title">链接</h2><ul><% for(const n of site.navigation){ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% } %></ul></div></section></div></aside><% } %></div><footer id="footer" class="clearfix"><p class="alignright"><a href="https://github.com/fossasia/green-park-2">Cordobo Green Park 2</a> by <a href="https://cordobo.com/">Andreas Jacob</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p><p><%= c.footerText||site.title() %> · <a href="#home">返回顶部 ↑</a></p></footer><dialog class="greenpark-lightbox" aria-label="图片预览"><button data-close type="button">关闭</button><img alt=""></dialog><progress class="greenpark-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>
