<% const archive=firekylin.archive;let count=0; %><div class="roxo-grid"><% while(archive.next()){count++;const locked=archive.row.password_protected||archive.row.title==='此内容被密码保护'||Boolean(archive.row.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||'');const image=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><article class="entry roxo-card <%= image?'has-image':'no-image' %>"><% if(image){ %><img class="card-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="card-content"><time><%= archive.date('YYYY/MM/DD') %></time><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card-summary"><%= archive.excerpt(180) %></p><a class="card-readmore" href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>