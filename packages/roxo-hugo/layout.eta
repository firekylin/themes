<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="roxo-header"><div class="roxo-container header-inner"><a class="roxo-brand" href="/"><% const logo=String(cfg.logoURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(logo)){ %><img class="brand-logo" src="<%= logo %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="roxo-container"><%~ block('content') %></main><footer class="roxo-footer"><div class="roxo-container"><a class="roxo-brand" href="/"><%= site.title() %></a><div class="footer-grid"><section><h2>关于本站</h2><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p></section><section><h2>阅读</h2><p><a href="/archives">文章归档</a></p><p><a href="/categories">分类目录</a></p></section><section><h2>探索</h2><p><a href="/tags">标签</a></p><p><a href="/search.html">搜索</a></p></section></div><p class="footer-credit">Roxo by <a href="https://github.com/sitepins/roxo-hugo">Sitepins / StaticMania</a> · Firekylin</p></div></footer></body></html>