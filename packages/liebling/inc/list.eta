<% const archive=firekylin.archive;let count=0; %><div class="l-grid centered"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="m-article-card entry <%= cover?'':'no-picture' %>"><div class="m-article-card__picture"><a href="<%= archive.permalink %>" class="m-article-card__picture-link" aria-label="<%= archive.title() %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><div class="m-article-card__info no-tag"><a class="m-article-card__info-link" href="<%= archive.permalink %>"><h2 class="m-article-card__title"><%= archive.title() %></h2><div class="m-article-card__timestamp"><time><%= archive.date('YYYY-MM-DD') %></time></div></a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>