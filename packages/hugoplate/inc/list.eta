<% const archive=firekylin.archive;let count=0; %><div class="post-grid"><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a href="<%= archive.permalink %>" tabindex="-1" aria-hidden="true"><img class="post-image" src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><%= archive.date('YYYY-MM-DD') %></div><p class="entry-summary"><%= String(archive.row.summary||archive.row.content||'').replace(/<[^>]*>/g,'').slice(0,230) %></p><a class="btn small" href="<%= archive.permalink %>">阅读全文</a></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>