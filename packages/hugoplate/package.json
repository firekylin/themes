{
  "name": "hugoplate",
  "title": "Hugoplate",
  "version": "0.1.0",
  "private": true,
  "description": "Hugoplate monochrome landing and two-column blog theme.",
  "license": "MIT",
  "author": "Zeon Studio; Firekylin contributors",
  "homepage": "https://github.com/zeon-studio/hugoplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/hugoplate"
  },
  "firekylin": {
    "type": "theme",
    "id": "hugoplate"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "introTitle",
      "label": "首页标题",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "introText",
      "label": "首页介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "heroImage",
      "label": "首页插图",
      "help": "可选站内路径或 HTTPS 图片地址。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，可留空。"
    }
  ]
}
