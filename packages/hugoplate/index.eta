<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud',{limit:30});const hero=String(site.themeConfig.heroImage||'');const validHero=/^(https?:\/\/|\/(?!\/))/.test(hero); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="hero"><div class="hero-copy"><h1><%= site.themeConfig.introTitle||site.title() %></h1><p><%= site.themeConfig.introText||site.description() %></p><a class="btn primary" href="#latest">开始阅读 →</a></div><% if(validHero){ %><img class="hero-image" src="<%= hero %>" alt="" loading="eager"><% } %></section><% }else{ %><div class="page-header"><h1><%= archive.archiveTitle||'文章' %></h1><a href="/">首页</a> / 文章</div><% } %><section class="blog-layout section" id="latest"><div><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><aside class="widgets"><h2>分类</h2><div class="widget"><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %></a><% } %></div><h2>标签</h2><div class="widget tag-cloud"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.row.name %></a><% } %></div></aside></section><% }) %>