<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="container navbar"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary>菜单</summary><nav aria-label="主导航"><a href="/">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a><a href="/categories">分类</a></nav></details><div class="header-actions"><a class="search-link" href="/search.html" aria-label="搜索文章">⌕</a><button id="theme-toggle" hidden aria-label="切换明暗模式" aria-pressed="false">◐</button><a class="btn small" href="/rss.html">RSS</a></div></div></header><main id="main" class="container"><%~ block('content') %></main><footer class="site-footer"><div class="container footer-top"><a class="brand" href="/"><%= site.title() %></a><nav aria-label="页脚导航"><a href="/archives">归档</a><a href="/tags">标签</a><a href="/search.html">搜索</a></nav><a href="/rss.html">RSS →</a></div><div class="footer-bottom"><p><%= site.themeConfig.footerText||'' %></p><p><a href="https://github.com/zeon-studio/hugoplate">Hugoplate</a> · Zeon Studio · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></div></footer></body></html>