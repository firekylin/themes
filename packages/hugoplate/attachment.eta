<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="single"><% if(found){ %><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="single-cover" src="<%= cover %>" alt=""><% } %><h1><%= archive.title() %></h1><div class="entry-meta"><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></div><details id="hugoplate-toc" hidden open><summary>本页目录</summary><nav aria-label="文章目录"></nav></details><div class="prose" id="post-content"><%~ archive.content() %></div><div class="post-bottom"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><button id="copy-link" class="btn small" hidden>复制文章链接</button></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>