<% const site=firekylin.site;const archive=firekylin.archive;let count=0,lastYear=''; %><div id="posts-list"><% while(archive.next()){count++; %><% const year=archive.date('YYYY');if(year!==lastYear){lastYear=year; %><h2 class="site-date-catalog"><%= year %></h2><% } %><div class="posts-line entry"><time class="posts-date"><%= archive.date('MM-DD') %></time><div class="posts-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></div></div><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>