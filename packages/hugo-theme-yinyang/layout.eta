<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div class="native-shell"><header><h1 class="header-title"><a href="/"><%= site.title() %></a></h1><div class="header-subtitle"><%= site.description() %></div></header><div class="header-items"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button class="theme-toggle" type="button" aria-label="切换深色或浅色模式" aria-pressed="false">◐</button></div><div class="header-line"></div><main id="main"><%~ block('content') %></main><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/joway/hugo-theme-yinyang">Yinyang</a></p></footer></div><script src="<%= site.themeUrl('res/theme.js') %>" defer></script></body></html>