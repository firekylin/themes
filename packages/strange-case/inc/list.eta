<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><div class="post-heading"><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><span><%= archive.date('YYYY-MM-DD') %></span></div><p class="entry-summary"><%= archive.excerpt(500) %></p><a href="<%= archive.permalink %>">继续阅读</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>