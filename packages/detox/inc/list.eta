<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="li entry"><header class="post-header"><h3 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><p class="post-time"><time><%= archive.date('YYYY-MM-DD') %></time></p></header><section class="post-excerpt"><p><%= archive.excerpt(400) %></p></section></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>