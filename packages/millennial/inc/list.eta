<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry"><a href="<%= archive.permalink %>"><div class="featured-post"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><h2><span><%= archive.title() %></span></h2></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %>