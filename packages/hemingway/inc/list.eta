<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry"><h3 class="subtitle is-6"><%= archive.date('YYYY-MM-DD') %></h3><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="content"><%= archive.excerpt(260) %> <a class="button is-link" href="<%= archive.permalink %>">阅读全文 »</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>