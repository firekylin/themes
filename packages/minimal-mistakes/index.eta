<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><h2 class="archive-subtitle">Recent Posts</h2><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>