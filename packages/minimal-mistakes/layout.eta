<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const avatar=String(cfg.avatar||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="masthead"><div class="masthead-inner"><a class="site-title" href="/"><%= site.title() %></a><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></div></header><div class="site-grid"><aside class="author"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt="作者头像"><% } %><div><h2><%= cfg.authorName||site.title() %></h2><p><%= site.description() %></p><ul><li><a href="/categories">▦ 分类</a></li><li><a href="/tags"># 标签</a></li><li><a href="/archives">▤ 所有文章</a></li></ul></div></aside><main id="main"><%~ block('content') %></main><aside class="right-sidebar"><nav id="toc" aria-label="文章目录" hidden><h2>On this page</h2><ul></ul></nav></aside></div><footer class="site-footer"><div><%= cfg.footerText||site.description() %><p>Firekylin · <a href="https://github.com/mmistakes/minimal-mistakes">Minimal Mistakes</a> 原生改编</p></div></footer></body></html>