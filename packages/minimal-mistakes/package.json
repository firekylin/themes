{
  "name": "minimal-mistakes",
  "title": "Minimal Mistakes",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Mistakes default author-sidebar blog layout.",
  "license": "MIT",
  "author": "Michael Rose and contributors; Firekylin contributors",
  "homepage": "https://github.com/mmistakes/minimal-mistakes",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/minimal-mistakes"
  },
  "firekylin": {
    "type": "theme",
    "id": "minimal-mistakes"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "作者名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatar",
      "label": "作者头像",
      "help": "HTTPS或本站图片路径。"
    }
  ]
}
