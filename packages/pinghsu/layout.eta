<% const site = await firekylin.widget('Widget_Options'); %>
<!doctype html>
<html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%~ block('title') %></title>
<meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<%~ block('headers') %>
</head><body><a class="skip-link" href="#main">跳转到正文</a><header class="header bg-white"><div class="navbar-container"><a class="navbar-logo" href="/"><%= site.title() %></a><nav aria-label="主导航"> <% site.navigation.forEach(nav => { %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %><a href="/search.html">搜索</a></nav></div></header>
<main id="main" class="main-content index-page clearfix"><%~ block('content') %></main><footer class="fk-footer"><p><%= site.themeConfig.footerText || site.title() %></p>
<p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/chakhsu/pinghsu">Pinghsu</a> by Chakhsu Lau · <a href="/rss.html">RSS</a></p></footer>
</body></html>
