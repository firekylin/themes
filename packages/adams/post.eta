<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('heading',()=>{ %><%= found?archive.title():site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><div class="entry-meta"><%= archive.date('YYYY-MM-DD') %> / <%= archive.author('display_name') %></div><article class="post_article" id="post-content"><%~ archive.content() %></article><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %><% }) %>