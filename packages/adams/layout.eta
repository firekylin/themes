<% const site=await firekylin.widget('Widget_Options');const heading=block('heading'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="container"><h1 class="fullname"><% if(heading){ %><%~ heading %><% }else{ %><%= site.title() %><% } %></h1><nav class="header_nav" aria-label="主导航"><ul class="menu"><li><a href="/">首页</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/search.html">搜索</a></li></ul></nav></div><div class="infos"><div class="container"><span class="placard"><%= site.themeConfig.placard||site.description() %></span><span class="fixed-title" aria-hidden="true"><% if(heading){ %><%~ heading %><% }else{ %><%= site.title() %><% } %></span></div></div></header><main id="main" class="container"><%~ block('content') %></main><footer class="footer"><div class="container"><nav aria-label="页脚导航"><ul class="menu"><li><a href="/archives">归档</a></li><li><a href="/tags">标签</a></li><li><a href="/rss.html">RSS</a></li></ul></nav><div class="footer-row"><span><%= site.themeConfig.footerText||site.title() %></span><span>Theme by <a href="https://github.com/Tokinx/Adams">Adams</a> · Firekylin</span></div></div></footer><aside class="setting_tool" aria-label="阅读工具"><a href="#top" aria-label="返回顶部">↑</a><a href="/" aria-label="首页">⌂</a><details class="search-tool"><summary aria-label="打开搜索">⌕</summary><form action="/search.html" method="get"><label class="sr-only" for="tool-keyword">搜索词</label><input id="tool-keyword" name="keyword" placeholder="输入关键词…" required><button type="submit">搜索</button></form></details><details class="appearance-tool" hidden><summary aria-label="阅读外观">◐</summary><div class="appearance"><div class="colors"><button data-color="default">默认</button><button data-color="sepia">护眼</button><button data-color="night">夜晚</button></div><div class="fonts"><button data-font="serif">Serif</button><button data-font="sans">Sans</button></div></div></details></aside></body></html>