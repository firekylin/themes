<% const archive=firekylin.archive;let count=0; %><div class="post-list"><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="meta entry"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="summary"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a class="thumb" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><p><%= String(archive.row.summary||'').replace(/<[^>]*>/g,'').slice(0,220) %></p></div><footer><span><%= archive.date('YYYY-MM-DD') %> 发布</span></footer></article><% } %></div><% if(!count){ %><p>这个页面没有你要找的内容。</p><% } %>