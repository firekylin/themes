<% const archive=firekylin.archive;let count=0; %><div class="recent-posts"><div class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><div class="post entry"><div class="post-header"><div class="meta"><div class="date"><span class="day"><%= archive.date("DD") %></span><span class="rest"><%= archive.date("MM-YYYY") %></span></div></div><div class="matter"><article><h3 class="title small"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><p class="description"><%= archive.excerpt(260) %></p></article></div></div></div><% }if(!count){ %><p>暂无文章。</p><% } %></div></div>