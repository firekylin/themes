<% const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},mode=['dark','auto'].includes(c.colorMode)?c.colorMode:'light',categories=await firekylin.widget('Widget_Metas_Category_List'),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><script defer src="<%= site.themeUrl('res/js/aquila.js') %>"></script></head><body class="fk-theme <%= mode==='dark'?'fk-dark':'' %>" data-mode="<%= mode %>"><a href="#main" class="skip-link">跳转到正文</a><header id="masthead"><nav class="navbar navbar-expand-lg navbar-light bg-light py-4"><div class="container"><a class="custom-logo-link aq-brand" href="/"><% if(safe(c.logoUrl)){ %><img src="<%= safe(c.logoUrl) %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a><div class="aq-desktop"><ul class="navbar-nav mr-auto"><% for(const n of site.navigation){ %><li class="nav-item"><a class="nav-link" href="<%= n.url %>"><%= n.label %></a></li><% } %></ul><form action="/search.html" class="search-form"><label class="screen-reader-text" for="nav-keyword">关键词</label><input id="nav-keyword" name="keyword" class="form-control" placeholder="搜索"><button class="btn btn-outline-success">搜索</button></form></div><details class="aq-mobile"><summary>菜单</summary><div><% for(const n of site.navigation){ %><a href="<%= n.url %>"><%= n.label %></a><% } %><a href="/search.html">搜索</a></div></details></div></nav></header><main id="main" class="site-main mt-5"><%~ block('content') %></main><footer id="site-footer" class="bg-light p-4"><div class="container"><div class="row"><section class="col-lg-4 col-md-6 col-sm-12"><%= c.footerText||site.description() %></section><section class="col-lg-4 col-md-6 col-sm-12"><h2>分类</h2><ul><% while(categories.next()){ %><li><a href="<%= categories.permalink %>"><%= categories.title() %></a></li><% } %></ul></section><section class="col-lg-4 col-md-6 col-sm-12"><a href="/rss.html">RSS</a> · <a href="https://github.com/imranhsayed/aquila">Aquila</a> · Firekylin <button data-mode-toggle type="button" hidden>切换配色</button></section></div></div></footer><dialog class="aquila-lightbox" aria-label="图片预览"><button type="button" data-close>关闭</button><img alt=""></dialog><progress class="aquila-progress" max="100" value="0" aria-label="阅读进度" hidden></progress></body></html>