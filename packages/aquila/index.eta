<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'index'}),recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}),front=c.homeStyle==='front'&&archive.is('index')&&!['cate','tag','author'].some(t=>archive.is(t))&&(!archive.pagination||archive.pagination.currentPage===1),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):''; %><% block('title',()=>{ %><%= archive.archiveTitle?archive.archiveTitle+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><div class="<%= front?'aq-front':'container' %>"><% if(front){ %><section class="aq-intro"><h1><%= site.title() %></h1><p><%= c.heroText||site.description() %></p></section><section aria-label="最新文章" class="aq-carousel"><div class="posts-carousel"><% while(recent.next()){const cover=safe(recent.row.featuredImage||recent.row.options?.featuredImage)||safe(c.coverImage); %><article class="card"><% if(cover){ %><img class="w-100" src="<%= cover %>" alt=""><% } %><div class="card-body"><h3 class="card-title"><%= recent.title() %></h3><p><%= recent.excerpt(180) %></p><a class="btn btn-primary" href="<%= recent.permalink %>">阅读更多</a></div></article><% } %></div><div class="aq-carousel-controls" hidden><button type="button" data-prev>上一组</button><button type="button" data-next>下一组</button></div></section><% }else{ %><% if(archive.archiveTitle){ %><h1 class="mb-5"><%= archive.archiveTitle %></h1><% } if(c.heroText){ %><p><%= c.heroText %></p><% } %><div class="row aq-grid"><% if(!archive.have()){ %><p class="col-12 empty">暂无文章</p><% } let columnIndex=0;while(archive.next()){const cover=safe(archive.row.featuredImage||archive.row.options?.featuredImage)||safe(c.coverImage); %><% if(columnIndex%3===0){ %><div class="col-lg-4 col-md-6 col-sm-12"><% } columnIndex++; %><article class="mb-5"><header class="entry-header"><% if(cover){ %><div class="entry-image mb-3"><a href="<%= archive.permalink %>"><figure class="img-container"><img src="<%= cover %>" alt="" loading="lazy"></figure></a></div><% } %><h2 class="entry-title post-card-title mb-3"><a class="text-dark" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-meta mb-3"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %></div><div class="aq-excerpt"><div class="truncate-4"><%= archive.excerpt(200) %></div><a class="btn btn-info mt-4" href="<%= archive.permalink %>">阅读更多</a></div><nav class="entry-footer mt-4"><% for(const cat of archive.row.cate||[]){ %><a class="entry-footer-link text-black-50 btn border border-secondary mb-2 mr-2" href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %></nav></article><% if(columnIndex%3===0){ %></div><% }} if(columnIndex%3!==0){ %></div><% } %></div><%~ include('inc/pagination',{archive}) %><% } %></div><% }); %>