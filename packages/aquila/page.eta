<% layout('layout');const site=await firekylin.widget('Widget_Options'),c=site.themeConfig||{},archive=await firekylin.widget('Widget_Archive',{type:'page'}),recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}),found=archive.next(),safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'',cover=found?safe(archive.row.featuredImage||archive.row.options?.featuredImage):''; %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% });block('content',()=>{ %><div class="container"><div class="row"><div class="<%= c.showSidebar==='false'?'col-12':'col-lg-8 col-md-8 col-sm-12' %>"><% if(found){ %><article class="mb-5"><header class="entry-header"><% if(cover){ %><div class="entry-image mb-3"><figure class="img-container"><img src="<%= cover %>" alt=""></figure></div><% } %><h1 class="page-title text-dark"><%= archive.title() %></h1></header><div class="entry-meta mb-3"><time><%= archive.date('Y-m-d') %></time> · <%= archive.author('display_name') %><span class="aquila-reading-time" hidden></span></div><details class="aquila-toc" hidden open><summary>文章目录</summary><ol></ol></details><div class="entry-content"><%~ archive.content() %></div><nav class="entry-footer mt-4"><% for(const cat of archive.row.cate||[]){ %><a class="entry-footer-link text-black-50 btn border border-secondary mb-2 mr-2" href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } for(const tag of archive.row.tag||[]){ %><a class="entry-footer-link text-black-50 btn border border-secondary mb-2 mr-2" href="/tag/<%= tag.pathname %>">#<%= tag.name %></a><% } %></nav></article><%~ firekylin.comment({title:'评论',className:'aq-comments'}) %><% }else{ %><p>内容不存在</p><% } %></div><% if(c.showSidebar!=='false'){ %><aside class="col-lg-4 col-md-4 col-sm-12" id="secondary"><h2>最新文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ul></aside><% } %></div></div><% }); %>