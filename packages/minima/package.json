{
  "name": "minima",
  "title": "Minima",
  "version": "0.1.1",
  "private": true,
  "description": "Jekyll Minima classic reading layout for Firekylin.",
  "license": "MIT",
  "author": "Parker Moore and minima contributors; Firekylin contributors",
  "homepage": "https://github.com/jekyll/minima",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/minima"
  },
  "firekylin": {
    "type": "theme",
    "id": "minima"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
