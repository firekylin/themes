<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><time class="post-meta"><%= archive.date('MMM D, YYYY') %></time><h2><a class="post-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></article><% }if(!count){ %><p>暂无文章。</p><% } %>