<% const archive=firekylin.archive;const site=firekylin.site;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><% if(count===1){ %><article class="gh-latest gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><header class="gh-card-header"><div class="gh-article-meta"><time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="gh-article-title gh-card-title"><%= archive.title() %></h2></header><p class="gh-article-excerpt"><%= archive.excerpt(300) %></p></a></article><div class="gh-wrapper"><section class="gh-section"><h2 class="gh-section-title">更多文章</h2><div class="gh-feed"><% }else{ %><article class="gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><header class="gh-card-header"><h2 class="gh-card-title"><%= archive.title() %></h2></header><p class="gh-card-excerpt"><%= archive.excerpt(180) %></p><footer class="gh-card-meta"><time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></footer></a></article><% } %><% }if(!count){ %><p>暂无文章。</p><% } %><% if(count){ %></div></section><aside class="gh-sidebar"><section class="gh-section"><h2 class="gh-section-title">关于</h2><div class="gh-about"><section class="gh-about-wrapper"><h3 class="gh-about-title"><%= site.title() %></h3><p class="gh-about-description"><%= site.description() %></p></section></div></section><section class="gh-section"><h2 class="gh-section-title">主题</h2><div class="gh-topic"><% const tags=firekylin.tags;while(tags.next()){ %><a class="gh-topic-item" href="<%= tags.permalink %>"><h3 class="gh-topic-name"><%= tags.row.name %></h3><span class="gh-topic-count"><%= tags.row.count %></span></a><% } %></div></section></aside></div><% } %>