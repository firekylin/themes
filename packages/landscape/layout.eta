<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="container"><div id="wrap"><header id="header"><div id="banner"></div><div class="outer" id="header-outer"><div id="header-title" class="inner"><h1 id="logo-wrap"><a href="/" id="logo"><%= site.title() %></a></h1><h2 id="subtitle-wrap"><span id="subtitle"><%= site.description() %></span></h2></div><div id="header-inner" class="inner"><nav id="main-nav" class="nav-items" aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="outer native-content"><main id="main"><%~ block('content') %></main><aside id="sidebar"><div class="sidebar-native"><h2><%= cfg.authorName||site.title() %></h2><p><%= site.description() %></p><a href="/archives">浏览归档</a></div></aside></div><footer id="footer"><div class="outer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/hexojs/hexo-theme-landscape">Landscape</a> by Tommy Chen</div></footer></div></div></body></html>