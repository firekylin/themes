<% const archive=firekylin.archive;let count=0; %><div class="content"><% while(archive.next()){count++; %><article class="card entry"><header class="card__header"><h2 class="card__header__title"><a class="card__header__link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="card__header__date date"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p></header><div class="card__body"><p><%= archive.excerpt(480) %></p></div><footer class="card__footer"><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %></div>