<% const archive=firekylin.archive;let count=0; %><div class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><a class="stretched entry" href="<%= archive.permalink %>"><article class="post-container"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><div class="post-text"><h2><%= archive.title() %></h2><span class="post-description"><%= archive.excerpt(120) %></span><span class="post-date"><%= archive.date('YYYY/MM/DD') %></span></div></article></a><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>