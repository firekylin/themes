<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post post-detail"><% if(found){ %><header class="header-image-container"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="header-image" src="<%= cover %>" alt=""><% } %><div class="text-container"><h1 class="page-title"><%= archive.title() %></h1><span class="page-description"><%= archive.excerpt(180) %></span><span class="page-date"><%= archive.date('YYYY/MM/DD') %></span></div></header><div class="body-container"><div class="prose post-content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %></div><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>