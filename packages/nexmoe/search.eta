<% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'搜索'}) %><div class="nexmoe-post"><article><h1>搜索</h1><form action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" value="<%= a.keyword||'' %>" required><button>搜索</button></form><% if(a.keyword&&a.pagination&&!a.pagination.count){ %><p>没有找到文章</p><% } %><% while(a.next()){ %><h2><a href="<%= a.permalink %>"><%= a.title() %></a></h2><%~ a.row.summary %><% } %></article></div><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>