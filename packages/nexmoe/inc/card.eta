<% const a=firekylin.article;const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const cover=a.row.featuredImage||a.row.fields?.Cover||c.background||site.themeUrl('res/cover.svg'); %><div class="nexmoe-post-cover"><% if(!firekylin.detail){ %><a href="<%= a.permalink %>"><% } %><img src="<%= cover %>" alt="" loading="lazy"><h1><%= a.title() %></h1><% if(!firekylin.detail){ %></a><% } %></div><div class="nexmoe-post-meta"><a><i class="material-icons" aria-hidden="true">event</i><%= a.date('YYYY年MM月DD日') %></a><% if(firekylin.html){ %><a><%= (String(firekylin.html).replace(/<[^>]*>/g,'').match(/[\u3400-\u9fff]/g)||[]).length %> 汉字</a><% } %><a href="<%= a.permalink %>#comments"><%= a.commentsNum('%d') %> 评论</a><%~ a.category(',') %><%~ a.tags(' ') %></div>