<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const blog=await firekylin.widget('Widget_Nexmoe_Blog');const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud',{ignoreZeroCount:true});const cat=categories.toArray();const tag=tags.toArray();const parts=String(c.widget||'category,tagcloud,archive').split(',').map(s=>s.trim());const avatar=c.logoUrl||site.themeUrl('res/avatar.svg');const cover=c.background||site.themeUrl('res/cover.svg'); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= firekylin.pageTitle?firekylin.pageTitle+' - ':'' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/mdui/css/mdui.min.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/style.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>"><% if(c.customCSS) { %><style><%~ c.customCSS %></style><% } %></head>
<body class="mdui-drawer-body-left" data-lightbox="<%= String(c.lightbox)!=='false' %>" data-toc="<%= String(c.toc)!=='false' %>"><div id="nexmoe-background"><div class="nexmoe-bg"><img src="<%= cover %>" alt=""></div><div class="mdui-appbar mdui-shadow-0"><div class="mdui-toolbar"><button id="drawer-toggle" class="mdui-btn mdui-btn-icon" aria-controls="drawer" aria-expanded="false" aria-label="打开导航"><i class="mdui-icon material-icons" aria-hidden="true">menu</i></button><div class="mdui-toolbar-spacer"></div><a href="/" class="mdui-btn mdui-btn-icon" aria-label="首页"><img src="<%= avatar %>" alt=""></a></div></div></div>
<button class="nexmoe-backdrop" id="drawer-backdrop" hidden aria-label="关闭导航"></button><div id="nexmoe-header"><aside class="nexmoe-drawer mdui-drawer" id="drawer" tabindex="-1"><div class="nexmoe-avatar"><a href="/"><img src="<%= avatar %>" alt="<%= site.title() %>"></a></div><div class="nexmoe-count"><div><span>文章</span><%= blog.row.postCount %></div><div><span>标签</span><%= tag.length %></div><div><span>分类</span><%= cat.length %></div></div>
<nav class="nexmoe-list mdui-list" aria-label="主导航"><a class="nexmoe-list-item mdui-list-item<%= firekylin.ctx.path==='/'?' active':'' %>" href="/"><i class="mdui-list-item-icon material-icons" aria-hidden="true">home</i><span class="mdui-list-item-content">回到首页</span></a><% site.navigation.forEach(n=>{ %><a class="nexmoe-list-item mdui-list-item" href="<%= n.url %>"><i class="mdui-list-item-icon material-icons" aria-hidden="true">list</i><span class="mdui-list-item-content"><%= n.label %></span></a><% }) %></nav>
<aside id="nexmoe-sidebar"><% for(const part of parts) { if(part==='category') { %><section class="nexmoe-widget-wrap"><h3 class="nexmoe-widget-title">文章分类</h3><div class="nexmoe-widget"><ul class="category-list"><% cat.forEach(x=>{ %><li><a href="/cate/<%= x.pathname %>"><%= x.name %></a></li><% }) %></ul></div></section><% } else if(part==='tagcloud') { %><section class="nexmoe-widget-wrap"><h3 class="nexmoe-widget-title">标签云</h3><div class="nexmoe-widget tagcloud"><% tag.forEach(x=>{ %><a href="/tag/<%= x.pathname %>"><%= x.name %></a><% }) %></div></section><% } else if(part==='archive') { %><section class="nexmoe-widget-wrap"><h3 class="nexmoe-widget-title">文章归档</h3><div class="nexmoe-widget"><ul><% Object.entries(blog.row.groups).forEach(([month,posts])=>{ %><li><a href="/archives#month-<%= month %>"><%= month %><span class="category-list-count"><%= posts.length %></span></a></li><% }) %></ul></div></section><% } else if(part==='search') { %><section class="nexmoe-widget-wrap"><form class="nexmoe-widget nexmoe-search" action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" placeholder="搜索" required></form></section><% } else if(part==='social') { %><section class="nexmoe-widget-wrap"><h3 class="nexmoe-widget-title">社交按钮</h3><div class="nexmoe-widget nexmoe-social"><% for(const key of ['bilibili','github','zhihu','telegram','twitter','steam']) { if(/^https?:\/\//.test(c[key]||'')) { %><a href="<%= c[key] %>" title="<%= key %>"><%= key.slice(0,2).toUpperCase() %></a><% } } %><a href="/rss.html">RSS</a><% if(c.game) { %><p><%= c.game %></p><% } %></div></section><% } } %></aside><footer class="nexmoe-copyright">© <%= new Date().getFullYear() %> <%= site.title() %> Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> &amp; <a href="https://github.com/theme-nexmoe/typecho-theme-nexmoe">Nexmoe</a></footer></aside></div>
<main id="nexmoe-content"><div class="nexmoe-primary">
