<% const a=firekylin.archive;const pg=a.pagination;if(pg&&pg.totalPages>1){ %><nav class="nexmoe-page-nav" aria-label="分页"><% if(pg.currentPage>1){ %><a href="<%= a.pageUrl(pg.currentPage-1) %>" aria-label="上一页">←</a><% } %><span class="page-number current"><%= pg.currentPage %></span><% if(pg.currentPage<pg.totalPages){ %><a href="<%= a.pageUrl(pg.currentPage+1) %>" aria-label="下一页">→</a><% } %></nav><% } %>