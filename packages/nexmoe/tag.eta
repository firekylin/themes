<%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'标签'}) %><div class="nexmoe-post"><article><h1>标签</h1><ul><% const items=await firekylin.widget('Widget_Metas_Tag_Cloud');while(items.next()){ %><li><a href="/tag/<%= items.row.pathname %>"><%= items.row.name %></a></li><% } %></ul></article></div><%~ await includeAsync('./inc/footer',firekylin) %>