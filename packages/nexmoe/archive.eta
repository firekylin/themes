<% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'归档'}) %><div class="nexmoe-archives nexmoe-post"><article><% Object.entries(a.grouped).forEach(([month,posts])=>{ %><h2 id="month-<%= month %>"><%= month %></h2><ul><% posts.forEach(post=>{ %><li><span><%= String(post.create_time).slice(5,10) %></span><a href="<%= a.permalinkFor(post) %>"><%= post.title %></a></li><% }) %></ul><% }) %></article></div><%~ await includeAsync('./inc/footer',firekylin) %>