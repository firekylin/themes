<% const a=await firekylin.widget('Widget_Archive',{type:'post'});const found=a.next(); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:found?a.title():''}) %><% if(found){ %><div class="nexmoe-post"><%~ await includeAsync('./inc/card',{...firekylin,article:a,html:a.content(),detail:true}) %><article class="nexmoe-article"><%~ a.content() %></article><aside class="nexmoe-post-right"><nav class="nexmoe-toc" aria-label="文章目录"></nav></aside><%~ firekylin.comment({className:'nexmoe-comments',title:'评论'}) %></div><% } %><%~ await includeAsync('./inc/footer',firekylin) %>