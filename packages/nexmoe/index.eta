<% const a=await firekylin.widget('Widget_Archive',{type:'index'});const full=await firekylin.widget('Widget_Nexmoe_FullPosts');const bodies=new Map(full.toArray().map(row=>[row.id,row.content])); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.archiveTitle}) %><% if(a.archiveTitle) { %><h1><%= a.archiveTitle %></h1><% } %><section class="nexmoe-posts"><% while(a.next()){ const html=bodies.get(a.row.id)||a.row.summary||''; %><div class="nexmoe-post"><%~ await includeAsync('./inc/card',{...firekylin,article:a,html}) %><article><%~ html %></article></div><% } %></section><%~ await includeAsync('./inc/pagination',{...firekylin,archive:a}) %><%~ await includeAsync('./inc/footer',firekylin) %>