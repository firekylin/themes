<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:3}); %><% block('featured',()=>{ if(!archive.archiveTitle){ %><section class="featured-content" aria-label="最新文章"><% let n=0;while(recent.next()&&n++<3){ const cover=String(recent.row?.options?.featuredImage||'');const has=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><article class="hentry <%= has?'has-post-thumbnail':'' %>"><a class="post-thumbnail" href="<%= recent.permalink %>" aria-label="<%= recent.title() %>"><% if(has){ %><img src="<%= cover %>" alt=""><% } %></a><header class="entry-header"><div class="entry-meta"><%= recent.date('YYYY-MM-DD') %></div><h2 class="entry-title"><a href="<%= recent.permalink %>"><%= recent.title() %></a></h2></header></article><% } %></section><% } }) %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>