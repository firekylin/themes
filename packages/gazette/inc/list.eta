<% const archive=firekylin.archive;let count=0; %><div class="native-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry hentry"><header class="entry-header"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="post-thumbnail" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div></header><div class="entry-summary"><p><%= archive.excerpt(240) %></p></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>