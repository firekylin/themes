<% /* Single index.php ordering: title, excerpt, then metadata. */ const archive=firekylin.archive; %><div class="fk-feed home-posts"><% while(archive.next()) { %><article class="entry-card post-item"><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(100) %></p><div class="entry-meta post-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% for(const cate of archive.row.cate || []) { %> · <a href="/cate/<%= cate.pathname %>"><%= cate.name %></a><% } %><% if(archive.row.comment_num!=null) { %> · <a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num) || 0 %> °C</a><% } %></div></div></article><% } %></div>