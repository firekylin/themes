<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const site = await firekylin.widget('Widget_Options'); const config = site.themeConfig || {}; const safe=value=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(value || '')) ? String(value) : ''; const background=safe(config.background); const accent = /^#[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(config.accentColor || '') ? config.accentColor : '#6f9fc7'; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.html">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--fk-accent:<%= accent %>}</style><script defer src="<%= site.themeUrl('res/js/single.js') %>"></script><%~ block('headers') %></head>
<body class="fk-theme  <%= config.colorMode === 'dark' ? 'fk-dark' : '' %>"><a class="skip-link" href="#main">跳转到正文</a>
<% if(background) { %><img class="single-background" src="<%= background %>" alt=""><% } %>
<header class="fk-header single-header"><a class="fk-brand" href="/"><%= site.title() %></a><div class="single-actions"><details class="single-menu"><summary>菜单</summary><nav class="fk-nav" aria-label="主导航"><% for(const nav of site.navigation) { %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></details><button type="button" data-single-dark hidden aria-label="切换夜间模式" aria-pressed="<%= config.colorMode==='dark' ? 'true' : 'false' %>">◐</button><a href="/search.html">搜索</a></div></header>
<% if(!firekylin.singleDetail) { %><section class="fk-hero home-title"><h1><%= site.title() %></h1><span><%= config.heroText || site.description() %></span><a href="/rss.html">RSS</a></section><% } %>
<div class="fk-shell"><main id="main"><%~ block('content') %></main></div><footer class="fk-footer"><p><%= config.footerText || site.title() %></p><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/Dreamer-Paul/Single">Single</a> by Dreamer-Paul · <a href="/rss.html">RSS</a></p></footer></body></html>
