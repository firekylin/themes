<% const archive=firekylin.archive;let count=0; %><section class="page-content"><table class="post-table"><tbody><% while(archive.next()){count++; %><tr class="entry"><td class="post-date-time date-time-font"><time><%= archive.date('YYYY-MM-DD') %></time></td><td class="post"><a href="<%= archive.permalink %>"><%= archive.title() %></a></td></tr><% } %></tbody></table></section><% if(!count){ %><p>暂无文章。</p><% } %>