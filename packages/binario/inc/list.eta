<% const archive=firekylin.archive;let count=0; %><div class="cards"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><div class="card card--2col"><article class="entry card__box block"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><a class="entry__featured" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><h2 class="entry__title title-excerpt"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry__content"><p><%= archive.excerpt(260) %></p></div><div class="entry__meta"><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.cate||[]).forEach(c=>{ %> · <a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div></article></div><% } %></div><% if(!count){ %><p class="block">暂无文章。</p><% } %>