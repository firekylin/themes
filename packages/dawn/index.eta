<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const archive=await firekylin.widget('Widget_Archive',{type:'index'});const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:50});const paths=String(cfg.featuredPaths||'').split(',').map(s=>encodeURIComponent(s.trim()));const featured=recent.stack.filter(p=>paths.includes(p.pathname)).slice(0,15);const avatar=String(cfg.avatar||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="cover"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="cover-icon" src="<%= avatar %>" alt="站点图标"><% } %><p><%= site.description() %></p></section><% if(featured.length){ %><section class="featured outer inner"><h2>Featured articles</h2><div class="featured-feed"><% featured.forEach(post=>{const image=String(post.options?.featuredImage||''); %><article><a href="<%= recent.permalinkFor(post) %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(image)){ %><img src="<%= image %>" alt=""><% } %><h3><%= post.title %></h3></a></article><% }); %></div></section><% } %><% } %><section class="reading feed-area"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>