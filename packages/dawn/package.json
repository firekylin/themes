{
  "name": "dawn",
  "title": "Dawn",
  "version": "0.1.0",
  "private": true,
  "description": "Dawn compact date feed with featured cards and centered reading layout.",
  "license": "MIT",
  "author": "Ghost Foundation; Firekylin contributors",
  "homepage": "https://github.com/TryGhost/Dawn",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/dawn"
  },
  "firekylin": {
    "type": "theme",
    "id": "dawn"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatar",
      "label": "首页图标",
      "help": "HTTPS或本站路径。"
    },
    {
      "type": "text",
      "name": "featuredPaths",
      "label": "精选文章标识",
      "help": "英文逗号分隔pathname，从最近50篇公开文章筛选。"
    }
  ]
}
