<% const archive=firekylin.archive;let count=0; %><div class="entries"><% while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-meta"><%= archive.date('YYYY-MM-DD') %></p><p><%= archive.excerpt(260) %></p><a class="readmore" href="<%= archive.permalink %>">Read More →</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %></div>