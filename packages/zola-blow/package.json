{
  "name": "zola-blow",
  "title": "Blow",
  "version": "0.1.0",
  "private": true,
  "description": "Blow’s original Tailwind CSS, gray rounded shadow cards, personal intro and persisted light/dark palettes.",
  "license": "MIT",
  "author": "Thomas Chartron; Firekylin contributors",
  "homepage": "https://github.com/tchartron/blow",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/zola-blow"
  },
  "firekylin": {
    "type": "theme",
    "id": "zola-blow"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍"
    },
    {
      "type": "text",
      "name": "profileName",
      "label": "个人姓名"
    },
    {
      "type": "text",
      "name": "introduction",
      "label": "个人介绍"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像 URL（可选）"
    }
  ]
}
