<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const archive=await firekylin.widget('Widget_Archive',{type:'index'});const avatar=String(cfg.avatarUrl||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="profile"><h1><%= cfg.profileName||site.title() %></h1><% if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img src="<%= avatar %>" alt=""><% } %><p><%= cfg.introduction||site.description() %></p></section><% } %><h1 class="listing-title"><%= archive.archiveTitle||'最新文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>