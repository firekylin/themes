<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><section class="entry"><h2><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><% if(archive.row.tag?.length){ %><div class="tags">标签：<% archive.row.tag.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><% } %><div class="content"><p><%= archive.excerpt(400) %></p></div></section><% } %><% if(!count){ %><p>暂无文章。</p><% } %>