<% const archive=firekylin.archive;let count=0; %><div class="row material-grid"><% while(archive.next()){count++; %><div class="col m4 s12"><article class="card-panel entry"><h4><a href="<%= archive.permalink %>"><%= archive.title() %></a></h4><p><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %></p><div class="summary"><%~ archive.excerpt(200) %></div><p><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.tag||[]).forEach(t=>{ %> <a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></p></article></div><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>