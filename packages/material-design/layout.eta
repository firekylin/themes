<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header id="index-banner" class="parallax-container"><% const hero=String(cfg.headerImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(hero)){ %><img class="hero-cover" src="<%= hero %>" alt=""><% } %><div class="section"><div class="container"><h1 class="center"><a href="/"><%= site.title() %></a></h1><div class="row center"><h5 class="col s12 light"><%= site.description() %></h5></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><main id="main" class="container material-main"><div class="section"><%~ block('content') %></div></main><footer class="page-footer"><div class="container native-footer-text"><p><%= cfg.footerText||site.description() %></p></div><div class="footer-copyright"><div class="container"><span class="footer-author"><%= cfg.authorName||site.title() %></span><span>Firekylin · <a href="https://github.com/pdevty/material-design">Design pdevty</a></span></div></div></footer></body></html>