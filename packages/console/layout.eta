<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="terminal"><a class="skip" href="#main">跳转到正文</a><div class="container"><div class="terminal-nav"><header class="terminal-logo"><div class="logo terminal-prompt"><a href="/" class="no-style"><%= site.title() %></a>:~#</div></header><nav class="terminal-menu" aria-label="主导航"><ul class="nav-items"><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav></div><main id="main"><%~ block('content') %></main><footer class="footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/mrmierzejewski/hugo-theme-console">Console</a> by Marcin Mierzejewski</footer></div></body></html>