<% const archive=firekylin.archive;let count=0; %><div class="posts-list"><% while(archive.next()){count++; %><article class="post entry"><time class="date"><%= archive.date('YYYY-MM-DD') %></time><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(300) %></p></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>