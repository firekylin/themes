<% const site=await firekylin.widget('Widget_Options');const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><a class="logo" href="/"><%= site.themeConfig.logoTitle||site.title() %></a><details class="site-menu" open><summary aria-label="展开菜单">☰</summary><nav aria-label="主导航"><a href="/">首页</a><a href="/archives">归档</a><a href="/tags">标签</a><a href="/categories">分类</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><nav class="social" aria-label="订阅与社交"><a href="/rss.html">RSS</a><% if(safe(site.themeConfig.githubUrl)){ %><a href="<%= site.themeConfig.githubUrl %>">GitHub</a><% } %></nav><div>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> | Theme - <a href="https://github.com/olOwOlo/hugo-theme-even">Even</a></div><div>© <%= new Date().getFullYear() %> ♥ <%= site.title() %></div><p><%= site.themeConfig.footerText||'' %></p></footer><button class="back-top" aria-label="返回顶部" hidden>⌃</button></body></html>