<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>归档 · <%= site.title() %><% }) %><% block('content',()=>{ %><section class="archive"><h1>归档</h1><% Object.entries(archive.grouped).forEach(([month,posts])=>{ %><h2><%= month %></h2><% posts.forEach(post=>{ %><div class="archive-row"><time><%= String(post.create_time).slice(5,10) %></time><a href="<%= archive.permalinkFor(post) %>"><%= post.title %></a></div><% }); %><% }); %></section><% }) %>