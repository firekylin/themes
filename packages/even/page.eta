<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post single"><% if(found){ %><h1 class="post-title"><%= archive.title() %></h1><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.cate||[]).forEach(c=>{ %> · <a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %></div><nav id="even-toc" aria-label="文章目录" hidden><h2>文章目录</h2><ul></ul></nav><div class="prose" id="post-content"><%~ archive.content() %></div><div class="post-tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>