<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post summary"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="post-summary"><%~ archive.excerpt(250) %></div><a class="read-more" href="<%= archive.permalink %>">阅读全文…</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>