<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="list__item post entry"><figure class="list__thumbnail"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></figure><header class="list__header"><h2 class="list__title post__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="list__meta meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><div class="content list__excerpt post__content clearfix"><%= archive.excerpt(240) %></div><div class="list__footer clearfix"><a class="list__footer-readmore btn" href="<%= archive.permalink %>">阅读全文</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>