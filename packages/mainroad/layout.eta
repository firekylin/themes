<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="body"><a class="native-skip" href="#main">跳转到正文</a><div class="container container--outer"><header class="header"><div class="container header__container"><div class="logo"><a class="logo__link" href="/"><div class="logo__text"><div class="logo__title"><%= site.title() %></div><div class="logo__tagline"><%= site.description() %></div></div></a></div><div class="menu"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="wrapper flex"><div class="primary"><main id="main" class="native-main main list"><%~ block('content') %></main></div><aside class="sidebar"><div class="widget"><h4 class="widget__title">关于</h4><p><%= site.description() %></p></div><div class="widget"><h4 class="widget__title">标签</h4><ul class="widget__list"><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><li class="widget__item"><a href="<%= tags.permalink %>"><%= tags.row.name %></a> (<%= tags.row.count %>)</li><% } %></ul></div></aside></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/Vimux/Mainroad">Mainroad</a> by Vimux</footer></body></html>