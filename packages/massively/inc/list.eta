<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="entry"><header><span class="date"><time><%= archive.date('YYYY-MM-DD') %></time></span><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><a class="image fit" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><p><%= archive.excerpt(260) %></p><ul class="actions special"><li><a href="<%= archive.permalink %>" class="button">阅读全文 →</a></li></ul></article><% }if(!count){ %><p>暂无文章。</p><% } %></section>