<% const archive=firekylin.archive;let count=0; %><section id="posts" class="tiles"><% while(archive.next()){count++;const locked=archive.row.password_protected||archive.row.title==='此内容被密码保护'||Boolean(archive.row.options?.postPasswordHash);const cover=locked?'':String(archive.row.options?.featuredImage||''); %><article class="entry"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="tile-image" src="<%= cover %>" alt="" loading="lazy"><% } %><header class="major"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(100) %></p><div class="tile-meta"><time><%= archive.date('YYYY/MM/DD') %></time></div></header><a class="tile-link" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>" tabindex="-1"></a></article><% } %></section><% if(!count){ %><p class="listing-heading">暂无文章。</p><% } %>