<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="wrapper"><header class="forty-header"><a class="forty-brand" href="/"><strong><%= site.title() %></strong></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main><footer id="footer"><div class="inner"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p class="forty-credit">Forty by <a href="https://html5up.net/forty">HTML5 UP / AJ</a> · Hugo port <a href="https://github.com/MarcusVirg/forty">MarcusVirg</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a> · Adapted for Firekylin</p></div></footer></div></body></html>