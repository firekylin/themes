<% const archive=firekylin.archive;let count=0; %><ul class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><li class="post_item entry"><div class="excerpt"><div class="excerpt_header"><h3 class="post_link"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="excerpt_footer partition"><div class="excerpt_thumbnail"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></div><div class="pale"><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></div></div></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>