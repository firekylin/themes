<% const archive=firekylin.archive; %><div class="post-list"><% while(archive.next()){ %><section class="entry"><% if(archive.row.is_top){ %><small class="featured">Featured</small><% } %><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></section><% } %><% if(!archive.have()){ %><p>暂无文章。</p><% } %></div>