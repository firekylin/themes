<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const avatar=String(cfg.avatar||''); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1>#<%= archive.archiveTitle %></h1><% }else if((!archive.pagination||archive.pagination.currentPage===1)&&(cfg.profileName||avatar)){ %><section class="profile"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><div class="avatar"><img src="<%= avatar %>" alt="<%= cfg.profileName||site.title() %>"></div><% } %><div><h2><%= cfg.profileName||site.title() %></h2><p><%= cfg.bio||site.description() %></p></div></section><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>