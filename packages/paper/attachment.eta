<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article><header class="post-header"><h1><%= archive.title() %></h1><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div></header><section class="content"><%~ archive.content() %></section><footer class="post-tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></footer></article><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %><% }) %>