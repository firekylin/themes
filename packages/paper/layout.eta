<% const site=await firekylin.widget('Widget_Options');const colors=['linen','wheat','gray','light'];const color=colors.includes(site.themeConfig.color)?site.themeConfig.color:'linen'; %><!doctype html><html lang="zh-CN" data-color="<%= color %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/paper.css') %>"><script defer src="<%= site.themeUrl('res/js/paper.js') %>"></script></head><body><header class="site-header"><a class="brand" href="/"><%= site.title() %></a><button id="dark-toggle" aria-label="切换深色模式" aria-pressed="false" hidden>☀</button><details class="paper-menu" open><summary aria-label="菜单">☰</summary><nav aria-label="主导航"><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">归档</a><a href="/search.html">搜索</a><% if(/^https:\/\//.test(String(site.themeConfig.github||''))){ %><a href="<%= site.themeConfig.github %>" rel="me">GitHub</a><% } %><a href="/rss.html" aria-label="RSS">RSS</a></nav></details></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><span>© <%= new Date().getFullYear() %> <%= site.title() %></span><span><a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/nanxiaobei/hugo-paper">Hugo Paper</a> by 南小北</span></footer></body></html>