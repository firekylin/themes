<% const site=await firekylin.widget('Widget_Options'); const cfg=site.themeConfig||{}; %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/base.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body class="<%= cfg.textIndent==='on'?'indent':'' %>"><a class="skip-link" href="#main">跳转到正文</a><%~ block('masthead',()=>{ %><header class="container"><a id="logo" href="/"><h1><%= site.title() %></h1></a><p class="description"><%= site.description() %></p><hr></header><% }) %><main id="main" class="container"><%~ block('content') %></main><footer id="footer" class="container"><hr><p>© <%= new Date().getFullYear() %> <%= site.title() %> · Using <a href="https://github.com/firekylin/firekylin">Firekylin</a> &amp; <a href="https://github.com/txperl/Moricolor-for-Typecho">Moricolor</a> by Trii Hsia.</p></footer><script defer src="<%= site.themeUrl('res/js/mori.js') %>"></script></body></html>
