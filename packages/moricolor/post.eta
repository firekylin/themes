<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('masthead',()=>{}) %><% block('content',()=>{ %><% if(found){const cover=String(archive.row.featuredImage||''); %><article class="post"><h2 class="reading-title"><%= archive.title() %></h2><div class="text-right"><div class="text-bar"><a href="/" aria-label="首页">⌂</a><button type="button" id="tor-show" hidden aria-controls="postTor" aria-expanded="false">目录</button><a href="#mori-comments">评论</a><button type="button" id="copy-link">复制链接</button><span id="copy-status" role="status"></span></div><div class="post-info"><span class="post-info-n"><% (archive.row.cate||[]).forEach(cat=>{ %><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a><% }) %></span><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>"><%= tag.name %></a><% }) %><time><%= archive.date('YYYY-MM-DD') %></time></div></div><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="cover-image" src="<%= cover %>" alt=""><% } %><div class="post-content"><%~ archive.content() %></div></article><nav class="post-nav"><a href="/">HOME</a></nav><% const comments=firekylin.comment({title:'评论'});if(comments){ %><details id="mori-comments" <%= site.themeConfig.showComments==='on'?'open':'' %>><summary>评论</summary><%~ comments %></details><% } %><div class="post-tor-content"><nav class="post-tor" id="postTor" aria-label="文章目录" hidden><div class="torarc-t"><div class="torarc-tile"></div></div></nav></div><% }else{ %><p>暂无内容。</p><% } %><% }) %>
