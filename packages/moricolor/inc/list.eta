<% const archive=firekylin.archive; const site=firekylin.site; let i=0; const count=Number.isFinite(Number(site.themeConfig.previewCount))?Math.max(0,Number(site.themeConfig.previewCount)):1; %>
<% while(archive.next()){ const cover=String(archive.row.featuredImage||''); %><article class="mori-entry"><details class="quick-preview" <%= i++<count?'open':'' %>><summary aria-label="预览：<%= archive.title() %>"><time><%= archive.date('YYYY-MM-DD') %></time></summary><div class="preview-content"><% if(site.themeConfig.previewImages==='on' && /^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><p><%= archive.excerpt(200,true) %></p></div></details><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></article><% } %>
