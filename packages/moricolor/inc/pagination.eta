<% const archive=firekylin.archive;const site=firekylin.site;const p=archive.pagination; %><nav class="pager" aria-label="分页"><% if(p&&p.currentPage<p.totalPages){ %><a rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>" aria-label="下一页">‹</a><% }else{ %><span aria-hidden="true">‹</span><% } %><details class="page-menu"><summary aria-label="页面导航">☰</summary><nav aria-label="主导航"><% site.navigation.forEach(nav=>{ %><a href="<%= nav.url %>"><%= nav.label %></a><% }) %><a href="/rss.html">RSS</a></nav></details><% if(p&&p.currentPage>1){ %><a rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>" aria-label="上一页">›</a><% }else{ %><span aria-hidden="true">›</span><% } %></nav>
