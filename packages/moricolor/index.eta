<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cats=await firekylin.widget('Widget_Metas_Category_List'); %><% block('title',()=>{ %><%= archive.archiveTitle ? archive.archiveTitle+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><section id="main-index"><h4><%= archive.archiveTitle||'記事' %></h4><%~ include('./inc/list',{archive,site}) %><% if(!archive.have()){ %><p>暂无文章。</p><% } %></section><%~ include('./inc/pagination',{archive,site}) %><section id="bottomtools"><h6>(ฅ´ω`ฅ)</h6><div class="bottomtool"><% if(site.themeConfig.quote){ %><p><%= site.themeConfig.quote %></p><% } %><p>Category <% while(cats.next()){ %> · <a href="<%= cats.permalink %>">&amp;<%= cats.row.name %></a><% } %> · <a href="/tags">Tags</a></p></div><form action="/search.html" method="get" role="search"><label class="sr-only" for="mori-search">搜索</label><input id="mori-search" name="keyword" type="search" placeholder="Search anything here~" required><button type="submit">搜索</button></form></section><% }) %>
