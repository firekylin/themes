<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'search'}); %><% block('title',()=>{ %>搜索 - <%= site.title() %><% }) %><% block('content',()=>{ %><h4>搜索：<%= archive.keyword %></h4><form class="search-page" action="/search.html" method="get" role="search"><label class="sr-only" for="keyword">搜索</label><input id="keyword" type="search" name="keyword" value="<%= archive.keyword %>" required><button type="submit">搜索</button></form><%~ include('./inc/list',{archive,site}) %><% if(!archive.have()){ %><p>暂无文章。</p><% } %><%~ include('./inc/pagination',{archive,site}) %><% }) %>
