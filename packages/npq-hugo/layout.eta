<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><aside id="sidenav"><header><% const avatar=String(cfg.avatarUrl||'');if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img src="<%= avatar %>" alt=""><% } %><a id="branding" href="/"><%= site.title() %></a><p class="sidebar-description"><%= site.description() %></p></header><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></aside><main id="main"><div class="content"><%~ block('content') %></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/saadnpq/npq-hugo">NPQ</a> · saadnpq</p></footer></main></body></html>