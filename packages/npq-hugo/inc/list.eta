<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="list-item entry"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(220) %></p><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time><% (archive.row.tag||[]).forEach(t=>{ %> · <a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>