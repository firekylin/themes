{
  "name": "npq-hugo",
  "title": "NPQ",
  "version": "0.1.0",
  "private": true,
  "description": "NPQ’s original dark fixed sidebar, blue links, bordered recent-post panels and heading directory.",
  "license": "GPL-3.0-only",
  "author": "saadnpq; Firekylin contributors",
  "homepage": "https://github.com/saadnpq/npq-hugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/npq-hugo"
  },
  "firekylin": {
    "type": "theme",
    "id": "npq-hugo"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "侧栏头像地址",
      "help": "可选；使用 HTTP(S) 或站内绝对路径。"
    }
  ]
}
