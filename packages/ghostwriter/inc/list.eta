<% const archive=firekylin.archive;let count=0; %><div class="native-intro"><p><%= firekylin.site.description() %></p></div><ol class="post-list"><% while(archive.next()){count++; %><li class="post-stub entry"><a href="<%= archive.permalink %>"><h4 class="post-stub-title"><%= archive.title() %></h4> <time class="post-stub-date"><%= archive.date('YYYY-MM-DD') %></time></a></li><% } %></ol><% if(!count){ %><p>暂无文章。</p><% } %>