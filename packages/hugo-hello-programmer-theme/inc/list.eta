<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><div class="post-title"><a href="<%= archive.permalink %>"><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time><h1><%= archive.title() %></h1></div></a></div><% const cover=String(archive.row?.options?.featuredImage||'');if(/^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="cover-image"><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"></a></div><% } %><p><%= archive.excerpt(300) %></p><a class="summary-more" href="<%= archive.permalink %>">继续阅读</a></article><hr class="summary-sep"><% } %><% if(!count){ %><p>暂无文章。</p><% } %>