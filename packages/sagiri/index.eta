<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||'' %> <%= site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="archive-heading"><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><% if(!archive.have()){ %><section class="post">暂无文章。</section><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>