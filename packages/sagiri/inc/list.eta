<% const archive=firekylin.archive; %><% while(archive.next()){const cover=String(archive.row.featuredImage||''); %><article class="post"><header class="post-header"><h2 class="post-title"><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><span><time><%= archive.date('YYYY-MM-DD') %></time></span><span><%= archive.author('display_name') %></span></div></header><div class="post-content"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><a href="<%= archive.permalink %>"><img class="post-thumbnail" src="<%= cover %>" alt="" loading="lazy"></a><% } %><p><%= archive.excerpt(200,true) %></p></div><div class="post-button"><a class="btn" href="<%= archive.permalink %>">阅读全文 »</a></div></article><% } %>