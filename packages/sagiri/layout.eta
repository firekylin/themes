<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig||{};const banner=String(cfg.headerImage||'');const avatar=String(cfg.avatarUrl||''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body><a class="skip-link" href="#main">跳转到正文</a><header class="header-wrap"><nav class="site-nav" aria-label="主导航"><ul class="menu"><li class="menu-item"><a href="/">首页</a></li><% site.navigation.forEach(nav=>{ %><li class="menu-item"><a href="<%= nav.url %>"><%= nav.label %></a></li><% }) %><li class="menu-item"><a href="/archives">归档</a></li><li class="menu-item"><a href="/search.html">搜索</a></li></ul></nav><div class="site-config"><% if(/^(https?:\/\/|\/(?!\/))/.test(banner)){ %><img class="banner-image" src="<%= banner %>" alt=""><% } %><div class="animated"><h1 class="site-title"><%= site.title() %></h1><p class="site-meta"><%= site.description() %></p></div></div></header><div class="main-inner"><main id="main" class="content-wrap"><%~ block('content') %></main><aside class="sidebar"><div class="sider-item"><div class="sidebar-nav"><button type="button" id="toc-tab" hidden aria-controls="article-toc" aria-expanded="false">文章目录</button><button type="button" id="overview-tab" aria-controls="site-overview" aria-expanded="true">站点概览</button></div><nav id="article-toc" aria-label="文章目录" hidden></nav><div id="site-overview"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img class="site-author-image" src="<%= avatar %>" alt="作者头像"><% } %><p class="site-author-name"><%= cfg.profileName||site.title() %></p><p><%= cfg.profileText||site.description() %></p><p><a href="/archives">归档</a> · <a href="/categories">分类</a> · <a href="/tags">标签</a> · <a href="/rss.html">RSS</a></p></div></div></aside></div><footer class="site-footer">© <%= new Date().getFullYear() %> <%= site.title() %> · Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/shiyiya/typecho-theme-sagiri">Sagiri</a> by Shiyi / DIYgod.</footer><a class="back-top" href="#main" aria-label="返回正文顶部">↑</a><script defer src="<%= site.themeUrl('res/js/sagiri.js') %>"></script></body></html>
