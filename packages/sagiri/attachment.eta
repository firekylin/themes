<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="post reading"><% if((archive.row.cate||[]).length){ %><div class="post-badge"><% archive.row.cate.forEach(cat=>{ %><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a><% }) %></div><% } %><header class="post-header"><h1 class="post-title"><span class="post-title-link"><%= archive.title() %></span></h1><div class="post-meta"><span><time><%= archive.date('YYYY-MM-DD') %></time></span><span><%= archive.author('display_name') %></span></div></header><div class="post-content"><%~ archive.content() %></div><footer class="post-footer"><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>">#<%= tag.name %></a> <% }) %></footer></article><% const comments=firekylin.comment({title:'评论'});if(comments){ %><section class="post sagiri-comments"><%~ comments %></section><% } %><% }else{ %><section class="post">暂无内容。</section><% } %><% }) %>