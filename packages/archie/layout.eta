<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/dark.css') %>" media="(prefers-color-scheme:dark)"></head><body><a class="skip" href="#main">跳转到正文</a><div class="content"><header><div class="main"><a href="/"><%= site.title() %></a></div><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a> <a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %> <a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><span><%= cfg.footerText||site.description() %></span><a href="/categories">分类</a> | <a href="/tags">标签</a><span>Firekylin · <a href="https://github.com/athul/archie">Archie</a> 原生改编</span></footer></div></body></html>