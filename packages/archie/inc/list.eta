<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><section class="entry list-item"><h1 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><time><%= archive.date('YYYY-MM-DD') %></time><p><%~ archive.excerpt(320) %></p><a class="readmore" href="<%= archive.permalink %>">Read more ⟶</a></section><% }if(!count){ %><p>暂无文章。</p><% } %>