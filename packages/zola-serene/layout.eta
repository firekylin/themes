<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="<%~ block('bodyClass') %>"><a class="skip" href="#main">跳转到正文</a><div id="wrapper"><main id="main"><section id="info"><% const avatar=String(cfg.profileImage||'');if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt=""><% } %><div id="text"><div id="name"><%= cfg.authorName||site.title() %></div><div id="bio"><%= site.description() %></div></div></section><section id="links"><nav id="left" class="native-nav nav-items" aria-label="主导航"><a class="home-link" href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><div id="right"><button id="theme-toggle" aria-label="切换明暗模式" type="button">切换明暗</button></div></section><%~ block('content') %><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/isunjn/serene">Serene</a></p></footer></main></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>