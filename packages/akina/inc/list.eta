<% const archive=firekylin.archive;%><div class="fk-feed"><% while(archive.next()){const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage||'')?archive.row.featuredImage:'';%><article class="entry-card"><% if(cover){ %><a class="akina-icon" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% for(const cat of archive.row.cate||[]){ %> · <a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><% if(archive.row.comment_num!=null){ %> · <%= Number(archive.row.comment_num)||0 %> 条评论<% } %></div><p class="entry-excerpt"><%= archive.excerpt(100) %></p><p class="akina-more"><a href="<%= archive.permalink %>">•••</a></p></div></article><% } %></div>