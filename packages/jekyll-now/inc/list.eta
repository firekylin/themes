<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><h2><a class="post-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-summary"><%~ archive.excerpt(400) %></div><a class="read-more" href="<%= archive.permalink %>">Read More</a></article><% }if(!count){ %><p>暂无文章。</p><% } %>