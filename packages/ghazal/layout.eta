<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="ghazal-header"><button id="menu-toggle" class="menu-toggle" aria-label="打开导航" aria-controls="site-menu" aria-expanded="false" hidden>☰</button><a class="site-name" href="/"><%= site.title() %></a><nav class="native-nav nav-items no-js-nav" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><dialog id="site-menu" class="slide-menu" aria-label="站点导航"><nav class="menu-container"><button id="menu-close" class="menu-close" aria-label="关闭导航">×</button><a class="menu-item" href="/">首页</a><a class="menu-item" href="/archives">归档</a><a class="menu-item" href="/categories">分类</a><a class="menu-item" href="/tags">标签</a><a class="menu-item" href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a class="menu-item" href="<%= n.url %>"><%= n.label %></a><% }); %></nav></dialog><main id="main"><%~ block('content') %></main><a class="to-top" href="#main">↑ 返回顶部</a><footer class="ghazal-footer"><div class="footer-columns"><section><h3>关于本站</h3><p class="footer-info"><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p></section><section><h3>站点导航</h3><ul><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></section><section><h3>最新文章</h3><ol><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a></li><% } %></ol></section></div><hr class="footer-rule"><div class="footer-credit"><p>Firekylin · <a href="https://github.com/darshanbaral/ghazal">Ghazal</a> by Darshan Baral</p></div></footer></body></html>