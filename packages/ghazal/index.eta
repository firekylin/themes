<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig; %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&(!archive.pagination||archive.pagination.currentPage===1)){const avatar=String(cfg.avatarURL||''); %><section class="ghazal-intro"><h1><%= site.title() %></h1><% if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="intro-avatar" src="<%= avatar %>" alt=""><% } %><p class="intro-text"><%= cfg.introText||site.description() %></p><nav class="intro-links" aria-label="简介导航"><a href="#articles">阅读文章 ↓</a><a href="/archives">全部归档</a></nav></section><% } %><section id="articles" class="listing"><h1 class="listing-heading"><%= archive.archiveTitle||'文章' %></h1><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>