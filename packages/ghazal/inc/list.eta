<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry list-sections"><div class="article-date"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></div><h2 class="article-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="article-summary"><%= archive.excerpt(160) %></p></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>