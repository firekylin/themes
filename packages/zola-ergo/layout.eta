<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><link id="dark-palette" rel="stylesheet" href="<%= site.themeUrl('res/css/dark.css') %>" media="not all"></head><body class="<%~ block('bodyClass') %>"><a class="skip" href="#main">跳转到正文</a><div class="native-top"><a href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav><button id="palette-toggle" type="button" aria-pressed="false" hidden>深色模式</button></div><header class="header"><% const avatar=String(cfg.profileImage||'');if(/^(?:https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="native-profile" src="<%= avatar %>" alt=""><% } %><h2><%= site.title() %></h2><div><%= site.description() %></div></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/insipx/Ergo">Ergo</a></p></footer><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>