<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post_list_item entry"><h1 class="article_title"><a class="article-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="frontmatter"><time><%= archive.date('YYYY-MM-DD') %></time></div><p class="article_content"><%= archive.excerpt(300) %></p><a class="button small" href="<%= archive.permalink %>">继续阅读 →</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>