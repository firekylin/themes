<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><b><time><%= archive.date('YYYY-MM-DD') %></time></b><div><p><%= archive.excerpt(300) %></p></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>