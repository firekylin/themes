<% const archive=firekylin.archive;let count=0; %><ul class="list"><% while(archive.next()){count++; %><li class="item entry"><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><header class="item-header"><h3 class="item-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3></header></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>