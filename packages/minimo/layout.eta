<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="has-sidebar <%~ block('bodyClass') %>"><a class="skip" href="#main">跳转到正文</a><div class="site"><details id="sidebar" class="sidebar" open><summary>关于本站</summary><div class="container"><section class="widget widget-about sep-after"><h2 class="site-title"><a href="/"><%= cfg.authorName||site.title() %></a></h2><p class="desc"><%= site.description() %></p></section><section class="widget"><h3>搜索</h3><form action="/search.html" method="get"><input name="keyword" type="search" aria-label="侧栏搜索关键词"><button type="submit">搜索</button></form></section><section class="widget"><h3>标签</h3><div class="tag-links"><% const cloud=await firekylin.widget('Widget_Metas_Tag_Cloud');while(cloud.next()){ %><a href="<%= cloud.permalink %>"><%= cloud.row.name %></a><% } %></div></section></div></details><div class="main"><div class="container"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><main id="main" class="container"><header class="header site-header"><div class="sep-after home-heading"><div class="header-info"><h1 class="site-title title"><%= site.title() %></h1><p class="desc"><%= site.description() %></p></div></div></header><%~ block('content') %></main><footer class="footer native-footer"><div class="container sep-before"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/MunifTanjim/minimo">Minimo</a></p></div></footer></div></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>