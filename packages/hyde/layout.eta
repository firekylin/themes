<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const color=/^0[89a-f]$/.test(String(cfg.colorScheme||''))?'theme-base-'+cfg.colorScheme:''; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="<%= color %> <%= cfg.reverse==='true'?'layout-reverse':'' %>"><a class="skip" href="#main">跳转到正文</a><aside class="sidebar"><div class="container sidebar-sticky"><div class="sidebar-about"><h1><a href="/"><%= site.title() %></a></h1><p class="lead"><%= site.description() %></p></div><nav class="sidebar-nav" aria-label="主导航"><a class="sidebar-nav-item" href="/">首页</a><a class="sidebar-nav-item" href="/archives">归档</a><a class="sidebar-nav-item" href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a class="sidebar-nav-item" href="<%= n.url %>"><%= n.label %></a><% }); %><a class="sidebar-nav-item" href="/categories">分类</a><a class="sidebar-nav-item" href="/tags">标签</a></nav><p>© <%= cfg.authorName||site.title() %></p><p class="credits"><%= cfg.footerText||'' %> Powered by Firekylin · <a href="https://github.com/poole/hyde">Hyde</a> 原生改编</p></div></aside><main id="main" class="content container"><%~ block('content') %></main></body></html>