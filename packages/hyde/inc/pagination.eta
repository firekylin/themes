<% const archive=firekylin.archive; const p=archive.pagination; %><% if(p && p.totalPages>1){ %><nav class="pagination" aria-label="分页"><% if(p.currentPage>1){ %><a class="pagination-item" rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">上一页</a><% } %><span><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a class="pagination-item" rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">下一页</a><% } %></nav><% } %>
