<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry post"><h1 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><time class="post-date"><%= archive.date('DD MMM YYYY') %></time><div class="prose"><%~ archive.excerpt(800) %></div><p><a href="<%= archive.permalink %>">继续阅读 →</a></p></article><% }if(!count){ %><p>暂无文章。</p><% } %>