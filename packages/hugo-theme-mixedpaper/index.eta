<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><section class="post_list content native-compact"><h1 class="listing-heading"><%= archive.archiveTitle %></h1><%~ include('./inc/compact',{archive}) %></section><% }else{ %><div class="post_list"><%~ include('./inc/list',{archive}) %></div><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>