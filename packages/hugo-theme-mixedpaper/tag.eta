<% layout('./layout');const site=await firekylin.widget('Widget_Options');const metas=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %>标签 · <%= site.title() %><% }) %><% block('content',()=>{ %><section class="post_list content native-wrap native-terms"><h1>标签</h1><ul class="listing"><% while(metas.next()){ %><li class="block_item item"><a href="/tag/<%= metas.row.pathname %>"><%= metas.title() %><sup><%= metas.row.count %></sup></a><% if(metas.row.children?.length){ %><ul class="children"><% metas.row.children.forEach(child=>{ %><li><a href="/tag/<%= child.pathname %>"><%= child.name %> (<%= child.count %>)</a></li><% }); %></ul><% } %></li><% } %></ul><% if(!metas.have()){ %><p>暂无内容。</p><% } %></section><% }) %>