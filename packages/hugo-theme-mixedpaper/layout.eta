<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header id="header"><div class="header_container"><h1 class="sitetitle"><a href="/" title="<%= site.title() %>"><%= site.title() %></a></h1><nav class="navbar native-nav nav-items" aria-label="主导航"><ul><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav></div></header><main id="main"><%~ block('content') %><div class="native-backtop"><a href="#header">↑ 返回顶部</a></div></main><a id="back_to_top" href="#header" aria-label="返回顶部">↑</a><footer id="footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/wayjam/hugo-theme-mixedpaper">Mixedpaper</a> · WayJam So</p></footer></body></html>