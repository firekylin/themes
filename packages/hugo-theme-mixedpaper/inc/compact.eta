<% const archive=firekylin.archive;let count=0; %><ul class="listing"><% while(archive.next()){count++; %><li class="line_item item"><a href="<%= archive.permalink %>"><span><%= archive.title() %></span><time class="date"><%= archive.date('YYYY-MM-DD') %></time></a></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>