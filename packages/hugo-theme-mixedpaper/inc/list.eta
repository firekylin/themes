<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const locked=Boolean(archive.row.password_protected||archive.row.options?.postPasswordHash||archive.row.title==='此内容被密码保护');const image=String(archive.row.options?.featuredImage||''); %><article class="entry post content"><time class="date"><%= archive.date('YYYY-MM-DD') %></time><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post_content summary"><% if(!locked&&/^(https?:\/\/|\/(?!\/))/i.test(image)){ %><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= image %>" alt="" loading="lazy"></a><% } %><p><%= archive.excerpt(400) %></p></div></article><% } %><% if(!count){ %><section class="content"><p>暂无文章。</p></section><% } %>