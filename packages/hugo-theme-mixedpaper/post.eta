<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const cfg=site.themeConfig;const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post post-detail content"><% if(found){ %><header class="article-meta"><h1 class="title post-title"><%= archive.title() %></h1><p class="post-date"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p></header><div class="prose post_content" id="post-content"><%~ archive.content() %></div><footer class="post-footer info"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><% if(cfg.postNote){ %><p class="post-note"><%= cfg.postNote %></p><% } %><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><nav class="other_posts" aria-label="相邻文章"><% if(archive.row.prev?.pathname){ %><a class="prev" rel="prev" href="<%= archive.permalinkFor(archive.row.prev) %>"><%= archive.row.prev.title %></a><% } %><% if(archive.row.next?.pathname){ %><a class="next" rel="next" href="<%= archive.permalinkFor(archive.row.next) %>"><%= archive.row.next.title %></a><% } %></nav><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>