<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'archive'});const years=new Map(),dateLabels=new Map();while(archive.next()){dateLabels.set(archive.row.id,archive.date('MM-DD'));}Object.entries(archive.grouped).forEach(([month,posts])=>{const year=month.slice(0,4);if(!years.has(year))years.set(year,[]);years.get(year).push(...posts);}); %><% block('title',()=>{ %>归档 · <%= site.title() %><% }) %><% block('content',()=>{ %><section id="archives" class="post_list content native-archive"><h1>归档</h1><div class="listing"><% for(const [year,posts] of years){ %><div class="collection-title"><h2><%= year %></h2></div><% for(const post of posts){ %><div class="archive-post line_item item"><a href="<%= archive.permalinkFor(post) %>"><span><%= post.title %></span><time class="date"><%= dateLabels.get(post.id)||'' %></time></a></div><% } %><% } %><% if(!years.size){ %><p>暂无文章。</p><% } %></div></section><% }) %>