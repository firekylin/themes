<% const archive=firekylin.archive;let count=0; %><div id="posts-wrapper" class="native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post hentry entry"><a class="entry-thumbnail" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><header class="entry-header"><div class="entry-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>