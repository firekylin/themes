<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="entry"><h2 class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="publish"><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></p><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><div class="list-image"><a href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><p><%= archive.excerpt(400) %></p></article><hr><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>