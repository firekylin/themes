{
  "name": "zola-tanuki",
  "title": "Tanuki",
  "version": "0.1.0",
  "private": true,
  "description": "Tanuki blog mode with original Sass, Geist typography, Catppuccin palettes, dated posts and native tag chips.",
  "license": "MIT",
  "author": "Raffael Schneider / raskell.io; Firekylin contributors",
  "homepage": "https://github.com/raskell-io/tanuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/zola-tanuki"
  },
  "firekylin": {
    "type": "theme",
    "id": "zola-tanuki"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
