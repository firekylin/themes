<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const tagsByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('tag').select();related.forEach(p=>tagsByPost.set(p.id,p.tag||[]));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><header class="blog-header"><h1 class="blog-header__title"><%= archive.archiveTitle||site.title() %></h1><p class="blog-header__description"><%= site.description() %></p></header><%~ include('./inc/list',{archive,tagsByPost}) %><%~ include('./inc/pagination',{archive}) %><% }) %>