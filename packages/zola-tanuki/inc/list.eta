<% const archive=firekylin.archive;let count=0; %><div class="blog-posts"><% while(archive.next()){count++;const tags=firekylin.tagsByPost?.get(archive.row.id)||archive.row.tag||[]; %><article class="entry blog-card"><div class="blog-card__content"><h2 class="blog-card__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="blog-card__description"><%= archive.excerpt(260) %></p><div class="blog-card__meta"><time><%= archive.date('YYYY-MM-DD') %></time><div class="blog-card__tags"><% tags.slice(0,3).forEach(t=>{ %><a class="tag" href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a><% }); %></div></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %></div>