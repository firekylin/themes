<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><header class="g-header"><div class="g-header-in"><a class="g-logo" href="/"><%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><div class="g-banner home-banner banner-theme-blue"><h2><%= site.title() %></h2><h3><%= site.description() %></h3></div><div class="g-container home-content"><main id="main" class="native-main article-list"><%~ block("content") %></main><aside class="g-sidebar-wrapper"><div class="g-sidebar"><section class="author-card"><div class="author-name"><%= cfg.authorName||site.title() %></div><div class="bio"><p><%= site.description() %></p></div></section></div></aside></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/kaeyleo/jekyll-theme-H2O">H2O</a> by Kaeyleo</footer></body></html>