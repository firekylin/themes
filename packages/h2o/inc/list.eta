<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="article-item entry"><div class="post-cover"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><section class="post-preview"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="post-excerpt"><%= archive.excerpt(240) %></p></section><footer class="post-meta"><span class="post-date"><time><%= archive.date('YYYY-MM-DD') %></time></span></footer></article><% }if(!count){ %><p>暂无文章。</p><% } %>