<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post entry"><header class="post-header"><% const cover=String(archive.row?.options?.featuredImage||'');if(/^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><a href="<%= archive.permalink %>"><img class="featured" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"></a><% } %><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><section class="post-excerpt"><p><%= archive.excerpt(300) %> <a class="read-more" href="<%= archive.permalink %>" aria-label="继续阅读">»</a></p></section><footer class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>