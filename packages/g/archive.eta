<% const a=await firekylin.widget('Widget_Archive',{type:'archive'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'归档'}) %><main id="archives" class="PAP"><div class="PAP-banner"><div><h1>归档</h1></div></div><div class="PAP-content"><% for(const [month,posts] of Object.entries(a.grouped)){ %><h3 id="month-<%= month %>"><%= month %></h3><div class="mon"><% posts.forEach(p=>{ %><div class="brick"><a href="<%= a.permalinkFor(p) %>"><span class="time"><%= String(p.create_time).slice(5,10) %></span> <%= p.title %></a></div><% }) %></div><% } %></div></main><%~ await includeAsync('./inc/footer',firekylin) %>