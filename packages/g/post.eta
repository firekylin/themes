<% const a=await firekylin.widget('Widget_Archive',{type:firekylin.kind||'post'});a.next();const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const cover=a.row.featuredImage||a.row.fields?.imgurl||a.row.fields?.thumb||''; %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.title()}) %><main id="post" class="PAP"><article><div id="post-banner" class="PAP-banner <%= cover?'PAP-IMG-Banner':'' %>"><% if(cover){ %><div class="PAP-banner-background" style="background-image:url(<%= JSON.stringify(cover) %>)"></div><div class="PAP-banner-mask"></div><% } %><div><h1><%= a.title() %></h1><p><%= a.date('YYYY-MM-DD') %> · <%~ a.category(' · ') %></p></div></div><div class="post-content PAP-content"><%~ a.content() %></div><% if(c.sponsorIMG){ %><div id="post-toolbar"><button id="sponsor-toggle" class="post-toolbar-btn" aria-expanded="false" aria-controls="post-sponsor"><%= c.sponsorText||'赞赏' %></button></div><div id="post-sponsor" hidden><img src="<%= c.sponsorIMG %>" alt="<%= c.sponsorText||'赞赏' %>"></div><% } %><div id="post-footer"><div id="post-footer-tag"><p><%~ a.tags(' ',true,'') %></p></div></div></article></main><%~ firekylin.comment({title:'评论'}) %><%~ await includeAsync('./inc/footer',{...firekylin,detail:true}) %>