<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const cssValue=x=>String(x||'').replace(/[<>;{}]/g,'');const bg=String(c.background||'#fff'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= firekylin.pageTitle?firekylin.pageTitle+' | ':'' %><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/G.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/animation.css') %>"><link id="g-dark" rel="stylesheet" href="<%= site.themeUrl('res/dark.css') %>" media="not all"><link rel="stylesheet" href="<%= site.themeUrl('res/port.css') %>"><style>html{--theme-color:<%= cssValue(c.themeColor||'#07F') %>;--header-color:<%= cssValue(c.headerColor||'#6A6A6A') %>;--theme-radius:<%= cssValue(c.themeRadius||'30px') %>;--theme-shadow:<%= String(c.themeShadow)==='0'?'none':'0 6px 12px 0 rgb(31 35 41 / 8%)' %>}html::before{background:<%= /^https?:/.test(bg)?'url('+JSON.stringify(bg)+')':cssValue(bg) %>;<% if(String(c.repeatBackground)==='1'){ %>background-repeat:repeat;background-size:auto;<% } %>}<%~ c.customCSS||'' %></style></head><body data-night="<%= c.autoNightMode||'0' %>" data-night-span="<%= c.autoNightSpan||'22-6' %>" data-auto-toc="<%= c.enableDefaultTOC||'0' %>"><div id="main"><header id="header"><div id="header-title"><h2><%= site.title() %></h2></div><div id="header-content"><div id="header-content-left"><p><%= String(site.description()).split('||')[0] %></p></div><div id="header-content-right"><nav><a href="/" class="<%= firekylin.ctx.path==='/'?'nav-focus':'' %>">首页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }) %><a href="/search.html">搜索</a></nav></div></div><% if(c.headerBackground){ %><img src="<%= c.headerBackground %>" alt="" id="header-background"><% } %></header>