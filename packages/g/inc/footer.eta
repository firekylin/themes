<% const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const cat=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}); %><footer><div id="footer-content"><div id="footer-sponsor"><a href="https://github.com/youranreus/G">G</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></div><nav id="footer-nav"><a href="/">首页</a><a href="/archives">归档</a><a href="/rss.html">RSS</a></nav></div><p id="footer-meta" class="clear"><span class="left"><% if(c.icp){ %><a href="<%= /^https?:/.test(c.icpUrl||'')?c.icpUrl:'https://beian.miit.gov.cn' %>"><%= c.icp %></a><% } %></span><span class="right"><%= c.buildYear||new Date().getFullYear() %> - <%= new Date().getFullYear() %> © <%= site.title() %></span></p></footer></div><div id="toolbar"><div id="toolbar-container"><button class="toolbar-btn" id="gototop" aria-label="回到顶部">↑</button><button class="toolbar-btn" id="darkmode" aria-label="夜间模式" aria-pressed="false">◐</button><% if(firekylin.detail){ %><button class="toolbar-btn" id="toc-toggle" aria-controls="toc" aria-expanded="false">目录</button><% } %><button class="toolbar-btn" id="sidebar-btn" aria-label="侧边栏" aria-controls="sliderbar" aria-expanded="false">☰</button></div></div><aside id="sliderbar" class="move-left" tabindex="-1" inert aria-hidden="true"><div class="sliderbar-content" id="profile"><div class="profile-content"><% if(c.profileAvatar){ %><div class="profile-avatar-container"><img src="<%= c.profileAvatar %>" alt=""></div><% } %><div class="profile-cover" style="background-image:url(<%= JSON.stringify(c.profileBG||'') %>)"></div><h4><%= site.title() %></h4><i><%= c.profileDes||site.description() %></i></div></div><div id="widgets"><section class="category-list"><h3>分类</h3><ul class="category-content"><% while(cat.next()){ %><li><a href="/cate/<%= cat.row.pathname %>"><%= cat.row.name %></a></li><% } %></ul></section><section class="widget-random-post"><h3>最近文章</h3><% while(recent.next()){ %><a class="item" href="<%= recent.permalink %>"><h4><%= recent.title() %></h4></a><% } %></section><section class="g-tags"><h3>标签</h3><% while(tags.next()){ %><a href="/tag/<%= tags.row.pathname %>"><%= tags.row.name %></a> <% } %></section></div></aside><button id="sliderbar-cover" hidden aria-label="关闭侧栏"></button><aside id="toc" inert aria-hidden="true"><div id="toc-container"><h3>目录</h3><div id="toc-content"></div><button id="toc-close" aria-label="关闭目录">×</button></div></aside><dialog id="g-lightbox"><button id="lightbox-close" aria-label="关闭图片">×</button><img alt=""></dialog><script src="<%= site.themeUrl('res/port.js') %>" defer></script></body></html>