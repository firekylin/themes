<% const a=await firekylin.widget('Widget_Archive',{type:'search'}); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:'搜索'}) %><main id="container"><form class="g-search" action="/search.html"><input type="search" name="keyword" aria-label="搜索关键词" required><button>搜索</button></form><div id="articles"><% while(a.next()){ %><div class="article-item"><h2 class="article-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h2><p><%= a.excerpt(100) %></p></div><% } %></div></main><%~ await includeAsync('./inc/footer',firekylin) %>