<% const a=await firekylin.widget('Widget_Archive',{type:'index'});const site=await firekylin.widget('Widget_Options');const c=site.themeConfig||{};const style=String(c.articleStyle||'0'); %><%~ await includeAsync('./inc/header',{...firekylin,pageTitle:a.archiveTitle}) %><main id="container"><% if(a.archiveTitle){ %><h1><%= a.archiveTitle %></h1><% } %><div id="articles"><% while(a.next()){const cover=a.row.featuredImage||a.row.fields?.imgurl||a.row.fields?.thumb||c.defaultBanner||''; %><% if(style==='2'){ %><div class="card-item"><article><div class="card-cover" style="background-image:url(<%= JSON.stringify(cover) %>)"></div><a class="card-item-link card-link" href="<%= a.permalink %>" aria-label="<%= a.title() %>"></a><h2 class="card-item-title"><%= a.title() %></h2><div class="card-item-meta"><div class="card-item-category"><span class="card-item-category-link"><%~ a.category(',') %></span><span class="card-item-date"><%= a.date('YYYY-MM-DD') %></span></div></div></article></div><% }else{ %><div class="article-item"<% if(style==='1'){ %> style="width:100%"<% } %>><h2 class="article-title"><a href="<%= a.permalink %>"><%= a.title() %></a></h2><% if(style==='1'){ %><p><%= a.excerpt(50) %></p><% } %><div class="article-data"><span><%~ a.category(',') %></span><span><%= a.date('YYYY-MM-DD') %></span></div><% if(cover){ %><div class="article-banner-wrap"></div><div class="article-banner" style="background-image:url(<%= JSON.stringify(cover) %>)"></div><% } %></div><% } } %></div><div id="articles-switch" class="clear"><% if(a.pagination.currentPage<a.pagination.totalPages){ %><a href="<%= a.pageUrl(a.pagination.currentPage+1) %>">更多 &gt;</a><% } if(a.pagination.currentPage>1){ %><a href="<%= a.pageUrl(a.pagination.currentPage-1) %>">&lt; 返回</a><% } %></div></main><%~ await includeAsync('./inc/footer',firekylin) %>