<% const site=await firekylin.widget('Widget_Options'); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body><header><a class="title" href="/"><h2><%= site.title() %></h2></a><nav aria-label="主导航"><a href="/">Home</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/archives">Blog</a><a href="/tags">Tags</a><a href="/search.html">搜索</a></nav></header><main id="main"><%~ block('content') %></main><footer>Made with <a href="https://github.com/janraasch/hugo-bearblog">Hugo Bear Blog</a> by Jan Raasch · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></footer></body></html>