<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h3>Filtering for "<%= archive.archiveTitle %>"</h3><small><a href="/">Remove filter</a></small><% }else if(site.themeConfig.intro){ %><p><%= site.themeConfig.intro %></p><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>