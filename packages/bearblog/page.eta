<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><h1><%= archive.title() %></h1><p><i><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time></i></p><article class="content"><%~ archive.content() %></article><p><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></p><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>No posts yet</p><% } %><% }) %>