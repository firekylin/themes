<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="sticky-nav look-sheet-bkg"><a class="skip" href="#main">跳转到正文</a><header class="navbar nav-bkg drop-shadow"><div class="content-container pagewide-bar-padding"><a class="brand" href="/">/ <%= site.title() %></a><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main" class="content-container article-pad-v <%~ block('surface') %>"><%~ block('content') %></main><footer class="content-container native-footer"><%= cfg.footerText||site.description() %><br><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/capnfabs/paperesque">Paperesque</a></footer></body></html>