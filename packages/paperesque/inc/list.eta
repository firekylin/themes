<% const archive=firekylin.archive;let count=0; %><ul id="list" class="list-unstyled list-of-titles"><% while(archive.next()){count++; %><li class="entry"><a href="<%= archive.permalink %>"><span class="post-title"><%= archive.title() %></span><br><time class="post-meta"><%= archive.date('YYYY-MM-DD') %></time></a></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>