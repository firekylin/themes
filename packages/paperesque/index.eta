<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><h1><%= site.title() %></h1><% } %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><div class="sidepull-container"><aside class="sidepull-side"><p><%= site.description() %></p></aside><div class="sidepull-main"><%~ include('./inc/list',{archive}) %></div></div><%~ include('./inc/pagination',{archive}) %><% }) %>