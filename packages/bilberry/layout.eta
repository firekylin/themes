<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="bilberry-hugo-theme"><a class="native-skip" href="#main">跳转到正文</a><header><div class="container"><div class="titles"><h3 class="title"><a href="/"><%= site.title() %></a></h3><span class="subtitle"><%= site.description() %></span></div></div></header><div class="container"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><main id="main" class="native-main main container"><%~ block("content") %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/Lednerb/bilberry-hugo-theme">Bilberry</a></footer></body></html>