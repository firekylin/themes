<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><div class="article-wrapper u-cf entry"><a class="bubble" href="<%= archive.permalink %>" aria-label="阅读全文">✎</a><article class="default article"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="content"><h1 class="article-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><p><%= archive.excerpt(260) %></p><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></article></div><% }if(!count){ %><p>暂无文章。</p><% } %>