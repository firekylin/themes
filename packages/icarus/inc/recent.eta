<% const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}); %><div class="card widget" data-type="recent_posts"><div class="card-content"><p class="menu-label">Recent posts</p><% while(recent.next()){ %><article class="media"><div class="media-content"><time class="is-size-7"><%= recent.date('Y-m-d') %></time><p><a class="link-muted" href="<%= recent.permalink %>"><%= recent.title() %></a></p></div></article><% } %></div></div><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><div class="card widget" data-type="tags"><div class="card-content"><p class="menu-label">Tags</p><div class="field is-grouped is-grouped-multiline"><% while(tags.next()){ %><div class="control"><a class="tags has-addons" href="<%= tags.permalink %>"><span class="tag"><%= tags.title() %></span><% if(tags.row?.count!=null){ %><span class="tag"><%= tags.row.count %></span><% } %></a></div><% } %></div></div></div>
