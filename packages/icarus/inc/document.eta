<%
const site=await firekylin.widget('Widget_Options'),cfg=site.themeConfig||{},type=firekylin.pageType;
const archive=await firekylin.widget('Widget_Archive',{type}),detail=['post','page','attachment'].includes(type);
const variant=['default','cyberpunk','m3e'].includes(cfg.variant)?cfg.variant:'default',appearance=['light','dark'].includes(cfg.appearance)?cfg.appearance:'auto';
const columns=[1,2,3].includes(Number(cfg.columns))?Number(cfg.columns):3;
const safeUrl=v=>typeof v==='string'&&/^(https?:\/\/|mailto:|\/(?!\/)|#)/i.test(v)?v:'#';
const parse=v=>{try{const a=JSON.parse(v||'[]');return Array.isArray(a)?a.filter(x=>x&&typeof x==='object').slice(0,50):[];}catch{return [];}};
const context={...firekylin,site,cfg,safeUrl,parse,detail};
%><!doctype html><html lang="en" data-appearance-mode="<%= appearance %>" data-appearance="<%= appearance %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><link rel="stylesheet" href="<%= site.themeUrl('res/css/'+variant+'.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>"><script src="<%= site.themeUrl('res/js/icarus.js') %>" defer></script></head><body class="is-<%= columns %>-column"><a class="skip-link" href="#main">Skip to content</a>
<nav class="navbar navbar-main"><div class="container navbar-container"><div class="navbar-brand justify-content-center"><a class="navbar-item navbar-logo" href="/"><%= site.title() %></a></div><div class="navbar-menu"><button type="button" class="navbar-item" id="menu-toggle" aria-controls="navbar-main-menu" aria-expanded="false" hidden>☰ Menu</button><div class="navbar-start" id="navbar-main-menu"><% for(const n of site.navigation||[]){ %><a class="navbar-item" href="<%= safeUrl(n.url) %>"><%= n.label %></a><% } %></div><div class="navbar-end"><a class="navbar-item" href="/search.html">Search</a><button class="navbar-item appearance-toggle" type="button" aria-label="Switch appearance" hidden>◐</button><% if(detail&&cfg.showToc!=='false'){ %><button class="navbar-item is-hidden-tablet" id="mobile-toc-toggle" type="button" aria-controls="toc" aria-expanded="false" hidden>Contents</button><% } %></div></div></div></nav>
<section class="section"><div class="container"><div class="columns"><main id="main" class="column column-main order-2 <%= columns===1?'is-12':columns===2?'is-8-tablet is-8-desktop is-8-widescreen':'is-8-tablet is-8-desktop is-6-widescreen' %>">
<% if(type==='archive'){ %><div class="card"><div class="card-content"><h1 class="title is-3">Archives</h1><% for(const [month,rows] of Object.entries(archive.grouped||{})){ %><h2 class="title is-4"><%= month %></h2><div class="timeline"><% for(const row of rows){ %><article class="media"><div class="media-content"><time class="is-size-7"><%= String(row.create_time).slice(0,10) %></time><p><a href="<%= archive.permalinkFor(row) %>"><%= row.title %></a></p></div></article><% } %></div><% } %></div></div>
<% }else if(type==='cate'||type==='tag'){const metas=await firekylin.widget(type==='cate'?'Widget_Metas_Category_List':'Widget_Metas_Tag_Cloud'); %><div class="card"><div class="card-content"><h1 class="title is-3"><%= type==='cate'?'Categories':'Tags' %></h1><ul class="menu-list"><% while(metas.next()){ %><li><a href="<%= metas.permalink %>"><%= metas.title() %></a></li><% } %></ul></div></div>
<% }else{ %>
<% if(type==='search'){ %><div class="card"><div class="card-content"><h1 class="title is-4">Search</h1><form action="/search.html" method="get"><label for="keyword">Search articles</label><div class="field has-addons"><div class="control is-expanded"><input class="input" name="keyword" id="keyword" value="<%= archive.keyword||'' %>"></div><div class="control"><button class="button is-primary">Search</button></div></div></form></div></div><% }else if(!detail&&archive.archiveTitle){ %><div class="card"><div class="card-content"><h1 class="title is-4"><%= archive.archiveTitle %></h1></div></div><% } %>
<% let count=0;while(archive.next()){count++;const cover=safeUrl(archive.row?.featuredImage||cfg.defaultCover); %><div class="card"><% if(cover!=='#'){ %><div class="card-image"><a class="image is-7by3" href="<%= archive.permalink %>"><img class="fill" src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><article class="card-content article"><div class="article-meta is-size-7 is-uppercase level is-mobile"><div class="level-left"><span class="level-item"><time><%= archive.date('Y-m-d') %></time></span><% if(cfg.showUpdated==='true'&&archive.row?.update_time){ %><span class="level-item">Updated <%= String(archive.row.update_time).slice(0,10) %></span><% } %><% for(const meta of archive.row?.cate||[]){ %><span class="level-item"><a class="link-muted" href="/cate/<%= meta.pathname %>"><%= meta.name %></a></span><% } %></div></div>
<% if(detail){ %><h1 class="title is-3 is-size-4-mobile"><%= archive.title() %></h1><% }else{ %><p class="title is-3 is-size-4-mobile"><a class="link-muted" href="<%= archive.permalink %>"><%= archive.title() %></a></p><% } %><div class="content"><% if(detail){ %><%~ archive.content() %><% }else{ %><p><%= archive.excerpt(300) %></p><% } %></div>
<% if(!detail){ %><a class="button is-small is-light" href="<%= archive.permalink %>">Read more</a><% }else{ %><div class="article-tags"><% for(const meta of archive.row?.tag||[]){ %><a class="tag mr-1" href="/tag/<%= meta.pathname %>"><%= meta.name %></a><% } %></div><nav class="level mt-4" aria-label="Adjacent posts"><% for(const key of ['prev','next']){const neighbor=archive.row?.[key];if(neighbor?.pathname){ %><a rel="<%= key %>" href="<%= archive.permalinkFor(neighbor) %>"><%= key %>: <%= neighbor.title %></a><% }} %></nav><% } %></article></div><% if(detail){const commentHtml=firekylin.comment({title:'Comments',className:'article-comments'});if(commentHtml){ %><div class="card"><div class="card-content"><%~ commentHtml %></div></div><% }break;}}if(!count){ %><div class="card"><div class="card-content">No articles found.</div></div><% } %>
<% if(!detail&&archive.pagination){const p=archive.pagination; %><nav class="pagination is-centered" aria-label="Pagination"><% if(p.currentPage>1){ %><a class="pagination-previous" rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">Previous</a><% } %><% if(p.currentPage<p.totalPages){ %><a class="pagination-next" rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">Next</a><% } %><ul class="pagination-list"><li><span class="pagination-link is-current"><%= p.currentPage %> / <%= p.totalPages %></span></li></ul></nav><% }} %>
</main><% if(columns>1){ %><aside class="column column-left order-1 is-4-tablet is-4-desktop <%= columns===3?'is-3-widescreen':'is-4-widescreen' %> <%= cfg.leftSticky==='true'?'is-sticky':'' %>"><%~ await includeAsync('profile',context) %><% if(detail&&cfg.showToc!=='false'){ %><div class="card widget" id="toc"><div class="card-content"><div class="menu"><p class="menu-label">Contents</p><button id="close-toc" type="button" class="button is-small is-hidden-tablet" hidden>Close</button><nav class="menu-list" aria-label="Table of contents"></nav></div></div></div><% } %><%~ await includeAsync('categories',context) %><% if(columns===2){ %><%~ await includeAsync('recent',context) %><% }else{ %><div class="column-right-shadow"></div><% } %></aside><% } %>
<% if(columns===3){ %><aside class="column column-right order-3 is-4-tablet is-4-desktop is-3-widescreen <%= cfg.rightSticky==='true'?'is-sticky':'' %>"><%~ await includeAsync('recent',context) %></aside><% } %></div></div></section>
<footer class="footer"><div class="container"><div class="level"><div class="level-start"><p>© <%= new Date().getFullYear() %> <%= cfg.footerText||site.title() %><br><a href="https://github.com/ppoffice/hexo-theme-icarus">Icarus</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></div><div class="level-end"><a href="/rss.html">RSS</a></div></div></div></footer><div id="toc-mask" hidden></div><a id="back-to-top" href="#" aria-label="Back to top">↑</a></body></html>
