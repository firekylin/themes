<% const {cfg,safeUrl,parse}=firekylin;const categories=await firekylin.widget('Widget_Metas_Category_List'); %><div class="card widget" data-type="categories"><div class="card-content"><div class="menu"><p class="menu-label">Categories</p><ul class="menu-list"><% while(categories.next()){ %><li><a class="level is-mobile" href="<%= categories.permalink %>"><span class="level-left"><%= categories.title() %></span><% if(categories.row?.count!=null){ %><span class="level-right tag"><%= categories.row.count %></span><% } %></a></li><% } %></ul></div></div></div><% const links=parse(cfg.links);if(links.length){ %><div class="card widget"><div class="card-content"><p class="menu-label">Links</p><ul class="menu-list"><% for(const link of links){ %><li><a href="<%= safeUrl(link.url) %>"><%= link.name %></a></li><% } %></ul></div></div><% } %>
