<% const {site,cfg,safeUrl,parse}=firekylin;const avatar=safeUrl(cfg.avatarUrl); %><div class="card widget" data-type="profile"><div class="card-content"><div class="has-text-centered"><% if(avatar!=='#'){ %><figure class="image is-128x128 mx-auto mb-3"><img class="is-rounded" src="<%= avatar %>" alt=""></figure><% } %><p class="title is-4"><%= cfg.profileName||site.title() %></p><p class="is-size-6 is-block"><%= cfg.profileBio||site.description() %></p><% if(cfg.profileLocation){ %><p class="is-size-6 is-block"><%= cfg.profileLocation %></p><% } %><% if(safeUrl(cfg.followUrl)!=='#'){ %><a class="button is-primary is-rounded is-fullwidth mt-3" href="<%= safeUrl(cfg.followUrl) %>">Follow</a><% } %><div class="level is-mobile mt-3"><% for(const s of parse(cfg.socialLinks)){ %><a class="level-item" href="<%= safeUrl(s.url) %>" rel="me noopener"><%= s.name %></a><% } %></div></div></div></div>
