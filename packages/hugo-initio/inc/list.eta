<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry post"><header class="entry-header"><div class="entry-meta"><time><%= archive.date('YYYY/MM/DD') %></time></div><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="entry-content"><p><%= archive.excerpt(400) %></p><a class="native-readmore" href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>