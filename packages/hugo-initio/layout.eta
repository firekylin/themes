<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header id="header"><div id="head"><% const banner=String(cfg.bannerURL||'');const avatar=String(cfg.avatarURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(banner)){ %><img class="banner-image" src="<%= banner %>" alt=""><% } %><h1 id="logo" class="text-center"><% if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="img-circle" src="<%= avatar %>" alt=""><% } %><span class="title"><a href="/"><%= site.title() %></a></span><span class="tagline"><%= site.description() %></span></h1></div><div class="navbar navbar-default native-navbar"><div class="container"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><main id="main" class="native-main"><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 reading-column"><%~ block('content') %></div></div></div></main><footer id="footer"><div class="container native-footer-columns"><section class="widget"><h3 class="widget-title">关于本站</h3><p><%= cfg.footerText||site.description() %></p></section><section class="widget"><h3 class="widget-title">探索</h3><p><a href="/archives">全部文章</a> · <a href="/categories">分类</a> · <a href="/tags">标签</a> · <a href="/search.html">搜索</a></p></section></div></footer><footer id="underfooter"><div class="container native-attribution"><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Design: <a href="https://www.gettemplate.com/info/initio/">Initio by Sergey Pozhilov / GetTemplate</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a><br>Hugo port <a href="https://github.com/miguelsimoni/hugo-initio">Miguel Simoni</a> · Adapted for Firekylin</p></div></footer></body></html>