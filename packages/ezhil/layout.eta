<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/dark.css') %>" media="(prefers-color-scheme:dark)" data-ezhil-dark><script src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="container wrapper"><header class="header"><h1 class="site-title"><a href="/"><%= site.title() %></a></h1><div class="site-description"><h2><%= site.description() %></h2><nav><ul class="flat"><li class="theme-switch"><button type="button" id="theme-toggle" aria-label="切换明暗配色">明 / 暗</button></li></ul></nav></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main"><%~ block('content') %></main></div><footer class="native-footer wrapper"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/vividvilla/ezhil">Ezhil</a></p></footer></body></html>