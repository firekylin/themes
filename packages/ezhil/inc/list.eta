<% const archive=firekylin.archive;let count=0; %><section class="recent-posts section"><h2 class="section-header">近期文章</h2><div class="posts"><% while(archive.next()){count++; %><article class="post entry"><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><a class="title" href="<%= archive.permalink %>"><%= archive.title() %></a> — <span class="description"><%= archive.excerpt(250) %></span></article><% } %></div></section><% if(!count){ %><p>暂无文章。</p><% } %>