<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){const cfg=site.themeConfig;const avatar=String(cfg.profileImage||''); %><section class="home-intro"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><div class="profile"><div class="profile-container"><img src="<%= avatar %>" alt=""></div></div><% } %><div class="content"><h1><%= cfg.authorName||site.title() %></h1><p><%= site.description() %></p></div></section><% } %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>