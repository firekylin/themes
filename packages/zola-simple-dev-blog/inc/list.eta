<% const archive=firekylin.archive;let count=0; %><section class="posts"><% while(archive.next()){count++; %><article class="post-preview entry"><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><small><time><%= archive.date('YYYY-MM-DD') %></time></small><div class="summary"><%= archive.excerpt(300) %> <a href="<%= archive.permalink %>">阅读全文</a></div></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>