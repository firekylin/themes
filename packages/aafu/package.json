{
  "name": "aafu",
  "title": "Aafu",
  "version": "0.1.0",
  "private": true,
  "description": "Aafu’s original Tailwind blog layout, expandable article metadata, stone palette, blue/yellow links and persistent dark mode.",
  "license": "MIT",
  "author": "Darshan Baral; Firekylin contributors",
  "homepage": "https://github.com/darshanbaral/aafu",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/aafu"
  },
  "firekylin": {
    "type": "theme",
    "id": "aafu"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
