<% const archive=firekylin.archive;const meta=firekylin.metaByPost||new Map();let count=0; %><% while(archive.next()){count++;const tax=meta.get(archive.row.id)||archive.row; %><details class="entry" <%= count===1?'open':'' %>><summary><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></summary><div class="metadata-panel"><p><time><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author('display_name') %></p><p><%= archive.excerpt(160) %></p><div class="taxonomies"><% (tax.cate||[]).forEach(c=>{ %><a class="categories" href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><% (tax.tag||[]).forEach(t=>{ %><a class="tags" href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div><a href="<%= archive.permalink %>">阅读全文</a></div></details><% } %><% if(!count){ %><p>暂无文章。</p><% } %>