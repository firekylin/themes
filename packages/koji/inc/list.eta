<% const archive=firekylin.archive;let count=0; %><div class="posts native-grid"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="preview entry"><div class="preview-wrapper"><a class="preview-image" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a><div class="preview-inner"><h2 class="preview-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>