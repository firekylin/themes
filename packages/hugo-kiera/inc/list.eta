<% const archive=firekylin.archive;let count=0,lastGroup=''; %><section id="home"><ul><% while(archive.next()){count++; %><li class="entry"><h1><a href="<%= archive.permalink %>"><%= archive.title() %></a></h1><aside><time><%= archive.date('YYYY-MM-DD') %></time></aside><% const cover=String(archive.row?.options?.featuredImage||'');if(/^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><p><%= archive.excerpt(300) %></p></li><% } %></ul></section><% if(!count){ %><p>暂无文章。</p><% } %>