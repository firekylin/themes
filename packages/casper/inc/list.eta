<% const archive=firekylin.archive;let count=0; %><div class="post-feed"><% while(archive.next()){count++;const image=String(archive.row.options?.featuredImage||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(image); %><article class="entry post-card <%= count===1?'large':(count<4?'dynamic':'') %> <%= valid?'':'no-image' %>"><% if(valid){ %><a class="card-image" href="<%= archive.permalink %>"><img src="<%= image %>" alt="" loading="lazy"></a><% } %><div class="card-content"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%~ archive.excerpt(300) %></p><time><%= archive.date('YYYY-MM-DD') %></time></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>