<% layout('./layout');const site=await firekylin.widget('Widget_Options');const cover=String(site.themeConfig.coverImage||'');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="hero outer"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="hero-image" src="<%= cover %>" alt=""><% } %><div class="inner"><h1><%= site.title() %></h1><p><%= site.description() %></p></div></section><% } %><div class="outer"><div class="inner posts"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div></div><% }) %>