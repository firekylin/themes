<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:4});const more=recent.stack.filter(p=>p.id!==archive.row.id).slice(0,3);const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-detail"><% if(found){ %><header class="reading"><h1><%= archive.title() %></h1><p class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p></header><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><figure class="article-cover"><img src="<%= cover %>" alt=""></figure><% } %><div class="prose reading" id="post-content"><%~ archive.content() %></div><footer class="post-footer reading"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><div class="reading"><%~ firekylin.comment({title:'评论'}) %></div><% }else{ %><p>暂无内容。</p><% } %></article><% if(more.length){ %><aside class="outer"><div class="inner read-more"><% more.forEach(p=>{const im=String(p.options?.featuredImage||''); %><article><a href="<%= recent.permalinkFor(p) %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(im)){ %><img src="<%= im %>" alt="" loading="lazy"><% } %><h2><%= p.title %></h2></a></article><% }); %></div></aside><% } %><% }) %>