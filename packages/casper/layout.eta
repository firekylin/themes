<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header outer"><div class="inner head"><a class="brand" href="/"><%= site.title() %></a><nav class="nav-items" aria-label="主导航"><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></div></header><main id="main"><%~ block('content') %></main><footer class="site-footer outer"><div class="inner"><span><%= cfg.footerText||site.description() %></span><a href="/categories">分类</a> · <a href="/tags">标签</a><span>Firekylin · <a href="https://github.com/TryGhost/Casper">Casper</a> 原生改编</span></div></footer></body></html>