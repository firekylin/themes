<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><header class="intro-header"><div class="container"><div class="site-heading"><h1><a href="/"><%= site.title() %></a></h1><span class="subheading"><%= site.description() %></span><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div></header><div class="container custom-haojen-container"><div class="row"><main id="main" class="native-main col-lg-8 col-lg-offset-1 col-md-8 col-md-offset-1 col-sm-12 col-xs-12 post-container"><%~ block("content") %></main><aside class="col-lg-3 col-md-3 sidebar-container"><h3><%= cfg.authorName||site.title() %></h3><p><%= site.description() %></p></aside></div></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/Haojen/hexo-theme-Anisina">Anisina</a> by Haojen</footer></body></html>