<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="post-preview entry"><a href="<%= archive.permalink %>"><h2 class="post-title"><%= archive.title() %></h2><p class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><div class="post-content-preview"><p><%= archive.excerpt(260) %></p></div></a></article><hr><% }if(!count){ %><p>暂无文章。</p><% } %>