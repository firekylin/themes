<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});let groups=[];try{const value=JSON.parse(site.themeConfig.directory||'[]');if(Array.isArray(value))groups=value.filter(g=>g&&typeof g.title==='string'&&Array.isArray(g.links)).slice(0,100);}catch{} const safe=u=>typeof u==='string'&&(u.startsWith('https://')||u.startsWith('http://')||(u.startsWith('/')&&!u.startsWith('//'))); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><section class="search-panel"><h1><%= site.title() %></h1><p><%= site.description() %></p><form action="/search.html" method="get"><label class="sr-only" for="directory-search">搜索站内文章</label><input id="directory-search" name="keyword" type="search" placeholder="搜索站内文章" required><button type="submit">搜索</button></form><label class="filter-label" hidden>筛选网址 <input id="link-filter" type="search" placeholder="输入网址名称或说明"></label></section><div id="link-groups"><% groups.forEach((g,i)=>{ %><section class="link-group" id="group-<%= i %>"><h2>◇ <%= g.title %></h2><div class="link-grid"><% g.links.filter(l=>l&&typeof l.title==='string'&&safe(l.url)).slice(0,200).forEach(l=>{ %><a class="url-card" href="<%= l.url %>" target="_blank" rel="noopener noreferrer" title="<%= l.description||l.title %>"><span class="url-icon"><% if(safe(l.logo)){ %><img src="<%= l.logo %>" alt="" loading="lazy"><% }else{ %><%= l.title.slice(0,1) %><% } %></span><span class="url-info"><strong><%= l.title %></strong><span><%= l.description||l.url %></span></span></a><% }); %></div></section><% }); %><% if(!groups.length){ %><p class="empty">暂无收录的网址。</p><% } %><p id="no-links" hidden>没有匹配的网址。</p></div><% } %><section class="article-section"><h2><%= archive.archiveTitle||'最新文章' %></h2><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></section><% }) %>