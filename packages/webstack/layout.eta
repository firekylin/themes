<% const site=await firekylin.widget('Widget_Options');let groups=[];try{const value=JSON.parse(site.themeConfig.directory||'[]');if(Array.isArray(value))groups=value.filter(g=>g&&typeof g.title==='string'&&Array.isArray(g.links)).slice(0,100);}catch{} %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到内容</a><aside class="sidebar"><a class="brand" href="/"><%= site.title() %></a><details class="site-menu" open><summary>导航菜单</summary><nav aria-label="主导航"><% groups.forEach((g,i)=>{ %><a href="/#group-<%= i %>"><span aria-hidden="true">◇</span><%= g.title %></a><% }); %><a href="/archives"><span aria-hidden="true">▤</span>文章归档</a><a href="/categories"><span aria-hidden="true">▦</span>分类</a><a href="/tags"><span aria-hidden="true">♧</span>标签</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><span aria-hidden="true">↗</span><%= n.label %></a><% }); %></nav></details></aside><div class="main-area"><header class="topbar"><a href="/">首页</a><a href="/search.html">文章搜索</a><button id="theme-toggle" type="button" aria-label="切换深色模式">◐</button></header><main id="main"><%~ block('content') %></main><footer>© <%= site.title() %> · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/shenweiyan/WebStack-Hugo">WebStack-Hugo</a> / <a href="https://github.com/WebStackPage/WebStackPage.github.io">WebStackPage</a></footer></div></body></html>