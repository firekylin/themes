<% const archive=firekylin.archive;let count=0; %><div class="article-grid"><% while(archive.next()){count++; %><article class="article-card"><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><time><%= archive.date('YYYY-MM-DD') %></time><p><%~ archive.excerpt(160) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>