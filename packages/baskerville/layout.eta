<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><header class="header section small-padding bg-dark"><div class="header-inner section-inner"><h1 class="blog-title"><a href="/"><%= site.title() %></a></h1><h3 class="blog-description"><%= site.description() %></h3></div></header><div class="navigation section bg-dark"><div class="navigation-inner section-inner"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><main id="main" class="native-main wrapper section medium-padding"><div class="content section-inner"><%~ block('content') %><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/andersnoren/baskerville">Baskerville</a> by Anders Norén</footer></div></main></body></html>