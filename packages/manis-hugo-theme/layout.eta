<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/normalize.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header class="container native-header"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main" class="container"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/yursan9/manis-hugo-theme">Manis</a></p></footer></body></html>