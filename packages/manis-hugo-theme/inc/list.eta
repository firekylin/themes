<% const site=firekylin.site;const archive=firekylin.archive;let count=0; %><section id="brand"><h1><%= site.title() %></h1><p><%= site.description() %></p><hr class="sep"><h4>最新文章</h4><ul class="no-bullet"><% while(archive.next()){count++; %><li class="entry"><span><time><%= archive.date('YYYY-MM-DD') %></time></span><a href="<%= archive.permalink %>"><%= archive.title() %></a></li><% } %></ul></section><% if(!count){ %><p>暂无文章。</p><% } %>