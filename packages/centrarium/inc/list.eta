<% const archive=firekylin.archive;let count=0; %><ul class="post-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="entry"><h2><a class="post-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><section class="post-excerpt"><p><%= archive.excerpt(280) %></p></section><section class="post-meta"><div class="post-date"><%= archive.date('YYYY-MM-DD') %></div></section><hr></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>