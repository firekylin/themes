{
  "name": "gokarna",
  "title": "Gokarna",
  "version": "0.1.0",
  "private": true,
  "description": "Gokarna profile and reading blog with persistent dark mode.",
  "license": "GPL-3.0-only",
  "author": "Gokarna contributors; Firekylin contributors",
  "homepage": "https://github.com/gokarna-theme/gokarna-hugo",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/gokarna"
  },
  "firekylin": {
    "type": "theme",
    "id": "gokarna"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatar",
      "label": "头像地址"
    }
  ]
}
