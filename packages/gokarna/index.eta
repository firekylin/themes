<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const avatar=String(site.themeConfig.avatar||'');const valid=/^(https?:\/\/|\/(?!\/))/.test(avatar); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="home-about"><% if(valid){ %><div class="avatar"><img class="size-m" src="<%= avatar %>" alt="<%= site.title() %>"></div><% } %><h1><%= site.title() %></h1><h2><%= site.description() %></h2></section><% }else{ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>