<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><link id="dark-style" rel="stylesheet" media="(prefers-color-scheme:dark)" href="<%= site.themeUrl('res/css/dark.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><nav class="header-nav" aria-label="主导航"><div class="nav-title"><a class="nav-brand" href="/"><%= site.title() %></a></div><div class="nav-links nav-items"><div class="nav-link"><a href="/archives">归档</a></div><div class="nav-link"><a href="/categories">分类</a></div><div class="nav-link"><a href="/tags">标签</a></div><div class="nav-link"><a href="/search.html">搜索</a></div><% site.navigation.forEach(n=>{ %><div class="nav-link"><a href="<%= n.url %>"><%= n.label %></a></div><% }); %><button class="mode-toggle" type="button" aria-pressed="false" hidden>深色模式</button></div></nav></header><main id="main"><%~ block('content') %></main><footer class="footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/gokarna-theme/gokarna-hugo">Gokarna</a></footer></body></html>