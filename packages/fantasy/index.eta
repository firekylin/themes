<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||'' %> <%= site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1 class="directory"><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><% if(!archive.have()){ %><p class="directory">暂无文章。</p><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>