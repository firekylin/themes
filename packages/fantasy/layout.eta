<% const site=await firekylin.widget('Widget_Options');const cats=await firekylin.widget('Widget_Metas_Category_List');const logo=String(site.themeConfig.logoUrl||''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/native.css') %>"></head><body><a class="skip-link" href="#main">跳转到正文</a><div class="wrapper"><header><a class="logo" href="/" aria-label="首页"><% if(/^(https?:\/\/|\/(?!\/))/.test(logo)){ %><img src="<%= logo %>" alt=""><% }else{ %><span class="logo-letter"><%= site.title().slice(0,1) %></span><% } %></a><div class="description"><h1><%= site.title() %></h1><h2><%= site.description() %></h2><nav aria-label="主导航"><ul><li><a href="/">首页</a></li><% site.navigation.forEach(nav=>{ %><li><a href="<%= nav.url %>"><%= nav.label %></a></li><% }) %><li><a href="/archives">归档</a></li><li><a href="/rss.html">订阅</a></li><li><a id="search-open" href="/search.html">搜索</a></li></ul></nav></div></header><main id="main"><%~ block('content') %></main></div><aside><div class="aside-left sidebar"><h3>浏览</h3><ul><li><a href="/archives">文章归档</a></li><li><a href="/tags">标签</a></li></ul></div><div class="aside-right sidebar"><h3>分门别类</h3><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.row.name %> <span><%= cats.row.count %> 篇</span></a></li><% } %></ul></div></aside><footer><span>© <%= new Date().getFullYear() %> <%= site.title() %></span><span> ♥ <a href="https://github.com/PCDotFan/Aragaki">Aragaki</a> by PCDotFan · <a href="https://github.com/Seevil/fantasy">Fantasy</a> by Xingr</span><div class="powered_by">Proudly published with <a href="https://github.com/firekylin/firekylin">Firekylin</a></div></footer><dialog id="search-dialog"><form action="/search.html" method="get" role="search"><label for="quick-search">搜索文章</label><input id="quick-search" name="keyword" type="search" required placeholder="输入关键字回车搜索"><button type="submit">搜索</button><button type="button" id="search-close">关闭</button></form></dialog><script defer src="<%= site.themeUrl('res/js/fantasy.js') %>"></script></body></html>
