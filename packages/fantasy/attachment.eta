<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' - ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article class="content"><h1><%= archive.title() %></h1><div class="meta"><span class="item"><time><%= archive.date('YYYY.MM.DD') %></time></span><% (archive.row.cate||[]).forEach(cat=>{ %><span class="item"><a href="/cate/<%= encodeURIComponent(cat.pathname) %>"><%= cat.name %></a></span><% }); %></div><div class="post"><%~ archive.content() %></div><p><% (archive.row.tag||[]).forEach(tag=>{ %><a href="/tag/<%= encodeURIComponent(tag.pathname) %>">#<%= tag.name %></a> <% }); %></p></article><% const comments=firekylin.comment({title:'评论'});if(comments){ %><section class="directory fantasy-comments"><%~ comments %></section><% } %><% }else{ %><p class="directory">暂无内容。</p><% } %><% }) %>