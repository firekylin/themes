<% const archive=firekylin.archive; %><section class="article-list"><% while(archive.next()){ %><article><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><p><%= archive.excerpt(200,true) %></p></div><div class="meta"><span class="item"><time><%= archive.date('YYYY.MM.DD') %></time></span><span class="item"><a href="<%= archive.permalink %>#comments"><%= Number(archive.row.comment_num)||0 %> 评</a></span></div></article><% } %></section>