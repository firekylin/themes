<% const archive=firekylin.archive;const site=firekylin.site;let count=0; %><section class="gh-section"><h2 class="gh-section-title"><span>最新文章</span></h2><div class="gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><header class="gh-card-header"><h2 class="gh-card-title"><%= archive.title() %></h2></header><div class="gh-card-excerpt"><%= archive.excerpt(220) %></div><footer class="gh-card-footer"><time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></footer></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div></section>