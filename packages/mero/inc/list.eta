<% const archive=firekylin.archive;let count=0; %><div class="post-list"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row; %><article class="entry"><details class="metadata-native"><summary><time><%= archive.date('YYYY-MM-DD') %></time><span class="more" aria-label="文章信息">＋</span></summary><div class="metadata-content"><span><%= archive.author('display_name') %></span><% (meta.cate||[]).forEach(c=>{ %><a href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a><% }); %><% (meta.tag||[]).forEach(t=>{ %><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>">#<%= t.name %></a><% }); %></div></details><h2 class="post-item-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(240) %></p></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>