<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate,tag').select();related.forEach(p=>metaByPost.set(p.id,p));}const home=archive.is('index')&&!archive.is('tag')&&!archive.is('cate')&&!archive.is('author')&&(archive.pagination?.currentPage||1)===1;const cfg=site.themeConfig;const portrait=String(cfg.portraitURL||'');const safePortrait=/^(https?:\/\/|\/(?!\/))/i.test(portrait); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(home){ %><div class="mero-home <%= safePortrait?'':'no-portrait' %>"><% if(safePortrait){ %><div class="portrait-column"><img src="<%= portrait %>" alt=""></div><% } %><div class="home-content"><section class="mero-panel"><h2 class="panel-label">关于</h2><h1 class="profile-title"><%= cfg.profileName||site.title() %></h1><p class="profile-intro"><%= cfg.introduction||site.description() %></p></section><section class="mero-panel"><h2 class="panel-label recent-label">最近文章</h2><%~ include('./inc/list',{archive,metaByPost}) %></section></div></div><% }else{ %><h1 class="listing-heading"><%= archive.archiveTitle||'文章' %></h1><%~ include('./inc/list',{archive,metaByPost}) %><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>