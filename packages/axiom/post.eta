<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||'');const avatar=String(site.themeConfig.authorAvatarURL||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article class="post-detail"><% if(found){ %><div class="ax-title ax-l-o"><div class="ax-l-i max-w-680"><h1 class="article-title"><%= archive.title() %></h1><div class="author-row"><% if(/^(https?:\/\/|\/(?!\/))/i.test(avatar)){ %><img class="author-avatar" src="<%= avatar %>" alt=""><% } %><div class="author-text"><p><%= archive.author('display_name') %></p><time class="author-date"><%= archive.date('YYYY-MM-DD') %></time></div></div></div></div><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="ax-feature ax-l-o"><div class="ax-l-i max-w-5xl"><img class="post-cover" src="<%= cover %>" alt=""></div></div><% } %><div class="ax-content ax-l-o"><div class="ax-l-i max-w-680"><details id="article-toc" class="toc" hidden><summary>目录</summary></details><div class="prose cdata" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a><% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %></div></div><% }else{ %><div class="ax-content ax-l-o"><div class="ax-l-i max-w-680"><p>暂无内容。</p></div></div><% } %></article><% }) %>