<% const archive=firekylin.archive;let count=0; %><div class="summary-list"><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry summary sm:flex"><% if(/^(https?:\/\/|\/(?!\/))/i.test(cover)){ %><div class="summary-image sm:flex-shrink-0 mb-4 sm:mb-0 sm:mr-10"><a href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= cover %>" alt="" loading="lazy"></a></div><% } %><div class="summary-content font-content-sans"><h2><a class="summary-title" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><a class="summary-excerpt" href="<%= archive.permalink %>"><%= archive.excerpt(175) %></a><p class="summary-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>