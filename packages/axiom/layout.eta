<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/toc.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="header"><div class="ax-l-i max-w-6xl"><div class="ax-logo"><a href="/"><% const logo=String(cfg.logoURL||'');if(/^(https?:\/\/|\/(?!\/))/i.test(logo)){ %><img src="<%= logo %>" alt="<%= site.title() %>"><% }else{ %><%= site.title() %><% } %></a></div><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main"><%~ block('content') %></main><footer class="footer"><div class="ax-l-i max-w-6xl"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %></p><p>Firekylin · <a href="https://github.com/marketempower/axiom">Axiom</a> · Jhaura Wachsman</p><p class="license-note">Adapted for Firekylin · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></p></div></footer></body></html>