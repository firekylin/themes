<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate,tag').select();related.forEach(p=>metaByPost.set(p.id,p));} %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="container"><div class="c-page-heading"><h1 class="c-page-heading__title"><%= archive.archiveTitle||site.title() %></h1><p class="c-page-heading__description"><%= archive.archiveTitle?'':site.description() %></p></div><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>