    "directory": "packages/zola-vonge"
  },
  "firekylin": {
    "type": "theme",
    "id": "zola-vonge"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
