  "private": true,
  "description": "Vonge’s original blue-white blog cards, overlapping content panels, gradient tags, Inter typography and split article cover.",
  "license": "MIT",
  "author": "Pascal Berrang and CloudCannon; Firekylin contributors",
  "homepage": "https://github.com/paberr/vonge-zola-theme",
  "repository": {
    "type": "git",
