<% const archive=firekylin.archive;let count=0; %><div class="row post-grid"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row;const image=String(archive.row.options?.featuredImage||'');const hasImage=/^(https?:\/\/|\/(?!\/))/i.test(image); %><article class="entry c-blog-card col col-4 col-d-6 col-t-12"><div class="c-blog-card__inner <%= hasImage?'':'no-cover' %>"><% if(hasImage){ %><div class="c-blog-card__image-wrap"><a class="c-blog-card__image" href="<%= archive.permalink %>" aria-label="<%= archive.title() %>"><img src="<%= image %>" alt="" loading="lazy"></a></div><% } %><div class="c-blog-card__content"><div class="c-blog-card__tags-box"><% (meta.tag||[]).forEach(t=>{ %><a class="c-blog-card__tag" href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>"><%= t.name %></a><% }); %></div><h2 class="c-blog-card__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="c-blog-card__excerpt"><%= archive.excerpt(260) %></p><div class="c-blog-card__meta"><div class="c-blog-card__info"><span class="c-blog-card__author-name"><%= archive.author('display_name') %></span><time class="c-blog-card__date"><%= archive.date('YYYY-MM-DD') %></time></div></div></div></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>