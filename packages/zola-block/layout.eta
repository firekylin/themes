<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN" data-flavor="<%= ['citric','lactic'].includes(cfg.flavor)?cfg.flavor:'auto' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/block.js') %>" defer></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="grain" aria-hidden="true"></div><div class="shell"><nav class="nav native-nav nav-items" aria-label="主导航"><div class="island pill"><ul><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></div></nav><main id="main" class="stack"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/ssiyad/block">Block</a></p></footer></div></body></html>