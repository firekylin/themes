<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><section class="island intro"><div class="intro-body"><p class="kicker"><%= site.description() %></p><h1 class="intro-title"><span class="mark mark-underline"><%= site.title() %><svg aria-hidden="true" viewBox="0 0 200 14" preserveAspectRatio="none"><path pathLength="1" stroke-width="2.4" d="M2 9 C 40 3, 90 12, 130 6 S 185 4, 198 8"/></svg></span></h1></div></section><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>