<% const archive=firekylin.archive;let count=0; %><section class="island posts"><div class="posts-head"><h2>文章</h2><a href="/archives">所有文章</a></div><ol class="native-list"><% while(archive.next()){count++; %><li class="entry"><a class="row numbered" href="<%= archive.permalink %>"><span class="row-num"><%= String(count).padStart(2,'0') %></span><span><span class="row-title"><%= archive.title() %></span><span class="row-excerpt"><span><%= archive.excerpt(200) %></span></span></span><time class="meta"><%= archive.date('YYYY-MM-DD') %></time></a></li><% } %></ol><% if(!count){ %><p>暂无文章。</p><% } %></section>