<% const archive=firekylin.archive;let count=0; %><div class="post-list"><% while(archive.next()){count++; %><article class="entry post-container"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(280) %></p><div class="read-more"><a href="<%= archive.permalink %>">继续阅读 →</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>