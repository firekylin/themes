<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><aside class="profile-sidebar" aria-label="博客简介"><% const profile=String(cfg.profileImage||'');const background=String(cfg.backgroundImage||'');if(/^(https?:\/\/|\/(?!\/))/i.test(background)){ %><img class="sidebar-background" src="<%= background %>" alt=""><% } %><div class="intro"><% if(/^(https?:\/\/|\/(?!\/))/i.test(profile)){ %><div class="logo-container"><a href="/"><img class="rounded-logo" src="<%= profile %>" alt="<%= cfg.authorName||site.title() %>"></a></div><% } %><h2><a href="/"><%= cfg.authorName||site.title() %></a></h2><h3><%= site.description() %></h3><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></aside><div class="content-wrapper"><div class="breadcrumb"><a href="/">首页</a> / <a href="/archives">文章</a></div><main id="main"><%~ block('content') %></main></div><footer class="site-footer"><div class="footer-wrapper"><p><%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/bjacquemet/personal-web">Personal Web</a> by Baptiste Jacquemet</p></div></footer></body></html>