<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><aside id="bio-panel" class="off-canvas" hidden><button id="bio-close" type="button">关闭介绍</button><div class="bio"><h2><%= cfg.authorName||site.title() %></h2><p><%= site.description() %></p></div></aside><div class="site-wrapper"><header><div class="h-wrap"><h1 class="title"><a href="/"><%= site.title() %></a></h1><button id="bio-open" type="button" aria-controls="bio-panel" aria-expanded="false" hidden>作者介绍</button><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/waynee95/zola-theme-hikari">Hikari</a></p></footer></div><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>