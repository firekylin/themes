<% const archive=firekylin.archive;let count=0; %><div id="home"><ul class="posts"><% while(archive.next()){count++; %><li class="entry"><a href="<%= archive.permalink %>"><div class="p-wrap"><article class="inner"><time><%= archive.date('YYYY-MM-DD') %></time><p><%= archive.title() %></p></article></div></a></li><% } %></ul></div><% if(!count){ %><p>暂无文章。</p><% } %>