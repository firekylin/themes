<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="content"><header class="header"><h1 class="header-title"><a href="/"><%= site.title() %></a></h1><nav class="header-menu nav-items" aria-label="主导航"><p><a href="/archives">/归档</a></p><p><a href="/categories">/分类</a></p><p><a href="/tags">/标签</a></p><p><a href="/search.html">/搜索</a></p><% site.navigation.forEach(n=>{ %><p><a href="<%= n.url %>">/<%= n.label %></a></p><% }); %></nav><button class="mode-toggle" type="button" aria-pressed="false" hidden>深色模式</button></header><main class="main" id="main"><%~ block('content') %></main></div><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/tomfran/typo">Typo</a> by Francesco Tomaselli</footer></body></html>