<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><div class="intro"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><p><%= site.description() %></p></div><div class="list-container"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div><% }) %>