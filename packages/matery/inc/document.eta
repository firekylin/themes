<% const site=await firekylin.widget('Widget_Options'),cfg=site.themeConfig||{},type=firekylin.pageType,detail=['post','page','attachment'].includes(type),archive=await firekylin.widget('Widget_Archive',{type});const safe=v=>typeof v==='string'&&/^(https?:\/\/|\/(?!\/)|#)/i.test(v)?v:'#';const parse=v=>{try{const a=JSON.parse(v||'[]');return Array.isArray(a)?a.filter(x=>x&&typeof x==='object').slice(0,20):[];}catch{return [];}};const slides=parse(cfg.slides),home=type==='index'&&!archive.archiveTitle;let active=detail?archive.next():false;const cover=safe((active&&archive.row.featuredImage)||cfg.coverUrl); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.title() %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS"><% for(const css of ['materialize.min','matery','post','dark','firekylin']){ %><link rel="stylesheet" href="<%= site.themeUrl('res/css/'+css+'.css') %>"><% } %><script src="<%= site.themeUrl('res/js/matery.js') %>" defer></script></head><body><a class="skip-link" href="#main">Skip to content</a><header class="navbar-fixed"><nav id="headNav" class="bg-color nav-transparent"><div id="navContainer" class="nav-wrapper container"><a class="brand-logo" href="/"><span class="logo-span"><%= site.title() %></span></a><button id="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" hidden>☰</button><ul class="right hide-on-med-and-down"><% for(const n of site.navigation||[]){ %><li><a href="<%= safe(n.url) %>"><%= n.label %></a></li><% } %><li><a href="/search.html">Search</a></li><li><button class="appearance-toggle" type="button" aria-label="Switch appearance" hidden>◐</button></li></ul></div></nav></header><nav id="mobile-nav" aria-label="Mobile navigation"><% for(const n of site.navigation||[]){ %><a href="<%= safe(n.url) %>"><%= n.label %></a><% } %><a href="/search.html">Search</a><button class="appearance-toggle" type="button" hidden>Switch appearance</button></nav>
<div class="<%= home?'carousel carousel-slider center index-cover':'bg-cover pd-header '+(detail?'post-cover':'about-cover') %>" id="cover"><% if(cover!=='#'){ %><img class="cover-image" src="<%= cover %>" alt=""><% } %><div class="<%= home?'carousel-item white-text bg-cover about-cover is-current':'cover-content' %>" data-slide="0"><div class="container"><div class="row"><div class="col s12"><div class="brand"><% if(detail){ %><h1 class="description center-align post-title"><%= active?archive.title():'Article' %></h1><% }else{ %><div class="title center-align"><%= cfg.slogan||site.title() %></div><div class="description center-align"><%= site.description() %></div><% } %></div></div></div><% if(home){ %><div class="cover-btns"><a class="btn" href="#articles">Start reading</a><% if(safe(cfg.buttonUrl)!=='#'){ %><a class="btn" href="<%= safe(cfg.buttonUrl) %>"><%= cfg.buttonLabel||'More' %></a><% } %></div><% } %></div></div><% if(home){for(const [i,s] of slides.entries()){ %><section class="carousel-item white-text bg-cover carousel-post" data-slide="<%= i+1 %>" hidden><% if(safe(s.image)!=='#'){ %><img class="cover-image" src="<%= safe(s.image) %>" alt=""><% } %><div class="container"><div class="title center-align"><%= s.title||'' %></div><div class="description center-align"><%= s.description||'' %></div><div class="cover-btns"><a class="btn" href="<%= safe(s.url) %>">Read more</a></div></div></section><% }if(slides.length){ %><button id="prev-cover" class="carousel-control" aria-label="Previous slide" hidden>‹</button><button id="next-cover" class="carousel-control" aria-label="Next slide" hidden>›</button><% }} %></div>
<main id="main" class="<%= detail?'container content':'content' %>"><% if(detail){ %><div id="artDetail"><div class="card"><div class="card-content article-info"><div class="row tag-cate"><% for(const t of archive.row?.tag||[]){ %><a class="chip bg-color" href="/tag/<%= t.pathname %>"><%= t.name %></a><% } %><% for(const c of archive.row?.cate||[]){ %><a class="post-category" href="/cate/<%= c.pathname %>"><%= c.name %></a><% } %></div><div class="post-info"><div class="post-date">Published: <%= active?archive.date('Y-m-d'):'' %></div><% if(cfg.showUpdated==='true'&&archive.row?.update_time){ %><div class="post-date">Updated: <%= String(archive.row.update_time).slice(0,10) %></div><% } %></div></div><hr><div class="card-content article-card-content"><% if(cfg.showToc!=='false'){ %><details id="toc"><summary>Contents</summary><nav aria-label="Table of contents"></nav></details><% } %><div id="articleContent"><%~ active?archive.content():'' %></div><div class="adjacent-posts"><% for(const key of ['prev','next']){const n=archive.row?.[key];if(n?.pathname){ %><a rel="<%= key %>" href="<%= archive.permalinkFor(n) %>"><%= n.title %></a><% }} %></div><%~ active?firekylin.comment({title:'Comments',className:'article-comments'}):'' %></div></div></div>
<% }else if(type==='archive'||type==='cate'||type==='tag'){ %><section class="container"><div class="card"><div class="card-content"><h1><%= type==='archive'?'Archives':type==='cate'?'Categories':'Tags' %></h1><% if(type==='archive'){for(const [m,rows] of Object.entries(archive.grouped||{})){ %><h2><%= m %></h2><ul><% for(const r of rows){ %><li><time><%= String(r.create_time).slice(0,10) %></time> <a href="<%= archive.permalinkFor(r) %>"><%= r.title %></a></li><% } %></ul><% }}else{const metas=await firekylin.widget(type==='cate'?'Widget_Metas_Category_List':'Widget_Metas_Tag_Cloud');while(metas.next()){ %><a class="chip" href="<%= metas.permalink %>"><%= metas.title() %></a><% }} %></div></div></section>
<% }else{ %><% if(home&&cfg.dreamText){ %><div id="indexCard" class="index-card"><div class="container"><div class="card"><div class="card-content center-align"><h2><%= cfg.dreamTitle||'My dream' %></h2><p><%= cfg.dreamText %></p></div></div></div></div><% } %><% if(type==='search'){ %><div class="container card"><form class="card-content" method="get" action="/search.html"><label for="keyword">Search articles</label><input id="keyword" name="keyword" value="<%= archive.keyword||'' %>"><button class="btn">Search</button></form></div><% } %><article id="articles" class="container articles"><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><div class="row article-row"><% let count=0;while(archive.next()){count++;const img=safe(archive.row?.featuredImage||cfg.defaultThumbnail||cfg.coverUrl); %><div class="article col s12 m6 l4"><div class="card"><a href="<%= archive.permalink %>"><div class="card-image"><% if(img!=='#'){ %><img src="<%= img %>" alt="" class="responsive-img" loading="lazy"><% } %><span class="card-title"><%= archive.title() %></span></div></a><div class="card-content article-content"><div class="summary block-with-text"><%= archive.excerpt(120) %></div><div class="publish-info"><span class="publish-date"><%= archive.date('Y-m-d') %></span><span class="publish-author"><%= archive.author() %></span></div></div><% if(archive.row?.tag?.length){ %><div class="card-action article-tags"><% for(const t of archive.row.tag){ %><a class="chip bg-color" href="/tag/<%= t.pathname %>"><%= t.name %></a><% } %></div><% } %></div></div><% }if(!count){ %><p>No articles found.</p><% } %></div></article><% if(archive.pagination){const p=archive.pagination; %><nav class="container paging center-align" aria-label="Pagination"><% if(p.currentPage>1){ %><a rel="prev" href="<%= archive.pageUrl(p.currentPage-1) %>">Previous</a><% } %><span><%= p.currentPage %> / <%= p.totalPages %></span><% if(p.currentPage<p.totalPages){ %><a rel="next" href="<%= archive.pageUrl(p.currentPage+1) %>">Next</a><% } %></nav><% }} %></main>
<footer class="page-footer bg-color"><div class="container center-align">© <%= new Date().getFullYear() %> <%= cfg.footerText||site.title() %><br><a href="https://github.com/blinkfox/hexo-theme-matery">Matery</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="/rss.html">RSS</a></div></footer><a id="backTop" class="btn" href="#" aria-label="Back to top">↑</a></body></html>
