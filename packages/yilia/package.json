{
  "name": "yilia",
  "title": "Yilia",
  "version": "0.1.0",
  "private": true,
  "description": "Yilia fixed profile sidebar and white article cards.",
  "license": "ISC",
  "author": "litten; Firekylin contributors",
  "homepage": "https://github.com/litten/hexo-theme-yilia",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/yilia"
  },
  "firekylin": {
    "type": "theme",
    "id": "yilia"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "profileName",
      "label": "侧栏名称",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "profileBio",
      "label": "侧栏介绍",
      "help": "留空使用站点描述。"
    },
    {
      "type": "text",
      "name": "avatarUrl",
      "label": "头像图片",
      "help": "可选站内路径或 HTTPS 图片。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚文字",
      "help": "纯文本，可留空。"
    },
    {
      "type": "text",
      "name": "aboutText",
      "label": "关于我",
      "help": "工具面板中的纯文本介绍。"
    }
  ]
}
