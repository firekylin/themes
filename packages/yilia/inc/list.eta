<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry article"><header class="article-header"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><time><%= archive.date('YYYY-MM-DD') %></time></header><div class="excerpt"><%~ archive.excerpt(350) %></div><footer class="article-info"><a href="<%= archive.permalink %>">展开全文 &gt;&gt;</a></footer></article><% }if(!count){ %><p>暂无文章。</p><% } %>