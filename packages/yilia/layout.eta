<% const site=await firekylin.widget('Widget_Options');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:30});const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');const avatar=String(site.themeConfig.avatarUrl||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body id="top"><a class="skip" href="#main">跳转到正文</a><aside class="left-col"><div class="overlay"></div><header class="profile"><a class="profilepic" href="/" aria-label="首页"><% if(/^(https?:\/\/|\/(?!\/))/.test(avatar)){ %><img src="<%= avatar %>" alt=""><% } %></a><h1><a href="/"><%= site.themeConfig.profileName||site.title() %></a></h1><p class="subtitle"><%= site.themeConfig.profileBio||site.description() %></p><nav class="header-menu" aria-label="主导航"><a href="/">主页</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/categories">分类</a><a href="/tags">标签</a></nav><nav class="smart-menu" aria-label="工具导航"><a href="#tools-all">所有文章</a> / <a href="#tools-about">关于我</a></nav><a class="rss" href="/rss.html">RSS</a></header></aside><aside class="tools" id="tools-all"><a class="close" href="#main">关闭 ×</a><form action="/search.html" method="get"><label for="tools-search">搜索文章</label><input name="keyword" id="tools-search" required placeholder="find something…"><button>搜索</button></form><details><summary>标签</summary><div class="tag-cloud"><% tags.stack.forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div></details><h2>最近文章</h2><ul><% while(recent.next()){ %><li><a href="<%= recent.permalink %>"><%= recent.title() %></a><time><%= recent.date('YYYY-MM-DD') %></time></li><% } %></ul><a href="/archives">查看全部归档 →</a></aside><aside class="tools" id="tools-about"><a class="close" href="#main">关闭 ×</a><p class="about-text"><%= site.themeConfig.aboutText||site.description() %></p></aside><div class="mid-col"><main id="main"><%~ block('content') %></main><footer class="site-footer"><span><%= site.themeConfig.footerText||site.title() %></span><span><a href="https://github.com/litten/hexo-theme-yilia">Yilia</a> · Firekylin</span></footer></div><a class="back-top" href="#top" aria-label="返回顶部">↑</a></body></html>