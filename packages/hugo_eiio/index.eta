<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const categories=await firekylin.widget('Widget_Metas_Category_List'); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle){ %><section class="panel panel-default intro"><div class="panel-body"><p class="text-primary"><%= site.description() %></p><div class="home-categories"><% while(categories.next()){ %><a class="btn btn-default btn-xs" href="/cate/<%= categories.row.pathname %>"><%= categories.row.name %></a><% } %></div></div></section><% } %><section class="panel panel-default"><div class="panel-heading"><h1><%= archive.archiveTitle||'文章' %></h1></div><div class="panel-body"><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %></div></section><% }) %>