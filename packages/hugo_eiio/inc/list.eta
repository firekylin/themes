<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||'');const valid=/^(https?:\/\/|\/(?!\/))/i.test(cover); %><article class="home-post entry"><% if(valid){ %><div class="cover-column"><a href="<%= archive.permalink %>"><div class="cover"><img class="image-container" src="<%= cover %>" alt="" loading="lazy"></div></a></div><% } %><div class="text-column <%= valid?'':'full' %>"><h2><a class="title_a" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><time class="badge"><%= archive.date('YYYY-MM-DD') %></time></p><p class="entry-excerpt"><%= archive.excerpt(240) %></p><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a class="btn btn-default btn-xs" href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div></div></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>