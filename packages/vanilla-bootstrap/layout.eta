<% const site = await firekylin.widget('Widget_Options'); const cfg = site.themeConfig || {}; const used = new Set(['/', '/archives', '/categories', '/tags', '/search.html']); %>
<!doctype html>
<html lang="zh-CN" class="h-100">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light"><title><%~ block('title') %></title>
  <meta name="description" content="<%= site.description() %>">
  <link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>">
</head>
<body class="d-flex flex-column h-100">
<a class="skip" href="#main">跳转到正文</a>
<header id="nav-border" class="container">
  <nav id="nav" class="nav justify-content-center native-nav nav-items" aria-label="主导航">
    <a class="nav-link" href="/"><%~ include('./inc/icon', {name:'home'}) %> 首页</a>
    <a class="nav-link" href="/archives"><%~ include('./inc/icon', {name:'file-text'}) %> 归档</a>
    <a class="nav-link" href="/categories"><%~ include('./inc/icon', {name:'folder'}) %> 分类</a>
    <a class="nav-link" href="/tags"><%~ include('./inc/icon', {name:'tag'}) %> 标签</a>
    <a class="nav-link" href="/search.html"><%~ include('./inc/icon', {name:'search'}) %> 搜索</a>
    <% site.navigation.forEach(n => { if (!used.has(n.url)) { used.add(n.url); %><a class="nav-link" href="<%= n.url %>"><%= n.label %></a><% } }); %>
  </nav>
</header>
<div class="container"><main id="main"><%~ block('content') %></main></div>
<footer id="footer" class="mt-auto text-center text-muted"><div class="container">
  <p><%= cfg.footerText || site.description() %></p>
  <p>Powered by <a href="https://firekylin.org">Firekylin</a> · <a href="https://github.com/zwbetz-gh/vanilla-bootstrap-hugo-theme">Vanilla Bootstrap</a> by Zachary Betz</p>
</div></footer>
</body></html>
