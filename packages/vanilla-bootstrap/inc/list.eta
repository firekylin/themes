<% const archive = firekylin.archive; let count = 0; %>
<% while (archive.next()) { count++; %>
<article class="entry"><h2 class="entry-title font-125"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2>
<%~ include('./meta', {archive}) %></article>
<% } %><% if (!count) { %><p>暂无文章。</p><% } %>
