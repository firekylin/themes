<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><%~ include('./inc/list',{archive}) %><% }else{ %><section class="intro"><h1><%= site.title() %></h1><p><%= site.description() %></p></section><h2>最新文章</h2><ul class="recent-posts"><% while(archive.next()){ %><li class="entry"><article><time><%= archive.date('YYYY-MM-DD') %></time><a href="<%= archive.permalink %>"><%= archive.title() %></a></article></li><% } %></ul><% } %><%~ include('./inc/pagination',{archive}) %><% }) %>