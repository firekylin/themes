<% const archive=firekylin.archive;let count=0; %><ul class="blog"><% while(archive.next()){count++; %><li><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p>published: <time><%= archive.date('YYYY-MM-DD') %></time></p><p><%= archive.excerpt(300) %></p></article></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %>