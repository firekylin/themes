<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><% const palette=['tokyonight','tokyostorm','tokyomoon','tokyoday'].includes(cfg.palette)?cfg.palette:'tokyonight'; %><body class="theme-<%= palette %>"><a class="skip" href="#main">跳转到正文</a><header class="site-header"><nav class="native-nav nav-items" aria-label="主导航"><a href="/">/home/</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><hr><main id="main"><%~ block('content') %></main><hr><footer class="site-footer"><p><%= cfg.footerText||site.description() %></p><p class="footer-author"><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/mxaddict/zolanight">ZolaNight</a></p></footer></body></html>