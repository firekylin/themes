<% const site=await firekylin.widget('Widget_Options'); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= site.description() %>"><title><%~ block('title') %></title><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳至内容</a><header class="floating-header"><div class="header-inner"><a class="brand" href="/"><%= site.title() %></a><div class="header-controls"><details class="site-menu" open><summary>Menu</summary><nav aria-label="主导航"><a href="/archives">Posts</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></details><button id="appearance" aria-label="切换深色模式" aria-pressed="false" hidden>◐</button></div></div></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><div>© <%= new Date().getFullYear() %> <%= site.title() %></div><div>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> &amp; <a href="https://github.com/nunocoracao/blowfish">Blowfish</a> · <a href="/rss.html">RSS</a> · <a href="#main">↑</a></div></footer></body></html>