<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'page'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><% if(found){ %><article><header class="post-header"><h1><%= archive.title() %></h1><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></header><section class="reading"><div class="prose" id="post-content"><%~ archive.content() %></div><nav id="blowfish-toc" aria-label="文章目录" hidden><h2>On this page</h2></nav></section><footer class="post-footer"><div class="author"><strong><%= archive.author('display_name') %></strong></div><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %></footer></article><% }else{ %><p>暂无内容。</p><% } %><% }) %>