<% const archive=firekylin.archive;let count=0; %><div class="card-grid"><% while(archive.next()){count++;const cover=String((archive.row.options||{}).featuredImage||''); %><article class="card"><a href="<%= archive.permalink %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img src="<%= cover %>" alt="" loading="lazy"><% } %><div class="card-body"><h3><%= archive.title() %></h3><div class="meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="summary"><%~ archive.excerpt(140) %></div></div></a></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>