<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const cfg=site.themeConfig;const safe=u=>/^(https?:\/\/|\/(?!\/))/.test(String(u||'')); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><% if(!archive.archiveTitle&&(!archive.pagination||archive.pagination.currentPage===1)){ %><section class="landing"><% if(safe(cfg.heroImage)){ %><div class="hero-background"><img src="<%= cfg.heroImage %>" alt="" fetchpriority="high"></div><% } %><div class="hero-copy"><% if(cfg.heroCaption){ %><p class="caption"><%= cfg.heroCaption %></p><% } %><h1><%= cfg.heroTitle||site.title() %></h1><p class="lead"><%= cfg.heroLead||site.description() %></p><div class="cta"><a class="primary" href="<%= safe(cfg.buttonUrl)?cfg.buttonUrl:'/archives' %>"><%= cfg.buttonLabel||'Explore posts' %> ↗</a><a href="/categories">Categories ↗</a></div></div></section><h2>Recent</h2><% }else{ %><h1><%= archive.archiveTitle||'Posts' %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>