<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="c-article p-list-article entry"><h2 class="c-article__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="c-article__meta"><time><%= archive.date('YYYY-MM-DD') %></time></p><div class="c-article__summary"><p><%= archive.excerpt(280) %></p></div><a class="c-article__btn p-list-article__btn" href="<%= archive.permalink %>">继续阅读</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>