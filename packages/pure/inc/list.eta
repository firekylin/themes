<% const archive=firekylin.archive;let count=0; %><div class="content article-list"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="article article-type-post entry"><div class="article-header"><h2 class="article-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></div><div class="article-entry text-muted"><p><%= archive.excerpt(260) %></p></div><p class="article-meta"><time><%= archive.date('YYYY-MM-DD') %></time></p></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>