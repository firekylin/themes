<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post post--preview entry"><header><h2 class="post__title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><footer class="post__meta"><time><%= archive.date('YYYY-MM-DD') %></time></footer><section class="post__excerpt"><p><%= archive.excerpt(350) %></p><p class="readmore"><a href="<%= archive.permalink %>">继续阅读…</a></p></section></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>