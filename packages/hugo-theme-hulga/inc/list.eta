<% const archive=firekylin.archive;let count=0; %><div class="post-lists"><% while(archive.next()){count++;const meta=firekylin.metaByPost?.get(archive.row.id)||archive.row; %><article class="entry box post-box"><h2 class="post-box-title"><a class="title is-5" href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p><%= archive.excerpt(280) %></p><div class="post-box-tags"><% (meta.tag||[]).forEach(t=>{ %><span class="post-box-tag"><a href="/tag/<%= encodeURIComponent(t.pathname||t.name) %>">#<%= t.name %></a></span><% }); %></div><div class="post-box-meta"><div class="post-box-time"><time><%= archive.date('YYYY/MM/DD') %></time><% (meta.cate||[]).forEach(c=>{ %> · <a href="/cate/<%= encodeURIComponent(c.pathname||c.name) %>"><%= c.name %></a><% }); %></div><a href="<%= archive.permalink %>">阅读更多</a></div></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>