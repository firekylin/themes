<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'post'});const found=archive.next();const cover=String(archive.row?.options?.featuredImage||''); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('hero',()=>{ %><% if(found){ %><h1 class="title post-title"><%= archive.title() %></h1><p class="subtitle post-hero-meta"><%= archive.date('YYYY/MM/DD') %> · <%= archive.author('display_name') %></p><% }else{ %><h1 class="title">暂无内容</h1><% } %><% }) %><% block('content',()=>{ %><section class="section"><div class="container article-grid"><article class="post-detail"><% if(found){ %><div class="prose post-content" id="post-content"><%~ archive.content() %></div><footer class="post-footer"><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><div class="post-actions"><a href="/archives">所有文章</a><a href="#main">↑ 返回顶部</a></div></footer><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><details id="TableOfContents" class="article-toc" hidden open><summary>目录</summary></details></div></section><% }) %>