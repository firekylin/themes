<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'});const metaByPost=new Map();const ids=archive.stack.map(p=>p.id).filter(Boolean);if(ids.length&&typeof archive.model==='function'){const related=await archive.model('post').where({id:['IN',ids]}).field('id').setRelation('cate,tag').select();related.forEach(p=>metaByPost.set(p.id,p));};const categories=await firekylin.widget('Widget_Metas_Category_List');const tags=await firekylin.widget('Widget_Metas_Tag_Cloud'); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('hero',()=>{ %><h1 class="title"><%= archive.archiveTitle||site.title() %></h1><p class="subtitle"><%= archive.archiveTitle?'':site.description() %></p><% }) %><% block('content',()=>{ %><section class="section"><div class="container native-columns"><div><%~ include('./inc/list',{archive,metaByPost}) %><%~ include('./inc/pagination',{archive}) %></div><aside class="taxonomy-sidebar"><section class="card"><header class="card-header"><h2 class="card-header-title">分类</h2></header><div class="card-content"><% while(categories.next()){ %><div class="sidebar-meta"><a href="<%= categories.permalink %>"><%= categories.row.name %></a><span class="tag"><%= categories.row.count %></span></div><% } %></div></section><section class="card"><header class="card-header"><h2 class="card-header-title">标签</h2></header><div class="card-content sidebar-tags"><% while(tags.next()){ %><a class="tag" href="<%= tags.permalink %>"><%= tags.row.name %> · <%= tags.row.count %></a><% } %></div></section></aside></div></section><% }) %>