<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/bootstrap.min.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><div id="nav-border" class="container"><nav id="nav" class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div><div class="container"><header id="home-jumbotron" class="jumbotron text-center"><h1 class="title"><a href="/"><%= site.title() %></a></h1><p class="font-125"><%= site.description() %></p></header><main id="main"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/plopcas/papaya">Papaya</a></p></footer></div></body></html>