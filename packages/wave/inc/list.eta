<% const archive=firekylin.archive;const site=firekylin.site;let count=0; %><div class="post-feed gh-feed"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><div class="post-media"><div class="u-placeholder square"><a class="post-image-link" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover post-image u-object-fit" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div></div><div class="post-wrapper"><header class="post-header"><div class="post-meta"><time class="post-meta-item post-meta-date"><%= archive.date('YYYY-MM-DD') %></time></div><h2 class="post-title"><a class="post-title-link" href="<%= archive.permalink %>"><%= archive.title() %></a></h2></header><div class="post-excerpt"><%= archive.excerpt(200) %></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>