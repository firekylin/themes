<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const logo=String(cfg.logo||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><header class="site-header"><div class="header-inner"><a class="brand" href="/"><img src="<%= /^(https?:\/\/|\/(?!\/))/.test(logo)?logo:site.themeUrl('res/logo.svg') %>" alt=""><%= site.title() %></a><nav class="nav-items" aria-label="主导航"><a href="/">主页</a><a href="/archives">归档</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %><a href="/search.html">搜索</a></nav></div></header><div class="content-grid"><main id="main"><%~ block('content') %></main><aside id="toc" aria-label="文章目录" hidden><h2>目录</h2><ul></ul></aside></div><footer class="site-footer"><p><a href="/categories">分类</a> · <a href="/tags">标签</a></p><p><%= cfg.authorName||site.title() %> · <%= cfg.footerText||site.description() %></p><p>Firekylin · <a href="https://github.com/kitian616/jekyll-TeXt-theme">TeXt</a> 原生改编</p></footer></body></html>