<% const archive=firekylin.archive;let count=0;while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="excerpt"><%~ archive.excerpt(350) %><p><a class="read-more" href="<%= archive.permalink %>">Read more</a></p></div><div class="article-info"><div class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><%= t.name %></a><% }); %></div><time>▦ <%= archive.date('YYYY-MM-DD') %></time></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>