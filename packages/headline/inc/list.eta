<% const archive=firekylin.archive;let count=0; %><div class="gh-topic gh-topic-grid"><div class="gh-topic-content gh-feed"><% while(archive.next()){count++; %><article class="gh-card entry"><a class="gh-card-link" href="<%= archive.permalink %>"><div class="gh-card-wrapper"><header class="gh-card-header"><h2 class="gh-card-title"><%= archive.title() %></h2></header><div class="gh-card-excerpt"><%= archive.excerpt(200) %></div><footer class="gh-card-footer"><span class="gh-card-author"><%= archive.author('display_name') %></span><time class="gh-card-date"><%= archive.date('YYYY-MM-DD') %></time></footer></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %></div></div>