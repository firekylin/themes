<% const archive=firekylin.archive;let count=0; %><ul class="category recent-posts"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><li class="entry"><div class="article"><article class="article"><header class="post-header"><span class="title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></span><span class="date"><time><%= archive.date('YYYY-MM-DD') %></time></span></header></article></div></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>