<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body ><a class="native-skip" href="#main">跳转到正文</a><header class="main-header detail-page image-bg no-cover"><h1 class="page-title"><a href="/"><%= site.title() %></a></h1><h2 class="page-description"><%= site.description() %></h2><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></header><main id="main" class="native-main content"><%~ block("content") %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/jwillmer/jekyllDecent">Decent</a> by Johannes Willmer</footer></body></html>