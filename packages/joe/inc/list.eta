<% /* Firekylin adaptation, modified 2026-10-28; see NOTICE.md and LICENSE. */ %>
<% const archive = firekylin.archive; %><div class="fk-feed joe_index">
<% while (archive.next()) { const cover = String(archive.row.featuredImage || ''); const safeCover = /^(https?:\/\/|\/(?!\/))/.test(cover); %><article class="entry-card joe_list__item"><div class="entry-copy"><h2 class="entry-title joe_list__item-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time> · <%= archive.author() %></p><p class="entry-excerpt"><%= archive.excerpt(160) %></p><a class="entry-more" href="<%= archive.permalink %>">阅读全文 →</a></div></article><% } %></div>
