<% const archive=firekylin.archive;%><div class="fk-feed joe-feed"><% while(archive.next()){const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(archive.row.featuredImage||'')?archive.row.featuredImage:'';%><article class="entry-card joe-card"><% if(cover){ %><a class="joe-thumb" href="<%= archive.permalink %>"><img src="<%= cover %>" alt="" loading="lazy"></a><% } %><div class="entry-copy"><h2 class="entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="entry-excerpt"><%= archive.excerpt(120) %></p><div class="entry-meta"><time datetime="<%= archive.date('YYYY-MM-DD') %>"><%= archive.date('YYYY-MM-DD') %></time><% if(archive.row.comment_num!=null){ %><span><%= Number(archive.row.comment_num)||0 %> 评论</span><% } %><% for(const cate of archive.row.cate||[]){ %><a href="/cate/<%= cate.pathname %>"><%= cate.name %></a><% } %></div></div></article><% } %></div>