<% const archive=firekylin.archive;let count=0; %><section class="native-feed"><% while(archive.next()){count++; %><article class="entry"><h3><a href="<%= archive.permalink %>"><%= archive.title() %></a></h3><time><%= archive.date('YYYY-MM-DD') %></time><p><%= archive.excerpt(240) %></p><div class="chips"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>"><span class="tag"><%= t.name %></span></a><% }); %></div></article><hr><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>