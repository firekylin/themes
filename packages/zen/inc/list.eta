<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="list-view entry"><header><h2 class="title mt--s mb--xxs"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="meta"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></p></header><p><%= archive.excerpt(220) %></p><a href="<%= archive.permalink %>">阅读全文 →</a></article><% }if(!count){ %><p>暂无文章。</p><% } %>