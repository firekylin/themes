<% const archive=firekylin.archive;let count=0; %><div class="article-list"><% while(archive.next()){count++; %><article class="entry"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time class="post-date"><%= archive.date('YYYY-MM-DD') %></time></div></header><p><%= archive.excerpt(300) %></p><a class="native-readmore" href="<%= archive.permalink %>">继续阅读 »</a></article><% } %></div><% if(!count){ %><p>暂无文章。</p><% } %>