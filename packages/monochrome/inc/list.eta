<% const archive=firekylin.archive;let count=0; %><ul class="list-layout"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><li class="entry"><a href="<%= archive.permalink %>"><%= archive.title() %></a> <span><%= archive.date('YYYY/MM/DD') %></span></li><% }if(!count){ %><p>暂无文章。</p><% } %></ul>