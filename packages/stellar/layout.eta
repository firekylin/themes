<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:5}); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><div class="shell"><details class="site-menu" open><summary aria-label="切换导航菜单">☰</summary><div class="leftbar"><header class="brand"><% if(/^(https?:\/\/|\/(?!\/))/.test(String(cfg.avatarUrl||''))){ %><img src="<%= cfg.avatarUrl %>" alt=""><% } %><a href="/"><%= cfg.brandName||site.title() %></a><p><%= cfg.brandTagline||site.description() %></p></header><a class="search-shortcut" href="/search.html">搜索本站 <kbd>/</kbd></a><nav aria-label="主导航"><a href="/"><span aria-hidden="true">▤</span><span class="nav-label">博客</span></a><a href="/categories"><span aria-hidden="true">▦</span><span class="nav-label">分类</span></a><a href="/tags"><span aria-hidden="true">#</span><span class="nav-label">标签</span></a><a href="/archives"><span aria-hidden="true">▣</span><span class="nav-label">归档</span></a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><span aria-hidden="true">◇</span><span class="nav-label"><%= n.label %></span></a><% }); %></nav><section class="recent"><h2>最近更新</h2><% recent.stack.forEach(post=>{ %><a href="<%= recent.permalinkFor(post) %>"><%= post.title %></a><% }); %></section><div class="settings"><label>外观<select id="color-mode"><option value="auto">跟随系统</option><option value="light">浅色</option><option value="dark">深色</option></select></label><button id="collapse-sidebar" hidden>收起侧栏</button></div></div></details><div class="main-column"><header class="mobile-brand"><a href="/"><%= site.title() %></a></header><nav class="listing-nav" aria-label="内容导航"><a href="/">近期发布</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/archives">归档</a></nav><main id="main"><%~ block('content') %></main><footer>© <%= cfg.footerText||site.title() %> · Powered by Firekylin<br>Theme <a href="https://github.com/xaoxuu/hexo-theme-stellar">Stellar</a> by xaoxuu · 原生改编</footer></div><aside id="outline-rail" aria-label="文章目录"></aside></div><dialog id="search-dialog"><button id="search-close">关闭</button><h2>搜索本站</h2><form action="/search.html"><input name="keyword" aria-label="搜索关键词" required><button>搜索</button></form><p>由 Firekylin 搜索公开文章。</p></dialog></body></html>