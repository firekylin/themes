<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><a href="<%= archive.permalink %>"><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><div class="post-cover"><img src="<%= cover %>" alt="" loading="lazy"></div><% } %><div class="entry-body"><h2><%= archive.title() %></h2><div class="excerpt"><%~ archive.excerpt(240) %></div><p class="meta"><%= archive.date('YYYY-MM-DD') %></p></div></a></article><% }if(!count){ %><p>暂无文章。</p><% } %>