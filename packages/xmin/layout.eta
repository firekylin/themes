<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header><nav class="nav-items" aria-label="主导航"><ul class="menu"><li><a href="/">首页</a></li><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %></ul></nav><hr></header><main id="main"><%~ block('content') %></main><footer class="site-footer"><hr><p><%= cfg.footerText||site.description() %></p><span><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/yihui/hugo-xmin">XMin</a> 原生改编</span></footer></body></html>