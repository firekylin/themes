<% const archive=firekylin.archive;let count=0; %><div class="native-cards"><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="entry grid grid-rows-[300px_auto] min-h-full group"><a class="relative overflow-hidden" href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %><div class="native-card-date"><time><%= archive.date('YYYY-MM-DD') %></time></div></a><div class="flex justify-between flex-col gap-4 py-6 pl-1"><div class="flex flex-col gap-3"><h2 class="text-2xl font-semibold -tracking-wider"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><p class="text-gray-700"><%= archive.excerpt(220) %></p></div><div class="font-semibold"><a href="<%= archive.permalink %>" class="read-more">阅读全文 →</a></div></div></article><% }if(!count){ %><p>暂无文章。</p><% } %></div>