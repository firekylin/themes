<% /* Susty / Jack Lenox; modified 2026-10-30 for Firekylin, GPL-2.0-or-later. */ const site=await firekylin.widget('Widget_Options');const logo=String(site.themeConfig.logoUrl||''); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><header id="masthead"><% if(/^(https?:\/\/|\/(?!\/))/.test(logo)){ %><a class="logo" href="/"><img src="<%= logo %>" alt="首页"></a><% } %><p><a href="/"><%= site.title() %></a></p><a class="menu-open" href="#site-navigation">菜单</a><a class="menu-close" href="#main" aria-label="关闭菜单">✖</a></header><div id="content"><nav id="site-navigation" aria-label="站点菜单"><h1>菜单</h1><ul><li><a href="/">首页</a></li><% site.navigation.forEach(n=>{ %><li><a href="<%= n.url %>"><%= n.label %></a></li><% }); %><li><a href="/archives">归档</a></li><li><a href="/categories">分类</a></li><li><a href="/tags">标签</a></li><li><a href="/search.html">搜索</a></li><li><a href="/rss.html">RSS</a></li></ul></nav><main id="main"><%~ block('content') %></main></div><footer id="colophon"><p><%= site.themeConfig.footerText||'' %></p><a href="https://github.com/firekylin/firekylin">Powered by Firekylin</a> | Theme: <a href="https://github.com/jacklenox/susty">Susty</a> by <a href="https://blog.jacklenox.com">Jack Lenox</a>.</footer></body></html>