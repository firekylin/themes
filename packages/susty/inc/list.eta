<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row.options?.featuredImage||''); %><article class="entry"><header><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><%= archive.date('YYYY-MM-DD') %></div></header><% if(/^(https?:\/\/|\/(?!\/))/.test(cover)){ %><img class="post-image" src="<%= cover %>" alt="" loading="lazy"><% } %><div class="prose"><%~ archive.excerpt(600) %></div><footer><a href="<%= archive.permalink %>">阅读全文</a></footer></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>