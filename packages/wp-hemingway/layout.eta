<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/fonts.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body class="firekylin-native"><a class="native-skip" href="#main">跳转到正文</a><div class="big-wrapper"><div class="header-cover section bg-dark-light no-padding"><header class="header section"><div class="header-inner section-inner"><div class="blog-info"><h1 class="blog-title"><a href="/"><%= site.title() %></a></h1><p class="blog-description"><%= site.description() %></p></div></div></header></div><div class="navigation section no-padding bg-dark"><div class="navigation-inner section-inner group"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></div></div><div class="wrapper section-inner group"><main id="main" class="native-main content left"><%~ block('content') %></main><aside class="sidebar right"><div class="widget"><h3 class="widget-title">关于</h3><p><%= site.description() %></p></div><div class="widget"><h3 class="widget-title">标签</h3><ul><% const tags=await firekylin.widget('Widget_Metas_Tag_Cloud');while(tags.next()){ %><li><a href="<%= tags.permalink %>"><%= tags.row.name %></a></li><% } %></ul></div></aside></div><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/andersnoren/hemingway">Hemingway</a> by Anders Norén</footer></div></body></html>