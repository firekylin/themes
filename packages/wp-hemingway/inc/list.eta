<% const archive=firekylin.archive;let count=0;while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||''); %><article class="post entry"><div class="featured-media"><a href="<%= archive.permalink %>"><% if(cover && /^(?:https?:\/\/|\/(?!\/))/i.test(cover)){ %><img class="native-cover" src="<%= cover %>" alt="<%= archive.title() %>" loading="lazy"><% } %></a></div><div class="post-header"><h2 class="post-title entry-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div></div><div class="post-content entry-content"><p><%= archive.excerpt(300) %></p></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>