<% const archive=firekylin.archive;let count=0; %><section class="sk3-cards sk3-flex sk3-flex-center-h"><% while(archive.next()){count++; %><article class="entry sk3-card box"><div class="sk3-flex"><a class="sk3-flex-inline" href="<%= archive.permalink %>"><h3><%= archive.title() %></h3></a><time class="card-date sk3-flex-right sk3-flex-down"><%= archive.date('YYYY-MM-DD') %></time></div><p class="card-summary"><%= archive.excerpt(220) %></p></article><% } %></section><% if(!count){ %><p>暂无文章。</p><% } %>