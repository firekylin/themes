<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig;const palette=cfg.palette==='light'?'light':'dark'; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/sk3.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body data-palette="<%= palette %>"><a class="skip" href="#main">跳转到正文</a><header class="site-header sk3-flex"><details class="sk3-menu"><summary class="sk3-sidebar-btn" aria-label="打开导航">☰</summary><aside class="sk3-sidebar box-right"><nav class="native-nav nav-items" aria-label="主导航"><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></nav></aside></details><a class="site-title" href="/"><h1><%= site.title() %></h1></a><span class="site-subtitle sk3-sub-title"><%= site.description() %></span></header><main id="main"><%~ block('content') %></main><footer class="site-footer sk3-flex sk3-flex-center-h"><p class="footer-text"><%= cfg.footerText||site.description() %></p><span>© <%= cfg.authorName||site.title() %></span><span>Powered by Firekylin.</span><span>Theme <a href="https://github.com/J-Siu/hugo-theme-sk3">SK3</a> by <a href="https://github.com/J-Siu">J-Siu</a>.</span></footer><script src="<%= site.themeUrl('res/js/theme.js') %>" defer></script></body></html>