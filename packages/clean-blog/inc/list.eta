<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="post-preview entry"><a href="<%= archive.permalink %>"><h2 class="post-title"><%= archive.title() %></h2><h3 class="post-subtitle"><%= archive.excerpt(180) %></h3></a><p class="post-meta"><%= archive.author('display_name') %> · <%= archive.date('YYYY-MM-DD') %></p></article><hr><% }if(!count){ %><p>暂无文章。</p><% } %>