{
  "name": "clean-blog",
  "title": "Clean Blog",
  "version": "0.1.0",
  "private": true,
  "description": "Original large masthead, bold sans-serif post previews, serif reading body, teal links and centered narrow Bootstrap grid.",
  "license": "MIT",
  "author": "Start Bootstrap; Firekylin contributors",
  "homepage": "https://github.com/StartBootstrap/startbootstrap-clean-blog-jekyll",
  "repository": {
    "type": "git",
    "url": "https://github.com/firekylin/themes.git",
    "directory": "packages/clean-blog"
  },
  "firekylin": {
    "type": "theme",
    "id": "clean-blog"
  },
  "engines": {
    "firekylin": ">=2.17.1"
  },
  "configElements": [
    {
      "type": "text",
      "name": "authorName",
      "label": "页脚作者",
      "help": "留空使用站点标题。"
    },
    {
      "type": "text",
      "name": "footerText",
      "label": "页脚介绍",
      "help": "留空使用站点描述。"
    }
  ]
}
