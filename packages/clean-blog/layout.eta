<% const site=await firekylin.widget('Widget_Options');const cfg=site.themeConfig; %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"></head><body><a class="skip" href="#main">跳转到正文</a><nav id="mainNav" aria-label="主导航"><div class="container native-nav"><a href="/"><%= site.title() %></a><div class="nav-items"><a href="/">首页</a><a href="/archives">归档</a><a href="/categories">分类</a><a href="/tags">标签</a><a href="/search.html">搜索</a><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %></a><% }); %></div></div></nav><header class="masthead"><div class="overlay"></div><div class="container"><div class="page-heading"><h1><%= site.title() %></h1><span class="subheading"><%= site.description() %></span></div></div></header><main id="main" class="container"><%~ block('content') %></main><footer class="native-footer"><p><%= cfg.footerText||site.description() %></p><%= cfg.authorName||site.title() %> · Firekylin · <a href="https://github.com/StartBootstrap/startbootstrap-clean-blog-jekyll">Clean Blog</a> by Start Bootstrap</footer></body></html>