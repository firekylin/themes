<% const site=await firekylin.widget('Widget_Options');const categories=await firekylin.widget('Widget_Metas_Category_List');const recent=await firekylin.widget('Widget_Contents_Post_Recent',{pageSize:10}); %><!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/theme.css') %>"><script defer src="<%= site.themeUrl('res/js/theme.js') %>"></script></head><body><a class="skip" href="#main">跳转到正文</a><aside id="sidebar"><div id="header-wrapper"><a class="brand" href="/"><%= site.title() %></a><form class="searchbox" action="/search.html" method="get"><label class="sr-only" for="sidebar-keyword">搜索文章</label><input id="sidebar-keyword" name="keyword" placeholder="搜索…" required><button aria-label="搜索">⌕</button></form></div><details class="site-menu" open><summary>目录</summary><div class="menu-content"><nav aria-label="站点目录"><a class="home-link" href="/">首页</a><div class="nav-group"><% site.navigation.forEach(n=>{ %><a href="<%= n.url %>"><%= n.label %><span class="read-icon" aria-hidden="true">✓</span></a><% }); %><details class="nav-section" open><summary>分类</summary><% while(categories.next()){ %><a href="<%= categories.permalink %>"><%= categories.row.name %><span class="read-icon" aria-hidden="true">✓</span></a><% } %></details><details class="nav-section" open><summary>最新文章</summary><% while(recent.next()){ %><a href="<%= recent.permalink %>"><%= recent.title() %><span class="read-icon" aria-hidden="true">✓</span></a><% } %></details></div><h2 class="more-title">更多</h2><div class="shortcuts"><a href="/archives">归档</a><a href="/tags">标签</a><a href="/rss.html">RSS</a><a href="/search.html">搜索文章</a></div></nav><div class="prefooter"><button id="clear-history" hidden>清除阅读记录</button></div><footer><p><%= site.themeConfig.footerText||'' %></p><p>Built with ♥ · <a href="https://github.com/matcornic/hugo-theme-learn">Learn</a> · <a href="https://github.com/firekylin/firekylin">Firekylin</a></p></footer></div></details></aside><div id="body"><div class="padding"><div id="top-bar"><a href="/">首页</a><span aria-hidden="true"> › </span><span>内容</span></div><main id="main"><%~ block('content') %></main></div></div></body></html>