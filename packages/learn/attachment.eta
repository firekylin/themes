<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'attachment'});const found=archive.next(); %><% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }) %><% block('content',()=>{ %><article><% if(found){ %><h1><%= archive.title() %></h1><details id="learn-toc" hidden><summary>本页目录</summary><nav aria-label="文章目录"></nav></details><div class="prose" id="post-content"><%~ archive.content() %></div><footer class="footline"><%= archive.date('YYYY-MM-DD') %> · <%= archive.author('display_name') %></footer><div class="tags"><% (archive.row.cate||[]).forEach(c=>{ %><a href="/cate/<%= c.pathname %>"><%= c.name %></a> <% }); %><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a> <% }); %></div><%~ firekylin.comment({title:'评论'}) %><% }else{ %><p>暂无内容。</p><% } %></article><% }) %>