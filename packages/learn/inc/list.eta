<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++; %><article class="entry"><h2><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="entry-meta"><%= archive.date('YYYY-MM-DD') %></div><div class="entry-summary"><%~ archive.excerpt(230) %></div><a href="<%= archive.permalink %>">阅读全文 →</a></article><% } %><% if(!count){ %><p>暂无文章。</p><% } %>