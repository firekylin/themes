<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><h1><%= archive.archiveTitle||site.themeConfig.introTitle||site.title() %></h1><% if(!archive.archiveTitle&&archive.pagination?.currentPage===1){ %><p class="intro"><%= site.themeConfig.introText||site.description() %></p><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>