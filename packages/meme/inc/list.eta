<% const archive=firekylin.archive;let count=0; %><% while(archive.next()){count++;const cover=String(archive.row?.options?.featuredImage||""); %><article class="content post home h-entry entry"><h2 class="post-title p-name"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><div class="post-meta"><time><%= archive.date('YYYY-MM-DD') %></time></div><div class="summary p-summary"><p><%= archive.excerpt(260) %></p></div><div class="read-more-container"><a href="<%= archive.permalink %>" class="button">阅读全文 →</a></div></article><% }if(!count){ %><p>暂无文章。</p><% } %>