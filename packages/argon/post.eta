<% layout('layout'); const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'post'}); const found=archive.next(); %>
<% block('title',()=>{ %><%= found?archive.title()+' · ':'' %><%= site.title() %><% }); block('content',()=>{ %>
<% if(found){ %><article class="post post-full card bg-white shadow-sm border-0"><% const image=archive.row.featuredImage||archive.row.options?.featuredImage||'';const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(image))?image:''; %><header class="post-header text-center <%= cover?'post-header-with-thumbnail':'' %>"><% if(cover){ %><img class="post-thumbnail" src="<%= cover %>" alt="" loading="lazy"><div class="post-header-text-container"><% } %><h1 class="post-title"><%= archive.title() %></h1><%~ include('inc/meta',{archive}) %><% if(cover){ %></div><% } %></header><div class="post-content" id="post_content"><%~ archive.content() %></div></article><div class="comment-container"><%~ firekylin.comment({title:'评论',className:'card argon-comments'}) %></div><% } else { %><p class="card empty">内容不存在</p><% } %><% }); %>
