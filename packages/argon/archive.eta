<% layout('layout');const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'archive'}); %><% block('title',()=>{ %>归档 · <%= site.title() %><% });block('content',()=>{ %><section class="post card"><h1>文章归档</h1><% for(const [month,rows] of Object.entries(archive.grouped||{})){ %><h2><%= month %></h2><ul class="archive-timeline"><% for(const row of rows){ %><li><a href="<%= archive.permalinkFor(row) %>"><%= row.title %></a></li><% } %></ul><% } %></section><% }); %>
