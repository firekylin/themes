<% /* Port of Argon 1.3.5 header.php/sidebar.php/footer.php. See NOTICE.md. */
const site=await firekylin.widget('Widget_Options'), c=site.themeConfig||{};
const safe=v=>/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(v||''))?String(v):'';
const color=/^#[a-f0-9]{6}$/i.test(c.accentColor||'')?c.accentColor:'#5e72e4';
const rgb=[1,3,5].map(n=>parseInt(color.slice(n,n+2),16));
const mode=['light','dark','black'].includes(c.colorMode)?c.colorMode:'auto';
const classes=[mode==='dark'||mode==='black'?'darkmode':'',mode==='black'?'amoled-dark':'',c.pageLayout==='single'?'single-column':c.pageLayout==='reverse'?'double-column-reverse':'',c.fontFamily==='serif'?'serif':''].join(' ');
const cats=await firekylin.widget('Widget_Metas_Category_List'), tags=await firekylin.widget('Widget_Metas_Tag_Cloud');
%><!doctype html><html lang="zh-CN" class="<%= classes %>" data-color-mode="<%= mode %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%~ block('title') %></title><meta name="description" content="<%= site.description() %>"><link rel="alternate" type="application/rss+xml" href="/rss.html" title="RSS">
<link rel="stylesheet" href="<%= site.themeUrl('res/css/upstream.css') %>"><link rel="stylesheet" href="<%= site.themeUrl('res/css/firekylin.css') %>">
<style>:root{--themecolor:<%= color %>;--themecolor-R:<%= rgb[0] %>;--themecolor-G:<%= rgb[1] %>;--themecolor-B:<%= rgb[2] %>;--themecolor-gradient:linear-gradient(150deg,<%= color %>,<%= color %>cc)}</style>
<script defer src="<%= site.themeUrl('res/js/argon.js') %>"></script></head><body class="fk-theme <%= mode==='dark'||mode==='black'?'fk-dark':'' %>"><a class="skip-link" href="#main">跳转到正文</a>
<header id="navbar-main"><a class="navbar-title" href="/"><%= site.title() %></a><nav aria-label="主导航"><% for(const nav of site.navigation){ %><a href="<%= nav.url %>"><%= nav.label %></a><% } %></nav><details class="mobile-nav"><summary>菜单</summary><nav><% for(const nav of site.navigation){ %><a href="<%= nav.url %>"><%= nav.label %></a><% } %><a href="/search.html">搜索</a></nav></details></header>
<section id="banner" class="banner section section-lg section-shaped"><div class="shape shape-style-1 shape-primary"><% for(let i=0;i<9;i++){ %><span></span><% } %></div><% if(safe(c.bannerImage)){ %><img class="banner-image" src="<%= safe(c.bannerImage) %>" alt=""><% } %><div class="banner-container container text-center"><div class="banner-title text-white"><span class="banner-title-inner"><%= c.bannerTitle||site.title() %></span><span class="banner-subtitle d-block"><%= c.heroText||site.description() %></span></div></div></section>
<div id="content" class="site-content"><aside id="leftbar" class="leftbar widget-area">
<% if(c.announcement){ %><div id="leftbar_announcement" class="card"><div class="leftbar-announcement-body"><div class="leftbar-announcement-title text-white">公告</div><div class="leftbar-announcement-content text-white"><%= c.announcement %></div></div></div><% } %>
<div id="leftbar_part1" class="card"><div class="leftbar-banner card-body"><span class="leftbar-banner-title text-white"><%= c.sidebarTitle||site.title() %></span><span class="leftbar-banner-subtitle text-white"><%= c.sidebarSubtitle||site.description() %></span></div><ul class="leftbar-menu"><% for(const nav of site.navigation){ %><li class="leftbar-menu-item"><a href="<%= nav.url %>"><%= nav.label %></a></li><% } %></ul><a class="sidebar-search" href="/search.html">搜索</a></div>
<div id="leftbar_part2" class="card"><div class="card-body"><% if(safe(c.avatarUrl)){ %><img id="leftbar_overview_author_image" src="<%= safe(c.avatarUrl) %>" alt="站点头像"><% } %><p id="leftbar_overview_author_name"><%= site.title() %></p><p id="leftbar_overview_author_description"><%= site.description() %></p><details open class="catalog" hidden><summary>文章目录</summary><ol id="leftbar_catalog"></ol></details><details open><summary>分类</summary><ul><% while(cats.next()){ %><li><a href="<%= cats.permalink %>"><%= cats.title() %></a></li><% } %></ul></details><details open><summary>标签</summary><div class="tag-cloud"><% while(tags.next()){ %><a href="<%= tags.permalink %>"><%= tags.title() %></a> <% } %></div></details></div></div></aside>
<div id="primary" class="content-area"><main id="main" class="site-main"><%~ block('content') %></main></div></div>
<footer class="argon-footer"><%= c.footerText||site.title() %><p>Powered by <a href="https://github.com/firekylin/firekylin">Firekylin</a> · <a href="https://github.com/solstice23/argon-theme">Argon</a> by solstice23 · <a href="/rss.html">RSS</a></p></footer>
<div class="floating-tools"><button type="button" data-mode hidden aria-label="切换颜色模式">◐</button><a href="#navbar-main" aria-label="返回顶部">↑</a></div><progress id="reading-progress" value="0" max="100" aria-label="阅读进度" hidden></progress><dialog class="image-viewer" aria-label="图片预览"><button type="button" data-close>关闭</button><img alt=""></dialog></body></html>
