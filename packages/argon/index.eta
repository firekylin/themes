<% layout('layout'); const site=await firekylin.widget('Widget_Options'),archive=await firekylin.widget('Widget_Archive',{type:'index'}); const c=site.themeConfig||{},length=Number.isFinite(Number(c.excerptLength))?Math.min(600,Math.max(0,Number(c.excerptLength))):175; %>
<% block('title',()=>{ %><%= archive.archiveTitle ? archive.archiveTitle+' · ' : '' %><%= site.title() %><% });block('content',()=>{ %>
<% if(archive.archiveTitle){ %><h1 class="card archive-heading"><%= archive.archiveTitle %></h1><% } %>
<% if(!archive.have()){ %><p class="card empty">暂无文章</p><% } %><% while(archive.next()){ %>
<article class="post card bg-white shadow-sm border-0"><% const image=archive.row.featuredImage||archive.row.options?.featuredImage||'';const cover=/^(https?:\/\/|\/(?!\/))[^\s<>\x22\x27]*$/i.test(String(image))?image:''; %><header class="post-header text-center <%= cover?'post-header-with-thumbnail':'' %>"><% if(cover){ %><img class="post-thumbnail" src="<%= cover %>" alt="" loading="lazy"><div class="post-header-text-container"><% } %><h2 class="post-title"><a href="<%= archive.permalink %>"><%= archive.title() %></a></h2><%~ include('inc/meta',{archive}) %><% if(cover){ %></div><% } %></header>
<% if(length){ %><div class="post-content"><%= archive.excerpt(length) %></div><% } %><a class="read-more" href="<%= archive.permalink %>">阅读全文 →</a></article><% } %><%~ include('inc/pagination',{archive}) %><% }); %>
