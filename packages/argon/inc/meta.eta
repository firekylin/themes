<% const a=firekylin.archive; %><div class="post-meta"><time class="post-meta-detail"><%= a.date('Y-m-d') %></time><span class="post-meta-devide">|</span><span class="post-meta-detail"><%= a.author('display_name') %></span><% if(a.row.comment_num!=null){ %><span class="post-meta-devide">|</span><a href="<%= a.permalink %>#comments"><%= Number(a.row.comment_num)||0 %> 评论</a><% } %><% for(const cat of a.row.cate||[]){ %><span class="post-meta-devide">|</span><a href="/cate/<%= cat.pathname %>"><%= cat.name %></a><% } %><span class="reading-time" hidden></span></div>