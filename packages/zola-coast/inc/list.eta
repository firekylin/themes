<% const archive=firekylin.archive;let count=0; %><section class="blog-list-page"><h2 class="title">文章</h2><a href="/tags" class="tag-list">所有标签 &gt;&gt;</a><ul><% while(archive.next()){count++; %><li class="entry"><a class="post-link" href="<%= archive.permalink %>"><p class="date">date: <%= archive.date('YYYY-MM-DD') %></p><p class="author">author: <%= archive.author('display_name') %></p><h2><%= archive.title() %></h2></a><p class="tags"><% (archive.row.tag||[]).forEach(t=>{ %><a href="/tag/<%= t.pathname %>">#<%= t.name %></a><% }); %></p></li><% } %></ul><% if(!count){ %><p>暂无文章。</p><% } %></section>