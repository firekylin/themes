<% layout('./layout');const site=await firekylin.widget('Widget_Options');const archive=await firekylin.widget('Widget_Archive',{type:'index'}); %><% block('title',()=>{ %><%= archive.archiveTitle||site.title() %><% }) %><% block('content',()=>{ %><section class="first-view"><% const hero=String(site.themeConfig.heroImage||'');if(/^(https?:\/\/|\/(?!\/))/.test(hero)){ %><img class="hero-image" src="<%= hero %>" alt=""><% } %><h1 class="title">#<%= site.title() %></h1></section><section class="about"><h2 class="title">关于本站</h2><p class="content"><%= site.description() %></p></section><% if(archive.archiveTitle){ %><h1><%= archive.archiveTitle %></h1><% } %><%~ include('./inc/list',{archive}) %><%~ include('./inc/pagination',{archive}) %><% }) %>